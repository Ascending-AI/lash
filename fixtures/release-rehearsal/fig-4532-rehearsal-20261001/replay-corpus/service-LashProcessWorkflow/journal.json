{
  "scenario": "service-LashProcessWorkflow",
  "service": "LashProcessWorkflow",
  "recorded_at_git_sha": "6b665cd0a405d3abe245d6473eb5085ab2d79add",
  "format": "lash-restate service handler journals v1; per handler, each distinct ordered command sequence its invocations wrote on the server double, minted ids elided as #",
  "journal_logic_epoch": 1,
  "handlers": {
    "await_cancel": [
      [
        "InputCommand",
        "GetPromiseCommand",
        "OutputCommand"
      ]
    ],
    "await_terminal": [
      [
        "InputCommand",
        "GetPromiseCommand",
        "OutputCommand"
      ]
    ],
    "run": [
      [
        "InputCommand",
        "RunCommand lash.build.generation",
        "RunCommand lash.segment.admit",
        "RunCommand lash.segment.start",
        "RunCommand lash.process.complete",
        "RunCommand lash.process.parent-end",
        "CompletePromiseCommand",
        "CompletePromiseCommand",
        "PeekPromiseCommand",
        "RunCommand lash.process.terminal.published",
        "OutputCommand"
      ]
    ]
  }
}
