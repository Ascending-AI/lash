effect dataframe.run(batch: Json) -> Json contract "example.dataframe.run/1"
effect dataframe.explain(batch: Json) -> Json contract "example.dataframe.explain/1"
use eq
use brand.built
use list.len
use list.concat
use map.contains
use num.lt
use dataframe.make_expr
use dataframe.make_quanta
use dataframe.col
use dataframe.lit
use dataframe.count
use dataframe.sum
use dataframe.expr.neq
use dataframe.expr.alias
use dataframe.expr.sort
use dataframe.data_quanta.read_text
use dataframe.data_quanta.then
use dataframe.data_quanta.flat_map
use dataframe.data_quanta.filter_by
use dataframe.data_quanta.map
use dataframe.data_quanta.reduce_by_key_fn
use dataframe.data_quanta.filter
use dataframe.data_quanta.reduce_by_key
use dataframe.data_quanta.sort
