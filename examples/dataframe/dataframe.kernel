function dataframe.lambda(rows: List(Any), stage: Any) -> List(Any)
kernel 1
charge sum(128, product(256, deep(rows)), product(256, deep(result)))
body {
  let out = []
  let callback = stage.callback
  let groups = map{}
  let order = []
  for row in rows metered 64 {
    let kind = stage.kind
    if eq(kind, "reduce_fn") {
      let key = apply callback(row)
      if map.contains(groups, key) {
        let combine = stage.combine
        let combined = apply combine(groups[key], row)
        set groups[key] = combined
      } else {
        set groups[key] = row
        set order[list.len(order)] = key
      }
    } else {
      let value = apply callback(row)
      if eq(kind, "flat_map") {
        for item in value metered 8 { set out[list.len(out)] = item }
      } else {
        if eq(kind, "filter_by") {
          if value { set out[list.len(out)] = row }
        } else { set out[list.len(out)] = value }
      }
    }
  }
  for key in order metered 8 { set out[list.len(out)] = groups[key] }
  return out
}

function dataframe.data_quanta.collect_rows(self: data_quanta) -> List(Any)
kernel 1
charge sum(128, product(256, deep(self)), product(256, deep(result)))
body {
  let rows = self.rows
  let schema = self.schema
  let plan = []
  for stage in self.plan metered 64 {
    if eq(stage.kind, "expression") {
      set plan[list.len(plan)] = stage.plan
    } else {
      if num.lt(0, list.len(plan)) {
        let answer = perform dataframe.run({rows: rows, schema: schema, plan: plan}) as Json
        set rows = answer.rows
        set schema = answer.schema
        set plan = []
      }
      let next = invoke dataframe.lambda(rows, stage)
      set rows = next
    }
  }
  if num.lt(0, list.len(plan)) {
    let answer = perform dataframe.run({rows: rows, schema: schema, plan: plan}) as Json
    set rows = answer.rows
  }
  return rows
}

function dataframe.data_quanta.explain(self: data_quanta) -> Json
kernel 1
charge sum(128, product(256, deep(self)), product(256, deep(result)))
body {
  let placement = []
  let plan = []
  for stage in self.plan metered 32 {
    if eq(stage.kind, "expression") {
      set plan[list.len(plan)] = stage.plan
    } else {
      if num.lt(0, list.len(plan)) {
        let explanation = perform dataframe.explain({rows: [], schema: self.schema, plan: plan}) as Json
        set placement[list.len(placement)] = explanation
        set plan = []
      }
      set placement[list.len(placement)] = {platform: "kernel", stage: stage.kind}
    }
  }
  if num.lt(0, list.len(plan)) {
    let explanation = perform dataframe.explain({rows: [], schema: self.schema, plan: plan}) as Json
    set placement[list.len(placement)] = explanation
  }
  return placement
}
