use dataframe.lambda
use dataframe.data_quanta.collect_rows
use dataframe.data_quanta.explain

function dataframe.make_expr(op: Text, args: List(Any), name: Text) -> expr
kernel 1
charge sum(16, deep(args), size(name), size(op))
body {
  let built = brand.built()
  return {op: op, args: args, name: name, __lash_brand: ("dataframe", "expr"), __lash_built: built}
}

function dataframe.make_quanta(rows: List(Any), schema: List(Text), plan: List(Any)) -> data_quanta
kernel 1
charge sum(16, size(rows), size(schema), size(plan))
body {
  let built = brand.built()
  return {rows: rows, schema: schema, plan: plan, __lash_brand: ("dataframe", "data_quanta"), __lash_built: built}
}

function dataframe.col(name: Text) -> expr
kernel 1
charge sum(32, deep(result))
body {
  let made = invoke dataframe.make_expr("col", [name], name)
  return made
}

function dataframe.lit(value: Json) -> expr
kernel 1
charge sum(32, deep(result))
body {
  let made = invoke dataframe.make_expr("lit", [value], "lit")
  return made
}

function dataframe.count() -> expr
kernel 1
charge sum(32, deep(result))
body {
  let made = invoke dataframe.make_expr("count", [], "count")
  return made
}

function dataframe.sum(value: expr) -> expr
kernel 1
charge sum(32, deep(result))
body {
  let made = invoke dataframe.make_expr("sum", [value], "sum")
  return made
}

function dataframe.expr.neq(self: expr, other: expr) -> expr
kernel 1
charge sum(32, deep(result))
body {
  let made = invoke dataframe.make_expr("neq", [self, other], self.name)
  return made
}

function dataframe.expr.alias(self: expr, name: Text) -> expr
kernel 1
charge sum(32, deep(result))
body {
  let made = invoke dataframe.make_expr("alias", [self], name)
  return made
}

function dataframe.expr.sort(self: expr, options: Record{ascending: Bool}) -> expr
kernel 1
charge sum(32, deep(result))
body {
  let made = invoke dataframe.make_expr("sort", [self, options.ascending], self.name)
  return made
}

function dataframe.data_quanta.read_text(text: Text) -> data_quanta
kernel 1
charge sum(32, size(text))
body {
  let made = invoke dataframe.make_quanta([text], ["value"], [])
  return made
}

function dataframe.data_quanta.then(self: data_quanta, stage: Any) -> data_quanta
kernel 1
charge sum(32, size(self), size(stage))
body {
  let plan = list.concat(self.plan, [stage])
  let made = invoke dataframe.make_quanta(self.rows, self.schema, plan)
  return made
}

function dataframe.data_quanta.flat_map(self: data_quanta, f: Fn(value: Any) -> Any) -> data_quanta
kernel 1
charge sum(32, size(self), deep(result))
body {
  let made = invoke dataframe.data_quanta.then(self, {kind: "flat_map", callback: f})
  return made
}

