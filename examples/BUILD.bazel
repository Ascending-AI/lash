filegroup(
    name = "shared_rust_sources",
    srcs = glob(["shared/**/*.rs"]),
    visibility = ["//visibility:public"],
)

# The TypeScript host-flow cells are linked by
# `crates/lash-typescript/tests/host_flow_examples.rs` with `include_str!`,
# so they are compile inputs of that test target.
filegroup(
    name = "typescript_host_flow_cells",
    srcs = glob(["typescript-host-flows/*.ts"]),
    visibility = ["//visibility:public"],
)
