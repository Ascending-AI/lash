function order_review(order: Json) -> Json
kernel 1
metering statements
@{imports}
use audit = @{audit}
body {
  let approved = []
  let skipped = []
  let status = "open"
  try {
    for group in order.groups {
      for line in group.lines {
        let sku = line.sku
        let item = invoke import 6(invoke import 6(group.name, "/"), sku)
        if invoke import 4(line.qty, 2) {
          let request = {item: item}
          let decision = perform 0(request) as Any
          if invoke import 5(decision.approved, false) {
            throw {code: "REJECTED", sku: sku}
          }
          do invoke import 7(approved, item)
        } else {
          do invoke import 7(skipped, sku)
        }
        let note = {entry: item}
        do perform 1(note) as Any
      }
    }
    set status = "reviewed"
  } catch error {
    set status = "rejected"
    let rejected = {entry: "rejected"}
    do perform 1(rejected) as Any
  }
  let summary = {status: status}
  let args = {summary: summary}
  let start = {definition: &audit, args: args}
  let audit_run = perform 2(start) as Any
  let wait = {handle: audit_run}
  let audited = perform 3(wait) as Any
  return {status: status, approved: approved, skipped: skipped, audited: audited}
}
