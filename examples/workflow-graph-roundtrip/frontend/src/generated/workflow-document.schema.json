    "NodeData": {
      "description": "A node's display name together with the one fact that decides whether the\nhost may throw it away: who chose it.\n\nRendering emits an `@label` annotation only for an authored name, so a\npayload that carries a title without saying where the name came from is a\nrename waiting to evaporate. The tag is therefore mandatory and carries the\ntitle inside the variant: \"title present, tag absent\" is unrepresentable,\nand an unknown tag is a decode error rather than a silent `derived`. The\nwire values (`label`, `derived`) mirror `WorkflowNodeNameSource`, which the\nbrowser client already writes on every node.",
      "oneOf": [
        {
          "description": "The author named this node: the title and its optional description are\ntheirs, and the save path renders them back as an `@label` annotation.",
          "properties": {
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "nameSource": {
              "const": "label",
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "nameSource",
            "title"
          ],
          "type": "object"
        },
        {
          "description": "The name is a rendering of the node's own expression. The title is\noutput, not input: the save path recomputes it and it carries no\ndescription.",
          "properties": {
            "nameSource": {
              "const": "derived",
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "nameSource",
            "title"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "availableVars": {
          "default": [],
