load(":pool_sizes.bzl", "POOL_EXEC_PROPERTIES")
load(":test_xml.bzl", "test_xml_runner")

exports_files([
    "generate_build_files.py",
    "junit_xml.py",
    "lash_rust.bzl",
    "target-inventory.json",
    "test_batch_runner.sh",
    "ui_fixtures_runner.sh",
    "workspace_targets.bzl",
])

exports_files(["patches/libsqlite3-sys-hermetic-manifest-dir.patch"])
exports_files(["patches/rules-rust-clippy-action-exec-group.patch"])

# The checked-in workspace fact that replaces a nested `cargo metadata` call in
# the lash-core dependency-direction test. Kept current by
# `tools/bazel/generate_build_files.py --check`.
filegroup(
    name = "target_inventory",
    srcs = ["target-inventory.json"],
    visibility = ["//visibility:public"],
)

exports_files(["patches/rules-swift-no-toolchain-registration.patch"])

# The `--run_under` prefix of every test action (`.bazelrc`): the test writes
# its own JUnit report, so Bazel never schedules a `generate-xml.sh` spawn.
test_xml_runner(
    name = "test_xml_runner",
    src = "test_xml_runner.sh",
    data = ["junit_xml.py"],
)

# The `--run_under` prefix of the PostgreSQL store job's sharded suites
# (`scripts/ci/store-tests.sh pg-store`): each test action takes a database
# slot of its own, records its shard's share of the binary's `--list`, then
# runs under `test_xml_runner.sh` like every other test.
test_xml_runner(
    name = "postgres_slot_runner",
    src = "postgres_slot_runner.sh",
    data = [
        "junit_xml.py",
        "test_xml_runner.sh",
    ],
)

# The workspace's execution platform: the small default request every action
# carries, plus one `pool_<cpu>_<memory_kb>`-scoped entry per distinct measured
# compile request. Exec-group-scoped platform properties are the only channel
# that reaches actions an *aspect* creates, so the Clippy/check aspects in
# `clippy.bzl` run their actions in the pool exec group named by the target's
# compile row instead of inheriting `exec_properties` they cannot see.
# `parents` keeps the host's constraints verbatim, so this platform matches
# exactly what `@platforms//host` matched.
platform(
    name = "pool",
    exec_properties = POOL_EXEC_PROPERTIES,
    parents = ["@platforms//host"],
    visibility = ["//visibility:public"],
)
