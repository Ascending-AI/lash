load("//tools/bazel:schema_checks.bzl", "schema_check", "schema_documents")
load("//tools/bazel:clippy.bzl", "lash_rust_clippy")
load(
    "//tools/bazel:feature_lanes.bzl",
    "FEATURE_LANE_CLIPPY_TARGETS",
    "FEATURE_LANE_COMPILE_TARGETS",
    "FEATURE_LANE_TEST_TARGETS",
)
load(
    "//tools/bazel:workspace_targets.bzl",
    "WORKSPACE_CLIPPY_TARGETS",
    "WORKSPACE_COMPILE_TARGETS",
    "WORKSPACE_DOC_TARGETS",
    "WORKSPACE_BAZEL_TEST_TARGETS",
    "WORKSPACE_DEFERRED_TEST_TARGETS",
    "WORKSPACE_DEV_SUITE_LABELS",
    "WORKSPACE_RUST_SOURCE_TARGETS",
    "WORKSPACE_TAIL_SUITE_LABELS",
    "WORKSPACE_TEST_SUITE_LABELS",
    "WORKSPACE_TEST_TARGETS",
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "clippy.toml",
])

filegroup(
    name = "workflow_graph_schema",
    srcs = ["schemas/host/workflow-graph/v13.schema.json"],
    testonly = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cargo_metadata",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
    ],
    visibility = ["//visibility:public"],
)

# The generated suite is the complete deterministic/default-feature test
# partition. Cargo-owned labels carry `manual`, so `bazel test //...` and this
# focused aggregate execute the same safe set. `WORKSPACE_TEST_SUITE_LABELS`
# is the member list with each package's plain tests swapped for its
# `:test_batch` aggregate (FIG-3365) -- the batch runs the identical binaries
# under one shared runfiles tree; member targets stay individually runnable.
test_suite(
    name = "workspace_tests",
    tests = WORKSPACE_TEST_SUITE_LABELS,
)

# The measured long tail of `workspace_tests`: every `//examples/` leaf, which
# trails the serial rebuild of a core-touching diff, plus the `dev-deferred`
# slow labels. CI's `bazel-tests` leg subtracts this suite and a second job
# runs it in parallel, so the partition's wall clock is max(legs), not sum.
# Locally `//:workspace_tests` still runs the whole partition in one command.
test_suite(
    name = "workspace_tail_tests",
    tests = WORKSPACE_TAIL_SUITE_LABELS,
)

# The feature-coverage lanes of scripts/feature-coverage.toml, compiled at each
# command's own feature resolution rather than the workspace's. One pool build
# replaces the fourteen `Package feature check` matrix legs and the
# `Runtime feature boundary` Cargo legs; `tools/bazel/feature_variants.py`
# explains how the resolutions are derived and what is NOT re-resolved.
filegroup(
    name = "feature_lanes",
    srcs = FEATURE_LANE_COMPILE_TARGETS,
    testonly = True,
)

# The lane commands that are `cargo test`, not `cargo check`. They are
# service-free, so the pool executes them; the rest of the lane graph is a
# compile-only proof exactly as `cargo check` is.
test_suite(
    name = "feature_lane_tests",
    tests = FEATURE_LANE_TEST_TARGETS,
)

# Slow suites excluded from the PR Bazel partition. CI runs this aggregate
# on lash-regress diffs and on trunk.
test_suite(
    name = "deferred_tests",
    tests = WORKSPACE_DEFERRED_TEST_TARGETS,
)

# The developer default: `workspace_tests` minus the labels too slow for an
# edit loop (the lash-sim profile/minimizer cases and the TypeScript no-abort
# stress binary). `//:workspace_tests` remains the PR partition CI runs.
test_suite(
    name = "dev_tests",
    tests = WORKSPACE_DEV_SUITE_LABELS,
)

# Runtime inputs for the few tests whose asserted contract spans package
# boundaries. Keeping them narrow preserves action invalidation granularity.
filegroup(
    name = "workspace_rust_sources",
    srcs = WORKSPACE_RUST_SOURCE_TARGETS,
    testonly = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "durable_fixtures",
    srcs = glob(["fixtures/**"]),
    testonly = True,
    visibility = ["//visibility:public"],
)

# scripts/confidence-gate.sh and the helpers it sources. The lash-core
# fault-matrix routing probes execute the gate against a recording `cargo`, so
# the script is a runtime input of that test, not a compile input.
filegroup(
    name = "confidence_gate_scripts",
    srcs = [
        "scripts/ci/confidence-stage.sh",
        "scripts/confidence-gate.sh",
        "scripts/worktree-gate-env.sh",
    ],
    testonly = True,
    visibility = ["//visibility:public"],
)

# The repository-root documents whose Postgres effect-history wording lash-sim
# asserts is consistent with the gate. `confidence-gate.sh` and the ADR are
# also how that test recognises the repository root.
filegroup(
    name = "confidence_gate_corpus",
    srcs = [
        "CONTEXT.md",
        "docs/adr/0008-confidence-gate.md",
        "docs/adr/0009-deterministic-simulation-harness.md",
        "scripts/confidence-gate.sh",
    ],
    testonly = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "workspace_test_scripts",
    srcs = ["scripts/slack-clone-live-model-ui.py"],
    testonly = True,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "perf_guard_budgets",
    srcs = ["scripts/perf_guard_budgets.json"],
    visibility = ["//visibility:public"],
)

# The accepted duration level shifts `lash-perf` reads with `include_str!`.
# Its own filegroup rather than a second source in `perf_guard_budgets`: the
# budgets are per-run ceilings and these are acknowledgements of an intended
# step, and only `lash-perf` compiles the acknowledgements in.
filegroup(
    name = "perf_duration_level_shifts",
    srcs = ["scripts/perf_duration_level_shifts.json"],
    visibility = ["//visibility:public"],
)

# Build these labels to compile the complete Cargo --workspace --all-targets
# shape without executing service-backed or otherwise Cargo-owned test gates.
filegroup(
    name = "workspace_compile",
    srcs = WORKSPACE_COMPILE_TARGETS,
    testonly = True,
)

# The `cargo clippy --workspace --all-targets` shape as cached Bazel actions:
# one clippy action per first-party crate target, with the workspace lint table
# and the nearest `clippy.toml` applied exactly as Cargo applies them.
lash_rust_clippy(
    name = "workspace_clippy",
    testonly = True,
    deps = WORKSPACE_CLIPPY_TARGETS,
)

# `slack-clone`'s `e2e` and `live-e2e` features are outside the resolved default
# workspace graph, so their `cfg(feature = ...)` code used to be linted by a
# `cargo clippy -p slack-clone --all-targets --features e2e` step on the Lint
# runner -- 106 s of Cargo compile inside an otherwise Bazel job. The
# feature-lane variants of the same targets carry the same lint config as every
# other label, so the aspect lints them here instead. `slack-clone` declares no
# `default` feature, so the lane's `--no-default-features --features e2e`
# resolution is byte-for-byte the resolution the Cargo command used.
lash_rust_clippy(
    name = "feature_lane_clippy",
    testonly = True,
    deps = FEATURE_LANE_CLIPPY_TARGETS,
)

# The `cargo doc --workspace` shape: one rust_doc action per library crate.
# Building this aggregate downloads nothing; `scripts/hermetic-build.sh doc`
# adds `--remote_download_outputs=toplevel` so the rendered trees land in
# bazel-bin for local viewing.
filegroup(
    name = "workspace_docs",
    srcs = WORKSPACE_DOC_TARGETS,
    testonly = True,
)

# This target keeps the complete Bazel and Cargo-owned test label set queryable.
# The executable default is `workspace_tests`; Cargo nextest retains special
# scheduling and service constraints for the excluded labels.
filegroup(
    name = "workspace_test_inventory",
    srcs = WORKSPACE_TEST_TARGETS,
    testonly = True,
)

# Python belongs to the fingerprinted executor image, like bash in the UI
# fixture runner. Generator binaries use the same target configuration as
# workspace_compile; checking documents does not trigger another Cargo graph.
schema_documents(
    name = "host_schema_documents",
    generator = "//crates/lashlang:workflow_schema_generator__bin",
    script = "scripts/generate-workflow-schemas.py",
)

schema_check(
    name = "host_schema_check",
    documents = ":host_schema_documents",
    checked = glob(["schemas/host/*/*.schema.json"]),
    script = "scripts/generate-workflow-schemas.py",
)

schema_documents(
    name = "example_schema_documents",
    generator = "//examples/workflow-graph-roundtrip:workflow_contract_schema__bin",
    script = "//examples/workflow-graph-roundtrip:scripts/generate-contract-schema.py",
)

schema_check(
    name = "example_schema_check",
    documents = ":example_schema_documents",
    checked = [
        "//examples/workflow-graph-roundtrip:frontend/src/generated/error-response.schema.json",
        "//examples/workflow-graph-roundtrip:frontend/src/generated/workflow-document.schema.json",
    ],
    script = "//examples/workflow-graph-roundtrip:scripts/generate-contract-schema.py",
)

filegroup(
    name = "schema_checks",
    srcs = [":host_schema_check", ":example_schema_check"],
)
alias(
    name = "runtime_off",
    actual = "@runtime_off_crates//:lash-runtime",
)
