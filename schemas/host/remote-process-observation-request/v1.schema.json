{
  "$defs": {
    "ProcessCursor": {
      "description": "Opaque process cursor: `lashpc1:<epoch>:<process-reference>:<position>:<sequence>`.",
      "pattern": "^lashpc1:[^:]+:p_[0-9a-f]{32}:[0-9]+:[0-9]+$",
      "type": "string"
    }
  },
  "$id": "https://lash.dev/schemas/remote-process-observation-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Start a process-scoped observation subscription for one exact process\nlifetime, optionally resuming from a process cursor.\n\nThe cursor is typed: a malformed cursor, or one from a retired version, is\nrefused at decode, naming the version it found.",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "process_id": {
      "type": "string"
    }
  },
  "required": [
    "process_id"
  ],
  "title": "RemoteProcessObservationRequest",
  "type": "object",
  "x-lash-schema-version": 1,
  "x-lash-version-constant": "REMOTE_PROTOCOL_VERSION"
}
