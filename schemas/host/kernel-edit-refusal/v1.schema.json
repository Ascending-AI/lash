                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "unbound_variable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-ADM-005`: an argument can never be a value of its parameter's\ntype.",
          "properties": {
            "argument_type": {
              "additionalProperties": false,
              "properties": {
                "callee": {
                  "type": "string"
