          "required": [
            "missing_function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-FORM-003`: a variable is read or assigned where no enclosing scope\nhas declared it.",
          "properties": {
            "unbound_variable": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
