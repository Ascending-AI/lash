{
  "$defs": {
    "DocumentId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EditDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "edit": {
          "description": "The edit at fault, by its position in the transaction. `None` when\nthe fault is of the transaction as a whole or of the document it\nleaves.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/EditDiagnosticKind"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "EditDiagnosticKind": {
      "oneOf": [
        {
          "enum": [
            "replacement_must_be_sole",
            "into_itself",
            "no_condition",
            "unsupported_canvas_edit",
            "not_value_target",
            "value_outside_canvas_set",
            "not_contiguous_steps",
            "action_in_header",
            "non_empty_discarded_arm",
            "escaping_binding",
            "control_target_lost"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name_collision": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "name_collision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`CANVAS-CLOSED`: the transaction was written against another document.",
          "properties": {
            "stale_base": {
              "additionalProperties": false,
              "properties": {
                "base": {
                  "$ref": "#/$defs/DocumentId"
                },
                "current": {
                  "$ref": "#/$defs/DocumentId"
                }
              },
              "required": [
                "base",
                "current"
              ],
              "type": "object"
            }
          },
          "required": [
            "stale_base"
          ],
          "type": "object"
        },
        {
          "const": "no_such_node",
          "description": "The site names no node of the base document, or a node an earlier\nedit of the transaction removed.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "wrong_node": {
              "additionalProperties": false,
              "properties": {
                "expected": {
                  "$ref": "#/$defs/NodeClass"
                },
                "found": {
                  "$ref": "#/$defs/NodeClass"
                }
              },
              "required": [
                "expected",
                "found"
              ],
              "type": "object"
            }
          },
          "required": [
            "wrong_node"
          ],
          "type": "object"
        },
        {
          "const": "not_in_block",
          "description": "`before` is not a statement of the block the position names.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "no_such_argument": {
              "additionalProperties": false,
              "properties": {
                "arguments": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "index": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "index",
                "arguments"
              ],
              "type": "object"
            }
          },
          "required": [
            "no_such_argument"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "no_such_function": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "no_such_function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "no_such_entry": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "no_such_entry"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "unprintable": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "$ref": "#/$defs/UnprintableReason"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "unprintable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "non_separable_step": {
              "additionalProperties": false,
              "properties": {
                "enclosing_statement": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Site"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Nearest enclosing complete statement in the transaction's base,\nfor editing the inseparable actions together in source."
                },
                "separable_step": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Site"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Nearest enclosing action accepted by structural step operations,\nwhen one exists. A statement with two performs has none."
                }
              },
              "type": "object"
            }
          },
          "required": [
            "non_separable_step"
          ],
          "type": "object"
        },
        {
          "const": "invalid_correspondence",
          "description": "Surviving nodes do not define a one-to-one relation.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The document cannot be read at all.",
          "properties": {
            "invalid": {
              "$ref": "#/$defs/InvalidReason"
            }
          },
          "required": [
            "invalid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`CANVAS-ATOMIC`: the edited document is not admitted.",
          "properties": {
            "refused": {
              "$ref": "#/$defs/RefusalReason"
            }
          },
          "required": [
            "refused"
          ],
          "type": "object"
        }
      ]
    },
    "FunctionId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "FunctionName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
      "type": "string"
    },
    "HelperUnavailableReason": {
      "description": "Why an exact helper cannot execute on this node.",
      "enum": [
        "retired",
        "unknown",
        "corrupt"
      ],
      "type": "string"
    },
    "ImportSlot": {
      "description": "A stable document-local Import coordinate. Names are diagnostic, never dispatch keys.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "InvalidReason": {
      "oneOf": [
        {
          "enum": [
            "empty_name",
            "limit_measures_result",
            "empty_formula",
            "guard_without_native",
            "empty_guard_unit"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "document": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "document"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "import": {
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                }
              },
              "required": [
                "slot"
              ],
              "type": "object"
            }
          },
          "required": [
            "import"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kernel_version": {
              "additionalProperties": false,
              "properties": {
                "found": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "supported": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "found",
                "supported"
              ],
              "type": "object"
            }
          },
          "required": [
            "kernel_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "too_deep": {
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "limit"
              ],
              "type": "object"
            }
          },
          "required": [
            "too_deep"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "duplicate_param": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "duplicate_param"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "duplicate_field": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "field"
              ],
              "type": "object"
            }
          },
          "required": [
            "duplicate_field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "loop_control_outside_loop": {
              "additionalProperties": false,
              "properties": {
                "keyword": {
                  "type": "string"
                }
              },
              "required": [
                "keyword"
              ],
              "type": "object"
            }
          },
          "required": [
            "loop_control_outside_loop"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A library call written as an expression's own call names a\nfunction with no native implementation: a call of it is an\naction, `invoke`.",
          "properties": {
            "call_not_native": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                },
                "name": {
                  "$ref": "#/$defs/FunctionName"
                }
              },
              "required": [
                "function",
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "call_not_native"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_of_another_version": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                },
                "name": {
                  "$ref": "#/$defs/FunctionName"
                },
                "required": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "written_for": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "function",
                "name",
                "written_for",
                "required"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_of_another_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_not_listed": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                }
              },
              "required": [
                "function"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_not_listed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_not_resolved": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                }
              },
              "required": [
                "function"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_not_resolved"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "helper_unavailable": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                },
                "reason": {
                  "$ref": "#/$defs/HelperUnavailableReason"
                }
              },
              "required": [
                "function",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "helper_unavailable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_arity": {
              "additionalProperties": false,
              "properties": {
                "accepted": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "given": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "required": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "given",
                "required",
                "accepted"
              ],
              "type": "object"
            }
          },
          "required": [
            "call_arity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "effect_not_listed": {
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                }
              },
              "required": [
                "slot"
              ],
              "type": "object"
            }
          },
          "required": [
            "effect_not_listed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_not_declared": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_not_declared"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "declared_function_in_library": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "declared_function_in_library"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-004`: a library body performs only the operations its\n`effects` lists.",
          "properties": {
            "effect_not_declared": {
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                }
              },
              "required": [
                "slot"
              ],
              "type": "object"
            }
          },
          "required": [
            "effect_not_declared"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entry_not_declared": {
              "additionalProperties": false,
              "properties": {
                "entry": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "entry"
              ],
              "type": "object"
            }
          },
          "required": [
            "entry_not_declared"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entry_arity": {
              "additionalProperties": false,
              "properties": {
                "declared": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "entry": {
                  "$ref": "#/$defs/Name"
                },
                "signature": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "entry",
                "signature",
                "declared"
              ],
              "type": "object"
            }
          },
          "required": [
            "entry_arity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "invalid_type": {
              "additionalProperties": false,
              "properties": {
                "problem": {
                  "type": "string"
                }
              },
              "required": [
                "problem"
              ],
              "type": "object"
            }
          },
          "required": [
            "invalid_type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "required_after_optional": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "required_after_optional"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "formula_unknown_param": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "formula_unknown_param"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-011`: a native version versions a native implementation.",
          "properties": {
            "native_version_without_native": {
              "additionalProperties": false,
              "properties": {
                "version": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "version"
              ],
              "type": "object"
            }
          },
          "required": [
            "native_version_without_native"
          ],
          "type": "object"
        },
        {
          "const": "native_version_zero",
          "description": "`K-LIB-011`: native versions count from 1.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-003`: a function with a native implementation takes no\nfunction.",
          "properties": {
            "native_takes_function": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "native_takes_function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-004`: a body that stands beside a native implementation\ncannot wait.",
          "properties": {
            "native_body_may_wait": {
              "additionalProperties": false,
              "properties": {
                "form": {
                  "$ref": "#/$defs/StatementForm"
                }
              },
              "required": [
                "form"
              ],
              "type": "object"
            }
          },
          "required": [
            "native_body_may_wait"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-EVAL-003`: an assignment evaluates its place before its\nright-hand side only when it writes a member, and that right-hand\nside is an expression, any action in it nested.",
          "properties": {
            "place_first_assignment": {
              "additionalProperties": false,
              "properties": {
                "problem": {
                  "type": "string"
                }
              },
              "required": [
                "problem"
              ],
              "type": "object"
            }
          },
          "required": [
            "place_first_assignment"
          ],
          "type": "object"
        },
        {
          "const": "action_as_expression",
          "description": "A right-hand side that is one action with variable and literal\narguments is the statement's action, not an expression: the one\nspelling kernel text reads back.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "`K-CLO-004`: a direct start passes the signature's arguments as the\nfunction's parameters, one for one.",
          "properties": {
            "start_arity": {
              "additionalProperties": false,
              "properties": {
                "declared": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "signature": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "signature",
                "declared"
              ],
              "type": "object"
            }
          },
          "required": [
            "start_arity"
          ],
          "type": "object"
        },
        {
          "const": "start_token",
          "description": "`K-CLO-004`: a token holds its tag first and its callable after it.",
          "type": "string"
        }
      ]
    },
    "Location": {
      "description": "The node a diagnostic is about.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A site the edit named, in the transaction's base document.",
          "properties": {
            "base": {
              "$ref": "#/$defs/Site"
            }
          },
          "required": [
            "base"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A site of the document as the transaction had edited it when the\nfault was found: the document it would have published, for a fault\nof admission.",
          "properties": {
            "edited": {
              "$ref": "#/$defs/Site"
            }
          },
          "required": [
            "edited"
          ],
          "type": "object"
        }
      ]
    },
    "MapType": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/Type"
        },
        "value": {
          "$ref": "#/$defs/Type"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "Name": {
      "description": "A variable, parameter or declared-function name.\n\nAny text is a name; the kernel gives none of them meaning. Structural\nvalidation refuses the empty name.",
      "type": "string"
    },
    "NodeClass": {
      "description": "What a site addresses, for a diagnostic.",
      "enum": [
        "block",
        "statement",
        "action",
        "expression"
      ],
      "type": "string"
    },
    "OperationRefusal": {
      "additionalProperties": false,
      "description": "A raw operation whose authored construct owns additional lowering work.",
      "properties": {
        "construct": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/QualifiedName"
        }
      },
      "required": [
        "operation",
        "construct",
        "detail"
      ],
      "type": "object"
    },
    "PackagePath": {
      "pattern": "^[a-z][a-z0-9]*(_[a-z][a-z0-9]*)*(\\.[a-z][a-z0-9]*(_[a-z][a-z0-9]*)*)*$",
      "type": "string"
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
