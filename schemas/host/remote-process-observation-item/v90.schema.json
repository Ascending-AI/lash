{
  "$id": "https://lash.dev/schemas/remote-process-observation-item/v90",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RemoteProcessObservationCompleteness": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "complete"
              ],
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/definitions/RemoteProcessObservationGapReason"
            },
            "state": {
              "enum": [
                "incomplete"
              ],
              "type": "string"
            }
          },
          "required": [
            "reason",
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteProcessObservationGapReason": {
      "enum": [
        "overflow",
        "expired",
        "subscriber_lagged",
        "publisher_replaced",
        "routing_unavailable",
        "process_id_reused",
        "cross_process",
        "invalid_cursor",
        "publisher_joined_mid_run",
        "incomplete_graph",
        "projection_truncated"
      ],
      "type": "string"
    },
    "RemoteProcessObservationProjection": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "$ref": "#/definitions/RemoteProcessObservationCompleteness"
        },
        "graph": true
      },
      "required": [
        "completeness"
      ],
      "type": "object"
    }
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string"
        },
        "incarnation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "process_id": {
          "type": "string"
        },
        "projection": {
          "$ref": "#/definitions/RemoteProcessObservationProjection"
        },
        "type": {
          "enum": [
            "snapshot"
          ],
          "type": "string"
        }
      },
      "required": [
        "cursor",
        "incarnation",
        "process_id",
        "projection",
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string"
        },
        "incarnation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "process_id": {
          "type": "string"
        },
        "record": true,
        "type": {
          "enum": [
            "event"
          ],
          "type": "string"
        }
      },
      "required": [
        "cursor",
        "incarnation",
        "process_id",
        "record",
        "type"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "incarnation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "latest_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "process_id": {
          "type": "string"
        },
        "projection": {
          "$ref": "#/definitions/RemoteProcessObservationProjection"
        },
        "reason": {
          "$ref": "#/definitions/RemoteProcessObservationGapReason"
        },
        "requested_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "gap"
          ],
          "type": "string"
        }
      },
      "required": [
        "incarnation",
        "process_id",
        "projection",
        "reason",
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "RemoteProcessObservationItem",
  "x-lash-schema-version": 90,
  "x-lash-version-constant": "REMOTE_PROTOCOL_VERSION"
}
