{
  "$defs": {
    "DocumentId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "FunctionId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "Name": {
      "description": "A variable, parameter or declared-function name.\n\nAny text is a name; the kernel gives none of them meaning. Structural\nvalidation refuses the empty name.",
      "type": "string"
    },
    "NodeAnnotation": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": true,
          "description": "Anything else a host or a dialect keeps on the node (layout, a source\nspan), under a key of its own choosing. The kernel reads none of it.",
          "type": "object"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        },
        "site": {
          "$ref": "#/$defs/Site"
        }
      },
      "required": [
        "site"
      ],
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "description": "A node's address: the code it belongs to and the chain of\n[`Node::children`] indexes that reaches it from that code's body.\n\nA site is derived from the document and is never written by a host\n(`K-ID-004`). An empty chain addresses the body itself.",
      "properties": {
        "path": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "unit"
      ],
      "type": "object"
    },
    "Unit": {
      "description": "The code a node belongs to.",
      "oneOf": [
        {
          "const": "main",
          "description": "The document's `main`.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A declared function of the document.",
          "properties": {
            "function": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The kernel-code body of a library function.",
          "properties": {
            "library": {
              "$ref": "#/$defs/FunctionId"
            }
          },
          "required": [
            "library"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://lash.dev/schemas/kernel-annotations/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The annotation layer of one document: everything about it that is not\nbehaviour.\n\nAnnotations are keyed to the document's identity and attached to nodes.\nThey never change what runs, and dropping them loses nothing a run needs.",
  "properties": {
    "dialect": {
      "description": "The dialect the document was written in.",
      "type": [
        "string",
        "null"
      ]
    },
    "document": {
      "$ref": "#/$defs/DocumentId",
      "description": "The document these annotate."
    },
    "nodes": {
      "description": "Per-node annotations, ordered by site, at most one per site.",
      "items": {
        "$ref": "#/$defs/NodeAnnotation"
      },
      "type": "array"
    },
    "source": {
      "description": "The source text the document was lowered from.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "document"
  ],
  "title": "Annotations",
  "type": "object",
  "x-lash-schema-version": 1,
  "x-lash-version-constant": "KERNEL_VERSION"
}
