{
  "$defs": {
    "ExprSlot": {
      "description": "The role one child expression plays in its parent [`Expr`].",
      "oneOf": [
        {
          "enum": [
            "condition",
            "then",
            "else",
            "iterable",
            "receiver",
            "callee",
            "this",
            "catch",
            "finally",
            "target",
            "index",
            "left",
            "right"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A statement of a block or an element of a list.",
          "properties": {
            "item": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "item"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The value of a record entry, by entry position.",
          "properties": {
            "entry": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "entry"
          ],
          "type": "object"
        },
        {
          "const": "inner",
          "description": "The expression a label or a structural role wraps.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A dynamic index of an assignment target's path, by position.",
          "properties": {
            "assign_index": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "assign_index"
          ],
          "type": "object"
        },
        {
          "const": "value",
          "description": "The value an assignment stores.",
          "type": "string"
        },
        {
          "const": "bind",
          "description": "The generated statements that bind a loop element to authored names.",
          "type": "string"
        },
        {
          "const": "body",
          "description": "The body of a loop, a function, a process literal or a `try`.",
          "type": "string"
        },
        {
          "const": "input",
          "description": "The input of a host descriptor constructor.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A call argument, by position.",
          "properties": {
            "arg": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "arg"
          ],
          "type": "object"
        },
        {
          "const": "operand",
          "description": "The single operand of a unary form.",
          "type": "string"
        },
        {
          "const": "method_key",
          "description": "The computed member a method call reads its callee from.",
          "type": "string"
        },
        {
          "const": "items",
          "description": "The collection a map intrinsic reads.",
          "type": "string"
        },
        {
          "const": "function",
          "description": "The callback a map intrinsic applies.",
          "type": "string"
        }
      ]
    },
    "ProcessParamWire": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "ty": {
          "$ref": "#/$defs/TypeExpr"
        }
      },
      "required": [
        "name",
        "ty"
      ],
      "type": "object"
    },
    "ProcessType": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "known",
              "type": "string"
            },
            "output": {
              "$ref": "#/$defs/TypeExpr"
            },
            "params": {
              "items": {
                "$ref": "#/$defs/ProcessParamWire"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "params",
            "output"
          ],
          "type": "object"
        }
      ]
    },
    "Span": {
      "properties": {
        "end": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "TypeExpr": {
      "description": "A serialized value-type expression.\n\nHost decoders must refuse unknown variants. `TypeExpr` is decoded only\nafter its graph or facet carrier version is accepted; adding a variant\ntherefore requires the owning carrier version to advance.",
      "oneOf": [
        {
          "enum": [
            "Any",
            "Str",
            "Int",
            "Float",
            "Bool",
            "Dict"
          ],
          "type": "string"
        },
        {
          "const": "Null",
          "description": "The literal `null` type; usually only useful as part of a\n`Union` (e.g. `str | null` for a nullable field).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Enum": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "Enum"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "List": {
              "$ref": "#/$defs/TypeExpr"
            }
          },
          "required": [
            "List"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Object": {
              "items": {
                "$ref": "#/$defs/TypeField"
              },
              "type": "array"
            }
          },
          "required": [
            "Object"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Ref": {
              "type": "string"
            }
          },
          "required": [
            "Ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Process": {
              "$ref": "#/$defs/ProcessType"
            }
          },
          "required": [
            "Process"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Union of alternative type shapes, e.g. `str | int | null`.",
          "properties": {
            "Union": {
              "$ref": "#/$defs/UnionMembers"
            }
          },
          "required": [
            "Union"
          ],
          "type": "object"
        }
      ]
    },
    "TypeField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "ty": {
          "$ref": "#/$defs/TypeExpr"
        }
      },
      "required": [
        "name",
        "ty",
        "optional"
      ],
      "type": "object"
    },
    "UnionMembers": {
      "items": {
        "$ref": "#/$defs/TypeExpr"
      },
      "minItems": 2,
      "type": "array"
    },
    "WorkflowDiagnosticClassification": {
      "description": "Whether a diagnostic establishes an admission failure for the analyzed\nprogram and host environment or gives advice without establishing a failure.",
      "enum": [
        "definite",
        "advisory"
      ],
      "type": "string"
    },
    "WorkflowDiagnosticKind": {
      "description": "Closed host-facing vocabulary for linker diagnostics.",
      "enum": [
        "duplicate_declaration",
        "duplicate_process_param",
        "unknown_process",
        "unknown_name",
        "unknown_builtin",
        "unknown_resource",
        "unknown_type",
        "incompatible_constructor_input",
        "incompatible_operation_input",
        "awaited_settled_expression",
        "incompatible_expected_literal",
        "incompatible_process_return",
        "incompatible_function_return",
        "duplicate_function_param",
        "function_argument_count",
        "incompatible_function_argument",
        "forbidden_in_function",
        "function_name_is_not_a_value",
        "function_shadows_builtin",
        "process_literal_outside_process_slot",
        "unresolved_receiver",
        "unknown_resource_operation",
        "ambiguous_module_operation",
        "bare_tool_call",
        "incompatible_process_argument",
        "feature_disabled",
        "process_lifecycle_outside_process",
        "opaque_host_descriptor_access",
        "unknown_object_field",
        "incompatible_builtin_operands",
        "incompatible_iteration_target",
        "module_hash",
        "invalid_ast"
      ],
      "type": "string"
    },
    "WorkflowExpectedArgument": {
      "properties": {
        "slot": {
          "$ref": "#/$defs/WorkflowSlotPath"
        },
        "ty": {
          "$ref": "#/$defs/TypeExpr"
        }
      },
      "required": [
        "slot",
        "ty"
      ],
      "type": "object"
    },
    "WorkflowNodeId": {
      "description": "A deterministic node identifier minted from structural owner and AST path.",
      "type": "string"
    },
    "WorkflowSlotPath": {
      "description": "An unambiguous address for one expression inside a workflow node.\n\nTwo spellings share the type. A *structural* path is made only of\n[`WorkflowSlotPathSegment::Expr`] segments and walks the typed child slots\nof the node's statement ([`super::workflow_node_statement`]), so it reaches\nevery expression role of every IR variant; the empty path is the statement\nitself. A *call-argument* path starts at a receiver call's argument\n(`call`, `arg`, then record fields and list indexes) and is what type\nfacets name their expected arguments by.\n\nThe serialized list is authoritative. [`Display`](std::fmt::Display) is a\nderived spelling for text-only host contracts; field names use JSON string\nquoting so they cannot collide with structural indexes or separators.",
      "items": {
        "$ref": "#/$defs/WorkflowSlotPathSegment"
      },
      "type": "array"
    },
    "WorkflowSlotPathSegment": {
      "description": "One structural step in a [`WorkflowSlotPath`].",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "call": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "arg": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "arg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "index": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "index"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One typed child slot of the IR expression reached so far.",
          "properties": {
            "expr": {
              "$ref": "#/$defs/ExprSlot"
            }
          },
          "required": [
            "expr"
          ],
          "type": "object"
        }
      ]
    },
    "WorkflowTypeDiagnostic": {
      "properties": {
        "classification": {
          "$ref": "#/$defs/WorkflowDiagnosticClassification"
        },
        "kind": {
          "$ref": "#/$defs/WorkflowDiagnosticKind"
        },
        "message": {
          "type": "string"
        },
        "node_id": {
          "$ref": "#/$defs/WorkflowNodeId"
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowSlotPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node_id",
        "kind",
        "classification",
        "message"
      ],
      "type": "object"
    },
    "WorkflowTypedVariable": {
      "properties": {
        "name": {
          "type": "string"
        },
        "ty": {
          "$ref": "#/$defs/TypeExpr"
        }
      },
      "required": [
        "name",
        "ty"
      ],
      "type": "object"
    }
  },
  "$id": "https://lash.dev/schemas/workflow-type-facets/v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "available_variables": {
      "items": {
        "$ref": "#/$defs/WorkflowTypedVariable"
      },
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/WorkflowTypeDiagnostic"
      },
      "type": "array"
    },
    "expected_arguments": {
      "items": {
        "$ref": "#/$defs/WorkflowExpectedArgument"
      },
      "type": "array"
    }
  },
  "title": "WorkflowNodeTypeFacets",
  "type": "object",
  "x-lash-schema-version": 4,
  "x-lash-version-constant": "WORKFLOW_TYPE_FACET_SCHEMA_VERSION"
}
