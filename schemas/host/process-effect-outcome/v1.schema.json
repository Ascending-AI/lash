{
  "$id": "https://lash.dev/schemas/process-effect-outcome/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "else": {
    "not": {
      "required": [
        "code"
      ]
    }
  },
  "if": {
    "properties": {
      "outcome_class": {
        "const": "failure"
      }
    }
  },
  "properties": {
    "call_id": {
      "pattern": "^tc_[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "minLength": 1,
      "type": "string"
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "loops": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "activation": {
                "maximum": 18446744073709551615,
                "minimum": 1,
                "type": "integer"
              },
              "position": {
                "type": "object"
              },
              "site": {
                "type": "object"
              }
            },
            "required": [
              "site",
              "activation",
              "position"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "site_path": {
          "items": {
            "type": [
              "object",
              "string"
            ]
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "node_id": {
      "minLength": 1,
      "type": "string"
    },
    "occurrence": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    },
    "operation": {
      "minLength": 1,
      "type": "string"
    },
    "outcome_class": {
      "enum": [
        "success",
        "failure",
        "cancelled"
