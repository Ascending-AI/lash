{
  "$id": "https://lash.dev/schemas/process-effect-outcome/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "else": {
    "not": {
      "required": [
        "code"
      ]
    }
  },
  "if": {
    "properties": {
      "outcome_class": {
        "const": "failure"
      }
    }
  },
  "properties": {
    "at": {
      "pattern": "^e:([0-9a-f]{2})+$",
      "type": "string"
    },
    "call_id": {
      "pattern": "^tc_[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "minLength": 1,
      "type": "string"
    },
    "origin": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A node's address: the code it belongs to and the chain of\n[`Node::children`] indexes that reaches it from that code's body.\n\nA site is derived from the document and is never written by a host\n(`K-ID-004`). An empty chain addresses the body itself.",
      "properties": {
        "path": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "unit": {
          "description": "The code a node belongs to.",
          "oneOf": [
            {
              "const": "main",
              "description": "The document's `main`.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "A declared function of the document.",
              "properties": {
                "function": {
                  "description": "A variable, parameter or declared-function name.\n\nAny text is a name; the kernel gives none of them meaning. Structural\nvalidation refuses the empty name.",
                  "type": "string"
                }
              },
              "required": [
                "function"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "The kernel-code body of a library function.",
              "properties": {
                "library": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "library"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "unit"
      ],
      "title": "Site",
      "type": "object"
    },
    "outcome_class": {
      "enum": [
        "success",
        "failure",
        "cancelled"
      ],
      "type": "string"
    },
    "replay_key": {
      "minLength": 1,
      "type": "string"
    },
    "vocabulary_version": {
      "const": 1
    }
  },
  "required": [
    "vocabulary_version",
    "at",
    "origin",
    "operation",
    "outcome_class",
    "call_id",
    "replay_key"
  ],
  "title": "ProcessEffectOccurrence",
  "type": "object",
  "x-lash-event-type": "process.effect_outcome",
  "x-lash-schema-version": 1,
  "x-lash-version-constant": "PROCESS_EVENT_VOCABULARY_VERSION"
}
