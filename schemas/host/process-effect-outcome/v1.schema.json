    },
    "replay_key": {
      "minLength": 1,
      "type": "string"
    },
    "vocabulary_version": {
      "const": 1
    }
  },
  "required": [
    "vocabulary_version",
    "node_id",
    "occurrence",
    "operation",
    "outcome_class",
    "call_id",
    "replay_key"
