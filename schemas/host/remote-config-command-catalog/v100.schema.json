{
  "$id": "https://lash.dev/schemas/remote-config-command-catalog/v100",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "RemoteConfigCommandDescriptor": {
      "additionalProperties": false,
      "description": "One registered config command and its generated schemas.",
      "properties": {
        "command": {
          "type": "string"
        },
        "input_schema": true,
        "output_schema": true,
        "owner": {
          "type": "string"
        },
        "refusal_schema": true
      },
      "required": [
        "command",
        "input_schema",
        "output_schema",
        "owner",
        "refusal_schema"
      ],
      "type": "object"
    }
  },
  "description": "Every config command a session admits, describing its config at `revision`. Discovery only: an owner can still refuse arguments its schema admits.",
  "properties": {
    "commands": {
      "items": {
        "$ref": "#/definitions/RemoteConfigCommandDescriptor"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "commands",
    "revision"
  ],
  "title": "RemoteConfigCommandCatalog",
  "type": "object",
  "x-lash-schema-version": 100,
  "x-lash-version-constant": "REMOTE_PROTOCOL_VERSION"
}
