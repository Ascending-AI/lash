{
  "$defs": {
    "RemoteConfigCommandDescriptor": {
      "additionalProperties": false,
      "description": "One registered config command and its generated schemas.",
      "properties": {
        "command": {
          "type": "string"
        },
        "input_schema": true,
        "output_schema": true,
        "owner": {
          "type": "string"
        },
        "refusal_schema": true
      },
      "required": [
        "owner",
        "command",
        "input_schema",
        "output_schema",
        "refusal_schema"
      ],
      "type": "object"
    }
  },
  "$id": "https://lash.dev/schemas/remote-config-command-catalog/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every config command a session admits, describing its config at\n`revision`. Discovery only: an owner can still refuse arguments its\nschema admits.",
  "properties": {
    "commands": {
      "items": {
        "$ref": "#/$defs/RemoteConfigCommandDescriptor"
      },
      "type": "array"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "commands"
  ],
  "title": "RemoteConfigCommandCatalog",
  "type": "object",
  "x-lash-schema-version": 1,
  "x-lash-version-constant": "REMOTE_PROTOCOL_VERSION"
}
