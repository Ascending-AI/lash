{
  "$defs": {
    "Action": {
      "description": "A form that is the whole right-hand side of its own statement\n(`K-STMT-001`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Calls a function and yields what it returns.",
          "properties": {
            "call": {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "items": {
                    "$ref": "#/$defs/Atom"
                  },
                  "type": "array"
                },
                "callee": {
                  "$ref": "#/$defs/Callee"
                }
              },
              "required": [
                "callee",
                "args"
              ],
              "type": "object"
            }
          },
          "required": [
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Runs one effect and yields its result, decoded as `result`.",
          "properties": {
            "perform": {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "items": {
                    "$ref": "#/$defs/Atom"
                  },
                  "type": "array"
                },
                "effect": {
                  "$ref": "#/$defs/QualifiedName"
                },
                "result": {
                  "$ref": "#/$defs/Type"
                }
              },
              "required": [
                "effect",
                "args",
                "result"
              ],
              "type": "object"
            }
          },
          "required": [
            "perform"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Waits for a number of milliseconds.",
          "properties": {
            "sleep": {
              "additionalProperties": false,
              "properties": {
                "duration": {
                  "$ref": "#/$defs/Atom"
                }
              },
              "required": [
                "duration"
              ],
              "type": "object"
            }
          },
          "required": [
            "sleep"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Waits on one task handle.",
          "properties": {
            "join": {
              "additionalProperties": false,
              "properties": {
                "task": {
                  "$ref": "#/$defs/Atom"
                }
              },
              "required": [
                "task"
              ],
              "type": "object"
            }
          },
          "required": [
            "join"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Waits on a list of task handles.",
          "properties": {
            "join_many": {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "$ref": "#/$defs/JoinMode"
                },
                "tasks": {
                  "$ref": "#/$defs/Atom"
                }
              },
              "required": [
                "mode",
                "tasks"
              ],
              "type": "object"
            }
          },
          "required": [
            "join_many"
          ],
          "type": "object"
        },
        {
          "const": "yield",
          "description": "Lets every other ready task run first.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Starts a task running a function and yields its handle.",
          "properties": {
            "spawn": {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "items": {
                    "$ref": "#/$defs/Atom"
                  },
                  "type": "array"
                },
                "callee": {
                  "$ref": "#/$defs/Callee"
                }
              },
              "required": [
                "callee",
                "args"
              ],
              "type": "object"
            }
          },
          "required": [
            "spawn"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Raises a cancellation in a task at its current wait.",
          "properties": {
            "cancel": {
              "additionalProperties": false,
              "properties": {
                "task": {
                  "$ref": "#/$defs/Atom"
                }
              },
              "required": [
                "task"
              ],
              "type": "object"
            }
          },
          "required": [
            "cancel"
          ],
          "type": "object"
        }
      ]
    },
    "Atom": {
      "description": "An argument of an action: a variable or a literal, never a computation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "variable": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "variable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "literal": {
              "$ref": "#/$defs/Literal"
            }
          },
          "required": [
            "literal"
          ],
          "type": "object"
        }
      ]
    },
    "Bytes": {
      "pattern": "^([0-9a-f]{2})*$",
      "type": "string"
    },
    "Callee": {
      "description": "What a statement-position call or a `spawn` runs.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A declared function of the document, by name.",
          "properties": {
            "declared": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "declared"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The closure or function reference a variable holds.",
          "properties": {
            "value": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A library function, by identity.",
          "properties": {
            "library": {
              "$ref": "#/$defs/FunctionId"
            }
          },
          "required": [
            "library"
          ],
          "type": "object"
        }
      ]
    },
    "Catch": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/Name",
          "description": "The variable the caught error value is bound to."
        },
        "body": {
          "items": {
            "$ref": "#/$defs/Stmt"
          },
          "type": "array"
        }
      },
      "required": [
        "binding",
        "body"
      ],
      "type": "object"
    },
    "Closure": {
      "additionalProperties": false,
      "description": "A function value written in place. It shares the variables of the scope\nthat defines it (`K-CLO-001`); which ones is derived, never written.",
      "properties": {
        "body": {
          "items": {
            "$ref": "#/$defs/Stmt"
          },
          "type": "array"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/Name"
          },
          "type": "array"
        }
      },
      "required": [
        "body"
      ],
      "type": "object"
    },
    "Expr": {
      "description": "An expression: evaluated within one statement, it never pauses a task.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "literal": {
              "$ref": "#/$defs/Literal"
            }
          },
          "required": [
            "literal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "variable": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "variable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "tuple": {
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "type": "array"
            }
          },
          "required": [
            "tuple"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "list": {
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "type": "array"
            }
          },
          "required": [
            "list"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "map": {
              "items": {
                "$ref": "#/$defs/MapEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "map"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "set": {
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "type": "array"
            }
          },
          "required": [
            "set"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "record": {
              "items": {
                "$ref": "#/$defs/RecordEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "record"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Reads a field or an index.",
          "properties": {
            "member": {
              "$ref": "#/$defs/Member"
            }
          },
          "required": [
            "member"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "closure": {
              "$ref": "#/$defs/Closure"
            }
          },
          "required": [
            "closure"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Calls a library function that has a native implementation.",
          "properties": {
            "call": {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "items": {
                    "$ref": "#/$defs/Expr"
                  },
                  "type": "array"
                },
                "function": {
                  "$ref": "#/$defs/FunctionId"
                }
              },
              "required": [
                "function",
                "args"
              ],
              "type": "object"
            }
          },
          "required": [
            "call"
          ],
          "type": "object"
        },
        {
          "const": "clock",
          "description": "The embedder's clock, as a timestamp.",
          "type": "string"
        },
        {
          "const": "random",
          "description": "A float drawn by the embedder, uniform in `[0, 1)`.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Reads through a projection handle.",
          "properties": {
            "read": {
              "$ref": "#/$defs/ProjectionRead"
            }
          },
          "required": [
            "read"
          ],
          "type": "object"
        }
      ]
    },
    "Float": {
      "pattern": "^(nan|-?inf|-?(0|[1-9][0-9]*)\\.[0-9]+|-?[1-9](\\.[0-9]+)?e-?[1-9][0-9]*)$",
      "type": "string"
    },
    "Formula": {
      "description": "An amount computed from the sizes of a call's arguments and result, in\nsaturating unsigned 64-bit arithmetic (`K-CHG-003`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "constant": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "constant"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The operand's own size (`K-CHG-004`).",
          "properties": {
            "size": {
              "$ref": "#/$defs/Operand"
            }
          },
          "required": [
            "size"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The operand's size with everything it holds (`K-CHG-005`).",
          "properties": {
            "deep_size": {
              "$ref": "#/$defs/Operand"
            }
          },
          "required": [
            "deep_size"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The operand's value, when it is a non-negative number (`K-CHG-006`).",
          "properties": {
            "magnitude": {
              "$ref": "#/$defs/Operand"
            }
          },
          "required": [
            "magnitude"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "sum": {
              "items": {
                "$ref": "#/$defs/Formula"
              },
              "type": "array"
            }
          },
          "required": [
            "sum"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "product": {
              "items": {
                "$ref": "#/$defs/Formula"
              },
              "type": "array"
            }
          },
          "required": [
            "product"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The largest of one or more amounts.",
          "properties": {
            "max": {
              "items": {
                "$ref": "#/$defs/Formula"
              },
              "type": "array"
            }
          },
          "required": [
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The smallest of one or more amounts.",
          "properties": {
            "min": {
              "items": {
                "$ref": "#/$defs/Formula"
              },
              "type": "array"
            }
          },
          "required": [
            "min"
          ],
          "type": "object"
        }
      ]
    },
    "FunctionBody": {
      "additionalProperties": false,
      "description": "A library function's kernel-code body. Its parameters are the\nsignature's, by name.",
      "properties": {
        "block": {
          "items": {
            "$ref": "#/$defs/Stmt"
          },
          "type": "array"
        },
        "functions": {
          "additionalProperties": false,
          "description": "Every library function the body calls, by identity, with the name\nits definition carries.",
          "patternProperties": {
            "^[0-9a-f]{64}$": {
              "$ref": "#/$defs/QualifiedName"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "block"
      ],
      "type": "object"
    },
    "FunctionId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Guard": {
      "additionalProperties": false,
      "description": "A native implementation's work bound: the unit it counts and the most\nunits one call may spend. A call that would pass the limit ends with a\ntyped bound error (`K-LIB-008`).",
      "properties": {
        "limit": {
          "$ref": "#/$defs/Formula",
          "description": "The limit, over the arguments."
        },
        "unit": {
          "description": "What one unit of work is, in words a second implementation can\ncount by: `\"backtracking step\"`.",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "limit"
      ],
      "type": "object"
    },
    "Implementation": {
      "description": "How a library function is implemented.",
      "oneOf": [
        {
          "const": "native",
          "description": "Only a native implementation, registered by the embedder.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Only a kernel-code body. A call to it is a statement of its own.",
          "properties": {
            "body": {
              "$ref": "#/$defs/FunctionBody"
            }
          },
          "required": [
            "body"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A native implementation and a kernel-code body that behave the same;\nan engine may run either.",
          "properties": {
            "both": {
              "$ref": "#/$defs/FunctionBody"
            }
          },
          "required": [
            "both"
          ],
          "type": "object"
        }
      ]
    },
    "Integer": {
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "type": "string"
    },
    "JoinMode": {
      "oneOf": [
        {
          "const": "all",
          "description": "Every member has ended, or the first failure.",
          "type": "string"
        },
        {
          "const": "all_settled",
          "description": "Every member has ended.",
          "type": "string"
        },
        {
          "const": "race",
          "description": "The first member to end.",
          "type": "string"
        },
        {
          "const": "any",
          "description": "The first member to succeed.",
          "type": "string"
        }
      ]
    },
    "Literal": {
      "oneOf": [
        {
          "enum": [
            "null",
            "absent"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": [
            "bool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "int": {
              "$ref": "#/$defs/Integer"
            }
          },
          "required": [
            "int"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "float": {
              "$ref": "#/$defs/Float"
            }
          },
          "required": [
            "float"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "$ref": "#/$defs/Bytes"
            }
          },
          "required": [
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A reference to a declared function of the document.",
          "properties": {
            "function": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "function"
          ],
          "type": "object"
        }
      ]
    },
    "MapEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/Expr"
        },
        "value": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "MapType": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/Type"
        },
        "value": {
          "$ref": "#/$defs/Type"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "Member": {
      "description": "A field of a record or an index into a collection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "target": {
                  "$ref": "#/$defs/Expr"
                }
              },
              "required": [
                "target",
                "field"
              ],
              "type": "object"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "index": {
              "additionalProperties": false,
              "properties": {
                "index": {
                  "$ref": "#/$defs/Expr"
                },
                "target": {
                  "$ref": "#/$defs/Expr"
                }
              },
              "required": [
                "target",
                "index"
              ],
              "type": "object"
            }
          },
          "required": [
            "index"
          ],
          "type": "object"
        }
      ]
    },
    "Name": {
      "description": "A variable, parameter or declared-function name.\n\nAny text is a name; the kernel gives none of them meaning. Structural\nvalidation refuses the empty name.",
      "type": "string"
    },
    "Operand": {
      "description": "What a [`Formula`] measures.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The argument bound to this parameter.",
          "properties": {
            "param": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "param"
          ],
          "type": "object"
        },
        {
          "const": "result",
          "description": "The value the call returns. A guard's limit may not name it.",
          "type": "string"
        }
      ]
    },
    "Param": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "optional": {
          "description": "The argument may be omitted, and is then absent (`K-FN-004`). No\nrequired parameter follows an optional one.",
          "type": "boolean"
        },
        "ty": {
          "$ref": "#/$defs/Type"
        }
      },
      "required": [
        "name",
        "ty"
      ],
      "type": "object"
    },
    "Place": {
      "description": "Where an assignment writes.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "variable": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "variable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "member": {
              "$ref": "#/$defs/Member"
            }
          },
          "required": [
            "member"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectionRead": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "$ref": "#/$defs/Expr"
        },
        "request": {
          "$ref": "#/$defs/Expr",
          "description": "What is asked of the projection: kernel data the host interprets."
        }
      },
      "required": [
        "handle",
        "request"
      ],
      "type": "object"
    },
    "QualifiedName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
      "type": "string"
    },
    "RecordEntry": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "type": "object"
    },
    "RecordType": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/RecordTypeField"
          },
          "type": "array"
        },
        "rest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Type"
            },
            {
              "type": "null"
            }
          ],
          "description": "The type of every field not named in `fields`. `None` closes the\nrecord: it has no other field."
        }
      },
      "type": "object"
    },
    "RecordTypeField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "optional": {
          "description": "The field may be missing.",
          "type": "boolean"
        },
        "ty": {
          "$ref": "#/$defs/Type"
        }
      },
      "required": [
        "name",
        "ty"
      ],
      "type": "object"
    },
    "Rhs": {
      "description": "The right-hand side of a `let` or an assignment.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expr": {
              "$ref": "#/$defs/Expr"
            }
          },
          "required": [
            "expr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/Action"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
