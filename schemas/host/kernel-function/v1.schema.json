  "$id": "https://lash.dev/schemas/kernel-function/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A library function: its name, its typed signature over kernel values,\nits error kinds, what a call is charged, the guard that bounds its work,\nand how it is implemented. Its identity is the hash of all of it, so a\nchange to any part is a new function.",
  "properties": {
    "charge": {
      "$ref": "#/$defs/Formula",
      "description": "What a call is charged, whichever implementation runs."
    },
    "errors": {
      "description": "The kinds of error a call may raise, beyond the kernel's own.",
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "guard": {
      "anyOf": [
        {
          "$ref": "#/$defs/Guard"
        },
        {
          "type": "null"
        }
      ],
      "description": "The work bound of a native implementation that can run away."
    },
    "implementation": {
      "$ref": "#/$defs/Implementation"
    },
    "kernel": {
      "description": "The kernel version the definition is written for.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "$ref": "#/$defs/QualifiedName"
    },
    "signature": {
      "$ref": "#/$defs/Signature"
    }
  },
  "required": [
    "kernel",
    "name",
    "signature",
    "charge",
    "implementation"
  ],
  "title": "FunctionDefinition",
  "type": "object",
  "x-lash-schema-version": 1,
  "x-lash-version-constant": "KERNEL_VERSION"
