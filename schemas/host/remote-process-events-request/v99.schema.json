{
  "$id": "https://lash.dev/schemas/remote-process-events-request/v99",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ProcessCursor": {
      "description": "Opaque process cursor: `lashpc2:<epoch>:<process-reference>:<position>:<sequence>`.",
      "pattern": "^lashpc2:[^:]+:r[0-9]+\\.[0-9a-f]+:[0-9]+:[0-9]+$",
      "type": "string"
    },
    "ProcessEventQueryMode": {
      "description": "Payload projection selected for a bounded process-event page.",
      "oneOf": [
        {
          "description": "Return the complete durable event, including its JSON payload.",
          "enum": [
            "full"
          ],
          "type": "string"
        },
        {
          "description": "Return only the event ordering position and type.",
          "enum": [
            "lite"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProcessCursor"
        },
        {
          "type": "null"
        }
      ],
      "description": "The process cursor to read after; absent reads from the start."
    },
    "incarnation": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "limit": {
      "format": "uint",
      "minimum": 1.0,
      "type": "integer"
    },
    "mode": {
      "$ref": "#/definitions/ProcessEventQueryMode"
    },
    "process_id": {
      "type": "string"
    }
  },
  "required": [
    "incarnation",
    "limit",
    "mode",
    "process_id"
  ],
  "title": "RemoteProcessEventsRequest",
  "type": "object",
  "x-lash-schema-version": 99,
  "x-lash-version-constant": "REMOTE_PROTOCOL_VERSION"
}
