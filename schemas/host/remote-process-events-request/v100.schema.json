{
  "$defs": {
    "ProcessCursor": {
      "description": "Opaque process cursor: `lashpc3:<epoch>:<process-reference>:<position>:<sequence>`.",
      "pattern": "^lashpc3:[^:]+:p_[0-9a-f]{32}:[0-9]+:[0-9]+$",
      "type": "string"
    },
    "ProcessEventQueryMode": {
      "description": "Payload projection selected for a bounded process-event page.",
      "oneOf": [
        {
          "const": "full",
          "description": "Return the complete durable event, including its JSON payload.",
          "type": "string"
        },
        {
          "const": "lite",
          "description": "Return only the event ordering position and type.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://lash.dev/schemas/remote-process-events-request/v100",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessCursor"
        },
        {
          "type": "null"
        }
      ],
      "description": "The process cursor to read after; absent reads from the start."
    },
    "limit": {
      "format": "uint",
      "minimum": 1,
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/ProcessEventQueryMode"
    },
    "process_id": {
      "type": "string"
    }
  },
  "required": [
    "process_id",
    "limit",
    "mode"
  ],
  "title": "RemoteProcessEventsRequest",
  "type": "object",
  "x-lash-schema-version": 100,
  "x-lash-version-constant": "REMOTE_PROTOCOL_VERSION"
}
