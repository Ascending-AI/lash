{
  "$defs": {
    "RemoteAnthropicThinkingRetention": {
      "oneOf": [
        {
          "enum": [
            "all"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "turns": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "turns"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteAttachmentAcceptanceRule": {
      "description": "MIME-bearing sources and scoped provider handles have distinct admission facts.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "mime",
              "type": "string"
            },
            "media_families": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "media_types": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "source": {
              "$ref": "#/$defs/RemoteAttachmentMimeSource"
            }
          },
          "required": [
            "kind",
            "source",
            "media_types",
            "media_families"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider_file",
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteAttachmentAcceptor": {
      "additionalProperties": false,
      "description": "Acceptance rules supplied by the host for a transport dialect.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/RemoteAttachmentAcceptanceRule"
          },
          "type": "array"
        }
      },
      "required": [
        "provider",
        "rules"
      ],
      "type": "object"
    },
    "RemoteAttachmentCapabilitySnapshot": {
      "additionalProperties": false,
      "description": "An immutable host catalogue revision retained in a session's model policy.",
      "properties": {
        "acceptors": {
          "items": {
            "$ref": "#/$defs/RemoteAttachmentAcceptor"
          },
          "type": "array"
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "revision",
        "acceptors"
      ],
      "type": "object"
    },
    "RemoteAttachmentMimeSource": {
      "description": "The source modes which carry a required MIME type.",
      "enum": [
        "inline",
        "stored",
        "external_url"
      ],
      "type": "string"
    },
    "RemoteCacheControlDialect": {
      "description": "Mirror of the core `CacheControlDialect`.",
      "enum": [
        "anthropic",
        "gemini"
      ],
      "type": "string"
    },
    "RemoteCacheRetention": {
      "description": "Mirror of the core `CacheRetention` prompt-cache lifetime hint.",
      "enum": [
        "none",
        "short",
        "long"
      ],
      "type": "string"
    },
    "RemoteChargeSafetyPolicy": {
      "description": "Required wire mirror of the session's duplicate-billing appetite.",
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "require_guarantee",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "properties": {
            "max_duplicate_cost_tokens": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "max_unsafe_retries": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "const": "accept_duplicate_billing",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "max_unsafe_retries"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteGenerationOptions": {
      "additionalProperties": false,
      "description": "Closed generation-option set: only options this protocol can actually\ndeliver to the core request are accepted. Unknown keys \u2014 including the\nremoved `top_p`, `stop` and `provider_options` \u2014 fail deserialization\nrather than being silently discarded on the way in.",
      "properties": {
        "output_token_cap": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parallel_tool_calls": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "seed": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "stop_sequences": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "temperature": {
          "description": "Sampling temperature, carried as a JSON number \u2014 the same JSON-number\nencoding the core `NonNegativeFiniteF64` uses, and carried through the\nconversion unchanged, so a number survives the round trip exactly as\nthe sender spelled it \u2014 negative zero is the single exception, and\nnormalizes to zero. Validated on the way in: finite, non-negative,\nand exactly representable as a binary64 float (integers up to 2^53).\n`serde_json::Number` also keeps this type `Eq`.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RemoteGoogleDialect": {
      "description": "Wire mirror of the host-supplied Google dialect.",
      "enum": [
        "legacy",
        "gemini3",
        "claude_on_vertex"
      ],
      "type": "string"
    },
    "RemoteInstructionRole": {
      "description": "Wire mirror of the host-supplied instruction role.",
      "enum": [
        "system",
        "developer"
      ],
      "type": "string"
    },
    "RemoteModelCapability": {
      "description": "Mirror of the core `ModelCapability`: host-supplied model capability\nmetadata carried with the model intent so remote workers validate and\nencode effort exactly like a local runtime.",
      "properties": {
        "cache_control": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteCacheControlDialect"
            },
            {
              "type": "null"
            }
          ]
        },
        "google_dialect": {
          "$ref": "#/$defs/RemoteGoogleDialect"
        },
        "instruction_role": {
          "$ref": "#/$defs/RemoteInstructionRole"
        },
        "native_mid_conversation_system": {
          "type": "boolean"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteReasoningCapability"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_retention": {
          "$ref": "#/$defs/RemoteReasoningRetentionPolicy"
        },
        "sampling": {
          "$ref": "#/$defs/RemoteSamplingCapability",
          "description": "Whether this model lets a caller set the sampling temperature."
        },
        "stream_termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteStreamTermination"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RemoteModelConfig": {
      "additionalProperties": false,
      "description": "Mirror of the core `ModelConfig`: the registry-minted binding a session\nrecorded for its key, and the reasoning it runs that model with.",
      "properties": {
        "key": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/RemoteModelMetadata"
        },
        "reasoning": {
          "$ref": "#/$defs/RemoteReasoningSelection",
          "default": "provider_default"
        }
      },
      "required": [
        "key",
        "metadata"
      ],
      "type": "object"
    },
    "RemoteModelMetadata": {
      "additionalProperties": false,
      "description": "Mirror of the core `ModelMetadata`: the recorded facts of one registered\nmodel.",
      "properties": {
        "capability": {
          "$ref": "#/$defs/RemoteModelCapability"
        },
        "extra_body": {
          "additionalProperties": true,
          "type": "object"
        },
        "limits": {
          "$ref": "#/$defs/RemoteProcessModelLimits"
        },
        "request_defaults": {
          "$ref": "#/$defs/RemoteModelRequestDefaults"
        },
        "wire_model": {
          "type": "string"
        }
      },
      "required": [
        "wire_model",
        "limits"
      ],
      "type": "object"
    },
    "RemoteModelRequestDefaults": {
      "additionalProperties": false,
      "description": "Mirror of the core `ModelRequestDefaults`: what a model's requests do\nwhere a request states nothing, recorded with the model.",
      "properties": {
        "cache_retention": {
          "$ref": "#/$defs/RemoteCacheRetention"
        },
        "expose_thinking": {
          "type": "boolean"
        },
        "max_output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "response_metadata_body_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "response_metadata_headers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RemoteNoProgressBudget": {
      "description": "Required wire mirror of the session's consecutive unproductive-attempt budget.",
      "oneOf": [
        {
          "enum": [
            "unbounded"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bounded": {
              "format": "uint",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "bounded"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteOpenAiReasoningContext": {
      "enum": [
        "current_turn",
        "all_turns"
      ],
      "type": "string"
    },
    "RemoteProcessExecutionEnvSpec": {
      "additionalProperties": false,
      "properties": {
        "plugin_config": {
          "$ref": "#/$defs/RemoteProcessPluginConfig"
        },
        "policy": {
          "$ref": "#/$defs/RemoteProcessExecutionPolicy"
        },
        "render": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteRecordedRender"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "plugin_config",
        "policy"
      ],
      "type": "object"
    },
    "RemoteProcessExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "attachment_acceptance": {
          "$ref": "#/$defs/RemoteAttachmentCapabilitySnapshot",
          "description": "The session's recorded attachment-acceptance rules."
        },
        "autonomous": {
          "default": false,
          "type": "boolean"
        },
        "charge_safety": {
          "$ref": "#/$defs/RemoteChargeSafetyPolicy"
        },
        "core_prompt": {
          "$ref": "#/$defs/RemotePromptLayer",
          "description": "The creating core's prompt layer the session recorded (FIG-4397),\nrendered beneath `prompt`."
        },
        "generation": {
          "$ref": "#/$defs/RemoteGenerationOptions",
          "description": "Session-wide generation intent, mirroring `SessionPolicy.generation`.\nA remote peer that persists an execution policy without it would\nresume the session with uncontrolled sampling."
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteModelConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "The recorded model selection; absent for a policy that selects none."
        },
        "no_progress_budget": {
          "$ref": "#/$defs/RemoteNoProgressBudget"
        },
        "prompt": {
          "$ref": "#/$defs/RemotePromptLayer"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_budget": {
          "$ref": "#/$defs/RemoteTurnBudget"
        }
      },
      "required": [
        "turn_budget",
        "no_progress_budget",
        "charge_safety"
      ],
      "type": "object"
    },
    "RemoteProcessModelLimits": {
      "additionalProperties": false,
      "properties": {
        "context_window_tokens": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "output_token_capacity": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "context_window_tokens"
      ],
      "type": "object"
    },
    "RemoteProcessPluginConfig": {
      "additionalProperties": false,
      "description": "Wire mirror of the plugin configuration a process captured, at its\nsession config revision (FIG-4379).",
      "properties": {
        "namespaces": {
          "additionalProperties": true,
          "type": "object"
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision"
      ],
      "type": "object"
    },
    "RemotePromptBuiltin": {
      "enum": [
        "main_agent_intro",
        "execution_instructions",
        "core_guidance"
      ],
      "type": "string"
    },
    "RemotePromptContribution": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/RemotePromptContributionGate"
        },
        "priority": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    },
    "RemotePromptContributionGate": {
      "properties": {
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RemotePromptLayer": {
      "properties": {
        "slots": {
          "additionalProperties": false,
          "properties": {
            "environment": {
              "$ref": "#/$defs/RemotePromptSlotLayer"
            },
            "execution": {
              "$ref": "#/$defs/RemotePromptSlotLayer"
            },
            "guidance": {
              "$ref": "#/$defs/RemotePromptSlotLayer"
            },
            "intro": {
              "$ref": "#/$defs/RemotePromptSlotLayer"
            },
            "project_instructions": {
              "$ref": "#/$defs/RemotePromptSlotLayer"
            },
            "runtime_context": {
              "$ref": "#/$defs/RemotePromptSlotLayer"
            }
          },
          "type": "object"
        },
        "template": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemotePromptTemplate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RemotePromptSectionTitle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "properties": {
            "builtin": {
              "$ref": "#/$defs/RemotePromptTitleBuiltin"
            }
          },
          "required": [
            "builtin"
          ],
          "type": "object"
        }
      ]
    },
    "RemotePromptSlot": {
      "enum": [
        "intro",
        "execution",
        "guidance",
        "project_instructions",
        "runtime_context",
        "environment"
      ],
      "type": "string"
    },
    "RemotePromptSlotLayer": {
      "properties": {
        "contributions": {
          "items": {
            "$ref": "#/$defs/RemotePromptContribution"
          },
          "type": "array"
        },
        "reset": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RemotePromptTemplate": {
      "properties": {
        "sections": {
          "items": {
            "$ref": "#/$defs/RemotePromptTemplateSection"
          },
          "type": "array"
        }
      },
      "required": [
        "sections"
      ],
      "type": "object"
    },
    "RemotePromptTemplateEntry": {
      "oneOf": [
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "kind": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "content"
          ],
          "type": "object"
        },
        {
          "properties": {
            "builtin": {
              "$ref": "#/$defs/RemotePromptBuiltin"
            },
            "kind": {
              "const": "builtin",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "builtin"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "slot",
              "type": "string"
            },
            "slot": {
              "$ref": "#/$defs/RemotePromptSlot"
            }
          },
          "required": [
            "kind",
            "slot"
          ],
          "type": "object"
        }
      ]
    },
    "RemotePromptTemplateSection": {
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/RemotePromptTemplateEntry"
          },
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemotePromptSectionTitle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RemotePromptTitleBuiltin": {
      "enum": [
        "execution"
      ],
      "type": "string"
    },
    "RemoteReasoningCapability": {
      "additionalProperties": false,
      "description": "Mirror of the core `ReasoningCapability`. Recorded shapes that carry a\nremoved field (the default effort, `aliases`) or an encoded `disable` are\nrefused.",
      "properties": {
        "disable": {
          "type": "boolean"
        },
        "efforts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "encoding": {
          "$ref": "#/$defs/RemoteReasoningEncoding",
          "default": "effort"
        },
        "mandatory": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RemoteReasoningEncoding": {
      "description": "Mirror of the core `ReasoningEncoding`.",
      "oneOf": [
        {
          "enum": [
            "effort"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "budget": {
              "additionalProperties": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            }
          },
          "required": [
            "budget"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteReasoningRetentionCapability": {
      "oneOf": [
        {
          "properties": {
            "supported": {
              "items": {
                "$ref": "#/$defs/RemoteOpenAiReasoningContext"
              },
              "type": "array"
            },
            "type": {
              "const": "open_ai_context",
              "type": "string"
            }
          },
          "required": [
            "type",
            "supported"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "anthropic_clear_thinking",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "client_side_user_segments",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteReasoningRetentionPolicy": {
      "properties": {
        "capability": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteReasoningRetentionCapability"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "$ref": "#/$defs/RemoteReasoningRetentionSelection"
        }
      },
      "required": [
        "selection"
      ],
      "type": "object"
    },
    "RemoteReasoningRetentionSelection": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "provider_default",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "context": {
              "$ref": "#/$defs/RemoteOpenAiReasoningContext"
            },
            "type": {
              "const": "open_ai_context",
              "type": "string"
            }
          },
          "required": [
            "type",
            "context"
          ],
          "type": "object"
        },
        {
          "properties": {
            "keep": {
              "$ref": "#/$defs/RemoteAnthropicThinkingRetention"
            },
            "type": {
              "const": "anthropic_clear_thinking",
              "type": "string"
            }
          },
          "required": [
            "type",
            "keep"
          ],
          "type": "object"
        },
        {
          "properties": {
            "max_segments": {
              "format": "uint",
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "const": "client_side_user_segments",
              "type": "string"
            }
          },
          "required": [
            "type",
            "max_segments"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteReasoningSelection": {
      "oneOf": [
        {
          "enum": [
            "provider_default",
            "disabled"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "effort": {
              "type": "string"
            }
          },
          "required": [
            "effort"
          ],
          "type": "object"
        }
      ]
    },
    "RemoteRecordedRender": {
      "additionalProperties": false,
      "properties": {
        "params": true,
        "renderer_id": {
          "type": "string"
        }
      },
      "required": [
        "renderer_id",
        "params"
      ],
      "type": "object"
    },
    "RemoteSamplingCapability": {
      "description": "Mirror of the core `SamplingCapability`: whether the model accepts a\ncaller-set temperature at all, or pins its own sampling and rejects one.",
      "enum": [
        "configurable",
        "pinned"
      ],
      "type": "string"
    },
    "RemoteStreamTermination": {
      "description": "Mirror of the core `StreamTermination`.",
      "enum": [
        "require_terminal_evidence",
        "eof_tolerated"
      ],
      "type": "string"
    },
    "RemoteTurnBudget": {
      "description": "Required wire mirror of the session's turn budget.",
      "oneOf": [
        {
          "enum": [
            "unbounded"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bounded": {
              "format": "uint",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "bounded"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://lash.dev/schemas/remote-persist-process-env-request/v100",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "env_spec": {
      "$ref": "#/$defs/RemoteProcessExecutionEnvSpec"
    }
  },
  "required": [
    "env_spec"
  ],
  "title": "RemotePersistProcessEnvRequest",
  "type": "object",
