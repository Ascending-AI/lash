        }
      },
      "required": [
        "refused",
        "helper"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionId"
        },
        "refused": {
          "const": "helper_unpaired",
          "type": "string"
        }
      },
      "required": [
        "refused",
        "function"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
