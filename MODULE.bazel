module(
    name = "lash",
    version = "0.0.0-dev",
)

bazel_dep(name = "llvm", version = "0.8.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rs", version = "0.0.110")
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.2")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.98.1",
)
use_repo(toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
rules_rust.patch(
    patches = ["//tools/bazel:patches/rules-rust-check-only-bin-metadata.patch"],
    strip = 1,
)
use_repo(rules_rust, "rules_rust")

rules_rust_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
    "@rules_rust_bindgen//:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
# The bundled build uses this metadata only as a header-location hint. Keep it
# repository-relative so the build-script binary and output are reusable across
# executor work directories.
crate.annotation(
    crate = "libsqlite3-sys",
    patch_args = ["-p1"],
    patches = ["//tools/bazel:patches/libsqlite3-sys-hermetic-manifest-dir.patch"],
    version = "0.35.0",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    deps = ["@crates//:aws_lc_sys_build_info"],
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    repositories = ["crates"],
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
)
inject_repo(crate, "aws-lc")
use_repo(crate, "crates")

runtime_off_sources = use_repo_rule("//tools/bazel:runtime_off_repository.bzl", "runtime_off_sources")
runtime_off_sources(name = "runtime_off_sources")
crate.from_cargo(
    name = "runtime_off_crates",
    prune_unreachable = True,
    cargo_lock = "@runtime_off_sources//:sources/witness/Cargo.lock",
    cargo_toml = "@runtime_off_sources//:sources/witness/Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "runtime_off_crates")
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    deps = ["@runtime_off_crates//:aws_lc_sys_build_info"],
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    repositories = ["runtime_off_crates"],
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
)

single_version_override(
    module_name = "rules_rs",
    version = "0.0.110",
    patches = ["//tools/bazel:patches/rules-rs-reachable-features.patch"],
    patch_strip = 1,
)

# Bazel brings rules_swift, but Lash has no Swift targets or host toolchains.
single_version_override(
    module_name = "rules_swift",
    version = "3.1.2",
    patches = ["//tools/bazel:patches/rules-swift-no-toolchain-registration.patch"],
    patch_strip = 1,
)
