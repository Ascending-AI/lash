+/// Properties-chain annotations, as `(argument path, header)` pairs.
+fn param_header_annotations(input_schema: &JsonObject) -> Vec<(Vec<String>, String)> {
+    fn collect(schema: &JsonObject, path: &mut Vec<String>, out: &mut Vec<(Vec<String>, String)>) {
+        if !path.is_empty()
+            && let Some(Value::String(header)) = schema.get("x-mcp-header")
+            && !header.is_empty()
+        {
+            out.push((path.clone(), header.clone()));
+        }
+        if let Some(Value::Object(properties)) = schema.get("properties") {
+            for (name, child) in properties {
+                if let Value::Object(child) = child {
+                    path.push(name.clone());
+                    collect(child, path, out);
+                    path.pop();
+                }
+            }
+        }
+    }
