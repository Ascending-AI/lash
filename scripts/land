#!/usr/bin/env python3
"""Land committed work after sourcing ./env.sh; --dry-run stops before pushing."""

import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

from apply_format_witnesses import apply as apply_format_witnesses
from perf_land_gate import apply_ratchet, cache

CEILINGS = "scripts/perf_land_ceilings.py"

# A land never runs code that differs from the tree it lands. Each process
# rebases once; when that rebase changed this script or a module it loaded
# from scripts/, or main moved after qualification, it re-executes itself
# from the tree with the same arguments. RUNS bounds the restarts.
SCRIPTS = Path(__file__).resolve().parent
RUNS = "LASH_LAND_RUNS"
MAX_RUNS = 12


def code_digest(path):
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except FileNotFoundError:
        return None


def loaded_code():
    """This script and every module loaded from its directory, by digest."""
    files = {Path(__file__).resolve()}
    for module in list(sys.modules.values()):
        source = getattr(module, "__file__", None)
        if source and Path(source).resolve().parent == SCRIPTS:
            files.add(Path(source).resolve())
    return {path: code_digest(path) for path in files}


LOADED = loaded_code()

GENERATED = re.compile(
    r"(^|/)BUCK$|^tools/buck2/target-inventory\.json$"
    r"|^tools/buck2/test-shard-weights\.json$|^tools/buck2/[a-z0-9_]+_test_labels\.txt$"
)
RACE = re.compile(
    r"\[rejected\]|fetch first|non-fast-forward|cannot lock ref|stale info|failed to update ref"
)
REMOTE = re.compile(
    r"returned error: 5\d\d|HTTP[/\s][^\n]*\b5\d\d\b|Internal Server Error|Bad Gateway"
    r"|Service Unavailable|Gateway Time-?out|connection (?:reset|refused|timed out|termination)"
    r"|unexpected disconnect|remote end hung up|closed by remote host|early EOF|could not resolve host"
    r"|failed to connect|network is unreachable",
    re.IGNORECASE,
)
HOOK = re.compile(r"^.*\.{3,}\s*Failed\s*$|^- hook id: ", re.MULTILINE)


def run(*args, check=True, quiet=False):
    if not quiet:
        print("+ " + " ".join(args), flush=True)
    result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace")
    if not quiet and result.stdout.strip():
        print("\n".join(result.stdout.rstrip().splitlines()[-40:]), flush=True)
    if check and result.returncode:
        raise RuntimeError(" ".join(args) + " failed:\n" + tail(result.stdout))
    return result


def tail(output):
    return "\n".join(output.rstrip().splitlines()[-40:])


def git(*args):
    return run("git", *args, quiet=True).stdout.strip()


def paths(*args):
    return [p for p in run("git", *args, quiet=True).stdout.split("\0") if p]


def rebasing():
    return any(Path(git("rev-parse", "--git-path", name)).exists()
               for name in ("rebase-merge", "rebase-apply"))


def generated(path):
    if GENERATED.search(path):
        return True
    # Main's header is authoritative, even if the conflict is a deletion.
    result = subprocess.run(["git", "show", f"origin/main:{path}"], capture_output=True)
    return b"@generated" in result.stdout[:400]


def rebase():
    created = set()
    try:
        result = run("git", "rebase", "origin/main", check=False)
        while result.returncode:
            files = paths("diff", "--name-only", "--diff-filter=U", "-z")
            if not files or not all(generated(p) for p in files):
                raise RuntimeError("rebase conflicts: " + ", ".join(files) if files else
                                   "rebase failed:\n" + tail(result.stdout))
            for path in files:
                # During rebase, ours is main plus commits already replayed.
                exists = run("git", "cat-file", "-e", f":2:{path}",
                             check=False, quiet=True).returncode == 0
                if exists:
                    run("git", "checkout", "--ours", "--", path)
                else:
                    run("git", "rm", "--", path)
            try:
                run("kiln", "sync")
            finally:
                created.update(paths("ls-files", "--others", "--exclude-standard", "-z"))
            run("git", "add", "-A")
            # --continue commits with the original author and message, or drops
            # a replay made empty by regeneration.
            result = run("git", "-c", "core.editor=true", "rebase", "--continue", check=False)
    except BaseException:
        if rebasing():
            run("git", "rebase", "--abort")
        # An unsuccessful sync may have written files before they were staged.
        for path in created.intersection(paths("ls-files", "--others", "--exclude-standard", "-z")):
            Path(path).unlink(missing_ok=True)
        raise


def push(main, qualified_head):
    outages = 0
    while True:
        current = git("rev-parse", "HEAD")
        if current != qualified_head:
            raise RuntimeError(f"candidate changed after qualification: {qualified_head} -> {current}; rerun scripts/land")
        # A push source is read as a ref name first, so a branch named after
        # the SHA would redirect a bare one; peel it to the object instead.
        result = run("git", "push", "origin", f"{qualified_head}^{{commit}}:refs/heads/main", check=False)
        if result.returncode == 0:
            return True
        output = result.stdout
        if HOOK.search(output):
            raise RuntimeError("push hook refused candidate; fix and commit, then rerun scripts/land:\n" + tail(output))
        elif RACE.search(output):
            return False
        elif REMOTE.search(output):
            # A dropped connection may have hidden a successful push.
            fetched = run("git", "fetch", "origin", "main", check=False)
            if fetched.returncode == 0:
                if run("git", "merge-base", "--is-ancestor", qualified_head, "origin/main",
                       check=False, quiet=True).returncode == 0:
                    return True
                if git("rev-parse", "origin/main") != main:
                    return False
            if outages == 3:
                raise RuntimeError("remote push retries exhausted:\n" + tail(output))
            delay = (2, 5, 10)[outages]
            outages += 1
            print(f"transient remote failure; retrying in {delay}s", flush=True)
            time.sleep(delay)
            continue
        raise RuntimeError("push refused:\n" + tail(output))


def ancestor_holds_lock(fd):
    info = os.fstat(fd)
    identity = (os.major(info.st_dev), os.minor(info.st_dev), info.st_ino)
    holders = set()
    for line in Path("/proc/locks").read_text().splitlines():
        fields = line.split()
        if len(fields) != 8 or fields[1:4] != ["FLOCK", "ADVISORY", "WRITE"]:
            continue
        major, minor, inode = fields[5].split(":")
        if (int(major, 16), int(minor, 16), int(inode)) == identity:
            holders.add(int(fields[4]))
    pid = os.getppid()
    while pid:
        if pid in holders:
            return True
        stat = Path(f"/proc/{pid}/stat").read_text()
        pid = int(stat.rsplit(")", 1)[1].split()[1])
    return False


@contextmanager
def land_lock():
    with open("/workspace/kiln/lash/land.lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if not ancestor_holds_lock(lock.fileno()):
                fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def restart(reason):
    runs = int(os.environ.get(RUNS, "1"))
    if runs >= MAX_RUNS:
        raise RuntimeError(f"main kept moving: {runs} runs of scripts/land")
    print(f"land: restarting from the rebased tree ({reason}); run {runs + 1}/{MAX_RUNS}", flush=True)
    os.environ[RUNS] = str(runs + 1)
    os.execv(sys.executable, [sys.executable, str(SCRIPTS / "land"), *sys.argv[1:]])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="rebase, regenerate and check, without pushing")
    args = parser.parse_args()
    cache()  # the gate's store: refuse before touching the tree
    os.chdir(git("rev-parse", "--show-toplevel"))
    if rebasing():
        raise RuntimeError("rebase already in progress")
    if git("status", "--porcelain", "--untracked-files=all"):
        raise RuntimeError("dirty tree: commit or discard changes first")
    run("git", "fetch", "origin", "main")
    main_sha = git("rev-parse", "origin/main")
    rebase()
    changed = sorted(path.name for path, digest in LOADED.items() if code_digest(path) != digest)
    if changed:
        restart("changed " + ", ".join(changed))
    authored = git("rev-parse", "HEAD")
    witness_paths = apply_format_witnesses(Path.cwd(), main_sha)
    if witness_paths:
        run("git", "add", "--", *witness_paths)
        ticket = re.search(r"\(FIG-\d+\)$", git("log", "-1", "--format=%s"))
        subject = "Refresh format witnesses and schemas for the rebased shapes"
        if ticket:
            subject += " " + ticket.group()
        run("git", "commit", "-m", subject, "-m",
            "Hosts that retain stores or opaque bytes in the previous formats "
            "must reset or recreate them before deployment. The generated "
            "host-upgrade entry lists the changed stamps. No new opt-in, "
            "migration or old-shape reader is provided.")
    # Allocation validates the complete planned tree, including unchanged
    # guards and the post-cut evidence. Do not project it a second time.
    run("python3", "scripts/perf-gates.py", "check-sources", "--land-perf-gate")
    run("python3", "scripts/apply_format_witnesses.py", "--check-artifacts")
    run("kiln", "build", "//:schema_checks", "//:workspace_clippy")
    run("python3", "scripts/check_format_registry.py")
    # ADR 0149's release law: a changed helper or native answer lands
    # only with its recorded release and native version. It is a test,
    # so the build above cannot run it (FIG-7640).
    run("kiln", "test", "//crates/lash-kernel-releases:lash-kernel-releases__unit_test",
        "--test_arg=--exact",
        "--test_arg=tests::checked_archive_covers_current_release_and_native_implementations")
    qualified_head = git("rev-parse", "HEAD")
    run("python3", "scripts/continuation_compat.py", "--base", main_sha)
    receipt = Path(".kiln/perf-land") / f"land-{time.time_ns()}-{os.getpid()}"
    run("python3", "scripts/perf_land_gate.py", "--base", main_sha, "--out", str(receipt))
    # The gate's measured ceiling ratchet rides with the land as its own
    # commit, like the format witnesses: only the lowered ceilings of the
    # qualified tree, so the measured binary is unchanged.
    lowered = json.loads((receipt / "receipt.json").read_text())["ratchet"]
    for key, ceiling in lowered.items():
        print(f"ratchet {key}: ceiling lowered to {ceiling}", flush=True)
    if args.dry_run:
        print("dry-run: ratchet not committed, push skipped; HEAD " + git("rev-parse", "HEAD"))
        return
    # The land pushes exactly what it qualified: the qualified head, or its
    # own ceiling commit on it. Anything else committed since is refused.
    landing = qualified_head
    landed = False
    try:
        if lowered:
            Path(CEILINGS).write_text(apply_ratchet(Path(CEILINGS).read_text(), lowered))
            run("git", "add", "--", CEILINGS)
            ticket = re.search(r"\(FIG-\d+\)$", git("log", "-1", "--format=%s", authored))
            subject = "Instruction ceilings ratchet down to the land's measured medians times 1.03"
            run("git", "commit", "-m", subject + (" " + ticket.group() if ticket else ""), "-m",
                "Generated by scripts/land from the perf gate's receipt: "
                + ", ".join(f"{key} {ceiling!r}" for key, ceiling in lowered.items()) + ".")
            landing = git("rev-parse", "HEAD")
            # What was committed, hooks included, must be exactly the
            # qualified policy with the permitted decreases.
            if (git("rev-parse", landing + "^@") != qualified_head
                    or paths("diff", "--name-only", "-z", qualified_head, landing) != [CEILINGS]
                    or run("git", "show", f"{landing}:{CEILINGS}", quiet=True).stdout
                    != apply_ratchet(run("git", "show", f"{qualified_head}:{CEILINGS}", quiet=True).stdout, lowered)):
                raise RuntimeError("ratchet commit is not the qualified ceilings with the receipt's decreases")
        with land_lock():
            current = git("rev-parse", "HEAD")
            if current != landing:
                raise RuntimeError(f"candidate changed after qualification: {landing} -> {current}; "
                                   "rerun scripts/land")
            run("git", "fetch", "origin", "main")
            landed = git("rev-parse", "origin/main") == main_sha and push(main_sha, landing)
    finally:
        # A ratchet that did not land is measured again on the next attempt.
        # Only the land's own ceiling commit is dropped, never other work.
        if not landed and landing != qualified_head and git("rev-parse", "HEAD") == landing:
            run("git", "reset", "--keep", qualified_head)
    if landed:
        print("landed " + git("rev-parse", "HEAD"))
        return
    if witness_paths:
        # Drop only our own generated commit, with a clean tree, before
        # rebasing authored work again. Never rebase allocated integers:
        # the next main may already have allocated the same values.
        if git("status", "--porcelain", "--untracked-files=all"):
            raise RuntimeError("dirty tree after push; cannot regenerate witnesses")
        run("git", "reset", "--keep", authored)
    restart("main moved")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, ValueError, OSError) as error:
        sys.exit(f"land: {error}")
