      "document": "kernel 1\nnumbers by_spelling\neffect echo(n: Int) -> Int\nfn worker(n) { let answer = perform echo(n) as Int return answer }\nmain {\n let kept = [1]\n let shared = kept\n let identity = fn(x) { return x }\n for n in [1] {\n  try {\n   let h = spawn call worker(n)\n   let answer = join h\n   set shared[0] = answer\n  } finally { do perform echo(9) as Int }\n }\n let value = kept[0]\n let got = apply identity(value)\n finish got\n}\n",
