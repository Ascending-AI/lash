{
  "rule": "K-MACH-004",
  "cases": [
    {
      "name": "a delivered wait resumes its own task",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(x: Int) -> Int\nmain {\n  let x = perform 0(1) as Int\n  finish x\n}\n",
      "expected": {
        "end": {
          "finished": {
            "int": "2"
          }
        },
        "trace": [
          {
            "effect": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "1"
                }
              ],
              "result": "int"
            }
          }
        ]
      },
      "environment": {
        "deliveries": [
          [
            {
              "request": 0,
              "outcome": {
                "completed": {
                  "int": "2"
                }
              }
            }
          ]
        ]
      }
    },
    {
      "name": "an outcome for a withdrawn handed-out wait is dropped",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(x: Int) -> Int\nimport 1 operation typescript.sleep(milliseconds: Int) -> Null\ndefinition \"function slow() -> Any\\nkernel 1\\nmetering statements\\nimport 0 operation host.echo(x: Int) -> Int\\nimport 1 operation typescript.sleep(milliseconds: Int) -> Null\\nbody {\\n  try {\\n    do perform 1(0) as Null\\n  } catch e {\\n    return e.kind\\n  }\\n}\\n\"\nmain {\n  let h = spawn invoke slow()\n  let first = perform 0(1) as Int\n  do cancel(h)\n  let cancelled = join h\n  let last = perform 0(2) as Int\n  finish cancelled\n}\n",
      "environment": {
        "deliveries": [
          [
            {
              "request": 1,
              "outcome": {
                "completed": {
                  "int": "2"
                }
              }
            }
          ],
          [
            {
              "request": 0,
              "outcome": {
                "completed": "null"
              },
              "dropped": true
            },
            {
              "request": 2,
              "outcome": {
                "completed": {
                  "int": "3"
                }
              }
            }
          ]
        ]
      },
      "expected": {
        "end": {
          "finished": {
            "text": "cancelled"
          }
        },
        "parks": 2,
        "trace": [
          {
            "effect": {
              "effect": "typescript.sleep",
              "args": [
                {
                  "int": "0"
                }
              ],
              "result": "null"
            }
          },
          {
            "effect": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "1"
                }
              ],
              "result": "int"
            }
          },
          {
            "effect": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "2"
                }
              ],
              "result": "int"
            }
          }
        ]
      }
    }
  ]
}
