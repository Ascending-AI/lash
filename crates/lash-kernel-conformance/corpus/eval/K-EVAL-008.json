{
  "rule": "K-EVAL-008",
  "cases": [
    {
      "name": "operands evaluated before a nested wait keep their values across a resume",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(value: Int) -> Int\nmain {\n  let xs = [1]\n  let r = (xs[0], perform 0(1) as Int, xs[0])\n  finish r\n}\n",
      "expected": {
        "prints": [],
        "end": {
          "finished": {
            "tuple": [
              {
                "int": "1"
              },
              {
                "int": "10"
              },
              {
                "int": "1"
              }
            ]
          }
        },
        "trace": [
          {
            "effect": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "1"
                }
              ],
              "result": "int"
            }
          }
        ]
      },
      "environment": {
        "deliveries": [
          [
            {
              "request": 0,
              "outcome": {
                "completed": {
                  "int": "10"
                }
              }
            }
          ]
        ],
        "resume": true
      }
    }
  ]
}
