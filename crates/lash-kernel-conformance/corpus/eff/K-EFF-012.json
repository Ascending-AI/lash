{
  "rule": "K-EFF-012",
  "cases": [
    {
      "name": "a read is answered inside its statement and charged as a recorded perform",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(x: Int) -> Int\nmain {\n  let x = perform 0(1) as Int\n  finish x\n}\n",
      "environment": {
        "reads": [
          "host.echo"
        ],
        "host": [
          {
            "perform": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "1"
                }
              ],
              "answer": {
                "Ok": {
                  "int": "2"
                }
              }
            }
          }
        ]
      },
      "expected": {
        "prints": [],
        "end": {
          "finished": {
            "int": "2"
          }
        },
        "trace": [],
        "charged": 10,
        "parks": 0
      }
    },
    {
      "name": "a read's error is raised at the perform",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(value: Int) -> Int\nmain {\n  try {\n    do perform 0(1) as Int\n  } catch e {\n    finish (e.kind, e.data)\n  }\n}\n",
      "environment": {
        "reads": [
          "host.echo"
        ],
        "host": [
          {
            "perform": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "1"
                }
              ],
              "answer": {
                "Err": {
                  "kind": "test",
                  "message": "message",
                  "data": {
                    "record": [
                      [
                        "n",
                        {
                          "int": "4"
                        }
                      ]
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "expected": {
        "prints": [],
        "end": {
          "finished": {
            "tuple": [
              {
                "text": "test"
              },
              {
                "record": [
                  [
                    "n",
                    {
                      "int": "4"
                    }
                  ]
                ]
              }
            ]
          }
        },
        "trace": [],
        "parks": 0
      }
    },
    {
      "name": "a read's answer is decoded as the perform states",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(value: Int) -> Int\nmain {\n  try {\n    do perform 0(1) as Int\n  } catch e {\n    finish e.kind\n  }\n}\n",
      "environment": {
        "reads": [
          "host.echo"
        ],
        "host": [
          {
            "perform": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "1"
                }
              ],
              "answer": {
                "Ok": {
                  "float": "1.5"
                }
              }
            }
          }
        ]
      },
      "expected": {
        "prints": [],
        "end": {
          "finished": {
            "text": "effect_result"
          }
        },
        "trace": [],
        "parks": 0
      }
    },
    {
      "name": "a recorded effect beside a read still waits",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.look(key: Int) -> Int\nimport 1 operation host.echo(value: Int) -> Int\nmain {\n  let a = perform 0(1) as Int\n  let b = perform 1(a) as Int\n  finish b\n}\n",
      "environment": {
        "reads": [
          "host.look"
        ],
        "host": [
          {
            "perform": {
              "effect": "host.look",
              "args": [
                {
                  "int": "1"
                }
              ],
              "answer": {
                "Ok": {
                  "int": "5"
                }
              }
            }
          }
        ],
        "deliveries": [
          [
            {
              "request": 0,
              "outcome": {
                "completed": {
                  "int": "6"
                }
              }
            }
          ]
        ]
      },
      "expected": {
        "prints": [],
        "end": {
          "finished": {
            "int": "6"
          }
        },
        "trace": [
          {
            "effect": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "5"
                }
              ],
              "result": "int"
            }
          }
        ],
        "parks": 1
      }
    },
    {
      "name": "a read binding of an effect the manifest does not list is refused",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(x: Int) -> Int\nmain {\n  let x = perform 0(1) as Int\n  finish x\n}\n",
      "environment": {
        "reads": [
          "other"
        ]
      },
      "expected": {
        "prints": [],
        "end": "refused",
        "trace": []
      }
    }
  ]
}
