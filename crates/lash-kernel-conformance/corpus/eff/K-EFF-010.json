              "nanoseconds": 0
            }
          }
        ]
      },
      "environment": {
        "deliveries": [
          [
            {
              "request": 0,
              "outcome": "elapsed"
            }
          ]
        ]
      }
    },
    {
      "name": "negative sleep duration raises number_range",
      "document": "kernel 1\nnumbers by_spelling\n\nmain {\ntry { do sleep -1 } catch e { print e.kind }\n}\n",
      "expected": {
        "prints": [
          {
            "text": "number_range"
          }
        ],
        "end": {
          "finished": "null"
        },
        "trace": []
      }
    }
  ]
