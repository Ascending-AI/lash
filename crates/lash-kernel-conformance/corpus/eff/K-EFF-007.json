{
  "rule": "K-EFF-007",
  "cases": [
    {
      "name": "wrong kind",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.source() -> Any\nmain {\n  try {\n    let value = perform 0() as Int\n    print value\n  } catch e {\n    finish e.kind\n  }\n  finish null\n}\n",
      "expected": {
        "prints": [],
        "trace": [
          {
            "effect": {
              "effect": "host.source",
              "args": [],
              "result": "int"
            }
          }
        ],
        "end": {
          "finished": {
            "text": "effect_result"
          }
        }
      },
      "environment": {
        "resume": true,
        "deliveries": [
          [
            {
              "request": 0,
              "outcome": {
                "completed": {
                  "text": "1"
                }
              }
            }
          ]
        ]
      }
    },
