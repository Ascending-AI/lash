{
  "rule": "K-HOST-001",
  "cases": [
    {
      "name": "host reads never cause a park",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation typescript.clock() -> Timestamp\nimport 1 operation typescript.random() -> Bytes\nmain {\nprint perform 0() as Timestamp\nprint perform 1() as Bytes\nfinish perform 0() as Timestamp\n}\n",
      "expected": {
        "prints": [
          {
            "timestamp": "1"
          },
          {
            "bytes": "8000000000000000"
          }
        ],
        "end": {
          "finished": {
            "timestamp": "2"
          }
        },
        "trace": [],
        "parks": 0
      },
      "environment": {
        "host": [
          {
            "perform": {
              "effect": "typescript.clock",
              "args": [],
              "answer": {
                "Ok": {
                  "timestamp": "1"
                }
              }
            }
          },
          {
            "perform": {
              "effect": "typescript.random",
              "args": [],
              "answer": {
                "Ok": {
                  "bytes": "8000000000000000"
                }
              }
            }
          },
          {
            "perform": {
              "effect": "typescript.clock",
              "args": [],
              "answer": {
                "Ok": {
                  "timestamp": "2"
                }
              }
            }
          }
        ],
        "reads": [
          "typescript.clock",
          "typescript.random"
        ]
      }
    }
  ]
}
