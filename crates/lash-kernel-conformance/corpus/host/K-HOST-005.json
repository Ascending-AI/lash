{
  "rule": "K-HOST-005",
  "cases": [
    {
      "name": "a read the host cannot answer stops the run at its statement",
      "document": "kernel 1\nnumbers by_spelling\nimport 0 operation host.echo(x: Int) -> Int\nmain {\n  print 1\n  let x = perform 0(1) as Int\n  print x\n  finish x\n}\n",
      "environment": {
        "reads": [
          "host.echo"
        ],
        "host": [
          {
            "perform": {
              "effect": "host.echo",
              "args": [
                {
                  "int": "1"
                }
              ],
              "answer": null
            }
          }
        ]
      },
      "expected": {
        "prints": [
          {
            "int": "1"
          }
        ],
        "end": "host_fault",
        "trace": [],
        "parks": 0
      }
    }
  ]
}
