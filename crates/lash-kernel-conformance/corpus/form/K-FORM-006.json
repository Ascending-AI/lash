                  {
                    "int": "3"
                  }
                ]
              },
              {
                "set": [
                  {
                    "int": "2"
                  }
                ]
              }
            ]
          }
        },
        "trace": []
      }
    },
    {
      "name": "append cannot skip list positions",
      "document": "kernel 1\nnumbers by_spelling\n\nmain {\ntry { let xs = [1] set xs[2] = 2 } catch e { print e.kind }\n}\n",
      "expected": {
        "prints": [
          {
            "text": "index_out_of_range"
