use kind
use same
use record.contains
use bool.not
use list.len
use ts.number_index
use num.lt
use ts.to_property_key
use num.to_float
use ts.list_index
use ts.exotic.get
function law.get_pattern(target: Any, key: Any) -> Any
kernel 1
charge 12
native
body {
  if same(kind(target), "record") {
    if same(kind(key), "text") {
      if bool.not(record.contains(target, "__lash_brand")) { return target[key] }
    }
  }
  let dynamic = fn(target, key) {
    let k = kind(target)
    if same(k, "list") {
      let length = list.len(target)
      let position = invoke ts.number_index(key, length)
      if same(position, -2.0) {
        let name = invoke ts.to_property_key(key)
        if same(name, "length") { return num.to_float(length) }
        set position = invoke ts.list_index(name, length)
      }
      if num.lt(position, 0) {
        let other = invoke ts.exotic.get(target, key)
        return other
      }
      let value = target[position]
      if same(value, ()) { return absent }
      return value
    }
    return absent
  }
  let outcome = apply dynamic(target, key)
  return outcome
}
