use ts.array.length
use num.lt
use error.new
use ts.get
use list.len
use num.add
function law.dense_pattern(this: Any) -> List(Any)
kernel 1
errors "type_error", "RangeError"
charge sum(8, size(this), size(result))
body {
  let length = invoke ts.array.length(this)
  if num.lt(4294967295.0, length) { throw error.new("RangeError", "Invalid array length", null) }
  let output = []
  let index = 0.0
  while num.lt(index, length) metered 2 {
    let value = invoke ts.get(this, index)
    set output[list.len(output)] = value
    set index = num.add(index, 1)
  }
  return output
}
