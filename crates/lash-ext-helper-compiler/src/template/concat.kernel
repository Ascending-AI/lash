use ts.require_object_coercible
use list.len
use ts.array.is
use ts.array.length
use num.lt
use ts.has_own
use ts.get
use num.add
function law.concat_pattern(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), size(result))
body {
  do invoke ts.require_object_coercible(this)
  let sources = [this]
  for source in args { set sources[list.len(sources)] = source }
  let output = []
  for source in sources {
    let array = invoke ts.array.is(source)
    if array {
      let length = invoke ts.array.length(source)
      let index = 0.0
      while num.lt(index, length) {
        let present = invoke ts.has_own(source, index)
        let value = ()
        if present { set value = invoke ts.get(source, index) }
        set output[list.len(output)] = value
        set index = num.add(index, 1)
      }
    } else { set output[list.len(output)] = source }
  }
  return output
}
