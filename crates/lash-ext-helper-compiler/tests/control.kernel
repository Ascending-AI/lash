# K-FORM-014..017: departures run cleanup in order; halts bypass handlers.
use eq
use num.add
use num.div
use num.lt
use num.mul
use list.len
use error.new
use law.declining
use kind
use same
use tuple.len

# PLAN-INDEP / ELEMENT-SOURCE: the spelling of a helper grants no array
# semantics. These definitions deliberately change a key, hole or return.
function ts.get_numeric(target: Any, key: Any) -> Any
kernel 1
charge 12
body { return target[num.add(key, 1.0)] }

function ts.get_computed(target: Any, key: Any) -> Any
kernel 1
charge 12
body {
  let value = target[key]
  if same(kind(value), "tuple") {
    if same(tuple.len(value), 0) { return null }
  }
  return value
}

function ts.set(target: Any, key: Any, value: Any) -> Any
kernel 1
charge 12
body { set target[key] = value return null }

# An allocating prefix is not a read-only Element path, even if discarded.
function law.allocating_element(target: Any, key: Any) -> Any
kernel 1
charge 12
body {
  let empty = ()
  let value = target[key]
  if same(kind(value), "tuple") {
    if same(tuple.len(value), 0) { return absent }
  }
  return value
}

# The same semantic operation under an unrelated name must still derive.
function law.element_read(target: Any, key: Any) -> Any
kernel 1
charge 12
body {
  let value = target[key]
  if same(kind(value), "tuple") {
    if same(tuple.len(value), 0) { return absent }
  }
  return value
}

function law.handlers(mode: Any, log: Any) -> Any
kernel 1
charge 10
body {
  try {
    for n in [1, 2, 3] {
      try {
        if eq(n, 1) { continue }
        if eq(n, 2) { break }
      } finally { set log[list.len(log)] = n }
    }
    try {
      if eq(mode, 0) { throw error.new("guest", "raised", null) }
      if eq(mode, 1) { return 10 }
      if eq(mode, 2) { return num.div(1, 0) }
      return 30
    } catch problem {
      set log[list.len(log)] = problem.kind
      return 20
    } finally {
      set log[list.len(log)] = 99
      if eq(mode, 3) { return 40 }
    }
  } finally { set log[list.len(log)] = 100 }
}

function law.halt() -> Any
kernel 1
charge 10
body {
  try { while true metered 2 {} }
  catch problem { return "caught" }
  finally { throw error.new("cleanup", "must not run on halt", null) }
}

# K-FORM-004, K-FN-005 and K-CHG-007: escaped closures share the body's
# parameter and local cells and retain their ordinary charge and depth.
function law.factory(start: Any) -> Any
kernel 1
charge 7
body {
  let count = start
  let increment = fn(delta) {
    set count = num.add(count, delta)
    return count
  }
  let peek = fn() { return (start, count) }
  set start = num.add(start, 1)
  return {increment: increment, peek: peek}
}

# K-LIB-006: a declining native enters its body's plan exactly once.
function law.declining(log: Any) -> Any
kernel 1
charge 3
native
body {
  set log[list.len(log)] = 1
  return log
}

function law.decline_caller(log: Any) -> Any
kernel 1
charge 5
body {
  let answer = invoke law.declining(log)
  return (answer, log)
}

# FIG-6814: a scalar path past the call budget leaves its whole arm to the
# body, the inputs its other paths answer included.
function law.budget(x: Float) -> Float
kernel 1
charge 3
body {
  if num.lt(x, 0.0) { return -1.0 }
  return num.add(num.mul(x, 2.0), 1.0)
}
