                    },
                    "start": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "type": "object"
                },
                "heading_path": {
                  "items": {
                    "maxLength": 256,
                    "type": "string"
                  },
                  "maxItems": 16,
