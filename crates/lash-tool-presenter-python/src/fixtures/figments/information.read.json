{
  "input": {
    "additionalProperties": false,
    "properties": {
      "read_ref": {
        "description": "Opaque reference returned by information.search, information.list, or information.read.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "read_ref"
    ],
    "type": "object"
  },
