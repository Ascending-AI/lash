                  "type": "integer"
                }
              },
              "type": "object"
            },
            "source_unit_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "text_truncated": {
              "const": true
            }
          },
          "required": [
            "source_unit_id",
            "text"
          ],
          "type": "object"
