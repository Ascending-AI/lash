      },
      "previous_read_ref": {
        "maxLength": 4096,
        "type": "string"
      },
      "record": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 512,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "email_thread",
              "message_thread",
              "calendar_event",
              "issue",
              "chat_window",
              "generated_artifact",
              "chat_turn",
              "workflow_result"
            ],
            "type": "string"
          },
          "open_url": {
            "maxLength": 4096,
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "display_name"
        ],
        "type": "object"
      },
      "units": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "attributes": {
              "additionalProperties": false,
              "type": "object"
            },
            "location": {
              "additionalProperties": false,
              "properties": {
                "character_range": {
                  "additionalProperties": false,
                  "properties": {
                    "end": {
