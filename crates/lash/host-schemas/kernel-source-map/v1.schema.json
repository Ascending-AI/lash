{
  "$defs": {
    "DocumentId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "FunctionId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Name": {
      "description": "A variable, parameter or declared-function name.\n\nAny text is a name; the kernel gives none of them meaning. Structural\nvalidation refuses the empty name.",
      "type": "string"
    },
    "NonEmptySpans": {
      "items": {
        "$ref": "#/$defs/Span"
      },
      "minItems": 1,
      "type": "array"
    },
    "Site": {
      "additionalProperties": false,
      "description": "A node's address: the code it belongs to and the chain of\n[`Node::children`] indexes that reaches it from that code's body.\n\nA site is derived from the document and is never written by a host\n(`K-ID-004`). An empty chain addresses the body itself.",
      "properties": {
        "path": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "unit"
      ],
      "type": "object"
    },
    "SourceLanguage": {
      "description": "The language of source, independent of a generated-source format version.",
      "enum": [
        "type_script",
        "python"
      ],
      "type": "string"
    },
    "SourceLocation": {
      "description": "Exactly one spelling or an offset for a genuinely unspelled node.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "spelled",
              "type": "string"
            },
            "ranges": {
              "$ref": "#/$defs/NonEmptySpans"
            }
          },
          "required": [
            "kind",
            "ranges"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "implicit",
              "type": "string"
            },
            "offset": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "offset"
          ],
          "type": "object"
        }
      ]
    },
    "SourceSite": {
      "additionalProperties": false,
      "description": "One document node's source locations.",
      "properties": {
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "site": {
          "$ref": "#/$defs/Site"
        }
      },
      "required": [
        "site",
        "location"
      ],
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "UTF-8 byte offsets in authored or printed source.",
      "properties": {
        "end": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Unit": {
      "description": "The code a node belongs to.",
      "oneOf": [
        {
          "const": "main",
          "description": "The document's `main`.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A declared function of the document.",
          "properties": {
            "function": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The kernel-code body of an authored or build-owned library function.\nNested helper closures retain this owning identity and their site path.",
          "properties": {
            "library": {
              "$ref": "#/$defs/FunctionId"
            }
          },
          "required": [
            "library"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://lash.dev/schemas/kernel-source-map/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source locations keyed by document identity and the SHA-256 of source bytes.\nSites are strictly ascending and unique. Validate decoded maps against their\ndocument and source before using their locations.",
  "properties": {
    "document": {
      "$ref": "#/$defs/DocumentId"
    },
    "language": {
      "$ref": "#/$defs/SourceLanguage"
    },
    "sites": {
      "items": {
        "$ref": "#/$defs/SourceSite"
      },
      "type": "array"
    },
    "source": {
      "items": {
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 32,
      "minItems": 32,
      "type": "array"
    }
  },
  "required": [
    "source",
    "document",
    "language",
    "sites"
  ],
  "title": "SourceMap",
  "type": "object",
  "x-lash-schema-version": 1,
  "x-lash-version-constant": "KERNEL_VERSION"
}
