    "Name": {
      "description": "A variable, parameter or declared-function name.\n\nAny text is a name; the kernel gives none of them meaning. Structural\nvalidation refuses the empty name.",
      "type": "string"
    },
    "Operation": {
      "description": "Every supported canvas operation, admitted atomically through [`crate::Draft::apply`].\nStructural operations accept only separable perform/tool steps. While loops\nsupport condition editing; creating or removing one requires source.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "set_value": {
              "additionalProperties": false,
              "properties": {
                "base": {
                  "$ref": "#/$defs/DocumentId"
                },
                "target": {
                  "$ref": "#/$defs/ValueTarget"
                },
                "value": {
                  "$ref": "#/$defs/DataValue"
                }
              },
              "required": [
                "base",
                "target",
                "value"
              ],
              "type": "object"
            }
          },
          "required": [
            "set_value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "insert_step": {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "items": {
                    "$ref": "#/$defs/DataValue"
                  },
                  "type": "array"
                },
                "at": {
                  "$ref": "#/$defs/Position"
                },
                "base": {
                  "$ref": "#/$defs/DocumentId"
                },
                "binding": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "result": {
                  "$ref": "#/$defs/Type"
                },
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                }
              },
              "required": [
                "base",
                "at",
                "slot",
                "args",
                "result"
              ],
              "type": "object"
            }
          },
          "required": [
            "insert_step"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "remove_step": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "$ref": "#/$defs/Site"
                },
                "base": {
                  "$ref": "#/$defs/DocumentId"
                }
              },
              "required": [
                "base",
                "action"
              ],
              "type": "object"
            }
          },
          "required": [
            "remove_step"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "move_step": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "$ref": "#/$defs/Site"
                },
                "base": {
                  "$ref": "#/$defs/DocumentId"
                },
