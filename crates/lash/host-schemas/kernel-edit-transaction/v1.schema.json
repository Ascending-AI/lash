                  "$ref": "#/$defs/Position"
                }
              },
              "required": [
                "base",
                "action",
                "to"
              ],
              "type": "object"
            }
          },
          "required": [
            "move_step"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "wrap_steps": {
              "additionalProperties": false,
              "properties": {
                "base": {
                  "$ref": "#/$defs/DocumentId"
                },
                "first": {
                  "$ref": "#/$defs/Site"
                },
                "last": {
                  "$ref": "#/$defs/Site"
                },
                "wrapper": {
                  "$ref": "#/$defs/Wrapper"
                }
              },
              "required": [
                "base",
                "first",
                "last",
                "wrapper"
              ],
              "type": "object"
            }
          },
          "required": [
            "wrap_steps"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "unwrap_steps": {
              "additionalProperties": false,
              "properties": {
                "base": {
                  "$ref": "#/$defs/DocumentId"
                },
                "branch": {
                  "$ref": "#/$defs/Branch"
                },
                "wrapper": {
                  "$ref": "#/$defs/Site"
                }
              },
              "required": [
                "base",
                "wrapper",
                "branch"
              ],
              "type": "object"
            }
          },
          "required": [
