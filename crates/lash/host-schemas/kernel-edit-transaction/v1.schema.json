{
  "$defs": {
    "ActExpr": {
      "additionalProperties": false,
      "description": "An action inside an expression: the action forms that may nest, with\nexpression arguments.",
      "properties": {
        "args": {
          "items": {
            "$ref": "#/$defs/Expr"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ActKind"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ActKind": {
      "description": "What an [`Expr::Act`] does. `yield` and `cancel` stay statement\nactions.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Calls a function and yields what it returns.",
          "properties": {
            "call": {
              "$ref": "#/$defs/Callee"
            }
          },
          "required": [
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Runs one effect and yields its result, decoded as `result`.",
          "properties": {
            "perform": {
              "additionalProperties": false,
              "properties": {
                "result": {
                  "$ref": "#/$defs/Type"
                },
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                },
                "then_yield": {
                  "description": "As [`Action::Perform`]'s.",
                  "type": "boolean"
                }
              },
              "required": [
                "slot",
                "result"
              ],
              "type": "object"
            }
          },
          "required": [
            "perform"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Starts a task running a function and yields its handle.",
          "properties": {
            "spawn": {
              "$ref": "#/$defs/Callee"
            }
          },
          "required": [
            "spawn"
          ],
          "type": "object"
        },
        {
          "const": "join",
          "description": "Waits on the task handle that is its one argument.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Waits on the list of task handles that is its one argument.",
          "properties": {
            "join_many": {
              "$ref": "#/$defs/JoinMode"
            }
          },
          "required": [
            "join_many"
          ],
          "type": "object"
        },
        {
          "const": "yield",
          "description": "Gives other ready tasks their turn.",
          "type": "string"
        },
        {
          "const": "cancel",
          "description": "Cancels the task handle that is its one argument.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Awaits its one argument by the await policy (`K-TASK-026`).",
          "properties": {
            "await": {
              "$ref": "#/$defs/FunctionTarget"
            }
          },
          "required": [
            "await"
          ],
          "type": "object"
        }
      ]
    },
    "Branch": {
      "enum": [
        "then",
        "else",
        "body"
      ],
      "type": "string"
    },
    "Bytes": {
      "pattern": "^([0-9a-f]{2})*$",
      "type": "string"
    },
    "CallablePresentation": {
      "additionalProperties": false,
      "description": "How a function a closure makes is started from outside its run: the\nsignature it is started under, how the dialect holds the function as a\nvalue, and how the entry calls it.",
      "properties": {
        "convention": {
          "$ref": "#/$defs/StartConvention"
        },
        "representation": {
          "$ref": "#/$defs/FunctionRepresentation"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        }
      },
      "required": [
        "signature",
        "representation",
        "convention"
      ],
      "type": "object"
    },
    "Callee": {
      "description": "What a call or a `spawn` runs.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A declared function of the document, by name.",
          "properties": {
            "local": {
              "$ref": "#/$defs/FunctionId"
            }
          },
          "required": [
            "local"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "import": {
              "$ref": "#/$defs/ImportSlot"
            }
          },
          "required": [
            "import"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The closure or function reference a variable holds.",
          "properties": {
            "value": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Closure": {
      "additionalProperties": false,
      "description": "A function value written in place. It shares the variables of the scope\nthat defines it (`K-CLO-001`); which ones is derived, never written.",
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionId",
          "description": "The anonymous body's own identity, local to the defining Document."
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallablePresentation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "function"
      ],
      "type": "object"
    },
    "DataMapEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/DataValue"
        },
        "value": {
          "$ref": "#/$defs/DataValue"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "DataRecordEntry": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/DataValue"
        }
      },
      "required": [
        "field",
        "value"
      ],
      "type": "object"
    },
    "DataValue": {
      "description": "Data that can be connected to a value slot; no executable syntax.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "literal": {
              "$ref": "#/$defs/Literal"
            }
          },
          "required": [
            "literal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "variable": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "variable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "tuple": {
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            }
          },
          "required": [
            "tuple"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "list": {
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            }
          },
          "required": [
            "list"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "set": {
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            }
          },
          "required": [
            "set"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "map": {
              "items": {
                "$ref": "#/$defs/DataMapEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "map"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "record": {
              "items": {
                "$ref": "#/$defs/DataRecordEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "record"
          ],
          "type": "object"
        }
      ]
    },
    "DocumentId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Expr": {
      "description": "An expression, evaluated within one statement. Only an [`Expr::Act`]\nin it may pause the task (`K-EVAL-008`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "literal": {
              "$ref": "#/$defs/Literal"
            }
          },
          "required": [
            "literal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "variable": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "variable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Evaluates the condition, then only the selected branch.",
          "properties": {
            "if": {
              "additionalProperties": false,
              "properties": {
                "cond": {
                  "$ref": "#/$defs/Expr"
                },
                "else": {
                  "$ref": "#/$defs/Expr"
                },
                "then": {
                  "$ref": "#/$defs/Expr"
                }
              },
              "required": [
                "cond",
                "then",
                "else"
              ],
              "type": "object"
            }
          },
          "required": [
            "if"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Evaluates `value` before binding `name`, visible only in `body`.",
          "properties": {
            "let": {
              "additionalProperties": false,
              "properties": {
                "body": {
                  "$ref": "#/$defs/Expr"
                },
                "name": {
                  "$ref": "#/$defs/Name"
                },
                "value": {
                  "$ref": "#/$defs/Expr"
                }
              },
              "required": [
                "name",
                "value",
                "body"
              ],
              "type": "object"
            }
          },
          "required": [
            "let"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "tuple": {
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "type": "array"
            }
          },
          "required": [
            "tuple"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "list": {
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "type": "array"
            }
          },
          "required": [
            "list"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "map": {
              "items": {
                "$ref": "#/$defs/MapEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "map"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "set": {
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "type": "array"
            }
          },
          "required": [
            "set"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "record": {
              "items": {
                "$ref": "#/$defs/RecordEntry"
              },
              "type": "array"
            }
          },
          "required": [
            "record"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Reads a field or an index.",
          "properties": {
            "member": {
              "$ref": "#/$defs/Member"
            }
          },
          "required": [
            "member"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "closure": {
              "$ref": "#/$defs/Closure"
            }
          },
          "required": [
            "closure"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Calls a library function that has a native implementation.",
          "properties": {
            "call": {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "items": {
                    "$ref": "#/$defs/Expr"
                  },
                  "type": "array"
                },
                "function": {
                  "$ref": "#/$defs/FunctionId"
                }
              },
              "required": [
                "function",
                "args"
              ],
              "type": "object"
            }
          },
          "required": [
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The embedder's clock, as a timestamp.\nA float drawn by the embedder, uniform in `[0, 1)`.\nReads through a projection handle.",
          "properties": {
            "read": {
              "$ref": "#/$defs/ProjectionRead"
            }
          },
          "required": [
            "read"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An action nested in the expression: the statement may pause at it,\nthe operands it has already evaluated kept as the roles of its\ncontinuation (`K-EVAL-008`).",
          "properties": {
            "act": {
              "$ref": "#/$defs/ActExpr"
            }
          },
          "required": [
            "act"
          ],
          "type": "object"
        }
      ]
    },
    "Float": {
      "pattern": "^(nan|-?inf|-?(0|[1-9][0-9]*)\\.[0-9]+|-?[1-9](\\.[0-9]+)?e-?[1-9][0-9]*)$",
      "type": "string"
    },
    "FunctionId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "FunctionRepresentation": {
      "description": "How a dialect holds a function as a value.",
      "oneOf": [
        {
          "const": "bare",
          "description": "The closure itself.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A tuple whose first member is the text `tag` and whose member at\n`callable` is the closure. The tuple crosses as one function value.",
          "properties": {
            "token": {
              "additionalProperties": false,
              "properties": {
                "callable": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "tag": {
                  "type": "string"
                }
              },
              "required": [
                "tag",
                "callable"
              ],
              "type": "object"
            }
          },
          "required": [
            "token"
          ],
          "type": "object"
        }
      ]
    },
    "FunctionTarget": {
      "description": "A convention helper local to this document or named by an explicit Import slot.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "local",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/FunctionId"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "import",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ImportSlot"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ImportSlot": {
      "description": "A stable document-local Import coordinate. Names are diagnostic, never dispatch keys.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "Integer": {
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "type": "string"
    },
    "JoinMode": {
      "oneOf": [
        {
          "const": "all",
          "description": "Every member has ended, or the first failure.",
          "type": "string"
        },
        {
          "const": "all_settled",
          "description": "Every member has ended.",
          "type": "string"
        },
        {
          "const": "race",
          "description": "The first member to end.",
          "type": "string"
        },
        {
          "const": "any",
          "description": "The first member to succeed.",
          "type": "string"
        }
      ]
    },
    "Literal": {
      "oneOf": [
        {
          "enum": [
            "null",
            "absent"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": [
            "bool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "int": {
              "$ref": "#/$defs/Integer"
            }
          },
          "required": [
            "int"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "float": {
              "$ref": "#/$defs/Float"
            }
          },
          "required": [
            "float"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "$ref": "#/$defs/Bytes"
            }
          },
          "required": [
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A reference to a declared function of the document.",
          "properties": {
            "function": {
              "$ref": "#/$defs/FunctionId"
            }
          },
          "required": [
            "function"
          ],
          "type": "object"
        }
      ]
    },
    "MapEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/Expr"
        },
        "value": {
          "$ref": "#/$defs/Expr"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "MapType": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/Type"
        },
        "value": {
          "$ref": "#/$defs/Type"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "Member": {
      "description": "A field of a record or an index into a collection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "target": {
                  "$ref": "#/$defs/Expr"
                }
              },
              "required": [
                "target",
                "field"
              ],
              "type": "object"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "index": {
              "additionalProperties": false,
              "properties": {
                "index": {
                  "$ref": "#/$defs/Expr"
                },
                "target": {
                  "$ref": "#/$defs/Expr"
                }
              },
              "required": [
