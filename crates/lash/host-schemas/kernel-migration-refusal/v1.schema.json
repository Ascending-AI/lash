{
  "$defs": {
    "CallableId": {
      "additionalProperties": false,
      "description": "A function and its operation context. Authored callbacks retain their defining\nLink; build helpers carry the caller's real Link and an exact library ID.",
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionId"
        },
        "link": {
          "$ref": "#/$defs/LinkId"
        }
      },
      "required": [
        "link",
        "function"
      ],
      "type": "object"
    },
    "DocumentId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "DocumentRefusal": {
      "description": "Why a document is not rewritten for the next version.",
      "oneOf": [
        {
          "properties": {
            "found": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "from": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "const": "version",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "found",
            "from"
          ],
          "type": "object"
        },
        {
          "properties": {
            "function": {
              "$ref": "#/$defs/FunctionId"
            },
            "reason": {
              "const": "function_not_held",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "function"
          ],
          "type": "object"
        },
        {
          "properties": {
            "function": {
              "$ref": "#/$defs/FunctionId"
            },
            "name": {
              "$ref": "#/$defs/FunctionName"
            },
            "reason": {
              "const": "function_retired",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "function",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "The rewrite performs `operation` under another requirement than the\ndocument did: adoption never moves code onto a changed operation\ncontract.",
          "properties": {
            "operation": {
              "$ref": "#/$defs/FunctionName"
            },
            "reason": {
              "const": "operation_contract_changed",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "operation"
          ],
          "type": "object"
        },
        {
          "properties": {
            "detail": {
              "type": "string"
            },
            "reason": {
              "const": "form_not_carried",
              "type": "string"
            },
            "site": {
              "$ref": "#/$defs/Site"
            }
          },
          "required": [
            "reason",
            "site",
            "detail"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "const": "correspondence",
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "FunctionId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "FunctionName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
      "type": "string"
    },
    "ImportSlot": {
      "description": "A stable document-local Import coordinate. Names are diagnostic, never dispatch keys.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "Invalid": {
      "additionalProperties": false,
      "description": "Why a document or a definition is refused, and the node at fault.",
      "properties": {
        "reason": {
          "$ref": "#/$defs/InvalidReason"
        },
        "site": {
          "anyOf": [
            {
              "$ref": "#/$defs/Site"
            },
            {
              "type": "null"
            }
          ],
          "description": "The node at fault. `None` when the fault is in no node: the\nmanifest, an entry, a signature."
        }
      },
      "required": [
        "reason"
      ],
      "type": "object"
    },
    "InvalidReason": {
      "oneOf": [
        {
          "enum": [
            "empty_name",
            "limit_measures_result",
            "empty_formula",
            "guard_without_native",
            "empty_guard_unit"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "document": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "document"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "import": {
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                }
              },
              "required": [
                "slot"
              ],
              "type": "object"
            }
          },
          "required": [
            "import"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kernel_version": {
              "additionalProperties": false,
              "properties": {
                "found": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "supported": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "found",
                "supported"
              ],
              "type": "object"
            }
          },
          "required": [
            "kernel_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "too_deep": {
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "limit"
              ],
              "type": "object"
            }
          },
          "required": [
            "too_deep"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "duplicate_param": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "duplicate_param"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "duplicate_field": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                }
              },
              "required": [
                "field"
              ],
              "type": "object"
            }
          },
          "required": [
            "duplicate_field"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "loop_control_outside_loop": {
              "additionalProperties": false,
              "properties": {
                "keyword": {
                  "type": "string"
                }
              },
              "required": [
                "keyword"
              ],
              "type": "object"
            }
          },
          "required": [
            "loop_control_outside_loop"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A library call written as an expression's own call names a\nfunction with no native implementation: a call of it is an\naction, `invoke`.",
          "properties": {
            "call_not_native": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                },
                "name": {
                  "$ref": "#/$defs/FunctionName"
                }
              },
              "required": [
                "function",
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "call_not_native"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_of_another_version": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                },
                "name": {
                  "$ref": "#/$defs/FunctionName"
                },
                "required": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "written_for": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "function",
                "name",
                "written_for",
                "required"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_of_another_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_not_listed": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                }
              },
              "required": [
                "function"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_not_listed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_not_resolved": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/FunctionId"
                }
              },
              "required": [
                "function"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_not_resolved"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_arity": {
              "additionalProperties": false,
              "properties": {
                "accepted": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "given": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "required": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "given",
                "required",
                "accepted"
              ],
              "type": "object"
            }
          },
          "required": [
            "call_arity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "effect_not_listed": {
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                }
              },
              "required": [
                "slot"
              ],
              "type": "object"
            }
          },
          "required": [
            "effect_not_listed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "function_not_declared": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "function_not_declared"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "declared_function_in_library": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "declared_function_in_library"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-004`: a library body performs only the operations its\n`effects` lists.",
          "properties": {
            "effect_not_declared": {
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "$ref": "#/$defs/ImportSlot"
                }
              },
              "required": [
                "slot"
              ],
              "type": "object"
            }
          },
          "required": [
            "effect_not_declared"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entry_not_declared": {
              "additionalProperties": false,
              "properties": {
                "entry": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "entry"
              ],
              "type": "object"
            }
          },
          "required": [
            "entry_not_declared"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entry_arity": {
              "additionalProperties": false,
              "properties": {
                "declared": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "entry": {
                  "$ref": "#/$defs/Name"
                },
                "signature": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "entry",
                "signature",
                "declared"
              ],
              "type": "object"
            }
          },
          "required": [
            "entry_arity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "invalid_type": {
              "additionalProperties": false,
              "properties": {
                "problem": {
                  "type": "string"
                }
              },
              "required": [
                "problem"
              ],
              "type": "object"
            }
          },
          "required": [
            "invalid_type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "required_after_optional": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "required_after_optional"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "formula_unknown_param": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "formula_unknown_param"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-011`: a native version versions a native implementation.",
          "properties": {
            "native_version_without_native": {
              "additionalProperties": false,
              "properties": {
                "version": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "version"
              ],
              "type": "object"
            }
          },
          "required": [
            "native_version_without_native"
          ],
          "type": "object"
        },
        {
          "const": "native_version_zero",
          "description": "`K-LIB-011`: native versions count from 1.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-003`: a function with a native implementation takes no\nfunction.",
          "properties": {
            "native_takes_function": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/Name"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "native_takes_function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-LIB-004`: a body that stands beside a native implementation\ncannot wait.",
          "properties": {
            "native_body_may_wait": {
              "additionalProperties": false,
              "properties": {
                "form": {
                  "$ref": "#/$defs/StatementForm"
                }
              },
              "required": [
                "form"
              ],
              "type": "object"
            }
          },
          "required": [
            "native_body_may_wait"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`K-EVAL-003`: an assignment evaluates its place before its\nright-hand side only when it writes a member, and that right-hand\nside is an expression, any action in it nested.",
          "properties": {
            "place_first_assignment": {
              "additionalProperties": false,
              "properties": {
                "problem": {
                  "type": "string"
                }
              },
              "required": [
                "problem"
              ],
              "type": "object"
            }
          },
          "required": [
            "place_first_assignment"
          ],
          "type": "object"
        },
        {
          "const": "action_as_expression",
          "description": "A right-hand side that is one action with variable and literal\narguments is the statement's action, not an expression: the one\nspelling kernel text reads back.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "`K-CLO-004`: a direct start passes the signature's arguments as the\nfunction's parameters, one for one.",
          "properties": {
            "start_arity": {
              "additionalProperties": false,
              "properties": {
                "declared": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "signature": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "signature",
                "declared"
              ],
              "type": "object"
            }
          },
          "required": [
            "start_arity"
          ],
          "type": "object"
        },
        {
          "const": "start_token",
          "description": "`K-CLO-004`: a token holds its tag first and its callable after it.",
          "type": "string"
        }
      ]
    },
    "LinkId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Name": {
      "description": "A variable, parameter or declared-function name.\n\nAny text is a name; the kernel gives none of them meaning. Structural\nvalidation refuses the empty name.",
      "type": "string"
    },
    "ParkedRefusal": {
      "description": "Why a parked run is not carried onto a rewritten document.",
      "oneOf": [
        {
          "properties": {
            "function": {
              "$ref": "#/$defs/FunctionId"
            },
            "reason": {
              "const": "helper_operation_context",
              "type": "string"
            },
            "slot": {
              "$ref": "#/$defs/ImportSlot"
            }
          },
          "required": [
            "reason",
            "function",
            "slot"
          ],
          "type": "object"
        },
        {
          "properties": {
            "function": {
              "$ref": "#/$defs/FunctionId"
            },
            "reason": {
              "const": "missing_helper",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "function"
          ],
          "type": "object"
        },
        {
          "properties": {
            "found": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "from": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "const": "version",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "found",
            "from"
          ],
          "type": "object"
        },
        {
          "properties": {
            "parked": {
              "$ref": "#/$defs/DocumentId"
            },
            "reason": {
              "const": "document",
              "type": "string"
            },
            "rewritten": {
              "$ref": "#/$defs/DocumentId"
            }
          },
          "required": [
            "reason",
            "parked",
            "rewritten"
          ],
          "type": "object"
        },
        {
          "description": "The run holds a coordinate at a node the rewrite does not carry: a\ntask stands there, a variable or a closure was made there, a loop or\na cleanup block there is under way, or a task or an effect is\nidentified by it.",
          "properties": {
            "held": {
              "type": "string"
            },
            "reason": {
              "const": "site_not_carried",
              "type": "string"
            },
            "site": {
              "$ref": "#/$defs/Site"
            }
          },
          "required": [
            "reason",
            "site",
            "held"
          ],
          "type": "object"
        },
        {
          "properties": {
            "function": {
              "$ref": "#/$defs/FunctionId"
            },
            "reason": {
              "const": "function_not_carried",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "function"
          ],
          "type": "object"
        },
        {
          "properties": {
            "detail": {
              "type": "string"
            },
            "reason": {
              "const": "state_not_carried",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "detail"
          ],
          "type": "object"
        }
      ]
    },
    "Site": {
      "additionalProperties": false,
      "description": "A node's address: the code it belongs to and the chain of\n[`Node::children`] indexes that reaches it from that code's body.\n\nA site is derived from the document and is never written by a host\n(`K-ID-004`). An empty chain addresses the body itself.",
      "properties": {
        "path": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "unit"
      ],
      "type": "object"
    },
    "StatementForm": {
      "description": "An action form, as a refusal names one the body of a function with a\nnative implementation may not run (`K-LIB-004`).",
      "enum": [
        "call",
        "perform",
        "join",
        "yield",
        "spawn",
        "cancel",
        "await"
      ],
      "type": "string"
    },
    "Unit": {
      "description": "The code a node belongs to.",
      "oneOf": [
        {
          "const": "main",
          "description": "The document's `main`.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A declared function of the document.",
          "properties": {
            "function": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The kernel-code body of an authored or build-owned library function.\nNested helper closures retain this owning identity and their site path.",
          "properties": {
            "library": {
              "$ref": "#/$defs/FunctionId"
            }
          },
          "required": [
            "library"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://lash.dev/schemas/kernel-migration-refusal/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Why a kernel process is not carried to the next kernel version.",
  "oneOf": [
    {
      "properties": {
        "callable": {
          "$ref": "#/$defs/CallableId"
        },
        "refused": {
          "const": "callable_origin_required",
          "type": "string"
        }
      },
      "required": [
        "refused",
        "callable"
      ],
      "type": "object"
    },
    {
      "properties": {
        "document": {
          "$ref": "#/$defs/DocumentId"
        },
        "refused": {
          "const": "document_missing",
          "type": "string"
        }
      },
      "required": [
        "refused",
        "document"
      ],
      "type": "object"
    },
    {
