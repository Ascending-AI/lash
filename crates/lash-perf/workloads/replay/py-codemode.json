{
  "format": "lash-perf-replay/1",
  "name": "py-codemode",
  "description": "W5: W4 in Python: tool replies read as dicts, a 1 MB value kept in a session global across parks, and a saved def.",
  "protocol": "python",
  "turns": [
    {
      "repeat": 1,
      "setup": true,
      "user": "Turn {turn}: load the corpus and keep it.",
      "replies": [
        {
          "cell": [
            "big = await tools_fixture_large({\"key\": \"corpus\", \"bytes\": 1000000})",
            "def describe(record, size):",
            "    return record[\"title\"] + \" / \" + str(size) + \" bytes kept\"",
            "last = \"none\"",
            "await control_finish({\"loaded\": big[\"bytes\"], \"length\": len(big[\"text\"])})"
          ]
        }
      ]
    },
    {
      "repeat": 49,
      "user": "Turn {turn}: check item {turn} against the corpus.",
      "replies": [
        {
          "cell": [
            "record = await tools_fixture_lookup({\"key\": \"item-{turn}\"})",
            "waited = await tools_fixture_slow({\"key\": \"wait-{turn}\", \"ms\": 5})",
            "head = big[\"text\"][0:4096]",
            "last = describe(record, len(big[\"text\"]))",
            "await control_finish({\"turn\": {turn}, \"last\": last, \"head\": len(head), \"waited\": waited[\"waited_ms\"], \"score\": record[\"score\"]})"
          ]
        }
      ]
    }
  ]
}
