      "source": "function readLater() { return globalThis.later; }\nfunction writeLater() { globalThis.later = 5; }\nconsole.log(readLater(), \"later\" in globalThis);\nwriteLater();\nconsole.log(readLater(), \"later\" in globalThis);\n",
      "reject": null,
      "deviation": null,
      "defect": null,
      "node": {
        "outcome": "normal",
        "prints": [
          "undefined false",
          "5 true"
