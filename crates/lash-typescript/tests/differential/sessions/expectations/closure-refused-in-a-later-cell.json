{
  "id": "closure-refused-in-a-later-cell",
  "about": "a later cell's use of a function an earlier cell bound is refused by name, live and after a reload (FIG-3608)",
  "probe": [
    "helper",
    "twice",
    "box",
    "n"
  ],
  "deviations": [
    "closure-boundary"
  ],
  "cells": [
    {
      "source": "const helper = (n) => n + 1;\nfunction twice(n) { return n * 2; }\nconst box = { run: helper, n: 2 };\nconsole.log(helper(1), twice(2), box.n);\n",
      "reject": null,
      "deviation": null,
      "defect": null,
      "node": {
        "outcome": "normal",
        "prints": [
          "2 4 2"
        ],
        "probes": {
          "helper": "function undefined",
          "twice": "function undefined",
          "box": "object {\"n\":2}",
          "n": "unbound"
        },
        "closures": [
          "helper",
          "twice",
          "box"
        ]
      }
    },
    {
      "source": "console.log(typeof helper, twice(3), box.n);\n",
      "reject": null,
      "deviation": "closure-boundary",
      "defect": null,
      "node": {
        "outcome": "normal",
        "prints": [
          "function 6 2"
        ],
        "probes": {
          "helper": "function undefined",
          "twice": "function undefined",
          "box": "object {\"n\":2}",
          "n": "unbound"
        },
        "closures": [
          "helper",
          "twice",
          "box"
        ]
      },
      "lash": {
        "resident": {
          "outcome": "rejected",
          "diagnostic": "TS_FUNCTION_NOT_PERSISTED",
          "prints": [],
          "probes": {
            "box": "dropped",
            "helper": "dropped",
            "n": "unbound",
            "twice": "dropped"
          }
        },
        "restart": {
          "outcome": "rejected",
          "diagnostic": "TS_FUNCTION_NOT_PERSISTED",
          "prints": [],
          "probes": {
            "box": "dropped",
            "helper": "dropped",
            "n": "unbound",
            "twice": "dropped"
          }
        }
      }
    }
  ]
}
