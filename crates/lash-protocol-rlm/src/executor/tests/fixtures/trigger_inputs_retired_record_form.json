  "source": "const remember = defineProcess({\n  name: \"remember\",\n  signals: {},\n  run: async (tick: timer.Tick, label: string) => {\n    return true;\n  }\n});\nconst source = timer.Schedule({ expr: \"0 8 * * *\", tz: \"UTC\" });\nconst handle = await registerTrigger({\n  source,\n  target: { definition: remember },\n  inputs: { tick: trigger.event, label: \"daily\" },\n  name: \"remembered\",\n  subscription_key: \"remembered-key\"\n});\nfinish(handle);\n"
