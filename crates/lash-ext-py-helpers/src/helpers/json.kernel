# JSON policy belongs to the Python module, over the kernel JSON codecs.
use kind
use same
use lt
use add
use bool.not
use text.repeat
use json.encode
use list.len
use record.keys
use map.keys
use py.fail
use py.call
use py.sealed
use py.sorted

function py.json_dump(value: Any, options: Tuple(Any, Any, Any, Any, Any, Any, Any, Any, Any)) -> Text
kernel 1
charge sum(16, deep(value), deep(options), size(result))
body {
  let skipkeys = options[0]
  let ascii = options[1]
  let check = options[2]
  let allow_nan = options[3]
  let cls = options[4]
  let indent = options[5]
  let separators = options[6]
  let default = options[7]
  let sort_keys = options[8]

  if same(skipkeys, absent) { set skipkeys = false }
  if same(ascii, absent) { set ascii = true }
  if same(allow_nan, absent) { set allow_nan = true }
  if same(sort_keys, absent) { set sort_keys = false }
  if bool.not(same(cls, absent)) { if bool.not(same(cls, null)) { do invoke py.fail("TypeError", "custom encoder classes are not available") } }
  let indentation = ""
  let pretty = false
  if bool.not(same(indent, absent)) {
    if bool.not(same(indent, null)) {
      set pretty = true
      if same(kind(indent), "integer") { if lt(0, indent) { set indentation = text.repeat(" ", indent) } } else {
        if bool.not(same(kind(indent), "text")) { do invoke py.fail("TypeError", "indent must be int, str or None") }
        set indentation = indent
      }
    }
  }
  let item_separator = ", "
  let key_separator = ": "
  if pretty { set item_separator = "," }
  if bool.not(same(separators, absent)) {
    if bool.not(same(separators, null)) { set item_separator = separators[0] set key_separator = separators[1] }
  }
  let gap = absent
  if pretty { set gap = indentation }
  let style = (ascii, item_separator, key_separator, 2, true, ("__lash_brand", "__py_ellipsis", "__py_module"), gap, allow_nan, skipkeys)
  if bool.not(sort_keys) {
    if same(default, absent) {} else { if same(default, null) { set default = absent } }
    if same(default, absent) {
      try { return json.encode(value, (-3, 16, true, true), style) } catch unsupported {
        let exception = "TypeError"
        if same(unsupported.kind, "json_number") { set exception = "ValueError" }
        if same(unsupported.kind, "cycle") { set exception = "ValueError" }
        do invoke py.fail(exception, unsupported.message)
      }
    }
  }
  # Evaluate default callbacks and ordering. Final JSON
  # emission, circular checks and path diagnostics remain in json.encode.
  let active = []
  let copies = []
  let prepare = absent
  set prepare = fn(item) {
    let k = kind(item)
    let sequence = same(k, "list")
    if same(k, "tuple") { set sequence = true }
    let mapping = same(k, "map")
    if same(k, "record") { if bool.not(invoke py.sealed(item)) { set mapping = true } }
    if bool.not(sequence) {
      if bool.not(mapping) {
        if same(k, "null") { return item }
        if same(k, "bool") { return item }
        if same(k, "integer") { return item }
        if same(k, "float") { return item }
        if same(k, "text") { return item }
        if bool.not(same(default, absent)) {
          if bool.not(same(default, null)) {
            let converted = invoke py.call(default, [item], map{})
            return apply prepare(converted)
          }
        }
        return item
      }
    }
    let position = 0
    for ancestor in active {
      if same(ancestor, item) { return copies[position] }
      set position = add(position, 1)
    }
    let copied = map{}
    if sequence { set copied = [] }
    set active[position] = item
    set copies[position] = copied
    if sequence {
      for member in item { set copied[list.len(copied)] = apply prepare(member) }
    } else {
      let keys = []
      if same(k, "map") { set keys = map.keys(item) } else { set keys = record.keys(item) }
      if sort_keys { set keys = invoke py.sorted(keys) }
      for key in keys {
        # An invalid key is rejected or skipped by the encoder before it reads
        # the value, so do not evaluate a default callback for that value.
        let kk = kind(key)
        let scalar = same(kk, "text")
        for supported in ["integer", "float", "bool", "null"] { if same(kk, supported) { set scalar = true } }
        if scalar { set copied[key] = apply prepare(item[key]) } else { set copied[key] = item[key] }
      }
    }
    remove active[position]
    remove copies[position]
    return copied
  }
  let prepared = apply prepare(value)
  try { return json.encode(prepared, (-3, 16, true, true), style) } catch unsupported {
    let exception = "TypeError"
    if same(unsupported.kind, "json_number") { set exception = "ValueError" }
    if same(unsupported.kind, "cycle") { set exception = "ValueError" }
    do invoke py.fail(exception, unsupported.message)
  }
  return ""
}
