# The line `print` writes: its arguments as `str` gives them, `sep` between.
function py.show(args: Any, sep: Text) -> Text
kernel 1
charge sum(4, deep(args), size(result))
body {
  let parts = []
  for item in args {
    let part = invoke py.str(item)
    set parts[list.len(parts)] = part
  }
  return text.join(parts, sep)
}

# Numeric strings accept Unicode decimal digits, but ASCII letters only.
function py.number_text(value: Text) -> Text
kernel 1
charge sum(8, size(value), size(result))
body {
  let points = []
  for point in text.to_code_points(text.trim_u17_0_0(value)) {
    if le(128, point) {
      let digit = invoke py.text.decimal(point)
      if le(0, digit) { set point = add(48, digit) }
    }
    if le(65, point) {
      if le(point, 90) { set point = add(point, 32) }
    }
    set points[list.len(points)] = point
  }
  return text.from_code_points(points)
}

# A separator must sit between two radix digits. The optional single
# separator immediately after an integer base prefix is consumed earlier.
function py.number_underscores(digits: Text, base: Int) -> Text
kernel 1
charge sum(8, product(size(digits), size(digits)))
body {
  let alphabet = text.slice("0123456789abcdefghijklmnopqrstuvwxyz", 0, base)
  let previous = false
  let out = []
  let index = 0
  for character in text.split(digits, "") {
    if same(character, "_") {
      let next = ""
      if lt(add(index, 1), text.len(digits)) { set next = text.get(digits, add(index, 1)) }
      let valid = previous
      if same(next, "") { set valid = false } else {
        if lt(text.find(alphabet, next, 0), 0) { set valid = false }
      }
      if bool.not(valid) { do invoke py.fail("ValueError", "misplaced numeric separator") }
      set previous = false
    } else {
      set previous = le(0, text.find(alphabet, character, 0))
      set out[list.len(out)] = character
    }
    set index = add(index, 1)
  }
  return text.join(out, "")
}

function py.int(value: Any, base?: Any) -> Int
kernel 1
charge sum(6, size(value))
body {
  let k = kind(value)
  if same(k, "text") {
    if same(base, absent) {
      set base = 10
    }
    if same(kind(base), "bool") {
      if base { set base = 1 } else { set base = 0 }
    }
    if bool.not(same(kind(base), "integer")) {
      do invoke py.fail("TypeError", "base must be an integer")
    }
    if bool.not(same(base, 0)) {
      if lt(base, 2) { do invoke py.fail("ValueError", "int() base must be >= 2 and <= 36, or 0") }
      if lt(36, base) { do invoke py.fail("ValueError", "int() base must be >= 2 and <= 36, or 0") }
    }
    try {
      let digits = invoke py.number_text(value)
      let sign = ""
      if text.starts_with(digits, "+") { set sign = "+" }
      if text.starts_with(digits, "-") { set sign = "-" }
      if bool.not(same(sign, "")) { set digits = text.slice(digits, 1, text.len(digits)) }
      let radix = base
      let prefixed = false
      for pair in [("0x", 16), ("0o", 8), ("0b", 2)] {
        let matches = bool.not(prefixed)
        if bool.not(text.starts_with(digits, pair[0])) { set matches = false }
        if matches {
          let accepts = same(base, 0)
          if same(base, pair[1]) { set accepts = true }
          if accepts {
            set radix = pair[1]
            set prefixed = true
            set digits = text.slice(digits, 2, text.len(digits))
          }
        }
      }
      if prefixed {
        if text.starts_with(digits, "_") { set digits = text.slice(digits, 1, text.len(digits)) }
      }
      if same(radix, 0) { set radix = 10 }
      set digits = invoke py.number_underscores(digits, radix)
      let number = int.parse(text.concat(sign, digits), radix)
      if same(base, 0) {
        if bool.not(prefixed) {
          if text.starts_with(digits, "0") {
            if bool.not(eq(number, 0)) { do invoke py.fail("ValueError", "leading zero in base zero") }
          }
        }
      }
      return number
    } catch problem {
      let shown = invoke py.repr(value)
      let hoisted1 = text.join(["invalid literal for int() with base ", num.to_text(base), ": ", shown], "")
      do invoke py.fail("ValueError", hoisted1)
    }
  }
  if bool.not(same(base, absent)) {
    do invoke py.fail("TypeError", "int() can't convert non-string with explicit base")
  }
  if same(k, "integer") {
    return value
  }
  if same(k, "bool") {
    if value {
      return 1
    }
    return 0
  }
  if same(k, "float") {
    if bool.not(eq(value, value)) {
      do invoke py.fail("ValueError", "cannot convert float NaN to integer")
    }
    if bool.not(is_finite(value)) {
      do invoke py.fail("OverflowError", "cannot convert float infinity to integer")
    }
    return num.to_int(trunc(value))
  }
  let name = invoke py.type(value)
  let hoisted2 = text.join(["int() argument must be a string, a bytes-like object or a real number, not '", name, "'"], "")
  do invoke py.fail("TypeError", hoisted2)
  return 0
}

function py.float(value: Any) -> Float
kernel 1
charge sum(6, size(value))
body {
  let k = kind(value)
  if same(k, "float") {
    return value
  }
  if same(k, "integer") {
    return num.to_float(value)
  }
  if same(k, "bool") {
    if value {
      return 1.0
    }
    return 0.0
  }
  if same(k, "text") {
    let digits = ""
    try {
      set digits = invoke py.number_text(value)
      set digits = invoke py.number_underscores(digits, 10)
    } catch problem {
      let shown = invoke py.repr(value)
      let message = text.concat("could not convert string to float: ", shown)
      do invoke py.fail("ValueError", message)
    }
    if same(digits, "infinity") {
      set digits = "inf"
    }
    if same(digits, "+infinity") {
      set digits = "inf"
    }
    if same(digits, "-infinity") {
      set digits = "-inf"
    }
    if same(digits, "+nan") {
      set digits = "nan"
    }
    if same(digits, "-nan") {
      set digits = "nan"
    }
    try {
      return float.parse(digits)
    } catch problem {
      let shown = invoke py.repr(value)
      let hoisted3 = text.concat("could not convert string to float: ", shown)
      do invoke py.fail("ValueError", hoisted3)
    }
  }
  let name = invoke py.type(value)
  let hoisted4 = text.join(["float() argument must be a string or a real number, not '", name, "'"], "")
  do invoke py.fail("TypeError", hoisted4)
  return 0.0
}

function py.abs(value: Any) -> Any
kernel 1
charge sum(4, size(value))
body {
  let ok = invoke py.is_number(value)
  if bool.not(ok) {
    let name = invoke py.type(value)
    let hoisted5 = text.join(["bad operand type for abs(): '", name, "'"], "")
    do invoke py.fail("TypeError", hoisted5)
  }
  if lt(value, 0) {
    return neg(value)
  }
  if same(kind(value), "float") {
    if eq(value, 0) {
      return 0.0
    }
  }
  return value
}

# `min(...)` when `largest` is false and `max(...)` when it is true, of the
# arguments, or of the one iterable given.
function py.extreme(args: Any, largest: Bool, key?: Any, default?: Any) -> Any
kernel 1
charge sum(4, deep(args))
body {
  let items = args
  if eq(tuple.len(args), 1) { let source = args[0] set items = invoke py.to_list(source) } else {
    if bool.not(same(default, absent)) { do invoke py.fail("TypeError", "Cannot specify a default for min/max with multiple positional arguments") }
  }
  let keyed = bool.not(same(key, absent))
  if same(key, null) { set keyed = false }
  let best = absent
  let rank = absent
  for item in items {
    let candidate = item
    if keyed { set candidate = invoke py.call(key, [item], map{}) }
    if same(best, absent) { set best = item set rank = candidate } else {
      let better = false
      if largest { set better = lt(rank, candidate) } else { set better = lt(candidate, rank) }
      if better { set best = item set rank = candidate }
    }
  }
  if same(best, absent) {
    if bool.not(same(default, absent)) { return default }
    do invoke py.fail("ValueError", "min/max iterable argument is empty")
  }
  return best
}

function py.sum(values: Any, start?: Any) -> Any
kernel 1
charge sum(4, deep(values))
body {
  let total = 0
  if bool.not(same(start, absent)) {
    set total = start
  }
  let items = values
  if bool.not(same(kind(items), "list")) { set items = invoke py.to_list(values) }
  for item in items {
    set total = invoke py.add(total, item)
  }
  return total
}

# `sorted(values, key=key, reverse=reverse)`: stable, by `<`. Each key is
# computed once, in order, and the keys are data the native sorts by: the
# merge compares them as a comparator closure over them would (FIG-6886).
function py.sorted(values: Any, key?: Any, reverse?: Any) -> List(Any)
kernel 1
charge sum(8, product(2, size(values)), size(result))
body {
  let items = invoke py.to_list(values)
  let keyed = bool.not(same(key, absent))
  if keyed {
    set keyed = bool.not(same(key, null))
  }
  let ranks = items
  if keyed {
    set ranks = []
    let callback = absent
    if lt(0, list.len(items)) { set callback = invoke py.call_target(key) }
    let arguments = [absent]
    let keywords = map{}
    for item in items metered 2 {
      set arguments[0] = item
      let rank = apply callback(arguments, keywords, absent)
      set ranks[list.len(ranks)] = rank
    }
  }
  let descending = false
  if bool.not(same(reverse, absent)) {
    set descending = invoke py.truth(reverse)
  }
  # An ordinary frame bills the native's formula over the actual ranks.
  # Nested library calls are covered by our linear completion formula,
  # which cannot measure callback-produced keys (K-CHG-007, FIG-6904).
  let sort = fn(items, ranks, descending) {
    return list.sort_by_keys(items, ranks, descending)
  }
  let ordered = apply sort(items, ranks, descending)
  return ordered
}

# `range(...)` as the list of its integers.
function py.range(first: Any, second?: Any, step?: Any) -> List(Int)
kernel 1
charge sum(4, size(result))
body {
  let start = 0
  let stop = first
  if bool.not(same(second, absent)) {
    set start = first
    set stop = second
  }
  if same(step, absent) {
    set step = 1
  }
  for bound in [start, stop, step] {
    if bool.not(same(kind(bound), "integer")) {
      let name = invoke py.type(bound)
      let hoisted8 = text.join(["'", name, "' object cannot be interpreted as an integer"], "")
      do invoke py.fail("TypeError", hoisted8)
    }
  }
  if eq(step, 0) {
    do invoke py.fail("ValueError", "range() arg 3 must not be zero")
  }
  let out = invoke collection.range(start, stop, step)
  return out
}

function py.enumerate(values: Any, start?: Any) -> List(Any)
kernel 1
charge sum(4, size(values), size(result))
body {
  let position = 0
  if bool.not(same(start, absent)) {
    set position = start
  }
  let items = invoke py.to_list(values)
  let out = []
  for item in items {
    set out[list.len(out)] = (position, item)
    set position = add(position, 1)
  }
  return out
}

# `zip(...)` of the iterables in the tuple `sequences`, as a list of tuples
# that stops with the shortest.
function py.zip(sequences: Any, strict?: Any) -> List(Any)
kernel 1
charge sum(4, deep(sequences), size(result))
body {
  let columns = []
  let shortest = absent
  for sequence in sequences {
    let column = invoke py.to_list(sequence)
    set columns[list.len(columns)] = column
    if same(shortest, absent) {
      set shortest = list.len(column)
    } else {
      if lt(list.len(column), shortest) {
        set shortest = list.len(column)
      }
    }
  }
  let checked = false
  if bool.not(same(strict, absent)) { set checked = invoke py.truth(strict) }
  if checked {
    for column in columns { if bool.not(eq(list.len(column), shortest)) { do invoke py.fail("ValueError", "zip() arguments have different lengths") } }
  }
  let out = []
  if same(shortest, absent) {
    return out
  }
  let row = 0
  while lt(row, shortest) {
    let line = ()
    for column in columns {
      set line = tuple.concat(line, (column[row],))
    }
    set out[row] = line
    set row = add(row, 1)
  }
  return out
}

function py.reversed(values: Any) -> List(Any)
kernel 1
charge sum(4, size(values), size(result))
body {
  let items = invoke py.to_list(values)
  let out = []
  let position = sub(list.len(items), 1)
  while le(0, position) {
    set out[list.len(out)] = items[position]
    set position = sub(position, 1)
  }
  return out
}

function py.any(values: Any) -> Bool
kernel 1
metering statements
body {
  let iterator = invoke py.iter(values)
  while true metered 2 {
    let item = invoke py.iterator.step(iterator)
    if eq(tuple.len(item), 0) { return false }
    let holds = invoke py.truth(item[0])
    if holds { return true }
  }
  return false
}

function py.all(values: Any) -> Bool
kernel 1
metering statements
body {
  let iterator = invoke py.iter(values)
  while true metered 2 {
    let item = invoke py.iterator.step(iterator)
    if eq(tuple.len(item), 0) { return true }
    let holds = invoke py.truth(item[0])
    if bool.not(holds) { return false }
  }
  return true
}

# `round(value)` is the nearest integer, ties to even; `round(value, digits)`
# keeps the number's kind.
function py.round(value: Any, digits?: Any) -> Any
kernel 1
charge sum(6, size(value))
body {
  let ok = invoke py.is_number(value)
  if bool.not(ok) {
    let name = invoke py.type(value)
    let hoisted9 = text.join(["type ", name, " doesn't define __round__ method"], "")
    do invoke py.fail("TypeError", hoisted9)
  }
  let plain = same(digits, absent)
  if bool.not(plain) {
    set plain = same(digits, null)
  }
  if bool.not(plain) {
    if same(kind(digits), "bool") {
      if digits { set digits = 1 } else { set digits = 0 }
    }
    if bool.not(same(kind(digits), "integer")) {
      do invoke py.fail("TypeError", "ndigits must be an integer")
    }
  }
  let integer = same(kind(value), "integer")
  if integer {
    if plain { return value }
    if le(0, digits) { return value }
  }
  if bool.not(eq(value, value)) {
    if plain {
      do invoke py.fail("ValueError", "cannot convert float NaN to integer")
    }
    return value
  }
  if bool.not(is_finite(value)) {
    if plain {
      do invoke py.fail("OverflowError", "cannot convert float infinity to integer")
    }
    return value
  }
  if plain {
    return num.to_int(round_even(value))
  }
  if lt(digits, 0) {
    let places = neg(digits)
    let magnitude = abs(value)
    if integer {
      # Avoid constructing a power larger than the integer needs.
      if lt(text.len(num.to_text(magnitude)), places) { return 0 }
    } else {
      if lt(308, places) { return mul(value, 0.0) }
    }
    let scale = pow(10, places)
    let whole = num.to_int(trunc(magnitude))
    let quotient = div_floor(whole, scale)
    let remainder = rem_floor(whole, scale)
    let twice = mul(remainder, 2)
    let up = lt(scale, twice)
    if eq(twice, scale) {
      set up = bool.not(eq(rem_floor(quotient, 2), 0))
      # A float's fractional part makes an integer half-way point
      # strictly above the tie. No division of floats loses that bit.
      if lt(whole, magnitude) { set up = true }
    }
    if up { set quotient = add(quotient, 1) }
    let rounded = mul(quotient, scale)
    if lt(value, 0) { set rounded = neg(rounded) }
    if integer { return rounded }
    if eq(rounded, 0) { return mul(value, 0.0) }
    try { return num.to_float(rounded) } catch problem {
      do invoke py.fail("OverflowError", "rounded value too large to represent")
    }
  }
  if lt(323, digits) { return value }
  return float.parse(format.fixed(value, digits))
}

# `isinstance(value, ...)` against the built-in type names in `names`. A
# bool is an int, as in Python.
function py.isinstance(value: Any, names: Any) -> Bool
kernel 1
charge sum(8, size(names))
body {
  let name = invoke py.type(value)
  if tuple.contains(names, name) {
    return true
  }
  if same(name, "bool") {
    return tuple.contains(names, "int")
  }
  return false
}

function py.ord(value: Any) -> Int
kernel 1
charge 6
body {
  if bool.not(same(kind(value), "text")) {
    let name = invoke py.type(value)
    let hoisted10 = text.join(["ord() expected string of length 1, but ", name, " found"], "")
    do invoke py.fail("TypeError", hoisted10)
  }
  if bool.not(eq(text.len(value), 1)) {
    let hoisted11 = text.join(["ord() expected a character, but string of length ", num.to_text(text.len(value)), " found"], "")
    do invoke py.fail("TypeError", hoisted11)
  }
  let points = text.to_code_points(value)
  return points[0]
}

function py.chr(value: Any) -> Text
kernel 1
charge 6
body {
  if bool.not(same(kind(value), "integer")) {
    let name = invoke py.type(value)
    let hoisted12 = text.join(["'", name, "' object cannot be interpreted as an integer"], "")
    do invoke py.fail("TypeError", hoisted12)
  }
  try {
    return text.from_code_points([value])
  } catch problem {
    do invoke py.fail("ValueError", "chr() arg not in range(0x110000)")
  }
  return ""
}

function py.divmod(left: Any, right: Any) -> Any
kernel 1
charge sum(6, size(left), size(right))
body {
  let quotient = invoke py.floordiv(left, right)
  let remainder = invoke py.mod(left, right)
  return (quotient, remainder)
}

function py.dict(value: Any, keywords: Any) -> Map(Any, Any)
kernel 1
charge sum(8, size(value), size(keywords), size(result))
body {
  let out = map{}
  if bool.not(same(value, absent)) { set out = invoke py.to_dict(value) }
  for key in keywords { set out[key] = keywords[key] }
  return out
}

# Every print emits immediately; flush has no buffered stream to drain.
function py.print_text(args: Any, options: Tuple(Any, Any, Any)) -> Text
kernel 1
charge sum(8, deep(args), deep(options), size(result))
body {
  let sep = options[0]
  let end = options[1]
  let flush = options[2]
  if same(sep, absent) { set sep = " " }
  if same(sep, null) { set sep = " " }
  if same(end, absent) { set end = "\n" }
  if same(end, null) { set end = "\n" }
  if bool.not(same(kind(sep), "text")) { do invoke py.fail("TypeError", "sep must be None or a string") }
  if bool.not(same(kind(end), "text")) { do invoke py.fail("TypeError", "end must be None or a string") }
  let shown = invoke py.show(args, sep)
  if same(end, "\n") { return shown }
  return text.concat(shown, end)
}
