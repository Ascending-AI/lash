  }
  return invoke py.getitem(target, index)
}

function py.list_setitem(target: List(Any), index: Int, value: Any) -> Null
kernel 1
charge sum(6, deep(index))
body {
  let length = list.len(target)
  let position = invoke py.index(index, length, "list", " assignment")
  set target[position] = value
  return null
