use tuple.contains
use tuple.values
use map.len
use map.contains
use map.keys
use map.copy
use record.contains
use record.len
use record.keys
use set.len
use set.contains
use set.keys
use set.copy
use py.exc.name
use py.exc.args
use py.exc.check_cause
use py.float_text
