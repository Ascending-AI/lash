function py.getitem(target: Any, index: Any) -> Any
kernel 1
charge sum(6, deep(index))
body {
  let iterator_token = invoke py.token(target, "py.iterator")
  if iterator_token { do invoke py.fail("TypeError", "iterator is not a sequence") }
  let callable_token = invoke py.token(target, "py.function")
  let slice_token = invoke py.token(target, "py.slice")
  if callable_token { do invoke py.fail("TypeError", "function is not a container") }
  if slice_token { do invoke py.fail("TypeError", "slice is not a container") }

  if same(kind(index), "tuple") {
    if eq(tuple.len(index), 4) {
      if same(index[0], "py.slice") {
        let sliced = invoke py.slice(target, index[1], index[2], index[3])
        return sliced
      }
    }
  }
  let k = kind(target)
  if same(k, "bytes") {
    let length = invoke py.bytes_len(target)
    let position = invoke py.index(index, length, "bytes", "")
    return bytes.at(target, position)
  }
  let mapping = same(k, "map")
  if same(k, "record") {
    if invoke py.sealed(target) {} else { set mapping = true }
  }
  if mapping {
    let present = false
    if same(k, "map") {
      set present = map.contains(target, index)
    } else {
      if same(kind(index), "text") {
        set present = record.contains(target, index)
      }
    }
    if present {
      return target[index]
    }
    let shown = invoke py.repr(index)
    throw error.new("KeyError", shown, ((index,), null))
  }
  if same(k, "list") {
    let hoisted10 = list.len(target)
    let position = invoke py.index(index, hoisted10, "list", "")
    return target[position]
  }
  if same(k, "tuple") {
    let hoisted11 = tuple.len(target)
    let position = invoke py.index(index, hoisted11, "tuple", "")
    return target[position]
  }
  if same(k, "text") {
    let hoisted12 = text.len(target)
    let position = invoke py.index(index, hoisted12, "string", "")
    return text.get(target, position)
  }
  let name = invoke py.type(target)
  let hoisted13 = text.join(["'", name, "' object is not subscriptable"], "")
  do invoke py.fail("TypeError", hoisted13)
  return null
}


function py.length(value: Any) -> Int
kernel 1
charge 4
body {
  let iterator_token = invoke py.token(value, "py.iterator")
  if iterator_token { do invoke py.fail("TypeError", "iterator is not a sequence") }
  let callable_token = invoke py.token(value, "py.function")
  let slice_token = invoke py.token(value, "py.slice")
  if callable_token { do invoke py.fail("TypeError", "function is not a container") }
  if slice_token { do invoke py.fail("TypeError", "slice is not a container") }

  let k = kind(value)
  if same(k, "bytes") { return invoke py.bytes_len(value) }
  if same(k, "list") {
    return list.len(value)
  }
  if same(k, "text") {
    return text.len(value)
  }
  if same(k, "map") {
    return map.len(value)
  }
  if same(k, "record") {
    if bool.not(invoke py.sealed(value)) {
      return record.len(value)
    }
  }
  if same(k, "tuple") {
    return tuple.len(value)
  }
  if same(k, "set") {
    return set.len(value)
  }
  let name = invoke py.type(value)
  let hoisted19 = text.join(["object of type '", name, "' has no len()"], "")
  do invoke py.fail("TypeError", hoisted19)
  return 0
}

# `for`'s protocol (`K-ITER-005`): what a loop walks of a value. A list, a
# tuple, a dict, a set and a str are walked live by the loop's own cursor, a
# str by code point; a record by a snapshot of its keys, unless it holds a
# brand: a package value is not iterable.
function py.for_in.open(value: Any) -> Any
kernel 1
charge 4
body {
  let callable_token = invoke py.token(value, "py.function")
  let slice_token = invoke py.token(value, "py.slice")
  if callable_token { do invoke py.fail("TypeError", "function is not a container") }
  if slice_token { do invoke py.fail("TypeError", "slice is not a container") }

  if same(kind(value), "tuple") {
    if eq(tuple.len(value), 3) { if same(value[0], "py.iterator") { return {iterator: value} } }
  }
  let k = kind(value)
  if same(k, "bytes") { return invoke py.bytes_items(value) }
  if same(k, "record") {
    if bool.not(invoke py.sealed(value)) {
      return record.keys(value)
    }
  }
  for walked in ["list", "tuple", "map", "set", "text"] {
    if same(k, walked) {
      return value
    }
  }
  let name = invoke py.type(value)
  let message = text.join(["'", name, "' object is not iterable"], "")
  do invoke py.fail("TypeError", message)
  return null
}

# A dict or a set walked by a loop is checked before each step and at
# exhaustion against `size`, its size when the loop opened it. A dict also
# spends one of its `remaining` entries per step it finds one, and refuses
# an entry it did not expect, as CPython's iterator does (FIG-6406). Gives
# what remains.
function py.for_in.check(value: Any, size: Int, remaining: Int, more: Bool) -> Int
kernel 1
charge 4
body {
  if same(kind(value), "map") {
    if bool.not(eq(map.len(value), size)) {
      do invoke py.fail("RuntimeError", "dictionary changed size during iteration")
    }
    if more {
      if eq(remaining, 0) {
        do invoke py.fail("RuntimeError", "dictionary keys changed during iteration")
      }
      return sub(remaining, 1)
    }
    return remaining
  }
  if bool.not(eq(set.len(value), size)) {
    do invoke py.fail("RuntimeError", "Set changed size during iteration")
  }
  return remaining
}

function py.to_tuple(value: Any) -> Any
kernel 1
charge sum(4, product(size(value), size(value)))
body {
  let callable_token = invoke py.token(value, "py.function")
  let slice_token = invoke py.token(value, "py.slice")
  if callable_token { do invoke py.fail("TypeError", "function is not a container") }
  if slice_token { do invoke py.fail("TypeError", "slice is not a container") }

  let iterator_token = invoke py.token(value, "py.iterator")
  if bool.not(iterator_token) { if same(kind(value), "tuple") {
    return value
  } }
  let items = invoke py.to_list(value)
  let out = ()
  for item in items {
    set out = tuple.concat(out, (item,))
  }
  return out
}

function py.to_set(value: Any) -> Set(Any)
kernel 1
charge sum(4, size(value), size(result))
body {
  if same(kind(value), "set") {
    return set.copy(value)
  }
  let items = invoke py.to_list(value)
  let out = set{}
  for item in items {
    set out[item] = true
  }
  return out
}

# `dict(value)`: a copy of a dict, or a dict of key and value pairs. A
# package value is no dict and, by `py.to_list`, not iterable.
function py.to_dict(value: Any) -> Map(Any, Any)
kernel 1
charge sum(4, size(value), size(result))
body {
  if same(kind(value), "map") {
    return map.copy(value)
  }
  let items = invoke py.to_list(value)
  let out = map{}
  for item in items {
    let pair = invoke py.to_list(item)
    if bool.not(eq(list.len(pair), 2)) {
      do invoke py.fail("ValueError", "dictionary update sequence element has the wrong length; 2 is required")
    }
    set out[pair[0]] = pair[1]
  }
  return out
}

# A tool's reply as Python reads it, as `json.loads` gives it: the JSON
# reaches the machine with every object a record, and an object is a dict
# here, at every depth.
function py.reply(value: Any) -> Any
kernel 1
charge sum(4, deep(value))
body {
  let go = absent
  set go = fn(v) {
    let k = kind(v)
    # A package value stays one: sealed, it is no dict.
    if same(k, "record") {
      if invoke py.sealed(v) {
        return v
      }
      let out = map{}
      let keys = record.keys(v)
      for key in keys {
        let item = v[key]
        let converted = apply go(item)
        set out[key] = converted
      }
      return out
    }
    if same(k, "list") {
      let out = []
      for item in v {
        let converted = apply go(item)
        set out[list.len(out)] = converted
      }
      return out
    }
    return v
  }
  let out = apply go(value)
  return out
}

# The `count` values an unpacking assignment takes from `value`.
function py.unpack(value: Any, count: Int) -> Any
kernel 1
charge sum(4, size(value))
body {
  let items = value
  let k = kind(value)
  let length = 0
  if same(k, "tuple") {
    set length = tuple.len(value)
  } else {
    if same(k, "list") {
      set length = list.len(value)
    } else {
      set items = invoke py.to_list(value)
      set length = list.len(items)
    }
  }
  if lt(count, length) {
    let hoisted22 = text.join(["too many values to unpack (expected ", num.to_text(count), ")"], "")
    do invoke py.fail("ValueError", hoisted22)
  }
  if lt(length, count) {
    let hoisted23 = text.join(["not enough values to unpack (expected ", num.to_text(count), ", got ", num.to_text(length), ")"], "")
    do invoke py.fail("ValueError", hoisted23)
  }
  return items
}

# time.time exposes seconds; its ordinary operation returns a Timestamp.
function py.time() -> Float
kernel 1
charge 6
body {
  let instant = perform python.clock() as Timestamp
  return num.div(num.to_float(timestamp.nanoseconds(instant)), 1000000000.0)
}

# Operation records are transported independently of Python's mutable dict.
# Preserve the original mapping and its values, including callable tokens.
function py.operation_input(value: Any) -> Any
kernel 1
metering statements
body {
  if same(kind(value), "map") {
    let out = {}
    for key in value {
      if same(kind(key), "text") {} else { return value }
      set out[key] = value[key]
    }
    return out
  }
  return value
}

# Private marker records cannot be constructed by Python container syntax.
function py.ellipsis() -> Any
kernel 1
charge 2
body { return {__py_ellipsis: true} }

# Each step consumes one bit and is priced by the primitive integer work.
# Sign extension terminates at 0/-1, retaining exact two's-complement semantics.
function py.bitwise(operator: Text, left: Any, right: Any) -> Any
kernel 1
charge sum(8, product(64, product(sum(size(left), size(right)), sum(size(left), size(right)))))
body {
  if same(kind(left), "set") { return invoke py.set_op(operator, left, right) }
  if same(kind(left), "bool") {
    if same(kind(right), "bool") {
      if same(operator, "|") { if left { return true } return right }
      if same(operator, "&") { if left { return right } return false }
      return bool.not(same(left, right))
    }
  }
  if same(kind(left), "bool") { if left { set left = 1 } else { set left = 0 } }
  if same(kind(right), "bool") { if right { set right = 1 } else { set right = 0 } }
  if bool.not(same(kind(left), "integer")) { do invoke py.operand_error(operator, left, right) }
  if bool.not(same(kind(right), "integer")) { do invoke py.operand_error(operator, left, right) }
  let out = 0
  let place = 1
  while true metered 4 {
    let a = rem_floor(left, 2)
    let b = rem_floor(right, 2)
    let bit = mul(a, b)
    if same(operator, "|") { if lt(0, add(a, b)) { set bit = 1 } }
    if same(operator, "^") { set bit = rem_floor(add(a, b), 2) }
    let final = le(-1, left)
    if final { set final = le(left, 0) }
    if final { set final = le(-1, right) }
    if final { set final = le(right, 0) }
    if final {
      if eq(bit, 1) { return sub(out, place) }
      return out
    }
    set out = add(out, mul(bit, place))
    set place = mul(place, 2)
    set left = div_floor(left, 2)
    set right = div_floor(right, 2)
  }
}

function py.invert(value: Any) -> Int
kernel 1
charge sum(4, size(value))
body {
  if same(kind(value), "bool") { if value { return -2 } return -1 }
  if bool.not(same(kind(value), "integer")) { do invoke py.fail("TypeError", "bad operand type for unary ~") }
  return sub(neg(value), 1)
}

# Left shifts use integer_pow's reservation before amplified allocation;
# right shifts stop at sign extension without building a huge power of two.
function py.shift(operator: Text, value: Any, count: Any) -> Int
kernel 1
charge sum(8, size(result), product(size(value), size(result)), product(64, product(sum(size(value), size(count)), sum(size(value), size(count)))))
body {
  if same(kind(value), "bool") { if value { set value = 1 } else { set value = 0 } }
  if same(kind(count), "bool") { if count { set count = 1 } else { set count = 0 } }
  if bool.not(same(kind(value), "integer")) { do invoke py.operand_error(operator, value, count) }
  if bool.not(same(kind(count), "integer")) { do invoke py.operand_error(operator, value, count) }
  if lt(count, 0) { do invoke py.fail("ValueError", "negative shift count") }
  if eq(value, 0) { return 0 }
  if same(operator, "<<") { return mul(value, pow(2, count)) }
  while lt(0, count) metered 2 {
    if eq(value, 0) { return 0 }
    if eq(value, -1) { return -1 }
    set value = div_floor(value, 2)
    set count = sub(count, 1)
  }
  return value
}

function py.bytes_len(value: Bytes) -> Int
kernel 1
charge sum(4, size(value))
native
body {
  let length = 0
  # Bytes are immutable: at most one read per byte and the terminating index
  # error. The completion formula covers this callback-free scan.
  while true {
    try { do bytes.at(value, length) } catch problem {
      if same(problem.kind, "index") { return length }
      throw problem
    }
    set length = add(length, 1)
  }
}

function py.bytes_items(value: Bytes) -> List(Int)
kernel 1
charge sum(4, size(value), size(result))
body {
  let length = invoke py.bytes_len(value)
  let items = []
  let i = 0
  while lt(i, length) metered 2 {
    set items[i] = bytes.at(value, i)
    set i = add(i, 1)
  }
  return items
}

function py.bytes_repr(value: Bytes) -> Text
kernel 1
charge sum(8, size(value), size(result))
body {
  let items = invoke py.bytes_items(value)
  let quote = "'"
  if list.contains(items, 39) { if bool.not(list.contains(items, 34)) { set quote = "\"" } }
  let parts = ["b", quote]
  for point in items {
    let shown = ""
    if eq(point, 9) { set shown = "\\t" } else {
    if eq(point, 10) { set shown = "\\n" } else {
    if eq(point, 13) { set shown = "\\r" } else {
    if eq(point, 92) { set shown = "\\\\" } else {
    if le(32, point) {
      if lt(point, 127) { set shown = text.from_code_points([point]) }
    }
    if same(shown, "") {
      let digits = int.to_text(point, 16)
      if lt(point, 16) { set digits = text.concat("0", digits) }
      set shown = text.concat("\\x", digits)
    } else { if same(shown, quote) { set shown = text.concat("\\", shown) } }
    } } } }
    set parts[list.len(parts)] = shown
  }
  set parts[list.len(parts)] = quote
  return text.join(parts, "")
}

function py.bytes(value?: Any, encoding?: Any, error_policy?: Any) -> Bytes
kernel 1
charge sum(6, deep(value), size(result))
body {
  if same(value, absent) { return b"" }
  if bool.not(same(encoding, absent)) {
    if bool.not(same(kind(value), "text")) { do invoke py.fail("TypeError", "encoding without a string argument") }
    if bool.not(same(encoding, "utf-8")) {
      if bool.not(same(encoding, "utf8")) { do invoke py.fail("LookupError", "unknown encoding") }
    }
    if bool.not(same(error_policy, absent)) { if bool.not(same(error_policy, "strict")) { do invoke py.fail("ValueError", "unsupported encoding error handler") } }
    return bytes.utf8_encode(value)
  }
  if same(kind(value), "bytes") { return value }
  if same(kind(value), "integer") {
    if lt(value, 0) { do invoke py.fail("ValueError", "negative count") }
    return bytes.utf8_encode(text.repeat("\u{0}", value))
  }
  let items = invoke py.to_list(value)
  for item in items {
    if bool.not(same(kind(item), "integer")) { do invoke py.fail("TypeError", "an integer is required") }
    if lt(item, 0) { do invoke py.fail("ValueError", "bytes must be in range(0, 256)") }
    if le(256, item) { do invoke py.fail("ValueError", "bytes must be in range(0, 256)") }
  }
  return bytes.from_octets(items)
}

# These private helper records and package values never expose record internals.
function py.sealed(value: Any) -> Bool
kernel 1
charge 4
body {
  if bool.not(same(kind(value), "record")) { return false }
  if record.contains(value, "__lash_brand") { return true }
  if record.contains(value, "__py_ellipsis") { return true }
  return record.contains(value, "__py_module")
}

# A lossless byte projection used only by octet algorithms, never by decode().
function py.bytes_text(value: Bytes) -> Text
kernel 1
charge sum(8, size(value), size(result))
body {
  let points = invoke py.bytes_items(value)
  return text.from_code_points(points)
}
