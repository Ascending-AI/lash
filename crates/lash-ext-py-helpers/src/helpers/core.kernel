function py.token(value: Any, tag: Text) -> Bool
kernel 1
charge 4
body {
  if same(kind(value), "tuple") {
    if lt(0, tuple.len(value)) { return same(value[0], tag) }
  }
  return false
}

# The Python class name of a raised value. A kernel operation's own error
# kind is the Python exception a program would catch it as.
function py.exc.name(value: Any) -> Text
kernel 1
charge 6
native
body {
  if bool.not(same(kind(value), "error")) {
    return "Exception"
  }
  let kinds = map{"type_error": "TypeError", "unbound_variable": "NameError", "index_out_of_range": "IndexError", "key_missing": "KeyError", "invalid_key": "TypeError", "division_by_zero": "ZeroDivisionError", "number_range": "OverflowError", "unordered": "ValueError", "text_boundary": "ValueError", "arity": "TypeError", "cycle": "ValueError", "cyclic_value": "ValueError", "not_data": "TypeError", "effect_result": "TypeError", "cancelled": "CancelledError", "join_self": "RuntimeError", "empty_join": "ValueError", "all_failed": "RuntimeError", "too_deep": "RecursionError", "number_parse": "ValueError", "zero_step": "ValueError", "invalid_scalar": "ValueError", "invalid_utf16": "ValueError", "invalid_utf8": "ValueError", "json_syntax": "ValueError", "json_depth": "ValueError", "json_number": "ValueError", "json_key": "TypeError"}
  let name = value.kind
  if map.contains(kinds, name) {
    return kinds[name]
  }
  return name
}

# `e.args`: the arguments the exception was made with, or its message alone
# for an error no `raise` of this dialect made.
function py.exc.args(value: Error) -> Any
kernel 1
charge 6
body {
  let data = value.data
  if same(kind(data), "tuple") {
    if eq(tuple.len(data), 2) {
      if same(kind(data[0]), "tuple") {
        return data[0]
      }
    }
  }
  return (value.message,)
}

# `repr` of a float: the kernel's shortest digits, with Python's exponent
# (`1e+16`, `1.5e-05`).
function py.float_text(value: Float) -> Text
kernel 1
charge 8
body {
  let parts = format.decimal_parts(value)
  let kind = parts[0]
  if same(kind, "nan") { return "nan" }
  let sign = ""
  if parts[1] { set sign = "-" }
  if same(kind, "infinity") { return text.concat(sign, "inf") }
  let digits = parts[2]
  let point = add(text.len(digits), parts[3])
  if lt(point, -3) {} else {
    if lt(16, point) {} else {
      if le(point, 0) {
        return text.join([sign, "0.", text.repeat("0", num.neg(point)), digits], "")
      }
      if le(text.len(digits), point) {
        return text.join([sign, digits, text.repeat("0", sub(point, text.len(digits))), ".0"], "")
      }
      return text.join([sign, text.slice(digits, 0, point), ".", text.slice(digits, point, text.len(digits))], "")
    }
  }
  let mantissa = text.slice(digits, 0, 1)
  if lt(1, text.len(digits)) {
    set mantissa = text.join([mantissa, ".", text.slice(digits, 1, text.len(digits))], "")
  }
  let exponent = sub(point, 1)
  let exponent_sign = "+"
  if lt(exponent, 0) { set exponent_sign = "-" }
  let exponent_digits = int.to_text(abs(exponent), 10)
  if lt(text.len(exponent_digits), 2) { set exponent_digits = text.concat("0", exponent_digits) }
  return text.join([sign, mantissa, "e", exponent_sign, exponent_digits], "")
}

# `repr` escapes non-printable scalars, using the smallest of x/u/U,
# and chooses the quote that needs the fewest escapes.
function py.text_repr(value: Text) -> Text
kernel 1
charge sum(8, product(32, size(value)), product(2, size(result)))
native
body {
  let quote = "'"
  if le(0, text.find(value, "'", 0)) {
    if lt(text.find(value, "\"", 0), 0) { set quote = "\"" }
  }
  let parts = [quote]
  for point in text.to_code_points(value) {
    let character = text.from_code_points([point])
    let escaped = character
    if same(character, "\\") { set escaped = "\\\\" } else {
      if same(character, quote) { set escaped = text.concat("\\", quote) } else {
        if same(point, 9) { set escaped = "\\t" } else {
          if same(point, 10) { set escaped = "\\n" } else {
            if same(point, 13) { set escaped = "\\r" } else {
              let printable = invoke py.text.printable(point)
              if bool.not(printable) {
                let prefix = "\\x"
                let width = 2
                if le(256, point) { set prefix = "\\u"
                  set width = 4 }
                if le(65536, point) { set prefix = "\\U"
                  set width = 8 }
                let digits = int.to_text(point, 16)
                set escaped = text.join([prefix, text.repeat("0", sub(width, text.len(digits))), digits], "")
              }
            }
          }
        }
      }
    }
    set parts[list.len(parts)] = escaped
  }
  set parts[list.len(parts)] = quote
  return text.join(parts, "")
}

# `type(value).__name__`. A package value's class is its type, as Python
# spells a class (`DataQuanta`); a record that holds a malformed brand is a
# `record`. The result's size covers the letters a class name keeps, and
# the loop's continuation charge each `_` it drops.
function py.type(value: Any) -> Text
kernel 1
charge sum(8, size(result))
native
body {
  if same(kind(value), "tuple") {
    if eq(tuple.len(value), 5) { if same(value[0], "py.function") {
      if same(kind(value[4]), "tuple") {
        if same(value[4][0], "py.type") { return "type" }
        if same(value[4][0], "py.exception") { return "type" }
      }
      return "function"
    } }
    if eq(tuple.len(value), 3) { if same(value[0], "py.iterator") { return "iterator" } }
    if eq(tuple.len(value), 4) { if same(value[0], "py.slice") { return "slice" } }
  }
  let k = kind(value)
  if same(k, "record") {
    if record.contains(value, "__py_ellipsis") { return "ellipsis" }
    if record.contains(value, "__py_module") { return "module" }
    let brand = invoke brand.of(value)
    if same(brand, absent) {
      return k
    }
    let parts = []
    for part in text.split(brand[1], "_") metered 2 {
      let head = text.upper_u17_0_0(text.slice(part, 0, 1))
      set parts[list.len(parts)] = text.concat(head, text.slice(part, 1, text.len(part)))
    }
    return text.join(parts, "")
  }
  if same(k, "null") {
    return "NoneType"
  }
  if same(k, "integer") {
    return "int"
  }
  if same(k, "text") {
    return "str"
  }
  if same(k, "map") {
    return "dict"
  }
  if same(k, "closure") {
    return "function"
  }
  if same(k, "task") {
    return "Task"
  }
  if same(k, "error") {
    let name = invoke py.exc.name(value)
    return name
  }
  return k
}

function py.repr(value: Any) -> Text
kernel 1
charge sum(8, deep(value), size(result))
body {
  let go = absent
  set go = fn(v) {
    let k = kind(v)
    if same(k, "null") {
      return "None"
    }
    if same(k, "bool") {
      if v {
        return "True"
      }
      return "False"
    }
    if same(k, "integer") {
      return num.to_text(v)
    }
    if same(k, "float") {
      let shown = invoke py.float_text(v)
      return shown
    }
    if same(k, "text") {
      let shown = invoke py.text_repr(v)
      return shown
    }
    if same(k, "bytes") { return invoke py.bytes_repr(v) }
    if same(k, "record") {
      if record.contains(v, "__py_ellipsis") { return "Ellipsis" }
      if record.contains(v, "__py_module") { return text.join(["<module '", v.__py_module, "'>"], "") }
    }
    let parts = []
    if same(k, "error") {
      let name = invoke py.exc.name(v)
      let args = invoke py.exc.args(v)
      for item in args {
        let part = apply go(item)
        set parts[list.len(parts)] = part
      }
      return text.join([name, "(", text.join(parts, ", "), ")"], "")
    }
    if same(k, "list") {
      for item in v {
        let part = apply go(item)
        set parts[list.len(parts)] = part
      }
      return text.join(["[", text.join(parts, ", "), "]"], "")
    }
    if same(k, "tuple") {
      if eq(tuple.len(v), 5) {
        if same(v[0], "py.function") {
          if same(kind(v[4]), "tuple") {
            if same(v[4][0], "py.type") { return text.join(["<class '", v[3], "'>"], "") }
            if same(v[4][0], "py.exception") { return text.join(["<class '", v[3], "'>"], "") }
          }
          if same(v[4], "py.builtin") { return text.join(["<built-in function ", v[3], ">"], "") }
          return text.join(["<function ", v[3], ">"], "")
        }
      }
      if eq(tuple.len(v), 3) { if same(v[0], "py.iterator") { return "<iterator>" } }
      if eq(tuple.len(v), 4) { if same(v[0], "py.slice") {
        let start = apply go(v[1])
        let stop = apply go(v[2])
        let step = apply go(v[3])
        return text.join(["slice(", start, ", ", stop, ", ", step, ")"], "")
      } }

      for item in v {
        let part = apply go(item)
        set parts[list.len(parts)] = part
      }
      if eq(tuple.len(v), 1) {
        return text.join(["(", parts[0], ",)"], "")
      }
      return text.join(["(", text.join(parts, ", "), ")"], "")
    }
    if same(k, "set") {
      if eq(set.len(v), 0) {
        return "set()"
      }
      for item in v {
        let part = apply go(item)
        set parts[list.len(parts)] = part
      }
      return text.join(["{", text.join(parts, ", "), "}"], "")
    }
    if same(k, "map") {
      for key in v {
        let shown_key = apply go(key)
        let item = v[key]
        let shown_item = apply go(item)
        set parts[list.len(parts)] = text.join([shown_key, ": ", shown_item], "")
      }
      return text.join(["{", text.join(parts, ", "), "}"], "")
    }
    if same(k, "closure") {
      return "<function>"
    }
    if same(k, "task") {
      return "<Task>"
    }
    # A package value shows its type, never its fields.
    if same(k, "record") {
      let brand = invoke brand.of(v)
      if bool.not(same(brand, absent)) {
        let name = invoke py.type(v)
        return text.join(["<", brand[0], ".", name, ">"], "")
      }
    }
    return text.join(["<", k, ">"], "")
  }
  let shown = apply go(value)
  return shown
}

function py.str(value: Any) -> Text
kernel 1
charge sum(8, deep(value), size(result))
body {
  let k = kind(value)
  if same(k, "text") {
    return value
  }
  # An integer's text is its repr, spelled without the repr's closure.
  if same(k, "integer") {
    return num.to_text(value)
  }
  if same(k, "error") {
    return value.message
  }
  let shown = invoke py.repr(value)
  return shown
}

# Raises an exception of class `name` made with the one argument `message`.
function py.fail(name: Text, message: Text) -> Any
kernel 1
charge 4
native
body {
  throw error.new(name, message, ((message,), null))
}

# The cause of `raise ... from cause`: an exception or None.
function py.exc.check_cause(cause: Any) -> Null
kernel 1
charge 4
body {
  if same(cause, null) {
    return null
  }
  if bool.not(same(kind(cause), "error")) {
    do invoke py.fail("TypeError", "exception causes must derive from BaseException")
  }
  return null
}

# A new exception of class `name` made with `args`. `str(e)` is its
# message: the one argument as `str` gives it, or as `repr` does for
# KeyError and its subclasses (`quoted`).
function py.exc.new(name: Text, args: Any, cause: Any, quoted: Bool) -> Error
kernel 1
charge sum(8, deep(args))
body {
  do invoke py.exc.check_cause(cause)
  let count = tuple.len(args)
  let message = ""
  if eq(count, 1) {
    let only = args[0]
    if quoted {
      set message = invoke py.repr(only)
    } else {
      set message = invoke py.str(only)
    }
  } else {
    if lt(1, count) {
      set message = invoke py.repr(args)
    }
  }
  return error.new(name, message, (args, cause))
}

# `e.__cause__`.
function py.exc.cause(value: Error) -> Any
kernel 1
charge 6
body {
  let data = value.data
  if same(kind(data), "tuple") {
    if eq(tuple.len(data), 2) {
      if same(kind(data[0]), "tuple") {
        return data[1]
      }
    }
  }
  return null
}

# `raise value from cause`, for a value that is already an exception.
function py.exc.with_cause(value: Any, cause: Any) -> Error
kernel 1
charge 8
body {
  if bool.not(same(kind(value), "error")) {
    do invoke py.fail("TypeError", "exceptions must derive from BaseException")
  }
  do invoke py.exc.check_cause(cause)
  let args = invoke py.exc.args(value)
  return error.new(value.kind, value.message, (args, cause))
}

# Whether a raised value is an instance of one of the classes `names`,
# which the lowerer writes out with every subclass it knows.
function py.exc.matches(value: Any, names: Any) -> Bool
kernel 1
charge sum(6, size(names))
body {
  let name = invoke py.exc.name(value)
  return tuple.contains(names, name)
}

# Whether `except (Exception, *also)` takes a raised value: everything but
# a cancellation and the exits Python keeps outside `Exception`, and of
# those the classes `also` names.
function py.exc.is_exception(value: Any, also: Any) -> Bool
kernel 1
charge sum(8, size(also))
body {
  let name = invoke py.exc.name(value)
  if tuple.contains(also, name) {
    return true
  }
  return bool.not(tuple.contains(("CancelledError", "KeyboardInterrupt", "SystemExit", "GeneratorExit"), name))
}

# A bare `raise` where the exception being handled is known only when it
# runs: in a function a handler called, or in a `finally`.
function py.exc.reraise(active: Any) -> Any
kernel 1
charge 4
body {
  if same(active, absent) {
    do invoke py.fail("RuntimeError", "No active exception to reraise")
  }
  throw active
}

# `raise value`.
function py.exc.throw(value: Any) -> Any
kernel 1
charge 4
body {
  if same(kind(value), "error") {
    throw value
  }
  do invoke py.fail("TypeError", "exceptions must derive from BaseException")
  return null
}

# A read of a variable that may not be bound yet.
function py.name_check(value: Any, name: Text, local: Bool) -> Any
kernel 1
charge 2
body {
  if same(value, absent) {
    if local {
      let hoisted1 = text.join(["cannot access local variable '", name, "' where it is not associated with a value"], "")
      do invoke py.fail("UnboundLocalError", hoisted1)
    }
    let hoisted2 = text.join(["name '", name, "' is not defined"], "")
    do invoke py.fail("NameError", hoisted2)
  }
  return value
}

# A call that left a parameter without a default unfilled.
function py.arg_missing(callee: Text) -> Any
kernel 1
charge 2
body {
  let hoisted3 = text.concat(callee, "() missing a required positional argument")
  do invoke py.fail("TypeError", hoisted3)
  return null
}

function py.is_number(value: Any) -> Bool
kernel 1
charge 2
body {
  let k = kind(value)
  if same(k, "integer") {
    return true
  }
  return same(k, "float")
}

function py.operand_error(operator: Text, left: Any, right: Any) -> Any
kernel 1
charge 8
native
body {
  let left_type = invoke py.type(left)
  let right_type = invoke py.type(right)
  let hoisted4 = text.join(["unsupported operand type(s) for ", operator, ": '", left_type, "' and '", right_type, "'"], "")
  do invoke py.fail("TypeError", hoisted4)
  return null
}

function py.truth(value: Any) -> Bool
kernel 1
charge 4
native 2
body {
  let k = kind(value)
  if same(k, "bool") {
    return value
  }
  if same(k, "null") {
    return false
  }
  if same(k, "integer") {
    return bool.not(eq(value, 0))
  }
  if same(k, "float") {
    return bool.not(eq(value, 0))
  }
  if same(k, "text") {
    return bool.not(same(value, ""))
  }
  if same(k, "bytes") { return bool.not(same(value, b"")) }
  if same(k, "list") {
    return lt(0, list.len(value))
  }
  if same(k, "tuple") {
    return lt(0, tuple.len(value))
  }
  if same(k, "map") {
    return lt(0, map.len(value))
  }
  if same(k, "record") {
    return lt(0, record.len(value))
  }
  if same(k, "set") {
    return lt(0, set.len(value))
  }
  return true
}

# Cache each operand's kind once. Integer arithmetic calls the numeric
# native directly, which also handles promotion beyond the inline range.
function py.add(left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), size(right))
native 2
body {
  let k = kind(left)
  let r = kind(right)
  if same(k, "integer") {
    if same(r, "integer") {
      return add(left, right)
    }
    if same(r, "float") {
      return add(left, right)
    }
  }
  if same(k, "float") {
    if same(r, "integer") {
      return add(left, right)
    }
    if same(r, "float") {
      return add(left, right)
    }
  }
  if same(k, r) {
    if same(k, "bytes") { return bytes.concat(left, right) }
    if same(k, "text") {
      return text.concat(left, right)
    }
    if same(k, "list") {
      return list.concat(left, right)
    }
    if same(k, "tuple") {
      return tuple.concat(left, right)
    }
  }
  do invoke py.operand_error("+", left, right)
  return null
}

# `list(value)`: a new list of what iterating `value` gives.
function py.to_list(value: Any) -> List(Any)
kernel 1
charge sum(4, size(value), size(result))
body {
  let callable_token = invoke py.token(value, "py.function")
  let slice_token = invoke py.token(value, "py.slice")
  if callable_token { do invoke py.fail("TypeError", "function is not a container") }
  if slice_token { do invoke py.fail("TypeError", "slice is not a container") }

  let k = kind(value)
  if same(k, "tuple") {
    if eq(tuple.len(value), 3) {
      if same(value[0], "py.iterator") {
        let out = []
        let next = value[2]
        while true metered 2 {
          let item = apply next(value[1])
          if eq(tuple.len(item), 0) { break }
          set out[list.len(out)] = item[0]
        }
        return out
      }
    }
  }
  if same(k, "list") {
    return list.copy(value)
  }
  if same(k, "tuple") {
    return tuple.values(value)
  }
  if same(k, "map") {
    return map.keys(value)
  }
  if same(k, "record") {
    if bool.not(invoke py.sealed(value)) {
      return record.keys(value)
    }
  }
  if same(k, "set") {
    return set.keys(value)
  }
  if same(k, "text") {
    return text.split(value, "")
  }
  if same(k, "bytes") { return invoke py.bytes_items(value) }
  let name = invoke py.type(value)
  let hoisted21 = text.join(["'", name, "' object is not iterable"], "")
  do invoke py.fail("TypeError", hoisted21)
  return []
}

# `left += right`: a list is extended in place, so its aliases see it.
function py.iadd(left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), size(right))
body {
  let k = kind(left)
  if same(k, "integer") {
    let r = kind(right)
    if same(r, "integer") {
      return add(left, right)
    }
    if same(r, "float") {
      return add(left, right)
    }
    do invoke py.operand_error("+", left, right)
    return null
  }
  if same(k, "list") {
    let items = invoke py.to_list(right)
    for item in items {
      set left[list.len(left)] = item
    }
    return left
  }
  let r = kind(right)
  if same(k, "float") {
    if same(r, "integer") {
      return add(left, right)
    }
    if same(r, "float") {
      return add(left, right)
    }
  }
  if same(k, r) {
    if same(k, "bytes") { return bytes.concat(left, right) }
    if same(k, "text") {
      return text.concat(left, right)
    }
    if same(k, "tuple") {
      return tuple.concat(left, right)
    }
  }
  do invoke py.operand_error("+", left, right)
  return null
}

function py.sub(left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), size(right))
body {
  let k = kind(left)
  let r = kind(right)
  if same(k, "integer") {
    if same(r, "integer") {
      return sub(left, right)
    }
    if same(r, "float") {
      return sub(left, right)
    }
  }
  if same(k, "float") {
    if same(r, "integer") {
      return sub(left, right)
    }
    if same(r, "float") {
      return sub(left, right)
    }
  }
  if same(k, "set") {
    if same(r, "set") {
      let out = set{}
      for member in left {
        if bool.not(set.contains(right, member)) {
          set out[member] = true
        }
      }
      return out
    }
  }
  do invoke py.operand_error("-", left, right)
  return null
}

function py.mul(left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), size(right), size(result))
body {
  let left_number = invoke py.is_number(left)
  let right_number = invoke py.is_number(right)
  if left_number {
    if right_number {
      return mul(left, right)
    }
  }
  let sequence = left
  let count = right
  if same(kind(left), "integer") {
    set sequence = right
    set count = left
  }
  let k = kind(sequence)
  if same(kind(count), "integer") {
    if lt(count, 0) {
      set count = 0
    }
    if same(k, "bytes") {
      let out = b""
      let round = 0
      while lt(round, count) metered 2 {
        set out = bytes.concat(out, sequence)
        set round = add(round, 1)
      }
      return out
    }
    if same(k, "text") {
      return text.repeat(sequence, count)
    }
    if same(k, "list") {
      let out = []
      let round = 0
      while lt(round, count) metered 2 {
        for item in sequence {
          set out[list.len(out)] = item
        }
        set round = add(round, 1)
      }
      return out
    }
    if same(k, "tuple") {
      let out = ()
      let round = 0
      while lt(round, count) metered 2 {
        set out = tuple.concat(out, sequence)
        set round = add(round, 1)
      }
      return out
    }
  }
  do invoke py.operand_error("*", left, right)
  return null
}

function py.truediv(left: Any, right: Any) -> Float
kernel 1
charge sum(4, size(left), size(right))
body {
  let ok = invoke py.is_number(left)
  if ok {
    set ok = invoke py.is_number(right)
  }
  if bool.not(ok) {
    do invoke py.operand_error("/", left, right)
  }
  if eq(right, 0) {
    if same(kind(left), "integer") {
      if same(kind(right), "integer") {
        do invoke py.fail("ZeroDivisionError", "division by zero")
      }
    }
    do invoke py.fail("ZeroDivisionError", "float division by zero")
  }
  return div(left, right)
}

function py.floordiv(left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), size(right))
body {
  let ok = invoke py.is_number(left)
  if ok {
    set ok = invoke py.is_number(right)
  }
  if bool.not(ok) {
    do invoke py.operand_error("//", left, right)
  }
  if eq(right, 0) {
    if same(kind(left), "integer") {
      if same(kind(right), "integer") {
        do invoke py.fail("ZeroDivisionError", "integer division or modulo by zero")
      }
    }
    do invoke py.fail("ZeroDivisionError", "float floor division by zero")
  }
  return div_floor(left, right)
}

function py.mod(left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), size(right))
body {
  if same(kind(left), "text") { return invoke py.percent(left, right) }
  let ok = invoke py.is_number(left)
  if ok {
    set ok = invoke py.is_number(right)
  }
  if bool.not(ok) {
    do invoke py.operand_error("%", left, right)
  }
  if eq(right, 0) {
    if same(kind(left), "integer") {
      if same(kind(right), "integer") {
        do invoke py.fail("ZeroDivisionError", "integer modulo by zero")
      }
    }
    do invoke py.fail("ZeroDivisionError", "float modulo")
  }
  return rem_floor(left, right)
}

function py.pow(left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), product(size(left), magnitude(right)))
body {
  let ok = invoke py.is_number(left)
  if ok {
    set ok = invoke py.is_number(right)
  }
  if bool.not(ok) {
    do invoke py.operand_error("** or pow()", left, right)
  }
  if lt(right, 0) {
    if eq(left, 0) {
      do invoke py.fail("ZeroDivisionError", "0.0 cannot be raised to a negative power")
    }
    if same(kind(left), "integer") {
      set left = num.to_float(left)
    }
  }
  let out = pow(left, right)
  if same(kind(out), "float") {
    if eq(out, out) {
      if bool.not(is_finite(out)) {
        if is_finite(left) {
          if is_finite(right) {
            do invoke py.fail("OverflowError", "(34, 'Numerical result out of range')")
          }
        }
      }
    } else {
      if eq(left, left) {
        if eq(right, right) {
          do invoke py.fail("ValueError", "a negative number raised to a fractional power is complex, which this dialect does not have")
        }
      }
    }
  }
  return out
}

function py.neg(value: Any) -> Any
kernel 1
charge sum(4, size(value))
body {
  let ok = invoke py.is_number(value)
  if ok {
    return neg(value)
  }
  let name = invoke py.type(value)
  let hoisted5 = text.join(["bad operand type for unary -: '", name, "'"], "")
  do invoke py.fail("TypeError", hoisted5)
  return null
}

function py.pos(value: Any) -> Any
kernel 1
charge sum(4, size(value))
body {
  let ok = invoke py.is_number(value)
  if ok {
    return value
  }
  let name = invoke py.type(value)
  let hoisted6 = text.join(["bad operand type for unary +: '", name, "'"], "")
  do invoke py.fail("TypeError", hoisted6)
  return null
}

# `|`, `&` and `^` of two sets. Integers have no bitwise operators here.
function py.set_op(operator: Text, left: Any, right: Any) -> Any
kernel 1
charge sum(4, size(left), size(right))
body {
  let ok = same(kind(left), "set")
  if ok {
    set ok = same(kind(right), "set")
  }
  if bool.not(ok) {
    do invoke py.operand_error(operator, left, right)
  }
  let out = set{}
  if same(operator, "|") {
    for member in left {
      set out[member] = true
    }
    for member in right {
      set out[member] = true
    }
    return out
  }
  if same(operator, "&") {
    for member in left {
      if set.contains(right, member) {
        set out[member] = true
      }
    }
    return out
  }
  for member in left {
    if bool.not(set.contains(right, member)) {
      set out[member] = true
    }
  }
  for member in right {
    if bool.not(set.contains(left, member)) {
      set out[member] = true
    }
  }
  return out
}

function py.contains(container: Any, item: Any) -> Bool
kernel 1
metering statements
body {
  let iterator_token = invoke py.token(container, "py.iterator")
  if iterator_token {
    while true metered 2 {
      let next = container[2]
      let step = apply next(container[1])
      if eq(tuple.len(step), 0) { return false }
      if eq(step[0], item) { return true }
    }
  }
  let callable_token = invoke py.token(container, "py.function")
  let slice_token = invoke py.token(container, "py.slice")
  if callable_token { do invoke py.fail("TypeError", "function is not a container") }
  if slice_token { do invoke py.fail("TypeError", "slice is not a container") }

  let k = kind(container)
  if same(k, "bytes") {
    let items = invoke py.bytes_items(container)
    if same(kind(item), "integer") {
      if lt(item, 0) { do invoke py.fail("ValueError", "byte must be in range(0, 256)") }
      if le(256, item) { do invoke py.fail("ValueError", "byte must be in range(0, 256)") }
      return list.contains(items, item)
    }
    if same(kind(item), "bytes") {
      let needle = invoke py.bytes_items(item)
      let i = 0
      while le(add(i, list.len(needle)), list.len(items)) metered 2 {
        if eq(list.slice(items, i, add(i, list.len(needle))), needle) { return true }
        set i = add(i, 1)
      }
      return false
    }
    do invoke py.fail("TypeError", "a bytes-like object is required")
  }
  if same(k, "list") {
    return list.contains(container, item)
  }
  if same(k, "tuple") {
    return tuple.contains(container, item)
  }
  if same(k, "map") {
    return map.contains(container, item)
  }
  if same(k, "record") {
    if invoke py.sealed(container) {
      let name = invoke py.type(container)
      let sealed = text.join(["argument of type '", name, "' is not iterable"], "")
      do invoke py.fail("TypeError", sealed)
    }
    if same(kind(item), "text") {
      return record.contains(container, item)
    }
    return false
  }
  if same(k, "set") {
    return set.contains(container, item)
  }
  if same(k, "text") {
    if same(kind(item), "text") {
      return le(0, text.find(container, item, 0))
    }
    let name = invoke py.type(item)
    let hoisted7 = text.join(["'in <string>' requires string as left operand, not ", name], "")
    do invoke py.fail("TypeError", hoisted7)
  }
  let name = invoke py.type(container)
  let hoisted8 = text.join(["argument of type '", name, "' is not iterable"], "")
  do invoke py.fail("TypeError", hoisted8)
  return false
}

# A subscript as a position in a sequence of `length`: an integer, counted
# from the end when negative. `verb` names the access in the IndexError,
# " assignment" for a store.
function py.index(index: Any, length: Int, what: Text, verb: Text) -> Int
kernel 1
charge 6
body {
  if bool.not(same(kind(index), "integer")) {
    let name = invoke py.type(index)
    let hoisted9 = text.join([what, " indices must be integers or slices, not ", name], "")
    do invoke py.fail("TypeError", hoisted9)
  }
  let position = index
  if lt(position, 0) {
    set position = add(position, length)
  }
  let inside = le(0, position)
  if inside {
    set inside = lt(position, length)
  }
  if bool.not(inside) {
    let problem = text.join([what, verb, " index out of range"], "")
    do invoke py.fail("IndexError", problem)
  }
  return position
}

# A record is read as a dict, unless it holds a brand: a package value is
# sealed, and only its type's members reach its fields.

function py.setitem(target: Any, index: Any, value: Any) -> Null
kernel 1
charge sum(6, deep(index))
body {
  let k = kind(target)
  if same(k, "map") {
    set target[index] = value
    return null
  }
  if same(k, "list") {
    let hoisted14 = list.len(target)
    let position = invoke py.index(index, hoisted14, "list", " assignment")
    set target[position] = value
    return null
  }
  let name = invoke py.type(target)
  let hoisted15 = text.join(["'", name, "' object does not support item assignment"], "")
  do invoke py.fail("TypeError", hoisted15)
  return null
}

function py.delitem(target: Any, index: Any) -> Null
kernel 1
charge sum(6, deep(index))
body {
  let k = kind(target)
  if same(k, "map") {
    if map.contains(target, index) {
      remove target[index]
      return null
    }
    let shown = invoke py.repr(index)
    throw error.new("KeyError", shown, ((index,), null))
  }
  if same(k, "list") {
    let hoisted16 = list.len(target)
    let position = invoke py.index(index, hoisted16, "list", " assignment")
    remove target[position]
    return null
  }
  let name = invoke py.type(target)
  let hoisted17 = text.join(["'", name, "' object doesn't support item deletion"], "")
  do invoke py.fail("TypeError", hoisted17)
  return null
}

# Shared normalization for reads, stores and deletion; omitted negative
# bounds retain their distinction from explicitly written negative indices.
function py.slice_bounds(length: Int, start: Any, stop: Any, step: Any) -> Any
kernel 1
metering statements
body {
  if same(step, null) {
    set step = 1
  }
  for bound in [start, stop, step] {
    if bool.not(same(bound, null)) {
      if bool.not(same(kind(bound), "integer")) {
        do invoke py.fail("TypeError", "slice indices must be integers or None")
      }
    }
  }
  if eq(step, 0) {
    do invoke py.fail("ValueError", "slice step cannot be zero")
  }
  let low = 0
  let high = length
  if lt(step, 0) {
    set low = -1
    set high = sub(length, 1)
  }
  if same(start, null) {
    if lt(step, 0) {
      set start = high
    } else {
      set start = low
    }
  } else {
    if lt(start, 0) {
      set start = add(start, length)
    }
    if lt(start, low) {
      set start = low
    }
    if lt(high, start) {
      set start = high
    }
  }
  if same(stop, null) {
    if lt(step, 0) {
      set stop = low
    } else {
      set stop = high
    }
  } else {
    if lt(stop, 0) {
      set stop = add(stop, length)
    }
    if lt(stop, low) {
      set stop = low
    }
    if lt(high, stop) {
      set stop = high
    }
  }
  return (start, stop, step)
}

# `target[start:stop:step]`; null stands for a bound that was not written.
function py.slice(target: Any, start: Any, stop: Any, step: Any) -> Any
kernel 1
charge sum(8, size(target), size(result))
body {
  let iterator_token = invoke py.token(target, "py.iterator")
  let callable_token = invoke py.token(target, "py.function")
  let slice_token = invoke py.token(target, "py.slice")
  if iterator_token { do invoke py.fail("TypeError", "iterator is not a sequence") }
  if callable_token { do invoke py.fail("TypeError", "function is not a sequence") }
  if slice_token { do invoke py.fail("TypeError", "slice is not a sequence") }
  let k = kind(target)
  let length = 0
  if same(k, "list") {
    set length = list.len(target)
  } else {
    if same(k, "tuple") {
      set length = tuple.len(target)
    } else {
      if same(k, "text") {
        set length = text.len(target)
      } else {
        if same(k, "bytes") { set length = invoke py.bytes_len(target) } else {
        let name = invoke py.type(target)
        let hoisted18 = text.join(["'", name, "' object is not subscriptable"], "")
        do invoke py.fail("TypeError", hoisted18)
        }
      }
    }
  }
  let bounds = invoke py.slice_bounds(length, start, stop, step)
  set start = bounds[0]
  set stop = bounds[1]
  set step = bounds[2]
  if eq(step, 1) {
    if same(k, "list") {
      return list.slice(target, start, stop)
    }
    if same(k, "tuple") {
      return tuple.slice(target, start, stop)
    }
    if same(k, "bytes") { return bytes.slice(target, start, stop) }
    return text.slice(target, start, stop)
  }
  let picked = []
  let position = start
  while true {
    if lt(0, step) {
      if le(stop, position) {
        break
      }
    } else {
      if le(position, stop) {
        break
      }
    }
    if same(k, "text") {
      set picked[list.len(picked)] = text.get(target, position)
    } else {
      if same(k, "bytes") { set picked[list.len(picked)] = bytes.at(target, position) } else {
      set picked[list.len(picked)] = target[position]
      }
    }
    set position = add(position, step)
  }
  if same(k, "list") {
    return picked
  }
  if same(k, "text") {
    return text.join(picked, "")
  }
  if same(k, "bytes") { return bytes.from_octets(picked) }
  let out = ()
  for item in picked {
    set out = tuple.concat(out, (item,))
  }
  return out
}

# Proven collection receivers retain the generic access fee and Python errors.
function py.dict_getitem(target: Map(Any, Any), index: Text) -> Any
kernel 1
charge sum(6, deep(index))
body {
  if map.contains(target, index) { return target[index] }
  let shown = invoke py.repr(index)
  throw error.new("KeyError", shown, ((index,), null))
}

function py.list_getitem(target: List(Any), index: Int) -> Any
kernel 1
charge sum(6, deep(index))
body {
  if le(0, index) {
    if lt(index, list.len(target)) { return target[index] }
  }
  return invoke py.getitem(target, index)
}

function py.tuple_getitem(target: Any, index: Int) -> Any
kernel 1
charge sum(6, deep(index))
body {
  if le(0, index) {
