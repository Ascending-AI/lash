function ts.object.own_keys(target: Any) -> List(Text)
kernel 1
charge sum(16, product(size(target), size(target)))
body {
  let keys = invoke ts.keys(target)
  # ts.keys already orders record, list and text keys, including arguments
  # hidden fields and array holes. Only error properties arrive unsorted.
  if same(kind(target), "error") {} else { return keys }
  let indices = []
  let index_values = []
  let others = []
  for key in keys {
    # Classify once, rejecting nondigit names before numeric conversion.
    let number = invoke ts.list_index(key, 4294967295.0)
    if num.le(0, number) {
      let position = list.len(indices)
      set indices[position] = key
      set index_values[position] = number
      while num.lt(0, position) {
        let previous = num.sub(position, 1)
        if num.le(index_values[previous], number) { break }
        set indices[position] = indices[previous]
        set index_values[position] = index_values[previous]
        set position = previous
      }
      set indices[position] = key
      set index_values[position] = number
    } else { set others[list.len(others)] = key }
  }
  for key in others { set indices[list.len(indices)] = key }
  return indices
}

