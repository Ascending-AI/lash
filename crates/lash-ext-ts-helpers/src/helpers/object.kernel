# Copies facts into a fresh guest descriptor; never mutates metadata.
function ts.object.descriptor(reader: Any, target: Any, key: Text) -> Any
kernel 1
charge sum(12, deep(key), deep(result))
body {
  let own = invoke ts.has_own(target, key)
  if own {} else { return absent }
  let receiver = invoke ts.receiver(target)
  let writable = true
  let enumerable = true
  let configurable = true
  let token = same(receiver, "builtin")
  if same(receiver, "closure") { if same(kind(target), "tuple") { set token = bool.not(same(target[1], "")) } }
  if token {
    let properties = invoke ts.builtin_own(target[1])
    let attributes = properties[key]
    if attributes.accessor {
      let getter = apply reader(target, ("getter", key))
      return {get: getter, set: absent, enumerable: attributes.enumerable, configurable: attributes.configurable}
    }
    set writable = attributes.writable
    set enumerable = attributes.enumerable
    set configurable = attributes.configurable
  } else {
    if same(receiver, "closure") { set writable = false set enumerable = false }
    if same(receiver, "brand:typescript.template") {
      set writable = false
      set configurable = false
      if same(key, "length") { set enumerable = false }
      if same(key, "raw") { set enumerable = false }
    }
    if same(receiver, "list") { if same(key, "length") { set enumerable = false set configurable = false } }
    if same(receiver, "brand:typescript.regex_match") { if same(key, "length") { set enumerable = false set configurable = false } }
    if same(receiver, "brand:regex.ecma.reg_exp") { set enumerable = false set configurable = false }
    if same(receiver, "text") { set writable = false set configurable = false if same(key, "length") { set enumerable = false } }
    if same(receiver, "error") {
      let keys = invoke ts.keys(target)
      set enumerable = false
      for name in keys { if same(name, key) { set enumerable = true } }
    }
    if same(receiver, "brand:typescript.arguments") {
      if set.contains(target.hidden, key) { set enumerable = false }
    }
  }
  let value = apply reader(target, key)
  return {value: value, writable: writable, enumerable: enumerable, configurable: configurable}
}

