function ts.object.getOwnPropertyNames(this: Any, args: List(Any)) -> Any
kernel 1
charge sum(8, deep(args), deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let target = args[0]
  do invoke ts.require_object_coercible(target)
  let receiver = invoke ts.receiver(target)
  let token = same(receiver, "builtin")
  if same(receiver, "closure") { if same(kind(target), "tuple") { set token = bool.not(same(target[1], "")) } }
  if token {
    let properties = invoke ts.builtin_own(target[1])
    return record.keys(properties)
  }
  if same(receiver, "closure") {
    let names = []
    for key in ["length", "name"] {
      let own = invoke ts.has_own(target, key)
      if own { set names[list.len(names)] = key }
    }
    return names
  }
  if same(receiver, "brand:regex.ecma.reg_exp") { return ["lastIndex"] }
  if same(receiver, "error") { if same(kind(target.data), "record") { return record.keys(target.data.properties) } return ["message"] }
  if same(receiver, "brand:typescript.arguments") {
    let names = invoke ts.object.own_keys(target.properties)
    set names[list.len(names)] = "callee"
    return names
  }
  if same(receiver, "brand:typescript.template") {
    let names = invoke ts.object.own_keys(target.items)
    set names[list.len(names)] = "length"
    if record.contains(target, "raw") { set names[list.len(names)] = "raw" }
    return names
  }
  let names = invoke ts.object.own_keys(target)
  for array_kind in ["list", "text", "brand:typescript.regex_match"] {
    if same(receiver, array_kind) {
      # Array length precedes the match array's other named properties.
      if same(receiver, "brand:typescript.regex_match") {
        let indices = invoke ts.object.own_keys(target.items)
        set indices[list.len(indices)] = "length"
        for name in ["index", "input", "groups", "indices"] {
          if record.contains(target, name) { set indices[list.len(indices)] = name }
        }
        return indices
      }
      set names[list.len(names)] = "length"
    }
  }
  return names
}

