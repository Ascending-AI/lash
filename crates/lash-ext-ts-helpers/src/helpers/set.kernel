# Calling the constructor without NewTarget never reads the iterable.
function ts.set.call(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge 4
body {
  throw error.new("type_error", "Set requires new", null)
}

function ts.set.construct(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(args), deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let output = set{}
  let source = args[0]
  let empty = invoke ts.is_nullish(source)
  if empty {} else {
    let values = invoke ts.iterate(source)
    for value in values metered 2 {
      let key = invoke ts.map.key(value)
      set output[key] = true
    }
  }
  return output
}

function ts.set.is(value: Any) -> Bool
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  return same(kind(value), "set")
}

function ts.set.size(this: Any) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  return num.to_float(set.len(this))
}

function ts.set.add(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let builtin_arg_0 = args[0]
let key = invoke ts.map.key(builtin_arg_0)
  set this[key] = true
  return this
}

function ts.set.has(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let builtin_arg_1 = args[0]
let key = invoke ts.map.key(builtin_arg_1)
  return set.contains(this, key)
}

function ts.set.delete(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let builtin_arg_2 = args[0]
let key = invoke ts.map.key(builtin_arg_2)
  let had = set.contains(this, key)
  set this[key] = false
  return had
}

function ts.set.clear(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  for key in set.values(this) metered 2 { set this[key] = false }
  return absent
}

function ts.set.values(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let output = []
  for key in this {
    let value = invoke ts.map.value(key)
    set output[list.len(output)] = value
  }
  return output
}

function ts.set.entries(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let output = []
  for key in this {
    let value = invoke ts.map.value(key)
    set output[list.len(output)] = [value, value]
  }
  return output
}

function ts.set.forEach(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 2)
  let callback = args[0]
  set callback = invoke ts.callable(callback)
  let receiver = args[1]
  for key in this metered 2 {
    let value = invoke ts.map.value(key)
    let passed = [value, value, this]
    do apply callback(receiver, passed)
  }
  return absent
}

# GetSetRecord reads and validates size, has, keys exactly once, in order.
# A Set/Map has no guest-owned protocol properties in this dialect.
function ts.set.other(other: Any) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(16, deep(other), deep(result))
body {
  let k = kind(other)
  if same(k, "set") { return {object: other, size: num.to_float(set.len(other))} }
  if same(k, "map") { return {object: other, size: num.to_float(map.len(other))} }
  let primitive = invoke ts.is_primitive(other)
  if primitive { throw error.new("type_error", "Set-like object required", null) }
  let size = invoke ts.get(other, "size")
  let size = invoke ts.to_number(size)
  if num.is_nan(size) { throw error.new("type_error", "size property is not a number", null) }
  set size = num.trunc(size)
  if num.lt(size, 0) { throw error.new("RangeError", "size property is negative", null) }
  let has = invoke ts.get(other, "has")
  set has = invoke ts.callable(has)
  if same(kind(has), "closure") {} else { throw error.new("type_error", "has property is not callable", null) }
  let keys = invoke ts.get(other, "keys")
  set keys = invoke ts.callable(keys)
  if same(kind(keys), "closure") {} else { throw error.new("type_error", "keys property is not callable", null) }
  return {object: other, size: size, has: has, keys: keys}
}

function ts.set.contains_other(other: Any, key: Any) -> Bool
kernel 1
errors "type_error"
charge sum(8, size(key))
body {
  let object = other.object
  if same(kind(object), "map") { return map.contains(object, key) }
  if same(kind(object), "set") { return set.contains(object, key) }
  let value = invoke ts.map.value(key)
  let passed = [value]
  let has = other.has
  let present = apply has(object, passed)
  return invoke ts.to_boolean(present)
}

function ts.set.close_keys(iterator: Any) -> Any
kernel 1
errors "type_error"
charge sum(8, deep(iterator))
body {
  let method = invoke ts.get(iterator, "return")
  let nullish = invoke ts.is_nullish(method)
  if nullish { return absent }
  let close = invoke ts.callable(method)
  if same(kind(close), "closure") {} else { throw error.new("type_error", "iterator return is not callable", null) }
  let none = []
  let returned = apply close(iterator, none)
  let primitive = invoke ts.is_primitive(returned)
  if primitive { throw error.new("type_error", "iterator return must return an object", null) }
  return absent
}

# Visit keys live, with guest next calls and dynamic continuation tests kept
# in bodies. False is an early normal exit and performs IteratorClose.
function ts.set.visit_keys(other: Any, visit: Any) -> Bool
kernel 1
errors "type_error"
charge sum(16, deep(other))
body {
  let object = other.object
  let k = kind(object)
  if same(k, "map") { set k = "set" }
  if same(k, "set") {
    for key in object metered 2 {
      let passed = [key]
      let more = apply visit(absent, passed)
      if more {} else { return false }
    }
    return true
  }
  let keys = other.keys
  let none = []
  let iterator = apply keys(object, none)
  let primitive = invoke ts.is_primitive(iterator)
  if primitive { throw error.new("type_error", "keys must return an iterator object", null) }
  let method = invoke ts.get(iterator, "next")
  let next = invoke ts.callable(method)
  if same(kind(next), "closure") {} else { throw error.new("type_error", "iterator next is not callable", null) }
  while true metered 2 {
    let step = apply next(iterator, none)
    let primitive = invoke ts.is_primitive(step)
    if primitive { throw error.new("type_error", "iterator result must be an object", null) }
    let done = invoke ts.get(step, "done")
    let done = invoke ts.to_boolean(done)
    if done { return true }
    let value = invoke ts.get(step, "value")
    let key = invoke ts.map.key(value)
    let passed = [key]
    let more = apply visit(absent, passed)
    if more {} else {
      do invoke ts.set.close_keys(iterator)
      return false
    }
  }
}

function ts.set.union(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = invoke ts.set.other(args[0])
  let output = set{}
  for key in this metered 2 { set output[key] = true }
  let visit = fn(context, passed) {
    set output[passed[0]] = true
    return true
  }
  do invoke ts.set.visit_keys(other, visit)
  return output
}

function ts.set.intersection(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = invoke ts.set.other(args[0])
  let output = set{}
  if num.le(set.len(this), other.size) {
    for key in this metered 2 {
      let present = invoke ts.set.contains_other(other, key)
      if present { set output[key] = true }
    }
  } else {
    let visit = fn(context, passed) {
      let key = passed[0]
      if set.contains(this, key) { set output[key] = true }
      return true
    }
    do invoke ts.set.visit_keys(other, visit)
  }
  return output
}

function ts.set.difference(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = invoke ts.set.other(args[0])
  let output = set{}
  for key in this metered 2 { set output[key] = true }
  if num.le(set.len(this), other.size) {
    for key in output metered 2 {
      let present = invoke ts.set.contains_other(other, key)
      if present { set output[key] = false }
    }
  } else {
    let visit = fn(context, passed) {
      set output[passed[0]] = false
      return true
    }
    do invoke ts.set.visit_keys(other, visit)
  }
  return output
}

function ts.set.symmetricDifference(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = invoke ts.set.other(args[0])
  let output = set{}
  for key in this metered 2 { set output[key] = true }
  let visit = fn(context, passed) {
    let key = passed[0]
    if set.contains(this, key) { set output[key] = false } else { set output[key] = true }
    return true
  }
  do invoke ts.set.visit_keys(other, visit)
  return output
}

function ts.set.isSubsetOf(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = invoke ts.set.other(args[0])
  if num.lt(other.size, set.len(this)) { return false }
  for key in this metered 2 {
    let present = invoke ts.set.contains_other(other, key)
    if present {} else { return false }
  }
  return true
}

function ts.set.isSupersetOf(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = invoke ts.set.other(args[0])
  if num.lt(set.len(this), other.size) { return false }
  let visit = fn(context, passed) { return set.contains(this, passed[0]) }
  return invoke ts.set.visit_keys(other, visit)
}

function ts.set.isDisjointFrom(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = invoke ts.set.other(args[0])
  if num.le(set.len(this), other.size) {
    for key in this metered 2 {
      let present = invoke ts.set.contains_other(other, key)
      if present { return false }
    }
    return true
  }
  let visit = fn(context, passed) {
    if set.contains(this, passed[0]) { return false }
    return true
  }
  return invoke ts.set.visit_keys(other, visit)
}
