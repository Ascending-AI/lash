use same
use text.join
use list.len
use json.boundary
use text.concat
use num.to_text
use num.add
use ts.console.json
use ts.console.write
use ts.receiver
use ts.to_string

# The same encoder owns JSON.stringify, console and host transport.
function ts.console.json(value: Any) -> Any
kernel 1
errors "type_error", "cycle", "json_number", "json_key", "json_depth", "not_data", "number_range"
charge sum(8, deep(value), size(result))
body { return json.boundary(value, "text", "JSON.stringify", "$", "") }

# `console.log` and its siblings: one print of the arguments joined by a
# space, a plain object or an array as compact JSON and anything else as its
# ToString.
function ts.console.write(args: List(Any), context: Text) -> Any
kernel 1
errors "type_error"
charge sum(4, deep(args))
body {
  let pieces = []
  let index = 0
  for item in args metered 2 {
    let k = invoke ts.receiver(item)
    let structured = same(k, "record")
    if structured {} else {
      set structured = same(k, "list")
    }
    if structured {
      let path = text.join(["$[", num.to_text(index), "]"], "")
      let piece = json.boundary(item, "text", context, path, "")
      set pieces[list.len(pieces)] = piece
    } else {
      let piece = invoke ts.to_string(item)
      set pieces[list.len(pieces)] = piece
    }
    set index = num.add(index, 1)
  }
  let line = text.join(pieces, " ")
  print line
  return absent
}

function ts.console.log(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge sum(4, deep(args))
body { return invoke ts.console.write(args, "console.log") }

