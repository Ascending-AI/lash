use record.contains
# JavaScript json behavior, expressed in kernel code.
use ts.callable
use ts.console.json
use date.ecma.format
use error.new
use float.to_int
use json.parse_binary64
use json.classify
use num.rem_trunc
use json.boundary
use kind
use list.contains
use list.len
use num.add
use num.is_nan
use num.lt
use num.max
use num.min
use num.trunc
use ref
use same
use text.repeat
use text.utf16_len
use text.utf16_slice
use ts.delete
use ts.get
use ts.json.parse
use ts.json.plain
use ts.json.stringify
use ts.json.stringify_generic
use ts.keys
use ts.object.own_keys
use ts.pad
use ts.receiver
use ts.set
use ts.to_property_key
use ts.to_string

function ts.json.parse(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(args), deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_0 = args[0]
let text = invoke ts.to_string(builtin_arg_0)
  let value = absent
  try { set value = json.parse_binary64(text) } catch invalid {
    throw error.new("SyntaxError", "Invalid JSON", null)
  }
  let reviver = args[1]
  set reviver = invoke ts.callable(reviver)
  if same(kind(reviver), "closure") {
    let visit = absent
    set visit = fn(holder, key) {
      let value = invoke ts.get(holder, key)
      let k = kind(value)
      let object = same(k, "record")
      if same(k, "list") { set object = true }
      if object {
        let keys = invoke ts.keys(value)
        for child in keys {
          let revived = apply visit(value, child)
          if same(kind(revived), "absent") { do invoke ts.delete(value, child) } else { do invoke ts.set(value, child, revived) }
        }
      }
      let passed = [key, value]
      let output = apply reviver(holder, passed)
      return output
    }
    let holder = {"": value}
    let output = apply visit(holder, "")
    return output
  }
  return value
}

# Callbacks are language evaluation. They prepare values without writing JSON
# fragments or deciding omission; json.boundary owns the final traversal.
function ts.json.stringify_generic(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(args), deep(result))
body {
  let args = invoke ts.pad(args, 3)
  let replacer = invoke ts.callable(args[1])
  let allowed = absent
  if same(kind(replacer), "list") {
    set allowed = []
    for item in replacer metered 2 {
      let k = invoke ts.receiver(item)
      if same(k, "text") {
        if list.contains(allowed, item) {} else { set allowed[list.len(allowed)] = item }
      }
      if same(k, "number") {
        let item = invoke ts.to_string(item)
        if list.contains(allowed, item) {} else { set allowed[list.len(allowed)] = item }
      }
    }
  }
  let gap = ""
  let space = args[2]
  let k = invoke ts.receiver(space)
  if same(k, "number") {
    let count = num.min(10.0, num.max(0.0, num.trunc(space)))
    if num.is_nan(count) { set count = 0.0 }
    set gap = text.repeat(" ", float.to_int(count))
  }
  if same(k, "text") { set gap = text.utf16_slice(space, 0, num.min(10, text.utf16_len(space))) }
  let active = []
  let copies = []
  let prepare = absent
  set prepare = fn(holder, key) {
    let value = invoke ts.get(holder, key)
    let k = kind(value)
    if same(k, "record") {
      let to_json = invoke ts.callable(value.toJSON)
      if same(kind(to_json), "closure") {
        let name = invoke ts.to_property_key(key)
        set value = apply to_json(value, [name])
      } else {
        if record.contains(value, "__lash_brand") {
          let brand = invoke ts.receiver(value)
          if same(brand, "brand:date.ecma.invalid_date") { set value = null }
          if same(brand, "brand:url.whatwg.url") { set value = value.state.href }
        }
      }
    }
    if same(k, "timestamp") { set value = date.ecma.format(value, "iso") }
    if same(kind(replacer), "closure") {
      let name = invoke ts.to_property_key(key)
      set value = apply replacer(holder, [name, value])
    }
    if same(kind(value), "record") { if same(value.__lash_brand, ("typescript", "template")) { set value = value.items } }
    let k = invoke ts.receiver(value)
    let array = same(k, "list")
    let object = same(k, "record")
    if same(k, "error") { set object = true }
    if array {} else { if object {} else { return value } }
    let identity = absent
    if same(k, "error") { set identity = ref(value.object.properties) } else { set identity = ref(value) }
    let position = 0
    for ancestor in active {
      if same(ancestor, identity) { return copies[position] }
      set position = num.add(position, 1)
    }
    let copied = {}
    if array { set copied = [] } else { if same(kind(allowed), "absent") {} else { set copied = map{} } }
    set active[position] = identity
    set copies[position] = copied
    let keys = []
    if array {
      let i = 0.0
      while num.lt(i, list.len(value)) { set keys[list.len(keys)] = i set i = num.add(i, 1.0) }
    } else {
      if same(kind(allowed), "absent") { set keys = invoke ts.object.own_keys(value) } else { set keys = allowed }
    }
    for child in keys {
      let prepared = apply prepare(value, child)
      if array { set copied[list.len(copied)] = prepared } else { set copied[child] = prepared }
    }
    remove active[position]
    remove copies[position]
    return copied
  }
  let prepared = apply prepare({"": args[0]}, "")
  try {
    return json.boundary(prepared, "text", "JSON.stringify", "$", gap)
  } catch invalid {
    if same(invalid.kind, "not_data") {
      throw error.new("type_error", invalid.message, invalid.data)
    }
    throw invalid
  }
}

# Whether JSON.stringify writes `value` as the console's JSON render does:
# a list, a record or a scalar whose containers hold only lists, records,
# null, bools, text and finite numbers. A record with a `toJSON` or a
# `__lash_brand` field, or with a key that begins with a digit (an index key, which
# JSON writes before the others), is not plain. Containers more than eight
# deep are not plain, so a cycle is not plain either. Classification reads
# borrowed values, allocating nothing. Shared values count at every occurrence;
# rejection stops the walk.
function ts.json.plain(value: Any) -> Bool
kernel 1
metering statements
body {
  # The native is neutral: forbidden fields, key interval, bounds and integer
  # admission are dialect policy. Its result packs work and admission in its low bit.
  let classified = json.classify(value, 8, ("toJSON", "__lash_brand"), "0", ":", false)
  return same(num.rem_trunc(classified, 2), 1)
}

# JSON.stringify(value, replacer, space). Plain data (`ts.json.plain`) with
# no replacer and no space is written by the console's one native pass;
# anything else takes the generic walk, which writes the same text for
# plain data. The common call, with the value alone, is not padded.
function ts.json.stringify(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
metering statements
body {
  let value = absent
  let bare = same(list.len(args), 1)
  if bare { set value = args[0] } else {
    let padded = invoke ts.pad(args, 3)
    if same(padded[1], absent) {
      if same(padded[2], absent) {
        set value = padded[0]
        set bare = true
      }
    }
  }
  if bare {
    let plain = invoke ts.json.plain(value)
    if plain {
      let text = invoke ts.console.json(value)
      return text
    }
  }
  let text = invoke ts.json.stringify_generic(this, args)
  return text
}
