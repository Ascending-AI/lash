use bool.not
use num.is_finite
use num.to_float
use num.le
use num.mul
use num.lt
use error.new
use float.to_int
use num.floor
# asyncio over kernel tasks.
#
# A Python task is a kernel task handle. The task runs `py.task.run`, which
# yields first, so the task starts when the ready queue reaches it, as
# `asyncio.create_task` schedules it (`K-TASK-002`), and which ends with
# `("ok", value)` or `("error", reason)` and never in an error of its own.
# So a task nobody awaits leaves no unobserved error behind, as in asyncio,
# and awaiting a task twice gives the same answer (`K-TASK-009`).
#
# A coroutine that is only awaited is an ordinary call and needs nothing
# here.

use kind
use same
use le
use mul
use list.len
use text.join
use py.type
use py.fail
use py.is_number
use py.task.bridge
use py.await

# What a task runs: `work()` is the coroutine call the task was made from.
function py.task.run(work: Any) -> Any
kernel 1
charge 6
body {
  try {
    do yield
    let value = apply work()
    return ("ok", value)
  } catch reason {
    return ("error", reason)
  }
}

# `await value`. A task gives its result or raises what ended it. When the
# awaiting task is cancelled while it waits, the task it awaits is cancelled
# too, as asyncio does. Any other value is not awaitable.
function py.await(value: Any) -> Any
kernel 1
charge 6
body {
  if same(kind(value), "task") {
    let outcome = absent
    try {
      set outcome = join value
    } catch reason {
      do cancel value
      throw reason
    }
    if same(outcome[0], "ok") {
      return outcome[1]
    }
    throw outcome[1]
  }
  let name = invoke py.type(value)
  let hoisted3 = text.join(["object ", name, " can't be used in 'await' expression"], "")
  do invoke py.fail("TypeError", hoisted3)
  return null
}

# `await f(...)` where the front end cannot see what `f` is. A coroutine
# call has already run to its result there, so a value that is not a task
# is what the call returned.
function py.await.result(value: Any) -> Any
kernel 1
charge 6
body {
  if same(kind(value), "task") {
    let awaited = invoke py.await(value)
    return awaited
  }
  return value
}

# One member of a `gather`: ends as the task did, in its result or in its
# error tagged as a member's, so the gathering `join` sees the first failure
# when it happens and can tell it from its own cancellation.
function py.task.bridge(task: Any) -> Any
kernel 1
charge 6
body {
  let outcome = join task
  if same(outcome[0], "ok") {
    return outcome[1]
  }
  throw ("member", outcome[1])
}

# `await asyncio.gather(...)` over tasks: their results in order, or the
# first failure. On a failure the others keep running (`K-TASK-015`). When
# the gathering task is cancelled, every task it gathers is cancelled and
# has ended before the cancellation goes on, as asyncio does.
function py.gather(tasks: Any) -> List(Any)
kernel 1
charge sum(6, size(tasks), size(result))
body {
  let members = []
  for task in tasks metered 2 {
    if same(kind(task), "task") {
      let member = spawn invoke py.task.bridge(task)
      set members[list.len(members)] = member
    } else {
      let name = invoke py.type(task)
      let hoisted1 = text.join(["An asyncio.Future, a coroutine or an awaitable is required, not '", name, "'"], "")
      do invoke py.fail("TypeError", hoisted1)
    }
  }
  let values = absent
  try {
    set values = join all members
  } catch reason {
    if same(kind(reason), "tuple") {
      throw reason[1]
    }
    for task in tasks metered 2 {
      do cancel task
    }
    let ended = join settled members
    throw reason
  }
  return values
}

# `await asyncio.sleep(seconds)`. A sleep of zero lets the other ready tasks
# run and asks the host for nothing.
function py.sleep(seconds: Any) -> Null
kernel 1
charge 512
body {
  let ok = invoke py.is_number(seconds)
  if ok {
    if le(seconds, 0) {
      do yield
      return null
    }
    if bool.not(num.is_finite(seconds)) { throw error.new("number_range", "`sleep` takes a duration that is finite and not negative") }
    let milliseconds = 9223372036854775807
    if le(seconds, 9223372036854775) {
      let duration = num.mul(num.to_float(seconds), 1000.0)
      if num.lt(duration, 9223372036854775808.0) { set milliseconds = float.to_int(num.floor(duration)) }
    }
    do perform python.sleep(milliseconds) as Null then yield
    return null
  }
  let name = invoke py.type(seconds)
  let hoisted2 = text.join(["asyncio.sleep() takes a number of seconds, not '", name, "'"], "")
  do invoke py.fail("TypeError", hoisted2)
  return null
}
