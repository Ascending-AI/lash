# The protocols of a loop over a dict view, `for k in d.keys()`, `.values()`
# and `.items()` (`K-ITER-005`): a dict is walked live through its keys and
# checked as a loop over the dict itself is (`py.for_in.check`); anything
# else is walked as the method gives it.
function py.for_in.keys(self: Any) -> Any
kernel 1
charge 4
body {
  if same(kind(self), "map") { return self }
  let keys = invoke py.method.keys(self)
  return keys
}

function py.for_in.values(self: Any) -> Any
kernel 1
charge 4
body {
  if same(kind(self), "map") { return self }
  let values = invoke py.method.values(self)
  return values
}

function py.for_in.items(self: Any) -> Any
kernel 1
charge 4
body {
  if same(kind(self), "map") { return self }
  let items = invoke py.method.items(self)
  return items
}

# What a pass over `.values()` binds: the value a dict holds for the key now.
function py.for_in.value(source: Any, key: Any) -> Any
kernel 1
charge 2
body {
  if same(kind(source), "map") { return source[key] }
  return key
}

# What a pass over `.items()` binds: the key and the value a dict holds for
# it now.
function py.for_in.item(source: Any, key: Any) -> Any
kernel 1
charge 2
body {
  if same(kind(source), "map") { return (key, source[key]) }
  return key
}

function py.method.setdefault(self: Any, key: Any, default?: Any) -> Any
kernel 1
charge sum(4, deep(key))
body {
  if same(kind(self), "map") {
    if map.contains(self, key) {
      return self[key]
    }
    let value = null
    if bool.not(same(default, absent)) {
      set value = default
    }
    set self[key] = value
    return value
  }
  do invoke py.no_attribute(self, "setdefault")
  return null
}

# `dict.update(other)` and `set.update(other)`.
function py.method.update(self: Any, args: Any, keywords: Any) -> Null
kernel 1
charge sum(8, deep(args), size(keywords))
body {
  let k = kind(self)
  if same(k, "map") {
    if lt(1, tuple.len(args)) { do invoke py.fail("TypeError", "update expected at most one positional argument") }
    if eq(tuple.len(args), 1) {
      let source = args[0]
      let entries = invoke py.to_dict(source)
      for key in entries { set self[key] = entries[key] }
    }
    for key in keywords { set self[key] = keywords[key] }
    return null
  }
  if same(k, "set") {
    if lt(0, map.len(keywords)) { do invoke py.fail("TypeError", "set.update takes no keyword arguments") }
    for source in args {
      let members = invoke py.to_list(source)
      for member in members { set self[member] = true }
    }
    return null
  }
  do invoke py.no_attribute(self, "update")
  return null
}

