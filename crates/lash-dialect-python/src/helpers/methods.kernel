function py.method.zfill(self: Any, width: Any) -> Text
kernel 1
charge sum(8, size(self), magnitude(width), size(result))
body {
  let value = invoke py.text_of(self, "zfill")
  if bool.not(same(kind(width), "integer")) { do invoke py.fail("TypeError", "width must be an integer") }
  let n = sub(width, text.len(value))
  if le(n, 0) { return value }
  let prefix = ""
  if text.starts_with(value, "+") { set prefix = "+" }
  if text.starts_with(value, "-") { set prefix = "-" }
  return text.join([prefix, text.repeat("0", n), text.slice(value, text.len(prefix), text.len(value))], "")
}

function py.method.expandtabs(self: Any, tabsize?: Any) -> Text
kernel 1
charge sum(8, size(self), size(result))
body {
  let value = invoke py.text_of(self, "expandtabs")
  if same(tabsize, absent) { set tabsize = 8 }
  if bool.not(same(kind(tabsize), "integer")) { do invoke py.fail("TypeError", "tabsize must be an integer") }
  let parts = []
  let column = 0
  for point in text.to_code_points(value) metered 2 {
    if eq(point, 9) {
      let n = 0
      if lt(0, tabsize) { set n = sub(tabsize, rem_floor(column, tabsize)) }
      set parts[list.len(parts)] = text.repeat(" ", n)
      set column = add(column, n)
    } else {
      set parts[list.len(parts)] = text.from_code_points([point])
      set column = add(column, 1)
      if eq(point, 10) { set column = 0 }
      if eq(point, 13) { set column = 0 }
    }
  }
  return text.join(parts, "")
}

function py.method.splitlines(self: Any, keepends?: Any) -> Any
kernel 1
charge sum(8, size(self), size(result))
body {
  let value = invoke py.text_of(self, "splitlines")
  let keep = false
  if bool.not(same(keepends, absent)) { set keep = invoke py.truth(keepends) }
  let points = text.to_code_points(value)
  let out = []
  let start = 0
  let i = 0
  while lt(i, list.len(points)) metered 2 {
    let point = points[i]
    if list.contains([10, 11, 12, 13, 28, 29, 30, 133, 8232, 8233], point) {
      let end = i
      set i = add(i, 1)
      if eq(point, 13) { if lt(i, list.len(points)) { if eq(points[i], 10) { set i = add(i, 1) } } }
      if keep { set end = i }
      set out[list.len(out)] = text.slice(value, start, end)
      set start = i
    } else { set i = add(i, 1) }
  }
  if lt(start, list.len(points)) { set out[list.len(out)] = text.slice(value, start, list.len(points)) }
  return out
}

