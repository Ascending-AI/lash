function py.method.startswith(self: Any, prefix: Any, start?: Any, end?: Any) -> Bool
kernel 1
charge sum(8, size(self), deep(prefix))
body {
  let value = invoke py.text_of(self, "startswith")
  let n = text.len(value)
  let bounds = invoke py.text.bounds(n, start, end)
  let needles = (prefix,)
  if same(kind(prefix), "tuple") { set needles = prefix }
  for item in needles {
    let needle = invoke py.text_of(item, "startswith")
    if le(bounds[0], bounds[1]) {
      let sliced = text.slice(value, bounds[0], bounds[1])
      if text.starts_with(sliced, needle) { return true }
    }
  }
  return false
}

function py.method.endswith(self: Any, prefix: Any, start?: Any, end?: Any) -> Bool
kernel 1
charge sum(8, size(self), deep(prefix))
body {
  let value = invoke py.text_of(self, "endswith")
  let n = text.len(value)
  let bounds = invoke py.text.bounds(n, start, end)
  let needles = (prefix,)
  if same(kind(prefix), "tuple") { set needles = prefix }
  for item in needles {
    let needle = invoke py.text_of(item, "endswith")
    if le(bounds[0], bounds[1]) {
      let sliced = text.slice(value, bounds[0], bounds[1])
      if text.ends_with(sliced, needle) { return true }
    }
  }
  return false
}

function py.method.replace(self: Any, old: Any, new: Any, count?: Any) -> Text
kernel 1
charge sum(8, product(size(self), size(old)), size(new), size(result))
body {
  let value = invoke py.text_of(self, "replace")
  let needle = invoke py.text_of(old, "replace")
  let replacement = invoke py.text_of(new, "replace")
  if same(count, absent) { set count = -1 }
  if bool.not(same(kind(count), "integer")) { do invoke py.fail("TypeError", "count must be an integer") }
  let parts = []
  let i = 0
  let replaced = 0
  let length = text.len(value)
  while le(i, length) metered 2 {
    if eq(replaced, count) { break }
    let found = text.find(value, needle, i)
    if lt(found, 0) { break }
    set parts[list.len(parts)] = text.slice(value, i, found)
    set parts[list.len(parts)] = replacement
    set replaced = add(replaced, 1)
    set i = add(found, text.len(needle))
    if eq(text.len(needle), 0) {
      if lt(i, length) { set parts[list.len(parts)] = text.get(value, i) }
      set i = add(i, 1)
    }
  }
  set parts[list.len(parts)] = text.slice(value, i, length)
  return text.join(parts, "")
}

function py.method.find(self: Any, value: Any, start?: Any, end?: Any) -> Int
kernel 1
charge sum(8, product(size(self), size(value)), deep(value))
body {
  let text = invoke py.text_of(self, "find")
  let needle = invoke py.text_of(value, "find")
  let found = invoke py.text.search(text, needle, start, end, false)
  return found
}

