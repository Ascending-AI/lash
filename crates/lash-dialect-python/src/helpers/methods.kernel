function py.no_attribute(receiver: Any, name: Text) -> Any
kernel 1
charge 8
body {
  let owner = invoke py.type(receiver)
  let hoisted1 = text.join(["'", owner, "' object has no attribute '", name, "'"], "")
  do invoke py.fail("AttributeError", hoisted1)
  return null
}

# A str argument of a str method.
function py.text_of(value: Any, method: Text) -> Text
kernel 1
charge 6
body {
  if same(kind(value), "text") {
    return value
  }
  let name = invoke py.type(value)
  let hoisted2 = text.join([method, "() argument must be str, not ", name], "")
  do invoke py.fail("TypeError", hoisted2)
  return ""
}

function py.method.append(self: Any, value: Any) -> Null
kernel 1
charge 4
body {
  if same(kind(self), "list") {
    set self[list.len(self)] = value
    return null
  }
  do invoke py.no_attribute(self, "append")
  return null
}

function py.method.extend(self: Any, values: Any) -> Null
kernel 1
charge sum(4, size(values))
body {
  if same(kind(self), "list") {
    let items = invoke py.to_list(values)
    for item in items {
      set self[list.len(self)] = item
    }
    return null
  }
  do invoke py.no_attribute(self, "extend")
  return null
}

function py.method.insert(self: Any, index: Any, value: Any) -> Null
kernel 1
charge sum(4, size(self))
body {
  if same(kind(self), "list") {
    if bool.not(same(kind(index), "integer")) {
      let name = invoke py.type(index)
      let hoisted3 = text.join(["'", name, "' object cannot be interpreted as an integer"], "")
      do invoke py.fail("TypeError", hoisted3)
    }
    let length = list.len(self)
    let position = index
    if lt(position, 0) {
      set position = add(position, length)
    }
    if lt(position, 0) {
      set position = 0
    }
    if lt(length, position) {
      set position = length
    }
    do invoke list.insert(self, position, value)
    return null
  }
  do invoke py.no_attribute(self, "insert")
  return null
}

# `list.pop([index])`, `dict.pop(key[, default])` and `set.pop()`.
function py.method.pop(self: Any, first?: Any, second?: Any) -> Any
kernel 1
charge sum(6, size(self))
body {
  let k = kind(self)
  if same(k, "list") {
    if bool.not(same(second, absent)) {
      do invoke py.fail("TypeError", "pop expected at most 1 argument, got 2")
    }
    if bool.not(same(first, absent)) {
      if bool.not(same(kind(first), "integer")) {
        let name = invoke py.type(first)
        let wrong = text.join(["'", name, "' object cannot be interpreted as an integer"], "")
        do invoke py.fail("TypeError", wrong)
      }
    }
    let length = list.len(self)
    if eq(length, 0) {
      do invoke py.fail("IndexError", "pop from empty list")
    }
    let position = sub(length, 1)
    if bool.not(same(first, absent)) {
      set position = first
      if lt(position, 0) {
        set position = add(position, length)
      }
      let inside = le(0, position)
      if inside {
        set inside = lt(position, length)
      }
      if bool.not(inside) {
        do invoke py.fail("IndexError", "pop index out of range")
      }
    }
    let value = self[position]
    remove self[position]
    return value
  }
  if same(k, "map") {
    if map.contains(self, first) {
      let value = self[first]
      remove self[first]
      return value
    }
    if same(second, absent) {
      let shown = invoke py.repr(first)
      throw error.new("KeyError", shown, ((first,), null))
    }
    return second
  }
  if same(k, "set") {
    for member in self {
      remove self[member]
      return member
    }
    throw error.new("KeyError", "'pop from an empty set'", (("pop from an empty set",), null))
  }
  do invoke py.no_attribute(self, "pop")
  return null
}

# `list.remove(value)` and `set.remove(member)`.
function py.method.remove(self: Any, value: Any) -> Null
kernel 1
charge sum(6, size(self), deep(value))
body {
  let k = kind(self)
  if same(k, "list") {
    let position = list.index_of(self, value)
    if lt(position, 0) {
      do invoke py.fail("ValueError", "list.remove(x): x not in list")
    }
    remove self[position]
    return null
  }
  if same(k, "set") {
    if set.contains(self, value) {
      remove self[value]
      return null
    }
    let shown = invoke py.repr(value)
    throw error.new("KeyError", shown, ((value,), null))
  }
  do invoke py.no_attribute(self, "remove")
  return null
}

function py.method.index(self: Any, value: Any, start?: Any, end?: Any) -> Int
kernel 1
charge sum(8, product(size(self), size(value)), deep(value))
body {
  let k = kind(self)
  if same(k, "list") { } else { if same(k, "tuple") { } else {
    if bool.not(same(k, "text")) { do invoke py.no_attribute(self, "index") }
  } }
  if same(k, "text") {
    let needle = invoke py.text_of(value, "index")
    let found = invoke py.text.search(self, needle, start, end, false)
    if lt(found, 0) { do invoke py.fail("ValueError", "substring not found") }
    return found
  }
  let length = invoke py.length(self)
  let bounds = invoke py.text.bounds(length, start, end)
  let i = bounds[0]
  while lt(i, bounds[1]) metered 2 {
    if eq(self[i], value) { return i }
    set i = add(i, 1)
  }
  do invoke py.fail("ValueError", "value is not in sequence")
  return 0
}

function py.method.count(self: Any, value: Any, start?: Any, end?: Any) -> Int
kernel 1
charge sum(8, product(size(self), size(value)), deep(value))
body {
  let k = kind(self)
  if same(k, "text") {
    let needle = invoke py.text_of(value, "count")
    let n = text.len(self)
    let bounds = invoke py.text.bounds(n, start, end)
    let i = bounds[0]
    let total = 0
    while le(i, bounds[1]) metered 2 {
      let found = invoke py.text.search(self, needle, i, bounds[1], false)
      if lt(found, 0) { break }
      set total = add(total, 1)
      let step = text.len(needle)
      if eq(step, 0) { set step = 1 }
      set i = add(found, step)
    }
    return total
  }
  if bool.not(same(start, absent)) { do invoke py.fail("TypeError", "count takes exactly one argument") }
  if bool.not(same(end, absent)) { do invoke py.fail("TypeError", "count takes exactly one argument") }
  let total = 0
  if same(k, "list") { } else { if bool.not(same(k, "tuple")) { do invoke py.no_attribute(self, "count") } }
  for item in self { if eq(item, value) { set total = add(total, 1) } }
  return total
}

# `list.sort(key=key, reverse=reverse)`, in place.
function py.method.sort(self: Any, key?: Any, reverse?: Any) -> Null
kernel 1
charge sum(8, product(4, size(self)))
body {
  if same(kind(self), "list") {
    let ordered = invoke py.sorted(self, key, reverse)
    do invoke list.clear(self)
    for item in ordered metered 2 {
      set self[list.len(self)] = item
    }
    return null
  }
  do invoke py.no_attribute(self, "sort")
  return null
}

function py.method.reverse(self: Any) -> Null
kernel 1
charge sum(4, size(self))
body {
  if same(kind(self), "list") {
    let items = list.copy(self)
    let last = sub(list.len(items), 1)
    let position = 0
    while le(position, last) {
      set self[position] = items[sub(last, position)]
      set position = add(position, 1)
    }
    return null
  }
  do invoke py.no_attribute(self, "reverse")
  return null
}

