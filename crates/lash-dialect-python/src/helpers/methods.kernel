function py.method.join(self: Any, values: Any) -> Text
kernel 1
charge sum(4, deep(values), size(result))
body {
  if same(kind(self), "text") {
    let items = invoke py.to_list(values)
    let joined = text.join_or_index(items, self)
    if same(kind(joined), "text") { return joined }
    let item = items[joined]
    let name = invoke py.type(item)
    let message = text.join(["sequence item ", num.to_text(joined), ": expected str instance, ", name, " found"], "")
    do invoke py.fail("TypeError", message)
    return ""
  }
  do invoke py.no_attribute(self, "join")
  return ""
}

# `str.split()` splits on runs of white space and drops empty pieces;
# `str.split(separator)` keeps them.
function py.method.split(self: Any, separator?: Any, maximum?: Any) -> Any
kernel 1
charge sum(8, size(self), size(separator), size(result))
body {
  if same(kind(self), "bytes") {
    let value = invoke py.bytes_text(self)
    let needle = separator
    if bool.not(same(separator, absent)) { if bool.not(same(separator, null)) { set needle = invoke py.bytes_text(separator) } }
    let parts = invoke py.text.split(value, needle, maximum, false, true)
    let out = []
    for part in parts { set out[list.len(out)] = bytes.from_octets(text.to_code_points(part)) }
    return out
  }
  return invoke py.text.split(self, separator, maximum, false, false)
}

function py.method.strip(self: Any, characters?: Any) -> Text
kernel 1
charge sum(8, product(size(self), size(characters)), size(result))
body {
  let value = invoke py.text_of(self, "strip")
  if same(characters, absent) { return text.trim_u17_0_0(value) }
  if same(characters, null) { return text.trim_u17_0_0(value) }
  let chars = invoke py.text_of(characters, "strip")
  return text.trim_set(value, chars, true, true)
}

