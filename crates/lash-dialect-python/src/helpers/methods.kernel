function py.method.get(self: Any, key: Any, default?: Any) -> Any
kernel 1
charge sum(4, deep(key))
body {
  let k = kind(self)
  let mapping = same(k, "map")
  if same(k, "record") { set mapping = true }
  if mapping {
    let present = false
    if same(k, "map") {
      set present = map.contains(self, key)
    } else {
      if same(kind(key), "text") {
        set present = record.contains(self, key)
      }
    }
    if present {
      return self[key]
    }
    if same(default, absent) {
      return null
    }
    return default
  }
  do invoke py.no_attribute(self, "get")
  return null
}

