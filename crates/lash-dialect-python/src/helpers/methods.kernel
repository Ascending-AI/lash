# Methods of the built-in types. `value.name(...)` lowers to a call of
# `py.method.name` with the receiver first; the receiver's kind chooses what
# runs, and a kind that has no such method raises AttributeError.

use kind
use same
use eq
use lt
use le
use bool.not
use error.new
use add
use num.to_text
use sub
