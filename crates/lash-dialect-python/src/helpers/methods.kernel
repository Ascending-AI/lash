function py.method.as_integer_ratio(self: Any) -> Any
kernel 1
charge sum(262144, size(self), size(result))
body {
  if same(kind(self), "integer") { return (self, 1) }
  if bool.not(same(kind(self), "float")) { do invoke py.no_attribute(self, "as_integer_ratio") }
  if bool.not(is_finite(self)) {
    if is_nan(self) { do invoke py.fail("ValueError", "cannot convert NaN to integer ratio") }
    do invoke py.fail("OverflowError", "cannot convert Infinity to integer ratio")
  }
  let numerator = self
  let denominator = 1
  while bool.not(is_integer(numerator)) metered 2 { set numerator = mul(numerator, 2) set denominator = mul(denominator, 2) }
  return (num.to_int(numerator), denominator)
}

function py.method.bit_length(self: Any) -> Int
