function py.method.hex(self: Any) -> Text
kernel 1
charge sum(16384, size(self), size(result))
body {
  if bool.not(same(kind(self), "float")) { do invoke py.no_attribute(self, "hex") }
  if bool.not(is_finite(self)) { return invoke py.str(self) }
  let value = abs(self)
  let sign = ""
  let metadata = format.decimal_parts(self)
  if metadata[1] { set sign = "-" }
  if eq(value, 0) { return text.concat(sign, "0x0.0p+0") }
  let exponent = 0
  while le(2, value) metered 2 { set value = div(value, 2) set exponent = add(exponent, 1) }
  while lt(value, 1) metered 2 { if eq(exponent, -1022) { break } set value = mul(value, 2) set exponent = sub(exponent, 1) }
  let whole = num.to_int(floor(value))
  let fraction = sub(value, num.to_float(whole))
  let digits = []
  let i = 0
  while lt(i, 13) metered 2 { set fraction = mul(fraction, 16) let digit = num.to_int(floor(fraction)) set digits[i] = int.to_text(digit, 16) set fraction = sub(fraction, num.to_float(digit)) set i = add(i, 1) }
  let exp_sign = "+"
  if lt(exponent, 0) { set exp_sign = "-" }
  return text.join([sign, "0x", int.to_text(whole, 16), ".", text.join(digits, ""), "p", exp_sign, num.to_text(abs(exponent))], "")
}

