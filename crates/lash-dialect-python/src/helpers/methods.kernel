function py.method.difference(self: Any, other: Any) -> Any
kernel 1
charge sum(4, size(self), size(other))
body {
  if same(kind(self), "set") {
    let members = invoke py.to_set(other)
    let out = set{}
    for member in self {
      if bool.not(set.contains(members, member)) {
        set out[member] = true
      }
    }
    return out
  }
  do invoke py.no_attribute(self, "difference")
  return null
}

function py.method.join(self: Any, values: Any) -> Text
kernel 1
charge sum(4, deep(values), size(result))
body {
  if same(kind(self), "text") {
    let items = invoke py.to_list(values)
    let joined = text.join_or_index(items, self)
    if same(kind(joined), "text") { return joined }
    let item = items[joined]
    let name = invoke py.type(item)
    let message = text.join(["sequence item ", num.to_text(joined), ": expected str instance, ", name, " found"], "")
    do invoke py.fail("TypeError", message)
    return ""
  }
  do invoke py.no_attribute(self, "join")
  return ""
}

# `str.split()` splits on runs of white space and drops empty pieces;
# `str.split(separator)` keeps them.
function py.method.split(self: Any, separator?: Any) -> Any
kernel 1
charge sum(4, size(self), size(result))
body {
  if same(kind(self), "text") {
    let plain = same(separator, absent)
    if bool.not(plain) {
      set plain = same(separator, null)
    }
    if plain {
      let out = []
      let word = []
      for point in text.to_code_points(self) {
        let whitespace = invoke py.text.whitespace(point)
        if whitespace {
          if lt(0, list.len(word)) {
            set out[list.len(out)] = text.from_code_points(word)
            set word = []
          }
        } else {
          set word[list.len(word)] = point
        }
      }
      if lt(0, list.len(word)) { set out[list.len(out)] = text.from_code_points(word) }
      return out
    }
    let needle = invoke py.text_of(separator, "split")
    if same(needle, "") {
      do invoke py.fail("ValueError", "empty separator")
    }
    return text.split(self, needle)
  }
  do invoke py.no_attribute(self, "split")
  return null
}

