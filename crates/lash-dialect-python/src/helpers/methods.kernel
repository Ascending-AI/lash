# the answer is whether it had not ended yet.
function py.method.cancel(self: Any) -> Bool
kernel 1
charge 4
body {
  if same(kind(self), "task") {
    let live = list.contains(tasks.unfinished(), self)
    do cancel self
    return live
  }
  do invoke py.no_attribute(self, "cancel")
  return false
}

