function py.method.union(self: Any, args: Any, keywords: Any) -> Any
kernel 1
charge sum(8, size(self), deep(args), size(result))
body {
  if bool.not(same(kind(self), "set")) { do invoke py.no_attribute(self, "union") }
  if lt(0, map.len(keywords)) { do invoke py.fail("TypeError", "set methods take no keyword arguments") }
  let out = set.copy(self)
  for source in args {
    let members = invoke py.to_set(source)
    set out = invoke py.set_op("|", out, members)
  }
  return out
}

