# The `dataframe` fixture's surface (FIG-6917): two value types, the
# package functions, an error and the operations its runner serves.
function col(name: Text) -> expr = dataframe.col
function lit(value: Any) -> expr = dataframe.lit
function count() -> expr = dataframe.count
function width(row: List(Any)) -> Int = dataframe.width
type expr = Record{op: Text, args: List(Any), name: Text}
  method neq(self: expr, other: expr) -> expr = dataframe.expr.neq
  method alias(self: expr, name: Text) -> expr = dataframe.expr.alias
  method sort(self: expr, options: Union(Record{ascending?: Bool}, Absent)) -> expr = dataframe.expr.sort
  property name(self: expr) -> Text = dataframe.expr.name
type data_quanta = Record{source: Text, plan: List(Record{step: Text, exprs: List(expr), callback?: Fn(value: Any) -> Any, n?: Int})}
  static read_text(text: Text) -> data_quanta = dataframe.data_quanta.read_text
  method flat_map(self: data_quanta, f: Fn(value: Any) -> Any, options: Record{output?: Text, where?: expr}) -> data_quanta = dataframe.data_quanta.flat_map
  method filter(self: data_quanta, predicate: expr) -> data_quanta = dataframe.data_quanta.filter
  method reduce_by_key(self: data_quanta, keys: List(expr), aggregates: List(expr)) -> data_quanta = dataframe.data_quanta.reduce_by_key
  method sort(self: data_quanta, ...keys: List(expr)) -> data_quanta = dataframe.data_quanta.sort
  method limit(self: data_quanta, n: Int) -> data_quanta = dataframe.data_quanta.limit
  async method collect_rows(self: data_quanta) -> List(Any) = dataframe.data_quanta.collect_rows
  async method explain(self: data_quanta) -> Text = dataframe.data_quanta.explain
error execution_error
operation run(plan: Any) -> List(Any) contract "dataframe.run/1"
internal operation explain(plan: Any) -> Text contract "dataframe.explain/1"
