# ThisNumberValue: unlike Number(), prototype methods never coerce receivers.
function ts.number.receiver(value: Any) -> Number
kernel 1
errors "type_error"
charge 8
body {
  let receiver = invoke ts.receiver(value)
  if same(receiver, "number") { return value }
  throw error.new("type_error", "Number receiver required", null)
}

