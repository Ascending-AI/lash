function ts.number.isSafeInteger(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(args), deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let value = args[0]
  let k = invoke ts.receiver(value)
  if same(k, "number") {} else { return false }
  if num.is_integer(value) { return num.le(num.abs(value), 9007199254740991.0) }
  return false
}

