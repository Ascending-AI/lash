function ts.math.hypot(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let values = []
  let infinite = false
  let invalid = false
  let scale = 0.0
  for arg in args {
    let value = invoke ts.to_number(arg)
    set value = num.abs(value)
    if eq(value, inf) { set infinite = true }
    if num.is_nan(value) { set invalid = true }
    set scale = num.max(scale, value)
    set values[list.len(values)] = value
  }
  if infinite { return inf }
  if invalid { return nan }
  if eq(scale, 0) { return 0.0 }
  let sum = 0.0
  for value in values {
    let scaled = num.div(value, scale)
    set sum = num.add(sum, num.mul(scaled, scaled))
  }
  return num.mul(scale, math.sqrt(sum))
}

function ts.math.imul(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_30 = args[0]
let a = invoke ts.to_int32(builtin_arg_30)
  let builtin_arg_31 = args[1]
let b = invoke ts.to_int32(builtin_arg_31)
  let builtin_arg_32 = num.mul(a, b)
let output = invoke ts.wrap_int32(builtin_arg_32)
  return num.to_float(output)
}

function ts.math.clz32(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let builtin_arg_33 = args[0]
let value = invoke ts.to_int32(builtin_arg_33)
  set value = int.rem_floor(value, 4294967296)
  let count = 32.0
  while num.lt(0, value) {
    set count = num.sub(count, 1.0)
    set value = int.div_floor(value, 2)
  }
  return count
}

function ts.math.fround(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let builtin_arg_34 = args[0]
let value = invoke ts.to_number(builtin_arg_34)
  if num.is_finite(value) {} else { return value }
  if eq(value, 0) { return value }
  let sign = 1.0
  if num.lt(value, 0) { set sign = -1.0 }
  let magnitude = num.abs(value)
  let quantum = 1.401298464324817e-45
  let binade = 1.1754943508222875e-38
  while num.le(num.mul(binade, 2.0), magnitude) {
    set binade = num.mul(binade, 2.0)
    set quantum = num.mul(quantum, 2.0)
  }
  let rounded = num.mul(num.round_even(num.div(magnitude, quantum)), quantum)
  if num.le(3.4028235677973366e38, rounded) { return num.mul(sign, inf) }
  return num.mul(sign, rounded)
}

