# JavaScript json behavior, expressed in kernel code.
use ts.callable
use ts.console.json
use date.ecma.format
use eq
use error.new
use float.to_int
use json.parse
use json.stringify
use kind
use list.contains
use list.len
use num.add
use num.is_finite
use num.is_nan
use num.lt
use num.max
use num.min
use num.sub
use num.trunc
use record.contains
use record.keys
use record.len
use record.values
use ref
use same
use set.contains
use text.compare
use text.concat
use text.ends_with
use text.join
use text.repeat
use text.utf16_len
use text.utf16_slice
use ts.delete
use ts.get
use ts.json.parse
use ts.json.plain
use ts.json.stringify
use ts.json.stringify_generic
use ts.keys
use ts.number.to_string
use ts.object.own_keys
use ts.pad
use ts.receiver
use ts.set
use ts.to_property_key
use ts.to_string

function ts.json.parse(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_0 = args[0]
let text = invoke ts.to_string(builtin_arg_0)
  let value = absent
  try { set value = json.parse(text, "float", "float") } catch invalid {
    throw error.new("SyntaxError", "Invalid JSON", null)
  }
  let reviver = args[1]
  set reviver = invoke ts.callable(reviver)
  if same(kind(reviver), "closure") {
    let visit = absent
    set visit = fn(holder, key) {
      let value = invoke ts.get(holder, key)
      let k = kind(value)
      let object = same(k, "record")
      if same(k, "list") { set object = true }
      if object {
        let keys = invoke ts.keys(value)
        for child in keys {
          let revived = apply visit(value, child)
          if same(kind(revived), "absent") { do invoke ts.delete(value, child) } else { do invoke ts.set(value, child, revived) }
        }
      }
      let passed = [key, value]
      let output = apply reviver(holder, passed)
      return output
    }
    let holder = {"": value}
    let output = apply visit(holder, "")
    return output
  }
  return value
}

# JSON.stringify's own walk: every hook, replacer, gap and kind JSON
# writes, value by value.
function ts.json.stringify_generic(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 3)
  let replacer = args[1]
  set replacer = invoke ts.callable(replacer)
  let allowed = absent
  if same(kind(replacer), "list") {
    set allowed = []
    for item in replacer {
      let k = invoke ts.receiver(item)
      if same(k, "text") {
        if list.contains(allowed, item) {} else { set allowed[list.len(allowed)] = item }
      }
      if same(k, "number") {
        let item = invoke ts.to_string(item)
        if list.contains(allowed, item) {} else { set allowed[list.len(allowed)] = item }
      }
    }
  }
  let gap = ""
  let space = args[2]
  let k = invoke ts.receiver(space)
  if same(k, "number") {
    let count = num.min(10.0, num.max(0.0, num.trunc(space)))
    if num.is_nan(count) { set count = 0.0 }
    set gap = text.repeat(" ", float.to_int(count))
  }
  if same(k, "text") { set gap = text.utf16_slice(space, 0, num.min(10, text.utf16_len(space))) }
  # Every value writes its fragments to `out`, which is joined once: the
  # text is copied once whatever its depth. A value JSON skips writes
  # nothing and answers false.
  let out = []
  let stack = set{}
  let serialize = absent
  set serialize = fn(holder, key, indent) {
    let value = invoke ts.get(holder, key)
    if same(value, ()) { set value = absent }
    let k = kind(value)
    if same(k, "record") {
      let to_json = value.toJSON
      set to_json = invoke ts.callable(to_json)
      if same(kind(to_json), "closure") {
        let name = invoke ts.to_property_key(key)
        let passed = [name]
        set value = apply to_json(value, passed)
      } else {
        let brand = value.brand
        if same(brand, "date.invalid") { set value = null }
        if same(brand, "url.whatwg") { set value = value.state.href }
      }
    }
    if same(k, "timestamp") { set value = date.ecma.format(value, "iso") }
    if same(kind(replacer), "closure") {
      let name = invoke ts.to_property_key(key)
      let passed = [name, value]
      set value = apply replacer(holder, passed)
    }
    let k = invoke ts.receiver(value)
    if same(k, "absent") { return false }
    if same(k, "closure") { return false }
    if same(k, "builtin") {
      if text.ends_with(value[1], ".prototype") { throw error.new("TS_REFLECTION_UNSUPPORTED", "A built-in prototype as JSON is outside the TypeScript dialect", null) }
      set out[list.len(out)] = "{}"
      return true
    }
    if same(k, "number") {
      let rendered = "null"
      if num.is_finite(value) { set rendered = invoke ts.number.to_string(value) }
      set out[list.len(out)] = rendered
      return true
    }
    if same(k, "text") { set out[list.len(out)] = json.stringify(value) return true }
    if same(k, "bool") {
      if value { set out[list.len(out)] = "true" } else { set out[list.len(out)] = "false" }
      return true
    }
    if same(k, "null") { set out[list.len(out)] = "null" return true }
    let array = same(k, "list")
    let object = same(k, "record")
    if array {} else { if object {} else { set out[list.len(out)] = "{}" return true } }
    let identity = ref(value)
    if set.contains(stack, identity) { throw error.new("type_error", "Converting circular structure to JSON", null) }
    set stack[identity] = true
    let next_indent = text.concat(indent, gap)
    # An array's keys are its indexes as numbers, read without spelling
    # them; a callback that sees a key is given its text.
    let keys = []
    if array {
      let i = 0.0
      while num.lt(i, list.len(value)) { set keys[list.len(keys)] = i set i = num.add(i, 1.0) }
    } else {
      if same(kind(allowed), "absent") { set keys = invoke ts.object.own_keys(value) } else { set keys = allowed }
    }
    let colon = ":"
    if same(gap, "") {} else { set colon = ": " }
    let open = ""
    if same(gap, "") {} else { set open = text.concat("\n", next_indent) }
    if array { set out[list.len(out)] = "[" } else { set out[list.len(out)] = "{" }
    let written = 0
    for child in keys {
      let mark = list.len(out)
      if eq(written, 0) {} else { set out[list.len(out)] = "," }
      if same(gap, "") {} else { set out[list.len(out)] = open }
      if array {} else {
        set out[list.len(out)] = json.stringify(child)
        set out[list.len(out)] = colon
      }
      let wrote = apply serialize(value, child, next_indent)
      if wrote {} else {
        if array { set out[list.len(out)] = "null" } else {
          while num.lt(mark, list.len(out)) { remove out[num.sub(list.len(out), 1)] }
        }
      }
      if eq(mark, list.len(out)) {} else { set written = num.add(written, 1) }
    }
    set stack[identity] = false
    if eq(written, 0) {} else {
      if same(gap, "") {} else { set out[list.len(out)] = text.concat("\n", indent) }
    }
    if array { set out[list.len(out)] = "]" } else { set out[list.len(out)] = "}" }
    return true
  }
  let holder = {"": args[0]}
  let wrote = apply serialize(holder, "", "")
  if wrote { return text.join(out, "") }
  return absent
}

# Whether JSON.stringify writes `value` as the console's JSON render does:
# a list, a record or a scalar whose containers hold only lists, records,
# null, bools, text and finite numbers. A record with a `toJSON` or a
# `brand` field, or with a key that begins with a digit (an index key, which
# JSON writes before the others), is not plain. Neither is a value with more
# than 128 values in all, counting each place a shared one is held, or with
# containers more than eight deep, so a cycle is not plain either. A
# container's size is compared with what is left of the 128 before any of
# its members is read, so the guard costs at most a fixed charge, one for
# each container and one for each value it reads, and twice its keys'
# bytes, whatever the value's size.
function ts.json.plain(value: Any) -> Bool
kernel 1
charge 1
body {
  let k = kind(value)
  if same(k, "text") { return true }
  if same(k, "float") { return num.is_finite(value) }
  if same(k, "bool") { return true }
  if same(k, "null") { return true }
  let container = same(k, "record")
  if same(k, "list") { set container = true }
  if container {} else { return same(k, "integer") }
  # The containers to read, breadth first, with the depth of their members.
  # The counts are floats, which compare more cheaply than integers.
  let containers = [value]
  let depths = [2.0]
  let visits = 1.0
  let next = 0.0
  while num.lt(next, list.len(containers)) {
    let items = containers[next]
    let depth = depths[next]
    set next = num.add(next, 1.0)
    if same(kind(items), "record") {
      if num.lt(128.0, num.add(visits, record.len(items))) { return false }
      if record.contains(items, "toJSON") { return false }
      if record.contains(items, "brand") { return false }
      for key in record.keys(items) {
        if same(text.compare(key, ":"), -1) {
          if same(text.compare(key, "0"), -1) {} else { return false }
        }
      }
      set items = record.values(items)
    } else {
      if num.lt(128.0, num.add(visits, list.len(items))) { return false }
    }
    set visits = num.add(visits, list.len(items))
    for item in items {
      let k = kind(item)
      if same(k, "text") { continue }
      if same(k, "float") {
        if num.is_finite(item) { continue }
        return false
      }
      if same(k, "bool") { continue }
      if same(k, "null") { continue }
      let container = same(k, "record")
      if same(k, "list") { set container = true }
      if container {
        if num.lt(8.0, depth) { return false }
        set containers[list.len(containers)] = item
        set depths[list.len(depths)] = num.add(depth, 1.0)
        continue
      }
      if same(k, "integer") { continue }
      return false
    }
  }
  return true
}

# JSON.stringify(value, replacer, space). Plain data (`ts.json.plain`) with
# no replacer and no space is written by the console's one native pass;
# anything else takes the generic walk, which writes the same text for
# plain data. The common call, with the value alone, is not padded.
function ts.json.stringify(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let value = absent
  let bare = same(list.len(args), 1)
  if bare { set value = args[0] } else {
    let padded = invoke ts.pad(args, 3)
    if same(padded[1], absent) {
      if same(padded[2], absent) {
        set value = padded[0]
        set bare = true
      }
    }
  }
  if bare {
    let plain = invoke ts.json.plain(value)
    if plain {
      let text = invoke ts.console.json(value)
      return text
    }
  }
  let text = invoke ts.json.stringify_generic(this, args)
  return text
}
