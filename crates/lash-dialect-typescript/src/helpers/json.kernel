# JavaScript json behavior, expressed in kernel code.
use ts.callable
use date.ecma.format
use eq
use error.new
use float.to_int
use json.parse
use json.stringify
use kind
use list.contains
use list.len
use num.add
use num.is_finite
use num.is_nan
use num.lt
use num.max
use num.min
use num.sub
use num.trunc
use ref
use same
use set.contains
use text.concat
use text.ends_with
use text.join
use text.repeat
use text.utf16_len
use text.utf16_slice
use ts.delete
use ts.get
use ts.json.parse
use ts.json.stringify
use ts.keys
use ts.number.to_string
use ts.object.own_keys
use ts.pad
use ts.receiver
use ts.set
use ts.to_property_key
use ts.to_string

function ts.json.parse(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_0 = args[0]
let text = invoke ts.to_string(builtin_arg_0)
  let value = absent
  try { set value = json.parse(text, "float", "float") } catch invalid {
    throw error.new("SyntaxError", "Invalid JSON", null)
  }
  let reviver = args[1]
  set reviver = invoke ts.callable(reviver)
  if same(kind(reviver), "closure") {
    let visit = absent
    set visit = fn(holder, key) {
      let value = invoke ts.get(holder, key)
      let k = kind(value)
      let object = same(k, "record")
      if same(k, "list") { set object = true }
      if object {
        let keys = invoke ts.keys(value)
        for child in keys {
          let revived = apply visit(value, child)
          if same(kind(revived), "absent") { do invoke ts.delete(value, child) } else { do invoke ts.set(value, child, revived) }
        }
      }
      let passed = [key, value]
      let output = apply reviver(holder, passed)
      return output
    }
    let holder = {"": value}
    let output = apply visit(holder, "")
    return output
  }
  return value
}

function ts.json.stringify(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 3)
  let replacer = args[1]
  set replacer = invoke ts.callable(replacer)
  let allowed = absent
  if same(kind(replacer), "list") {
    set allowed = []
    for item in replacer {
      let k = invoke ts.receiver(item)
      if same(k, "text") {
        if list.contains(allowed, item) {} else { set allowed[list.len(allowed)] = item }
      }
      if same(k, "number") {
        let item = invoke ts.to_string(item)
        if list.contains(allowed, item) {} else { set allowed[list.len(allowed)] = item }
      }
    }
  }
  let gap = ""
  let space = args[2]
  let k = invoke ts.receiver(space)
  if same(k, "number") {
    let count = num.min(10.0, num.max(0.0, num.trunc(space)))
    if num.is_nan(count) { set count = 0.0 }
    set gap = text.repeat(" ", float.to_int(count))
  }
  if same(k, "text") { set gap = text.utf16_slice(space, 0, num.min(10, text.utf16_len(space))) }
  # Every value writes its fragments to `out`, which is joined once: the
  # text is copied once whatever its depth. A value JSON skips writes
  # nothing and answers false.
  let out = []
  let stack = set{}
  let serialize = absent
  set serialize = fn(holder, key, indent) {
    let value = invoke ts.get(holder, key)
    if same(value, ()) { set value = absent }
    let k = kind(value)
    if same(k, "record") {
      let to_json = value.toJSON
      set to_json = invoke ts.callable(to_json)
      if same(kind(to_json), "closure") {
        let name = invoke ts.to_property_key(key)
        let passed = [name]
        set value = apply to_json(value, passed)
      } else {
        let brand = value.brand
        if same(brand, "date.invalid") { set value = null }
        if same(brand, "url.whatwg") { set value = value.state.href }
      }
    }
    if same(k, "timestamp") { set value = date.ecma.format(value, "iso") }
    if same(kind(replacer), "closure") {
      let name = invoke ts.to_property_key(key)
      let passed = [name, value]
      set value = apply replacer(holder, passed)
    }
    let k = invoke ts.receiver(value)
    if same(k, "absent") { return false }
    if same(k, "closure") { return false }
    if same(k, "builtin") {
      if text.ends_with(value[1], ".prototype") { throw error.new("TS_REFLECTION_UNSUPPORTED", "A built-in prototype as JSON is outside the TypeScript dialect", null) }
      set out[list.len(out)] = "{}"
      return true
    }
    if same(k, "number") {
      let rendered = "null"
      if num.is_finite(value) { set rendered = invoke ts.number.to_string(value) }
      set out[list.len(out)] = rendered
      return true
    }
    if same(k, "text") { set out[list.len(out)] = json.stringify(value) return true }
    if same(k, "bool") {
      if value { set out[list.len(out)] = "true" } else { set out[list.len(out)] = "false" }
      return true
    }
    if same(k, "null") { set out[list.len(out)] = "null" return true }
    let array = same(k, "list")
    let object = same(k, "record")
    if array {} else { if object {} else { set out[list.len(out)] = "{}" return true } }
    let identity = ref(value)
    if set.contains(stack, identity) { throw error.new("type_error", "Converting circular structure to JSON", null) }
    set stack[identity] = true
    let next_indent = text.concat(indent, gap)
    # An array's keys are its indexes as numbers, read without spelling
    # them; a callback that sees a key is given its text.
    let keys = []
    if array {
      let i = 0.0
      while num.lt(i, list.len(value)) { set keys[list.len(keys)] = i set i = num.add(i, 1.0) }
    } else {
      if same(kind(allowed), "absent") { set keys = invoke ts.object.own_keys(value) } else { set keys = allowed }
    }
    let colon = ":"
    if same(gap, "") {} else { set colon = ": " }
    let open = ""
    if same(gap, "") {} else { set open = text.concat("\n", next_indent) }
    if array { set out[list.len(out)] = "[" } else { set out[list.len(out)] = "{" }
    let written = 0
    for child in keys {
      let mark = list.len(out)
      if eq(written, 0) {} else { set out[list.len(out)] = "," }
      if same(gap, "") {} else { set out[list.len(out)] = open }
      if array {} else {
        set out[list.len(out)] = json.stringify(child)
        set out[list.len(out)] = colon
      }
      let wrote = apply serialize(value, child, next_indent)
      if wrote {} else {
        if array { set out[list.len(out)] = "null" } else {
          while num.lt(mark, list.len(out)) { remove out[num.sub(list.len(out), 1)] }
        }
      }
      if eq(mark, list.len(out)) {} else { set written = num.add(written, 1) }
    }
    set stack[identity] = false
    if eq(written, 0) {} else {
      if same(gap, "") {} else { set out[list.len(out)] = text.concat("\n", indent) }
    }
    if array { set out[list.len(out)] = "]" } else { set out[list.len(out)] = "}" }
    return true
  }
  let holder = {"": args[0]}
  let wrote = apply serialize(holder, "", "")
  if wrote { return text.join(out, "") }
  return absent
}
