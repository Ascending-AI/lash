# Calling the constructor without NewTarget never reads the iterable.
function ts.set.call(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge 4
body {
  throw error.new("type_error", "Set requires new", null)
}

function ts.set.construct(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let output = set{}
  let source = args[0]
  let empty = invoke ts.is_nullish(source)
  if empty {} else {
    let values = invoke ts.iterate(source)
    for value in values {
      let key = invoke ts.map.key(value)
      set output[key] = true
    }
  }
  return output
}

function ts.set.is(value: Any) -> Bool
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  return same(kind(value), "set")
}

function ts.set.size(this: Any) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  return num.to_float(set.len(this))
}

function ts.set.add(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let builtin_arg_0 = args[0]
let key = invoke ts.map.key(builtin_arg_0)
  set this[key] = true
  return this
}

function ts.set.has(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let builtin_arg_1 = args[0]
let key = invoke ts.map.key(builtin_arg_1)
  return set.contains(this, key)
}

function ts.set.delete(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let builtin_arg_2 = args[0]
let key = invoke ts.map.key(builtin_arg_2)
  let had = set.contains(this, key)
  set this[key] = false
  return had
}

function ts.set.clear(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  for key in set.values(this) { set this[key] = false }
  return absent
}

function ts.set.values(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let output = []
  for key in this {
    let value = invoke ts.map.value(key)
    set output[list.len(output)] = value
  }
  return output
}

function ts.set.entries(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let output = []
  for key in this {
    let value = invoke ts.map.value(key)
    set output[list.len(output)] = [value, value]
  }
  return output
}

function ts.set.forEach(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 2)
  let callback = args[0]
  set callback = invoke ts.callable(callback)
  let receiver = args[1]
  for key in this {
    let value = invoke ts.map.value(key)
    let passed = [value, value, this]
    do apply callback(receiver, passed)
  }
  return absent
}

function ts.set.other(other: Any) -> Any
kernel 1
errors "type_error", "TS_METHOD_UNSUPPORTED"
charge sum(16, deep(other))
body {
  let k = kind(other)
  if same(k, "set") { return other }
  if same(k, "map") { return other }
  let size = invoke ts.get(other, "size")
  let size = invoke ts.to_number(size)
  if num.is_nan(size) { throw error.new("type_error", "size property is not a number", null) }
  let has = invoke ts.get(other, "has")
  set has = invoke ts.callable(has)
  if same(kind(has), "closure") {} else { throw error.new("type_error", "has property is not callable", null) }
  let keys = invoke ts.get(other, "keys")
  set keys = invoke ts.callable(keys)
  if same(kind(keys), "closure") {} else { throw error.new("type_error", "keys property is not callable", null) }
  throw error.new("TS_METHOD_UNSUPPORTED", "Set algebra accepts a Set or Map, not guest has/keys callbacks", null)
}

function ts.set.contains_other(other: Any, key: Any) -> Bool
kernel 1
charge 4
body {
  if same(kind(other), "map") { return map.contains(other, key) }
  return set.contains(other, key)
}

function ts.set.other_size(other: Any) -> Number
kernel 1
charge 4
body {
  if same(kind(other), "map") { return num.to_float(map.len(other)) }
  return num.to_float(set.len(other))
}

function ts.set.union(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = args[0]
  let other = invoke ts.set.other(other)
  let output = set{}
  for key in this {
    set output[key] = true
  }
  for key in other {
    set output[key] = true
  }
  return output
}

function ts.set.intersection(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "TS_METHOD_UNSUPPORTED"
charge sum(8, deep(result))
body {
  if same(kind(this), "set") {} else { throw error.new("type_error", "Set receiver required", null) }
  let args = invoke ts.pad(args, 1)
  let other = args[0]
  let other = invoke ts.set.other(other)
  let output = set{}
  let size = invoke ts.set.other_size(other)
  if num.le(set.len(this), size) {
    for key in this {
      let present = invoke ts.set.contains_other(other, key)
      if present { set output[key] = true }
    }
  } else {
    for key in other {
      if set.contains(this, key) { set output[key] = true }
    }
  }
  return output
}

