# JavaScript number_primitive behavior, expressed in kernel code.
use bool.not
use eq
use text.utf16_get
use text.utf16_len
use float.parse
use format.decimal_parts
use float.to_int
use int.div_trunc
use int.pow
use int.rem_trunc
use int.to_text
use kind
use num.abs
use num.add
use num.floor
use num.is_nan
use num.le
use num.lt
use num.mul
use num.neg
use num.sub
use num.to_float
use num.to_int
use same
use text.concat
use text.len
use text.repeat
use text.slice
use text.trim_set
use ts.string.trim_value
use ts.number.digit
use ts.number.layout
use ts.number.parse
use ts.number.parse_decimal
use ts.number.parse_int
use ts.number.parts
use ts.number.ratio
use ts.number.round_decimal
use ts.number.to_string

# ECMA-262 Tables 31 and 32: WhiteSpace (including BOM, excluding NEL)
# and LineTerminator. The kernel trims a caller-supplied scalar set; the
# dialect owns this set. Every member is a whole BMP scalar, so removing
# it cannot split a UTF-16 surrogate pair.
function ts.string.trim_value(text: Text, leading: Bool, trailing: Bool) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, size(text))
body {
  return text.trim_set(text, "\u{0009}\u{000a}\u{000b}\u{000c}\u{000d} \u{00a0}\u{1680}\u{2000}\u{2001}\u{2002}\u{2003}\u{2004}\u{2005}\u{2006}\u{2007}\u{2008}\u{2009}\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}\u{feff}", leading, trailing)
}

function ts.number.digit(character: Text, radix: Int) -> Int
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if eq(text.utf16_len(character), 1) {} else { return -1 }
  let unit = text.utf16_get(character, 0)
  let value = -1
  if num.le(48, unit) { if num.le(unit, 57) { set value = num.sub(unit, 48) } }
  if num.le(97, unit) { if num.le(unit, 122) { set value = num.sub(unit, 87) } }
  if num.le(65, unit) { if num.le(unit, 90) { set value = num.sub(unit, 55) } }
  if num.lt(value, radix) { return value }
  return -1
}

function ts.number.parse_int(source: Text, radix: Int, whole: Bool) -> Number
kernel 1
errors "type_error", "RangeError"
charge sum(12, product(size(source), size(source)))
body {
  let source = invoke ts.string.trim_value(source, true, true)
  let length = text.len(source)
  let i = 0
  let sign = 1.0
  let first = text.slice(source, 0, 1)
  if same(first, "-") { set sign = -1.0 set i = 1 }
  if same(first, "+") { set i = 1 }
  let base = radix
  if eq(base, 0) { set base = 10 }
  if num.lt(base, 2) { return nan }
  if num.lt(36, base) { return nan }
  if eq(radix, 0) {
    let prefix = text.slice(source, i, num.add(i, 2))
    if same(prefix, "0x") { set base = 16 }
    if same(prefix, "0X") { set base = 16 }
  }
  if eq(base, 16) {
    let prefix = text.slice(source, i, num.add(i, 2))
    if same(prefix, "0x") { set i = num.add(i, 2) }
    if same(prefix, "0X") { set i = num.add(i, 2) }
  }
  let start = i
  let value = 0
  while num.lt(i, length) {
    let character = text.slice(source, i, num.add(i, 1))
    let digit = invoke ts.number.digit(character, base)
    if num.lt(digit, 0) { break }
    set value = num.add(num.mul(value, base), digit)
    set i = num.add(i, 1)
  }
  if eq(start, i) { return nan }
  if whole { if eq(i, length) {} else { return nan } }
  try { return num.mul(sign, num.to_float(value)) } catch overflow { return num.mul(sign, inf) }
}

function ts.number.parse_decimal(source: Text, whole: Bool) -> Number
kernel 1
errors "type_error", "RangeError"
charge sum(16, product(size(source), 20))
body {
  let source = invoke ts.string.trim_value(source, true, true)
  let length = text.len(source)
  let i = 0
  let sign = 1.0
  let first = text.slice(source, 0, 1)
  if same(first, "-") { set sign = -1.0 set i = 1 }
  if same(first, "+") { set i = 1 }
  if same(text.slice(source, i, num.add(i, 8)), "Infinity") {
    if whole { if eq(num.add(i, 8), length) {} else { return nan } }
    return num.mul(sign, inf)
  }
  let digits = 0
  while num.lt(i, length) {
    let builtin_arg_0 = text.slice(source, i, num.add(i, 1))
let d = invoke ts.number.digit(builtin_arg_0, 10)
    if num.lt(d, 0) { break }
    set digits = num.add(digits, 1)
    set i = num.add(i, 1)
  }
  if same(text.slice(source, i, num.add(i, 1)), ".") {
    set i = num.add(i, 1)
    while num.lt(i, length) {
      let builtin_arg_1 = text.slice(source, i, num.add(i, 1))
let d = invoke ts.number.digit(builtin_arg_1, 10)
      if num.lt(d, 0) { break }
      set digits = num.add(digits, 1)
      set i = num.add(i, 1)
    }
  }
  if eq(digits, 0) { return nan }
  let mantissa_end = i
  let marker = text.slice(source, i, num.add(i, 1))
  let exponential = same(marker, "e")
  if exponential {} else { set exponential = same(marker, "E") }
  if exponential {
    set i = num.add(i, 1)
    let next = text.slice(source, i, num.add(i, 1))
    if same(next, "+") { set i = num.add(i, 1) }
    if same(next, "-") { set i = num.add(i, 1) }
    let start = i
    while num.lt(i, length) {
      let builtin_arg_2 = text.slice(source, i, num.add(i, 1))
let d = invoke ts.number.digit(builtin_arg_2, 10)
      if num.lt(d, 0) { break }
      set i = num.add(i, 1)
    }
    if eq(start, i) { set i = mantissa_end }
  }
  if whole { if eq(i, length) {} else { return nan } }
  let prefix = text.slice(source, 0, i)
  try { return float.parse(prefix) } catch overflow { return num.mul(sign, inf) }
}

function ts.number.parse(source: Text) -> Number
kernel 1
errors "type_error", "RangeError"
charge sum(24, product(size(source), size(source)))
body {
  let source = invoke ts.string.trim_value(source, true, true)
  if same(source, "") { return 0.0 }
  let prefix = text.slice(source, 0, 2)
  let base = 0
  if same(prefix, "0x") { set base = 16 }
  if same(prefix, "0X") { set base = 16 }
  if same(prefix, "0b") { set base = 2 }
  if same(prefix, "0B") { set base = 2 }
  if same(prefix, "0o") { set base = 8 }
  if same(prefix, "0O") { set base = 8 }
  if num.lt(0, base) {
    let number_body = text.slice(source, 2, text.len(source))
    let first = text.slice(number_body, 0, 1)
    if same(first, "+") { return nan }
    if same(first, "-") { return nan }
    let parsed = invoke ts.number.parse_int(number_body, base, true)
    return parsed
  }
  let parsed = invoke ts.number.parse_decimal(source, true)
  return parsed
}

function ts.number.parts(value: Number) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  # Exact kernel integers have exact decimal digits, without binary64
  # rounding. All JavaScript floats use the shortest converter below.
  if same(kind(value), "integer") {
    let digits = int.to_text(num.abs(value), 10)
    let last = text.len(digits)
    let exponent = 0
    while num.lt(1, last) {
      if eq(text.utf16_get(digits, num.sub(last, 1)), 48) {
        set last = num.sub(last, 1)
        set exponent = num.add(exponent, 1)
      } else { break }
    }
    return (text.slice(digits, 0, last), exponent)
  }
  # The neutral primitive obtains shortest digits once. JavaScript's layout
  # and precision rounding stay in the consumers below.
  let parts = format.decimal_parts(value)
  return (parts[2], parts[3])
}

function ts.number.layout(digits: Text, point: Int, scientific: Bool) -> Text
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if scientific {
    let exponent = num.sub(point, 1)
    let mantissa = text.slice(digits, 0, 1)
    if num.lt(1, text.len(digits)) { set mantissa = text.concat(mantissa, text.concat(".", text.slice(digits, 1, text.len(digits)))) }
    let sign = ""
    if num.le(0, exponent) { set sign = "+" }
    return text.concat(mantissa, text.concat("e", text.concat(sign, int.to_text(exponent, 10))))
  }
  if num.le(point, 0) {
    let zeros = text.repeat("0", num.neg(point))
    return text.concat("0.", text.concat(zeros, digits))
  }
  if num.le(text.len(digits), point) {
    return text.concat(digits, text.repeat("0", num.sub(point, text.len(digits))))
  }
  return text.concat(text.slice(digits, 0, point), text.concat(".", text.slice(digits, point, text.len(digits))))
}

function ts.number.to_string(value: Number) -> Text
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if num.is_nan(value) { return "NaN" }
  if eq(value, inf) { return "Infinity" }
  if eq(value, -inf) { return "-Infinity" }
  if eq(value, 0) { return "0" }
  # Every integer below 2^53 is a float exactly, so its shortest digits
  # are its decimal digits.
  if eq(num.floor(value), value) {
    if num.lt(num.abs(value), 9007199254740992.0) { return int.to_text(num.to_int(value), 10) }
  }
  let parts = invoke ts.number.parts(value)
  let digits = parts[0]
  let point = num.add(text.len(digits), parts[1])
  let scientific = num.lt(point, -5)
  if num.lt(21, point) { set scientific = true }
  let output = invoke ts.number.layout(digits, point, scientific)
  if num.lt(value, 0) { return text.concat("-", output) }
  return output
}

function ts.number.ratio(value: Number) -> Any
kernel 1
errors "type_error", "RangeError"
charge 2200
body {
  let numerator = num.abs(value)
  let denominator = 1
  while bool.not(eq(numerator, num.floor(numerator))) {
    set numerator = num.mul(numerator, 2.0)
    set denominator = num.mul(denominator, 2)
  }
  return (float.to_int(numerator), denominator)
}

function ts.number.round_decimal(value: Number, shift: Int) -> Text
kernel 1
errors "type_error", "RangeError"
charge sum(2300, magnitude(shift))
body {
  let ratio = invoke ts.number.ratio(value)
  let numerator = ratio[0]
  let denominator = ratio[1]
  if num.le(0, shift) { set numerator = num.mul(numerator, int.pow(10, shift)) } else {
    set denominator = num.mul(denominator, int.pow(10, num.neg(shift)))
  }
  let rounded = int.div_trunc(numerator, denominator)
  let remainder = int.rem_trunc(numerator, denominator)
  if num.le(denominator, num.mul(remainder, 2)) { set rounded = num.add(rounded, 1) }
  return int.to_text(rounded, 10)
}
