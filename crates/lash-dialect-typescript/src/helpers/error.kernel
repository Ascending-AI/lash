function ts.error.toString(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let name = invoke ts.error.name(this)
  let message = invoke ts.get(this, "message")
  if same(kind(message), "absent") { set message = "" } else { set message = invoke ts.to_string(message) }
  if same(name, "") { return message }
  if same(message, "") { return name }
  return text.concat(name, text.concat(": ", message))
}
