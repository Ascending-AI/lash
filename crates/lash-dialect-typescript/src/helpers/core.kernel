function ts.has(target: Any, key: Any) -> Bool
kernel 1
errors "type_error", "TS_REFLECTION_UNSUPPORTED"
charge sum(12, deep(key))
body {
  let primitive = invoke ts.is_primitive(target)
  if primitive { throw error.new("type_error", "Cannot use 'in' to search in a value that is not an object", null) }
  let k = invoke ts.receiver(target)
  let name = invoke ts.to_property_key(key)
  if same(k, "error") {
    for inherited in ["name", "message", "toString", "constructor", "hasOwnProperty", "propertyIsEnumerable", "valueOf", "toLocaleString", "isPrototypeOf"] metered 2 {
      if same(name, inherited) { return true }
    }
  }
  let own = invoke ts.has_own(target, name)
  if own { return true }
  for inherited in ["valueOf", "toString", "hasOwnProperty", "constructor", "isPrototypeOf", "propertyIsEnumerable", "toLocaleString"] metered 2 {
    if same(name, inherited) { return true }
  }
  if same(k, "closure") {
    for inherited in ["call", "apply", "bind", "caller", "arguments"] metered 2 { if same(name, inherited) { return true } }
  }
  return false
}

# The keys `for...in` visits, as a new list.
function ts.keys(target: Any) -> List(Text)
kernel 1
charge sum(4, product(size(target), size(target)))
body {
  let k = kind(target)
  if same(k, "record") { if same(target.__lash_brand, ("typescript", "template")) {
    set target = target.items
    set k = "list"
  } }
  let hidden_fields = set{}
  if same(k, "record") { if same(target.__lash_brand, ("typescript", "arguments")) {
    set hidden_fields = target.hidden
    set target = target.properties
  } }
  let match = false
  let match_fields = []
  if same(k, "record") {
    let receiver = invoke ts.receiver(target)
    if same(receiver, "brand:typescript.template") {
      set target = target.items
      set k = "list"
    } else {
      if same(receiver, "brand:typescript.iterator") { return ["next"] }
      if same(receiver, "brand:typescript.regex_match") { set match = true }
      if match {} else { if same(receiver, "record") {} else { return [] } }
    }
    if match {
      for name in record.keys(target) {
        let hidden = false
        for internal in ["items", "__lash_brand", "__lash_built"] { if same(name, internal) { set hidden = true } }
        if hidden {} else { set match_fields[list.len(match_fields)] = name }
      }
      set target = target.items
      set k = "list"
    }
  }
  let keys = []
  if same(k, "error") {
    if same(kind(target.data), "record") {
      let attributes = target.data.nonEnumerable
      let properties = target.data.properties
      if same(kind(properties), "record") {
        for name in record.keys(properties) {
          let hidden = false
          if same(kind(attributes), "record") { set hidden = record.contains(attributes, name) }
          if hidden {} else { set keys[list.len(keys)] = name }
        }
      }
    }
    return keys
  }
  if same(k, "text") {
    let position = 0.0
    let length = text.utf16_len(target)
    while num.lt(position, length) {
      let key = invoke ts.number.format_value(position)
      set keys[list.len(keys)] = key
      set position = num.add(position, 1)
    }
    return keys
  }
  if same(k, "record") {
    let numeric = []
    let other = []
    for key in record.keys(target) {
      if set.contains(hidden_fields, key) { continue }
      # The text of an index begins with a digit, as ts.list_index reads it.
      let index = -1.0
      let first = text.slice(key, 0, 1)
      if num.lt(text.compare(first, "0"), 0) {} else {
        if num.lt(0, text.compare(first, "9")) {} else { set index = invoke ts.list_index(key, 4294967295.0) }
      }
      if num.le(0, index) {
        let position = list.len(numeric)
        set numeric[position] = index
        while num.lt(0, position) {
          let previous = num.sub(position, 1)
          if num.le(numeric[previous], index) { break }
          set numeric[position] = numeric[previous]
          set position = previous
        }
        set numeric[position] = index
      } else { set other[list.len(other)] = key }
    }
    for index in numeric {
      let key = invoke ts.number.format_value(index)
      set keys[list.len(keys)] = key
    }
    for key in other { set keys[list.len(keys)] = key }
    return keys
  }
  if same(k, "list") {
    let position = 0.0
    while num.lt(position, list.len(target)) {
      if same(target[position], ()) {} else {
        let key = invoke ts.number.format_value(position)
        set keys[list.len(keys)] = key
      }
      set position = num.add(position, 1)
    }
  }
  if match {
    for name in match_fields { set keys[list.len(keys)] = name }
  }
  return keys
}

# Copies the own properties of `source` onto `target`: an object spread.
function ts.assign(target: Any, source: Any) -> Any
kernel 1
charge sum(4, product(size(source), size(source)))
body {
  let keys = invoke ts.keys(source)
  for key in keys {
    let value = invoke ts.get(source, key)
    set target[key] = value
  }
  return target
}

# The own properties of `source` whose names are not in `taken`, as a new
# object: an object pattern's rest.
function ts.object_rest(source: Any, taken: List(Text)) -> Any
kernel 1
errors "type_error"
charge sum(4, product(size(source), size(source)), size(taken))
body {
  do invoke ts.require_object_coercible(source)
  let skip = set{}
  for name in taken {
    set skip[name] = true
  }
  let rest = {}
  let keys = invoke ts.keys(source)
  for name in keys {
    if skip[name] {} else {
      let value = invoke ts.get(source, name)
      set rest[name] = value
    }
  }
  return rest
}

# Guest arrays cross a host boundary as plain data. A value that holds no
# hole, no absent and no tuple anywhere a deep copy reads, no cycle and
# nothing deeper than a copy takes, is what the copy and walk below would
# give: it crosses as it is, read once by a native pass. Anything else is
# copied first: replacing absent slots must never fill the guest's holes
# or change any guest alias. Each container of the copy is then visited
# once, without recursion: a hole or absent array slot becomes null, a
# built-in object's token anywhere is refused, and only a container is
# visited further. The token of a function the program made (its path is
# empty) is left as it is: the run's copy-out crosses it as a function
# value, or refuses it as no data (`K-EFF-002`). A built-in function is
# forwarded only by the supplied source-owned factory; otherwise it is refused.
# Frozen template records cross as their cooked/raw items, preserving guest state.
function ts.copy_boundary(value: Any, forward: Any) -> Any
kernel 1
errors "cyclic_value", "too_deep", "type_error", "not_data"
charge sum(4, deep(value))
body {
  if same(kind(value), "record") { if same(value.__lash_brand, ("typescript", "template")) { set value = value.items } }
  let convert = fn(child) {
    if same(kind(child), "record") { if same(child.__lash_brand, ("typescript", "template")) { return child.items } }
    if same(kind(child), "tuple") {
      if same(child, ()) { return child }
      if same(child[0], "ts.function") {
        if same(child[1], "") { return child }
        if same(kind(forward), "closure") {
          let wrapped = apply forward(child)
          return wrapped
        }
        throw error.new("not_data", "A built-in function is not data", null)
      }
      if same(child[0], "ts.object") { throw error.new("not_data", "A built-in object is not data", null) }
    }
    return child
  }
  let k = kind(value)
  if same(k, "tuple") { let converted = apply convert(value) return converted }
  if same(k, "set") { return set.copy_deep(value) }
  if collection.holds_none(value, set{"absent", "tuple"}) { return value }
  let copied = value
  if same(k, "list") { set copied = list.copy_deep(value) } else {
    if same(k, "record") { set copied = record.copy_deep(value) } else {
      if same(k, "map") { set copied = map.copy_deep(value) } else { return value }
    }
  }
  let pending = [copied]
  while num.lt(0, list.len(pending)) metered 2 {
    let last = num.sub(list.len(pending), 1)
    let item = pending[last]
    remove pending[last]
    let keys = []
    if same(kind(item), "list") {
      let index = 0
      while num.lt(index, list.len(item)) {
        set keys[list.len(keys)] = index
        set index = num.add(index, 1)
      }
    } else {
      if same(kind(item), "record") { set keys = record.keys(item) } else { set keys = map.keys(item) }
    }
    for key in keys {
      let child = item[key]
      if same(kind(item), "list") {
        if same(child, ()) { set item[key] = null continue }
        if same(child, absent) { set item[key] = null continue }
      }
      let converted = apply convert(child)
      set item[key] = converted
      let ck = kind(converted)
      for container in ["list", "record", "map"] {
        if same(ck, container) { set pending[list.len(pending)] = converted }
      }
    }
  }
  return copied
}

# Console conversion has no authored forwarding factory: functions stay refused.
function ts.boundary(value: Any) -> Any
kernel 1
errors "cyclic_value", "too_deep", "type_error", "not_data"
charge sum(4, deep(value))
body {
  let copied = invoke ts.copy_boundary(value, absent)
  return copied
}

# The strict arguments object owns its indexed properties and independent length.
function ts.arguments(items: List(Any)) -> Any
kernel 1
charge sum(8, size(items))
body {
  let properties = {length: num.to_float(list.len(items))}
  let index = 0
  for value in items {
    let key = invoke ts.number.format_value(index)
    set properties[key] = value
    set index = num.add(index, 1)
  }
  let built = brand.built()
  return {__lash_brand: ("typescript", "arguments"), __lash_built: built, properties: properties, hidden: set{"length"}}
}

# The ordinary sleep operation takes durable whole milliseconds. The old
# timer boundary discarded sub-millisecond precision after validating it.
function ts.sleep_duration(milliseconds: Any) -> Int
kernel 1
charge 1024
body {
  let number = milliseconds
  if bool.not(eq(kind(number), "integer")) {
    if bool.not(eq(kind(number), "float")) { throw error.new("type_error", "sleep takes a number of milliseconds") }
  }
  set number = num.to_float(number)
  if num.lt(number, 0.0) { throw error.new("number_range", "`sleep` takes a duration that is finite and not negative") }
  if bool.not(num.is_finite(number)) { throw error.new("number_range", "`sleep` takes a duration that is finite and not negative") }
  if num.le(9223372036854775807.0, number) { return 9223372036854775807 }
  return float.to_int(num.floor(number))
}

# FIG-7282: validate at the locale boundary; never consult host settings.
function ts.locale_arguments(args: List(Any), method: Text) -> Any
kernel 1
errors "TS_METHOD_UNSUPPORTED"
charge sum(12, size(method), size(result))
body {
  if num.lt(0, list.len(args)) {
    if same(args[0], absent) {} else {
      if same(args[0], "en-US") {} else {
        throw error.new("TS_METHOD_UNSUPPORTED", text.concat(method, " supports only () or ('en-US' or undefined), with no options; Date uses UTC"), null)
      }
    }
  }
  if num.lt(1, list.len(args)) {
    if same(args[1], absent) {} else {
      throw error.new("TS_METHOD_UNSUPPORTED", text.concat(method, " supports only () or ('en-US' or undefined), with no options; Date uses UTC"), null)
    }
  }
  return absent
}

# Called after arguments have evaluated, with the already-read method.
function ts.method_callable(value: Any, receiver: Any, name: Any) -> Any
kernel 1
errors "TS_METHOD_UNSUPPORTED", "type_error", "RangeError"
charge sum(512, size(name), size(result))
body {
  let method = invoke ts.callable(value)
  if same(name, absent) { return method }
  if same(kind(method), "closure") { return method }
  if same(kind(method), "function") { return method }
  let name = invoke ts.to_string(name)
  let receiver = invoke ts.receiver(receiver)
  throw error.new("TS_METHOD_UNSUPPORTED", text.concat("Method ", text.concat(name, text.concat(" is not callable on receiver ", receiver))), null)
}

function ts.number.checked(value: Float) -> Float
kernel 1
charge 1
native
body { return float.neg(float.neg(value)) }
