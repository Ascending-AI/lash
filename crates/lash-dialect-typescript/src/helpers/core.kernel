    let length = list.len(target.items)
    let position = invoke ts.list_index(name, length)
    return num.le(0, position)
  }
  if same(k, "brand:typescript.regex_match") {
    let name = invoke ts.to_property_key(key)
    if same(name, "length") { return true }
    for field in ["items", "__lash_brand", "__lash_built"] { if same(name, field) { return false } }
