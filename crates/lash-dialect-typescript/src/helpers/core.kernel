use text.utf16_len
use text.utf16_get
use text.utf16_slice
use text.concat
use text.len
use text.slice
use text.ends_with
use float.parse
use text.utf16_compare
use text.to_code_points
use list.copy_deep
use record.copy_deep
use map.copy_deep
use set.contains
use set.copy_deep
use map.entries
use ts.boundary
use list.len
use record.get
use record.contains
use record.keys
use json.stringify
use ts.regexp.escaped_source
