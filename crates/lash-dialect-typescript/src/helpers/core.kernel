# A package receiver is identified by its canonical (package, type) brand.
# The tag is derived for dialect dispatch; the brand is not a capability.
function ts.receiver(value: Any) -> Text
kernel 1
charge sum(3, size(result))
native
body {
  let k = kind(value)
  # The kinds most receivers have come first: a string's and an array's
  # methods, then an object's.
  if same(k, "text") {
    return k
  }
  if same(k, "list") {
    return k
  }
  if same(k, "record") {
    let brand = invoke brand.of(value)
    if same(brand, absent) {} else { return text.concat("brand:", text.concat(brand[0], text.concat(".", brand[1]))) }
    return k
  }
  if same(k, "float") {
    return "number"
  }
  if same(k, "integer") {
    return "bigint"
  }
  if same(k, "function") {
    return "closure"
  }
  if same(k, "tuple") {
    if same(value, ()) {} else {
      if same(value[0], "ts.function") { return "closure" }
      if same(value[0], "ts.object") { return "builtin" }
    }
  }
  return k
}

# A function value as what calls it: a built-in function's token as the
# closure it carries, and any other value as itself. A helper that calls a
# function the program gave it calls what this gives.
function ts.callable(value: Any) -> Any
kernel 1
charge 4
native
body {
  if same(kind(value), "tuple") {} else { return value }
  if same(value, ()) { return value }
  if same(value[0], "ts.function") { return value[4] }
  return value
}

# What `===` compares: a built-in function's token by its path, since each
# read of a built-in makes a new token; a function the program made, whose
# path is empty, by the closure it carries; and any other value as itself.
function ts.identity(value: Any) -> Any
kernel 1
charge 4
body {
  if same(kind(value), "tuple") {} else { return value }
  if same(value, ()) { return value }
  if same(value[0], "ts.function") {
    if same(value[1], "") { return value[4] }
    return ("ts.function", value[1])
  }
  return value
}

# What a built-in class called without `new` does when only `new` builds it.
function ts.requires_new(name: Text) -> Any
kernel 1
errors "type_error"
charge 4
body {
  throw error.new("type_error", text.concat("Constructor ", text.concat(name, " requires 'new'")), null)
}

