    if bool.not(record.contains(target, "__lash_brand")) {
      if same(kind(key), "text") { return record.contains(target, key) }
      let name = invoke ts.to_property_key(key)
      return record.contains(target, name)
    }
  }
  if same(k, "list") {
    let length = list.len(target)
    let position = invoke ts.number_index(key, length)
    if same(position, -2.0) {} else {
      if num.lt(position, 0) { return false }
      return bool.not(same(target[position], ()))
    }
  } else {
    do invoke ts.require_object_coercible(target)
  }
  let name = invoke ts.to_property_key(key)
  set k = invoke ts.receiver(target)
  let token = same(k, "builtin")
  if same(k, "closure") { if same(kind(target), "tuple") { set token = bool.not(same(target[1], "")) } }
  if token {
    let own = invoke ts.builtin_own(target[1])
    return record.contains(own, name)
  }
  if same(k, "closure") {
    if same(kind(target), "tuple") {
      for described in ["name", "length"] metered 2 {
        if same(name, described) { return bool.not(record.contains(target[5], name)) }
      }
    }
    # A function's own `prototype` carries attributes the dialect does not
    # keep, and so do the `name` and `length` of one it did not make.
    for described in ["name", "length", "prototype"] metered 2 {
      if same(name, described) { throw error.new("TS_REFLECTION_UNSUPPORTED", "Testing a function's own properties is outside the TypeScript dialect", null) }
    }
