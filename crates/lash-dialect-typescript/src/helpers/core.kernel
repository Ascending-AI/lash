  for object_kind in ["map", "set", "timestamp", "closure", "bool", "number", "bigint", "brand:date.ecma.invalid_date"] metered 2 {
    if same(k, object_kind) { return false }
  }
  if same(k, "brand:typescript.arguments") {
    let name = invoke ts.to_property_key(key)
    if same(name, "callee") { return true }
