kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let pair = invoke ts.numeric_pair(left, right)
  let a = pair[0]
  let b = pair[1]
  return num.mul(a, b)
}

function ts.div(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let pair = invoke ts.numeric_pair(left, right)
  let a = pair[0]
  let b = pair[1]
  if same(kind(a), "integer") {
    if eq(b, 0) { throw error.new("RangeError", "Division by zero", null) }
    return int.div_trunc(a, b)
  }
  return num.div(a, b)
}

function ts.rem(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let pair = invoke ts.numeric_pair(left, right)
  let a = pair[0]
  let b = pair[1]
  if same(kind(a), "integer") {
    if eq(b, 0) { throw error.new("RangeError", "Division by zero", null) }
  }
  return num.rem_trunc(a, b)
}

function ts.pow(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let pair = invoke ts.numeric_pair(left, right)
  let a = pair[0]
  let b = pair[1]
  if same(kind(a), "integer") {
    if num.lt(b, 0) { throw error.new("RangeError", "BigInt exponent must be nonnegative", null) }
    return int.pow(a, b)
  }
  if num.is_nan(b) {
    return nan
  }
  if eq(num.abs(a), 1) {
    if num.is_finite(b) {} else { return nan }
  }
  return float.pow(num.to_float(a), num.to_float(b))
}

function ts.neg(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(10, deep(value))
body {
  let number = invoke ts.to_numeric(value)
  return num.neg(number)
}

# ToInt32, as an integer.
function ts.to_int32(value: Any) -> Int
kernel 1
errors "type_error"
charge sum(12, deep(value))
body {
  let number = invoke ts.to_number(value)
  if num.is_finite(number) {} else {
    return 0
  }
  let wrapped = int.rem_floor(float.to_int(num.trunc(number)), 4294967296)
  if num.le(2147483648, wrapped) {
    return num.sub(wrapped, 4294967296)
  }
  return wrapped
}

# An integer reduced to the signed 32-bit range.
function ts.wrap_int32(value: Int) -> Int
kernel 1
charge 3
body {
  let wrapped = int.rem_floor(value, 4294967296)
  if num.le(2147483648, wrapped) {
    return num.sub(wrapped, 4294967296)
  }
  return wrapped
}

# The low five bits of a shift's right operand.
function ts.shift_count(value: Any) -> Int
kernel 1
errors "type_error"
charge sum(14, deep(value))
body {
  let count = invoke ts.to_int32(value)
  return int.rem_floor(count, 32)
}

# Combine the 32 bits after ECMAScript ToInt32; no unregistered native
# bit operations are assumed by the dialect.
function ts.bitwise32(left: Int, right: Int, operation: Text) -> Int
kernel 1
charge 1024
body {
  # Below 2^32 a float is exact, and float arithmetic is cheaper than
  # integer arithmetic.
  let a = num.to_float(int.rem_floor(left, 4294967296))
  let b = num.to_float(int.rem_floor(right, 4294967296))
  let conjunction = same(operation, "and")
  let disjunction = same(operation, "or")
  let weight = 1.0
  let result_value = 0.0
  # Once both operands have no bits left, every remaining bit is 0; for
  # "and", once either has none.
  while num.lt(0.0, num.add(a, b)) {
    if conjunction { if eq(num.min(a, b), 0.0) { break } }
    let x = num.rem_floor(a, 2.0)
    let y = num.rem_floor(b, 2.0)
    let bit = num.add(x, y)
    if conjunction { set bit = num.mul(x, y) } else {
      if disjunction { set bit = num.min(bit, 1.0) } else { set bit = num.rem_floor(bit, 2.0) }
    }
    set result_value = num.add(result_value, num.mul(weight, bit))
    set a = num.div_floor(a, 2.0)
    set b = num.div_floor(b, 2.0)
    set weight = num.mul(weight, 2.0)
  }
  let combined = float.to_int(result_value)
  let signed = invoke ts.wrap_int32(combined)
  return signed
}

function ts.bit_and(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(28, deep(left), deep(right))
body {
  let pair = invoke ts.numeric_pair(left, right)
  let left = pair[0]
  let right = pair[1]
  if same(kind(left), "integer") { let output = invoke ts.bigint.bitwise(left, right, "and") return output }
  let a = invoke ts.to_int32(left)
  let b = invoke ts.to_int32(right)
  let combined = invoke ts.bitwise32(a, b, "and")
  return num.to_float(combined)
}

function ts.bit_or(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(28, deep(left), deep(right))
body {
  let pair = invoke ts.numeric_pair(left, right)
  let left = pair[0]
  let right = pair[1]
  if same(kind(left), "integer") { let output = invoke ts.bigint.bitwise(left, right, "or") return output }
  let a = invoke ts.to_int32(left)
  let b = invoke ts.to_int32(right)
  let combined = invoke ts.bitwise32(a, b, "or")
  return num.to_float(combined)
}

function ts.bit_xor(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(28, deep(left), deep(right))
body {
  let pair = invoke ts.numeric_pair(left, right)
