# What a value is to a dispatcher: "absent", "null", "bool", "number",
# "text", "list", "record", "closure", "error", "map", "set", "timestamp",
# or "brand:<b>" for a record whose `brand` field is the text <b>. A
# built-in function's token is a "closure" and a built-in namespace's or
# prototype's token is a "builtin" (`builtins/mod.rs`).
function ts.receiver(value: Any) -> Text
kernel 1
charge 3
body {
  let k = kind(value)
  if same(k, "integer") {
    return "number"
  }
  if same(k, "float") {
    return "number"
  }
  if same(k, "function") {
    return "closure"
  }
  if same(k, "record") {
    let brand = value.brand
    if same(kind(brand), "text") {
      return text.concat("brand:", brand)
    }
  }
  if same(k, "tuple") {
    if same(value, ()) {} else {
      if same(value[0], "ts.function") { return "closure" }
      if same(value[0], "ts.object") { return "builtin" }
    }
  }
  return k
}

# A function value as what calls it: a built-in function's token as the
# closure it carries, and any other value as itself. A helper that calls a
# function the program gave it calls what this gives.
function ts.callable(value: Any) -> Any
kernel 1
charge 4
body {
  if same(kind(value), "tuple") {} else { return value }
  if same(value, ()) { return value }
  if same(value[0], "ts.function") { return value[4] }
  return value
}

# What `===` compares: a built-in function's token by its path, since each
# read of a built-in makes a new token, and any other value as itself.
function ts.identity(value: Any) -> Any
kernel 1
charge 4
body {
  if same(kind(value), "tuple") {} else { return value }
  if same(value, ()) { return value }
  if same(value[0], "ts.function") { return ("ts.function", value[1]) }
  return value
}

# What a built-in class called without `new` does when only `new` builds it.
function ts.requires_new(name: Text) -> Any
kernel 1
errors "type_error"
charge 4
body {
  throw error.new("type_error", text.concat("Constructor ", text.concat(name, " requires 'new'")), null)
}

# `Function(...)`: code built from text.
function ts.function_from_text(this: Any, args: List(Any)) -> Any
kernel 1
errors "TS_FUNCTION_CONSTRUCTOR_UNSUPPORTED"
charge 4
body {
  throw error.new("TS_FUNCTION_CONSTRUCTOR_UNSUPPORTED", "The Function constructor builds code from text, which the TypeScript dialect does not", null)
}

# `Function.prototype(...)`, which accepts anything and returns undefined.
function ts.nothing(this: Any, args: List(Any)) -> Any
kernel 1
charge 2
body {
  return absent
}

function ts.is_primitive(value: Any) -> Bool
kernel 1
charge 4
body {
  let k = invoke ts.receiver(value)
  for primitive in ["absent", "null", "bool", "number", "text"] {
    if same(k, primitive) {
      return true
    }
  }
  return false
}

function ts.is_nullish(value: Any) -> Bool
kernel 1
charge 2
body {
  if same(value, null) {
    return true
  }
  return same(value, absent)
}

# Raises the ReferenceError of a `let` or `const` read before its
# declaration ran.
function ts.tdz(value: Any, name: Text) -> Any
kernel 1
errors "ReferenceError"
charge 2
body {
  if same(value, ()) {
    throw error.new("ReferenceError", text.concat("Cannot access '", text.concat(name, "' before initialization")), null)
  }
  return value
}

function ts.require_object_coercible(value: Any) -> Any
kernel 1
errors "type_error"
charge 3
body {
  let nullish = invoke ts.is_nullish(value)
  if nullish {
    throw error.new("type_error", "Cannot destructure a value that is undefined or null", null)
  }
  return value
}

# ToBoolean.
function ts.to_boolean(value: Any) -> Bool
kernel 1
charge 3
body {
  let k = kind(value)
  if same(k, "bool") {
    return value
  }
  if same(k, "absent") {
    return false
  }
  if same(k, "null") {
    return false
  }
  if same(k, "text") {
    return bool.not(same(value, ""))
  }
  if same(k, "integer") {
    return bool.not(eq(value, 0))
  }
  if same(k, "float") {
    if num.is_nan(value) {
      return false
    }
    return bool.not(eq(value, 0))
  }
  return true
}

# `!value`.
function ts.not(value: Any) -> Bool
kernel 1
charge 4
body {
  let truthy = invoke ts.to_boolean(value)
  return bool.not(truthy)
}

function ts.typeof(value: Any) -> Text
kernel 1
charge 4
body {
  let k = invoke ts.receiver(value)
  if same(k, "absent") {
    return "undefined"
  }
  if same(k, "bool") {
    return "boolean"
  }
  if same(k, "number") {
    return "number"
  }
  if same(k, "text") {
    return "string"
  }
  if same(k, "closure") {
    return "function"
  }
  return "object"
}

# ToString of a primitive.
function ts.primitive_to_string(value: Any) -> Text
kernel 1
errors "type_error"
charge sum(4, size(result))
body {
  let k = invoke ts.receiver(value)
  if same(k, "text") {
    return value
  }
  if same(k, "absent") {
    return "undefined"
  }
  if same(k, "null") {
    return "null"
  }
  if same(k, "bool") {
    if value {
      return "true"
    }
    return "false"
  }
  if same(k, "number") {
    let spelled = invoke ts.number.to_string(value)
    return spelled
  }
  throw error.new("type_error", "Cannot convert object to primitive value", null)
}

# ToNumber of a primitive.
function ts.primitive_to_number(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(4, size(value))
body {
  let k = invoke ts.receiver(value)
  if same(k, "number") {
    return num.to_float(value)
  }
  if same(k, "absent") {
    return nan
  }
  if same(k, "null") {
    return 0.0
  }
  if same(k, "bool") {
    if value {
      return 1.0
    }
    return 0.0
  }
  if same(k, "text") {
    let parsed = invoke ts.number.parse(value)
    return parsed
  }
  throw error.new("type_error", "Cannot convert object to primitive value", null)
}

# ToPrimitive. `hint` is "default", "number" or "string". An array is its
# elements joined by commas; a plain object runs its own `valueOf` and
# `toString` in the hint's order and is "[object Object]" when it has
# neither.
function ts.to_primitive(value: Any, hint: Text) -> Any
kernel 1
errors "type_error"
charge sum(4, deep(value))
body {
  let convert = absent
  set convert = fn(value, hint) {
    let k = invoke ts.receiver(value)
    for primitive in ["absent", "null", "bool", "number", "text"] {
      if same(k, primitive) {
        return value
      }
    }
    if same(k, "brand:ts.arguments") { return "[object Arguments]" }
    if same(k, "list") {
      let joined = ""
      let first = true
      for item in value {
        if first {
          set first = false
        } else {
          set joined = text.concat(joined, ",")
        }
        let nullish = same(item, ())
        if nullish {} else { set nullish = invoke ts.is_nullish(item) }
        if nullish {} else {
          let primitive = apply convert(item, "string")
          let piece = invoke ts.primitive_to_string(primitive)
          set joined = text.concat(joined, piece)
        }
      }
      return joined
    }
    if same(k, "record") {
      let order = ["valueOf", "toString"]
      if same(hint, "string") {
        set order = ["toString", "valueOf"]
      }
      for name in order {
        if record.contains(value, name) {} else {
          # Ordinary objects inherit valueOf (returns the receiver) and
          # toString (returns the tag). An own non-callable shadows either.
          if same(name, "toString") { return "[object Object]" }
        }
        let method = record.get(value, name)
        set method = invoke ts.callable(method)
        if same(kind(method), "closure") {
          let none = []
          let outcome = apply method(value, none)
          let primitive = invoke ts.is_primitive(outcome)
          if primitive {
            return outcome
          }
        }
      }
      throw error.new("type_error", "Cannot convert object to primitive value", null)
    }
    if same(k, "error") {
      return text.concat(value.kind, text.concat(": ", value.message))
    }
    if same(k, "closure") {
      if same(kind(value), "tuple") {
        return text.concat("function ", text.concat(value[2], "() { [native code] }"))
      }
      throw error.new("type_error", "A function has no string or number form", null)
    }
    if same(k, "builtin") {
      if text.ends_with(value[1], ".prototype") {
        throw error.new("TS_REFLECTION_UNSUPPORTED", "A built-in prototype as a primitive is outside the TypeScript dialect", null)
      }
      return text.concat("[object ", text.concat(value[2], "]"))
    }
    let exotic = invoke ts.exotic.to_primitive(value, hint)
    return exotic
  }
  let outcome = apply convert(value, hint)
  return outcome
}

# ToString.
function ts.to_string(value: Any) -> Text
kernel 1
errors "type_error"
charge sum(8, deep(value))
body {
  let primitive = invoke ts.to_primitive(value, "string")
  let spelled = invoke ts.primitive_to_string(primitive)
  return spelled
}

# ToNumber.
function ts.to_number(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(8, deep(value))
body {
  let primitive = invoke ts.to_primitive(value, "number")
  let number = invoke ts.primitive_to_number(primitive)
  return number
}

# ToPropertyKey.
function ts.to_property_key(key: Any) -> Text
kernel 1
errors "type_error"
charge sum(8, deep(key))
body {
  if same(kind(key), "text") {
    return key
  }
  let spelled = invoke ts.to_string(key)
  return spelled
}

# The parts of a template literal or of any concatenation, already texts.
function ts.join(parts: List(Text)) -> Text
kernel 1
charge sum(2, deep(parts))
body {
  let joined = ""
  for part in parts {
    set joined = text.concat(joined, part)
  }
  return joined
}

# `a + b`.
function ts.add(left: Any, right: Any) -> Any
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let a = invoke ts.to_primitive(left, "default")
  let b = invoke ts.to_primitive(right, "default")
  let textual = same(kind(a), "text")
  if textual {} else {
    set textual = same(kind(b), "text")
  }
  if textual {
    let sa = invoke ts.primitive_to_string(a)
    let sb = invoke ts.primitive_to_string(b)
    return text.concat(sa, sb)
  }
  let na = invoke ts.primitive_to_number(a)
  let nb = invoke ts.primitive_to_number(b)
  return num.add(na, nb)
}

function ts.sub(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let a = invoke ts.to_number(left)
  let b = invoke ts.to_number(right)
  return num.sub(a, b)
}

function ts.mul(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let a = invoke ts.to_number(left)
  let b = invoke ts.to_number(right)
  return num.mul(a, b)
}

function ts.div(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let a = invoke ts.to_number(left)
  let b = invoke ts.to_number(right)
  return num.div(a, b)
}

function ts.rem(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let a = invoke ts.to_number(left)
  let b = invoke ts.to_number(right)
  return num.rem_trunc(a, b)
}

function ts.pow(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
body {
  let a = invoke ts.to_number(left)
  let b = invoke ts.to_number(right)
  if num.is_nan(b) {
    return nan
  }
  if eq(num.abs(a), 1) {
    if num.is_finite(b) {} else { return nan }
  }
  return num.pow(a, b)
}

function ts.neg(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(10, deep(value))
body {
  let number = invoke ts.to_number(value)
  return num.neg(number)
}

# ToInt32, as an integer.
function ts.to_int32(value: Any) -> Int
kernel 1
errors "type_error"
charge sum(12, deep(value))
body {
  let number = invoke ts.to_number(value)
  if num.is_finite(number) {} else {
    return 0
  }
  let wrapped = int.rem_floor(float.to_int(num.trunc(number)), 4294967296)
  if num.le(2147483648, wrapped) {
    return num.sub(wrapped, 4294967296)
  }
  return wrapped
}

# An integer reduced to the signed 32-bit range.
function ts.wrap_int32(value: Int) -> Int
kernel 1
charge 3
body {
  let wrapped = int.rem_floor(value, 4294967296)
  if num.le(2147483648, wrapped) {
    return num.sub(wrapped, 4294967296)
  }
  return wrapped
}

# The low five bits of a shift's right operand.
function ts.shift_count(value: Any) -> Int
kernel 1
errors "type_error"
charge sum(14, deep(value))
body {
  let count = invoke ts.to_int32(value)
  return int.rem_floor(count, 32)
}

# Combine the 32 bits after ECMAScript ToInt32; no unregistered native
# bit operations are assumed by the dialect.
function ts.bitwise32(left: Int, right: Int, operation: Text) -> Int
kernel 1
charge 1024
body {
  let a = int.rem_floor(left, 4294967296)
  let b = int.rem_floor(right, 4294967296)
  let weight = 1
  let result_value = 0
  let index = 0
  while num.lt(index, 32) {
    let x = int.rem_floor(a, 2)
    let y = int.rem_floor(b, 2)
    let bit = num.mul(x, y)
    if same(operation, "or") {
      set bit = num.sub(num.add(x, y), bit)
    }
    if same(operation, "xor") {
      set bit = int.rem_floor(num.add(x, y), 2)
    }
    set result_value = num.add(result_value, num.mul(weight, bit))
    set a = int.div_floor(a, 2)
    set b = int.div_floor(b, 2)
    set weight = num.mul(weight, 2)
    set index = num.add(index, 1)
  }
  let signed = invoke ts.wrap_int32(result_value)
  return signed
}

function ts.bit_and(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(28, deep(left), deep(right))
body {
  let a = invoke ts.to_int32(left)
  let b = invoke ts.to_int32(right)
  let combined = invoke ts.bitwise32(a, b, "and")
  return num.to_float(combined)
}

function ts.bit_or(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(28, deep(left), deep(right))
body {
  let a = invoke ts.to_int32(left)
  let b = invoke ts.to_int32(right)
  let combined = invoke ts.bitwise32(a, b, "or")
  return num.to_float(combined)
}

function ts.bit_xor(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(28, deep(left), deep(right))
body {
  let a = invoke ts.to_int32(left)
  let b = invoke ts.to_int32(right)
  let combined = invoke ts.bitwise32(a, b, "xor")
  return num.to_float(combined)
}

function ts.bit_not(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(14, deep(value))
body {
  let a = invoke ts.to_int32(value)
  return num.to_float(num.sub(num.neg(a), 1))
}

function ts.shl(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(32, deep(left), deep(right))
body {
  let a = invoke ts.to_int32(left)
  let count = invoke ts.shift_count(right)
  let wide = num.mul(a, int.pow(2, count))
  let shifted = invoke ts.wrap_int32(wide)
  return num.to_float(shifted)
}

function ts.shr(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(30, deep(left), deep(right))
body {
  let a = invoke ts.to_int32(left)
  let count = invoke ts.shift_count(right)
  return num.to_float(int.div_floor(a, int.pow(2, count)))
}

function ts.ushr(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(30, deep(left), deep(right))
body {
  let a = invoke ts.to_int32(left)
  let count = invoke ts.shift_count(right)
  return num.to_float(int.div_floor(int.rem_floor(a, 4294967296), int.pow(2, count)))
}

# `a === b`. Two numbers by value; two objects when they are the same
# object.
function ts.strict_equals(left: Any, right: Any) -> Bool
kernel 1
charge 8
body {
  let a = invoke ts.receiver(left)
  let b = invoke ts.receiver(right)
  if same(a, b) {} else {
    return false
  }
  if same(a, "number") {
    return eq(left, right)
  }
  let x = invoke ts.identity(left)
  let y = invoke ts.identity(right)
  return same(x, y)
}

function ts.strict_not_equals(left: Any, right: Any) -> Bool
kernel 1
charge 10
body {
  let equal = invoke ts.strict_equals(left, right)
  return bool.not(equal)
}

# `a == b`.
function ts.loose_equals(left: Any, right: Any) -> Bool
kernel 1
errors "type_error"
charge sum(24, deep(left), deep(right))
body {
  let loose = absent
  set loose = fn(left, right) {
    let a = invoke ts.receiver(left)
    let b = invoke ts.receiver(right)
    if same(a, b) {
      let equal = invoke ts.strict_equals(left, right)
      return equal
    }
    let left_nullish = invoke ts.is_nullish(left)
    let right_nullish = invoke ts.is_nullish(right)
    if left_nullish {
      return right_nullish
    }
    if right_nullish {
      return false
    }
    if same(a, "bool") {
      let number = invoke ts.primitive_to_number(left)
      let equal = apply loose(number, right)
      return equal
    }
    if same(b, "bool") {
      let number = invoke ts.primitive_to_number(right)
      let equal = apply loose(left, number)
      return equal
    }
    if same(a, "number") {
      if same(b, "text") {
        let number = invoke ts.number.parse(right)
        return eq(left, number)
      }
    }
    if same(a, "text") {
      if same(b, "number") {
        let number = invoke ts.number.parse(left)
        return eq(number, right)
      }
    }
    let left_primitive = invoke ts.is_primitive(left)
    let right_primitive = invoke ts.is_primitive(right)
    if left_primitive {
      if right_primitive {
        return false
      }
      let primitive = invoke ts.to_primitive(right, "default")
      let equal = apply loose(left, primitive)
      return equal
    }
    if right_primitive {
      let primitive = invoke ts.to_primitive(left, "default")
      let equal = apply loose(primitive, right)
      return equal
    }
    return false
  }
  let equal = apply loose(left, right)
  return equal
}

function ts.loose_not_equals(left: Any, right: Any) -> Bool
kernel 1
errors "type_error"
charge sum(26, deep(left), deep(right))
body {
  let equal = invoke ts.loose_equals(left, right)
  return bool.not(equal)
}

# The operands of a relational operator, converted left first: a tuple of
# whether both are texts and the two operands, as texts or as numbers.
function ts.relational(left: Any, right: Any) -> Tuple(Bool, Any, Any)
kernel 1
errors "type_error"
charge sum(16, deep(left), deep(right))
body {
  let a = invoke ts.to_primitive(left, "number")
  let b = invoke ts.to_primitive(right, "number")
  if same(kind(a), "text") {
    if same(kind(b), "text") {
      return (true, a, b)
    }
  }
  let na = invoke ts.primitive_to_number(a)
  let nb = invoke ts.primitive_to_number(b)
  return (false, na, nb)
}

function ts.lt(left: Any, right: Any) -> Bool
kernel 1
errors "type_error"
charge sum(20, deep(left), deep(right))
body {
  let operands = invoke ts.relational(left, right)
  if operands[0] {
    return num.lt(text.utf16_compare(operands[1], operands[2]), 0)
  }
  return num.lt(operands[1], operands[2])
}

function ts.gt(left: Any, right: Any) -> Bool
kernel 1
errors "type_error"
charge sum(20, deep(left), deep(right))
body {
  let operands = invoke ts.relational(left, right)
  if operands[0] {
    return num.lt(text.utf16_compare(operands[2], operands[1]), 0)
  }
  return num.lt(operands[2], operands[1])
}

function ts.le(left: Any, right: Any) -> Bool
kernel 1
errors "type_error"
charge sum(20, deep(left), deep(right))
body {
  let operands = invoke ts.relational(left, right)
  if operands[0] {
    return bool.not(num.lt(text.utf16_compare(operands[2], operands[1]), 0))
  }
  return num.le(operands[1], operands[2])
}

function ts.ge(left: Any, right: Any) -> Bool
kernel 1
errors "type_error"
charge sum(20, deep(left), deep(right))
body {
  let operands = invoke ts.relational(left, right)
  if operands[0] {
    return bool.not(num.lt(text.utf16_compare(operands[1], operands[2]), 0))
  }
  return num.le(operands[2], operands[1])
}

# A list with at least `count` elements: `items` itself when it is long
# enough, else a copy filled out with absent. A parameter list and an array
# pattern read their positions from it.
function ts.pad(items: List(Any), count: Number) -> List(Any)
kernel 1
charge sum(2, size(items), magnitude(count))
body {
  if num.le(count, list.len(items)) {
    return items
  }
  let padded = []
  for item in items {
    set padded[list.len(padded)] = item
  }
  while num.lt(list.len(padded), count) {
    set padded[list.len(padded)] = absent
  }
  return padded
}

# A hole is not a JavaScript value. Reading one gives undefined.
function ts.hole_value(value: Any) -> Any
kernel 1
charge 1
body {
  if same(value, ()) { return absent }
  return value
}

# The elements of `items` from `start` on, as a new list: a rest parameter
# or a rest element.
function ts.rest(items: List(Any), start: Number) -> List(Any)
kernel 1
charge sum(2, size(items))
body {
  let rest = []
  let position = start
  while num.lt(position, list.len(items)) {
    let item = items[position]
    let value = invoke ts.hole_value(item)
    set rest[list.len(rest)] = value
    set position = num.add(position, 1)
  }
  return rest
}

# The lists of `parts` end to end, as a new list: an array literal or an
# argument list with a spread in it.
function ts.spread(parts: List(List(Any))) -> List(Any)
kernel 1
charge sum(2, deep(parts))
body {
  let flat = []
  for part in parts {
    for item in part {
      set flat[list.len(flat)] = item
    }
  }
  return flat
}

# What `for...of`, a spread and an array pattern take from a value, as a
# list. An array is itself, so a loop over it reads it live.
function ts.iterate(target: Any) -> List(Any)
kernel 1
errors "type_error"
charge sum(4, size(target))
body {
  let k = invoke ts.receiver(target)
  if same(k, "brand:ts.arguments") {
    let items = []
    let index = 0.0
    while true {
      let property = target.properties.length
      let numeric = invoke ts.to_number(property)
      if num.is_nan(numeric) { break }
      let length = num.min(num.floor(numeric), 9007199254740991.0)
      if num.le(length, index) { break }
      let key = invoke ts.number.to_string(index)
      set items[list.len(items)] = target.properties[key]
      set index = num.add(index, 1.0)
    }
    return items
  }
  if same(k, "brand:regex.match") { return target.items }
  if same(k, "list") {
    return target
  }
  if same(k, "text") {
    let items = []
    let position = 0
    let length = text.utf16_len(target)
    while num.lt(position, length) {
      let unit = text.utf16_get(target, position)
      let end = num.add(position, 1)
      if num.le(55296, unit) { if num.le(unit, 56319) { set end = num.add(end, 1) } }
      set items[list.len(items)] = text.utf16_slice(target, position, end)
      set position = end
    }
    return items
  }
  if same(k, "brand:ts.iterator") {
      let iterator_items = []
      let next = target.next
      while true {
        let array_arg_1 = []
        let step = apply next(target, array_arg_1)
        if step.done { break }
        set iterator_items[list.len(iterator_items)] = step.value
      }
      return iterator_items
  }
  let items = invoke ts.exotic.iterate(target)
  return items
}

# The position a property key names in a list of `length` elements, or -1
# when it names none.
function ts.list_index(key: Any, length: Number) -> Number
kernel 1
charge sum(6, size(key))
body {
  let name = invoke ts.to_property_key(key)
  let position = invoke ts.number.parse(name)
  if num.is_finite(position) {} else { return -1.0 }
  if eq(num.floor(position), position) {} else { return -1.0 }
  if num.lt(position, 0) { return -1.0 }
  let canonical = invoke ts.number.to_string(position)
  if same(canonical, name) {} else { return -1.0 }
  if num.lt(position, length) { return num.to_float(position) }
  return -1.0
}

# `target[key]` and `target.key` where no built-in row answers.
function ts.get(target: Any, key: Any) -> Any
kernel 1
errors "type_error"
charge sum(12, deep(key))
body {
  let k = invoke ts.receiver(target)
  if same(k, "closure") {
    let name = invoke ts.to_property_key(key)
    if same(name, "caller") { throw error.new("type_error", "Restricted function property", null) }
    if same(name, "arguments") { throw error.new("type_error", "Restricted function property", null) }
  }
  if same(k, "brand:ts.arguments") {
    let name = invoke ts.to_property_key(key)
    if same(name, "callee") { throw error.new("type_error", "Strict arguments.callee is restricted", null) }
    return target.properties[name]
  }
  if same(k, "text") {
    let length = text.utf16_len(target)
    if same(key, "length") { return num.to_float(length) }
    let position = invoke ts.list_index(key, length)
    if num.lt(position, 0) { return absent }
    let index = float.to_int(position)
    try { return text.utf16_slice(target, index, num.add(index, 1)) } catch boundary {
      throw error.new("TS_LONE_SURROGATE_UNSUPPORTED", "String index contains a lone surrogate", null)
    }
  }
  if same(k, "brand:regex.ecma") {
    let name = invoke ts.to_property_key(key)
    if same(name, "lastIndex") { return target.lastIndex }
    if same(name, "source") {
      let pattern = target.pattern
      let source = invoke ts.regexp.escaped_source(pattern)
      return source
    }
    if same(name, "flags") { return target.flags }
    for pair in [["global", "g"], ["ignoreCase", "i"], ["multiline", "m"], ["dotAll", "s"], ["unicode", "u"], ["sticky", "y"]] {
      if same(name, pair[0]) { return num.le(0, text.utf16_find(target.flags, pair[1], 0)) }
    }
    return absent
  }
  if same(k, "brand:regex.match") {
    let name = invoke ts.to_property_key(key)
    if same(name, "length") { return num.to_float(list.len(target.items)) }
    for field in ["index", "input", "groups"] { if same(name, field) { return target[name] } }
    let arg_1 = list.len(target.items)
    let position = invoke ts.list_index(key, arg_1)
    if num.lt(position, 0) { return absent }
    let element = target.items[position]
    let outcome = invoke ts.hole_value(element)
    return outcome
  }
  if same(k, "brand:ts.iterator") {
    let name = invoke ts.to_property_key(key)
    return target[name]
  }
  if same(k, "record") {
    let name = invoke ts.to_property_key(key)
    return target[name]
  }
  if same(k, "list") {
    let length = list.len(target)
    let name = invoke ts.to_property_key(key)
    if same(name, "length") { return num.to_float(length) }
    let position = invoke ts.list_index(name, length)
    if num.lt(position, 0) {
      let other = invoke ts.exotic.get(target, key)
      return other
    }
    let value = target[position]
    let element_value = invoke ts.hole_value(value)
    return element_value
  }
  if same(kind(target), "tuple") {
    if same(k, "closure") {
      let name = invoke ts.to_property_key(key)
      if same(name, "name") { return target[2] }
      if same(name, "length") { return target[3] }
    }
    if same(k, "tuple") {} else {
      throw error.new("TS_REFLECTION_UNSUPPORTED", "Reading a built-in's properties generically is outside the TypeScript dialect", null)
    }
  }
  let nullish = invoke ts.is_nullish(target)
  if nullish {
    let name = invoke ts.to_property_key(key)
    throw error.new("type_error", text.concat("Cannot read properties of undefined or null (reading '", text.concat(name, "')")), null)
  }
  let other = invoke ts.exotic.get(target, key)
  return other
}

# `target[key] = value`.
function ts.set(target: Any, key: Any, value: Any) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(12, deep(key))
body {
  let k = invoke ts.receiver(target)
  if same(k, "closure") {
    let name = invoke ts.to_property_key(key)
    if same(name, "caller") { throw error.new("type_error", "Restricted function property", null) }
    if same(name, "arguments") { throw error.new("type_error", "Restricted function property", null) }
  }
  if same(k, "brand:ts.arguments") {
    let name = invoke ts.to_property_key(key)
    if same(name, "callee") { throw error.new("type_error", "Strict arguments.callee is restricted", null) }
    set target.properties[name] = value
    return value
  }
  if same(k, "brand:regex.ecma") {
    let name = invoke ts.to_property_key(key)
    if same(name, "lastIndex") { set target.lastIndex = value
      return value }
    throw error.new("type_error", "Cannot assign to a read-only RegExp property", null)
  }
  if same(k, "record") {
    let name = invoke ts.to_property_key(key)
    set target[name] = value
    return value
  }
  if same(k, "list") {
    let name = invoke ts.to_property_key(key)
    if same(name, "length") {
      let length = invoke ts.to_number(value)
      if num.is_finite(length) {} else { throw error.new("RangeError", "Invalid array length", null) }
      if eq(num.floor(length), length) {} else { throw error.new("RangeError", "Invalid array length", null) }
      if num.lt(length, 0) { throw error.new("RangeError", "Invalid array length", null) }
      if num.lt(4294967295.0, length) { throw error.new("RangeError", "Invalid array length", null) }
      while num.lt(length, list.len(target)) { remove target[num.sub(list.len(target), 1)] }
      while num.lt(list.len(target), length) { set target[list.len(target)] = () }
      return value
    }
    let position = invoke ts.list_index(name, 4294967295.0)
    if num.lt(position, 0) {
      throw error.new("TS_ARRAY_NON_INDEX_PROPERTY_UNSUPPORTED", "arrays do not carry named properties", null)
    }
    while num.lt(list.len(target), position) { set target[list.len(target)] = () }
    set target[position] = value
    return value
  }
  if same(kind(target), "tuple") {
    if same(k, "tuple") {} else {
      throw error.new("TS_REFLECTION_UNSUPPORTED", "Assigning a property of a built-in is outside the TypeScript dialect", null)
    }
  }
  let nullish = invoke ts.is_nullish(target)
  if nullish {
    let name = invoke ts.to_property_key(key)
    throw error.new("type_error", text.concat("Cannot set properties of undefined or null (setting '", text.concat(name, "')")), null)
  }
  let written = invoke ts.exotic.set(target, key, value)
  return written
}

# `delete target[key]`.
function ts.delete(target: Any, key: Any) -> Bool
kernel 1
errors "type_error"
charge sum(12, deep(key))
body {
  let k = invoke ts.receiver(target)
  if same(k, "error") {
    let name = invoke ts.to_property_key(key)
    if same(kind(target.data), "record") {
      let properties = target.data.properties
      if same(kind(properties), "record") { remove properties[name] }
      let attributes = target.data.nonEnumerable
      if same(kind(attributes), "record") { remove attributes[name] }
    }
    return true
  }
  if same(k, "brand:ts.arguments") {
    let name = invoke ts.to_property_key(key)
    if same(name, "callee") { throw error.new("type_error", "Cannot delete strict arguments.callee", null) }
    remove target.properties[name]
    set target.hidden[name] = false
    return true
  }
  if same(k, "record") {
    let name = invoke ts.to_property_key(key)
    remove target[name]
    return true
  }
  if same(k, "list") {
    let name = invoke ts.to_property_key(key)
    if same(name, "length") { throw error.new("type_error", "Cannot delete array length", null) }
    let array_arg_2 = list.len(target)
    let position = invoke ts.list_index(name, array_arg_2)
    if num.le(0, position) { set target[position] = () }
    return true
  }
  if same(kind(target), "tuple") {
    if same(k, "tuple") {} else {
      throw error.new("TS_REFLECTION_UNSUPPORTED", "Deleting a property of a built-in is outside the TypeScript dialect", null)
    }
  }
  let nullish = invoke ts.is_nullish(target)
  if nullish {
    throw error.new("type_error", "Cannot convert undefined or null to object", null)
  }
  throw error.new("type_error", "Only a property of a plain object can be deleted", null)
}

# HasOwnProperty after conceptual ToObject; no wrapper escapes. A
# built-in's own properties are reflection, which the dialect refuses with a
# typed error.
function ts.has_own(target: Any, key: Any) -> Bool
kernel 1
errors "type_error", "TS_REFLECTION_UNSUPPORTED"
charge sum(12, deep(key))
body {
  do invoke ts.require_object_coercible(target)
  let name = invoke ts.to_property_key(key)
  let k = invoke ts.receiver(target)
  let token = same(k, "builtin")
  if same(k, "closure") { set token = same(kind(target), "tuple") }
  if token {
    throw error.new("TS_REFLECTION_UNSUPPORTED", "Testing a built-in's own properties is outside the TypeScript dialect", null)
  }
  if same(k, "closure") {
    # A function's own `name`, `length` and `prototype` carry attributes
    # the dialect does not keep.
    for described in ["name", "length", "prototype"] {
      if same(name, described) { throw error.new("TS_REFLECTION_UNSUPPORTED", "Testing a function's own properties is outside the TypeScript dialect", null) }
    }
  }
  if same(k, "brand:regex.ecma") {
    throw error.new("TS_REFLECTION_UNSUPPORTED", "Testing a RegExp's own properties is outside the TypeScript dialect", null)
  }
  if same(k, "brand:ts.iterator") { return record.contains(target, name) }
  if same(k, "text") {
    if same(name, "length") { return true }
    let length = text.utf16_len(target)
    let position = invoke ts.list_index(name, length)
    return num.le(0, position)
  }
  if same(k, "error") {
    if same(kind(target.data), "record") {
      let properties = target.data.properties
      if same(kind(properties), "record") { return record.contains(properties, name) }
      return false
    }
    return same(name, "message")
  }
  for object_kind in ["map", "set", "timestamp", "closure", "bool", "number", "brand:date.invalid"] {
    if same(k, object_kind) { return false }
  }
  if same(k, "brand:ts.arguments") {
    let name = invoke ts.to_property_key(key)
    if same(name, "callee") { return true }
    return record.contains(target.properties, name)
  }
  if same(k, "brand:regex.match") {
    let name = invoke ts.to_property_key(key)
    for field in ["length", "index", "input", "groups"] { if same(name, field) { return true } }
    let length = list.len(target.items)
    let position = invoke ts.list_index(name, length)
    if num.lt(position, 0) { return false }
    return bool.not(same(target.items[position], ()))
  }
  if same(k, "record") {
    let name = invoke ts.to_property_key(key)
    return record.contains(target, name)
  }
  if same(k, "list") {
    let name = invoke ts.to_property_key(key)
    if same(name, "length") { return true }
    let array_arg_3 = list.len(target)
    let position = invoke ts.list_index(name, array_arg_3)
    if num.lt(position, 0) { return false }
    return bool.not(same(target[position], ()))
  }
  return false
}

function ts.has(target: Any, key: Any) -> Bool
kernel 1
errors "type_error", "TS_REFLECTION_UNSUPPORTED"
charge sum(12, deep(key))
body {
  let primitive = invoke ts.is_primitive(target)
  if primitive { throw error.new("type_error", "Cannot use 'in' to search in a value that is not an object", null) }
  let k = invoke ts.receiver(target)
  let name = invoke ts.to_property_key(key)
  if same(k, "error") {
    for inherited in ["name", "message", "toString", "constructor", "hasOwnProperty", "propertyIsEnumerable", "valueOf", "toLocaleString", "isPrototypeOf"] {
      if same(name, inherited) { return true }
    }
  }
  let own = invoke ts.has_own(target, name)
  if own { return true }
  for inherited in ["valueOf", "toString", "hasOwnProperty", "constructor", "isPrototypeOf", "propertyIsEnumerable", "toLocaleString"] {
    if same(name, inherited) { return true }
  }
  if same(k, "closure") {
    for inherited in ["call", "apply", "bind", "caller", "arguments"] { if same(name, inherited) { return true } }
  }
  return false
}

# The keys `for...in` visits, as a new list.
function ts.keys(target: Any) -> List(Text)
kernel 1
charge sum(4, size(target))
body {
  let k = kind(target)
  let hidden_fields = set{}
  if same(k, "record") { if same(target.brand, "ts.arguments") {
    set hidden_fields = target.hidden
    set target = target.properties
  } }
  let keys = []
  if same(k, "error") {
    if same(kind(target.data), "record") {
      let attributes = target.data.nonEnumerable
      let properties = target.data.properties
      if same(kind(properties), "record") {
        for name in record.keys(properties) {
          let hidden = false
          if same(kind(attributes), "record") { set hidden = record.contains(attributes, name) }
          if hidden {} else { set keys[list.len(keys)] = name }
        }
      }
    }
    return keys
  }
  if same(k, "text") {
    let position = 0.0
    let length = text.utf16_len(target)
    while num.lt(position, length) {
      let key = invoke ts.number.to_string(position)
      set keys[list.len(keys)] = key
      set position = num.add(position, 1)
    }
    return keys
  }
  if same(k, "record") {
    let numeric = []
    let other = []
    for key in record.keys(target) {
      if set.contains(hidden_fields, key) { continue }
      let index = invoke ts.list_index(key, 4294967295.0)
      if num.le(0, index) {
        let position = list.len(numeric)
        set numeric[position] = index
        while num.lt(0, position) {
          let previous = num.sub(position, 1)
          if num.le(numeric[previous], index) { break }
          set numeric[position] = numeric[previous]
          set position = previous
        }
        set numeric[position] = index
      } else { set other[list.len(other)] = key }
    }
    for index in numeric {
      let key = invoke ts.number.to_string(index)
      set keys[list.len(keys)] = key
    }
    for key in other { set keys[list.len(keys)] = key }
    return keys
  }
  if same(k, "list") {
    let position = 0.0
    while num.lt(position, list.len(target)) {
      if same(target[position], ()) {} else {
        let key = invoke ts.number.to_string(position)
        set keys[list.len(keys)] = key
      }
      set position = num.add(position, 1)
    }
  }
  return keys
}

# Copies the own properties of `source` onto `target`: an object spread.
function ts.assign(target: Any, source: Any) -> Any
kernel 1
charge sum(4, size(source))
body {
  let keys = invoke ts.keys(source)
  for key in keys {
    let value = invoke ts.get(source, key)
    set target[key] = value
  }
  return target
}

# The own properties of `source` whose names are not in `taken`, as a new
# object: an object pattern's rest.
function ts.object_rest(source: Any, taken: List(Text)) -> Any
kernel 1
errors "type_error"
charge sum(4, size(source), size(taken))
body {
  do invoke ts.require_object_coercible(source)
  let skip = set{}
  for name in taken {
    set skip[name] = true
  }
  let rest = {}
  if same(kind(source), "record") {
    for name in record.keys(source) {
      if skip[name] {} else {
        set rest[name] = source[name]
      }
    }
  }
  return rest
}

# Guest arrays cross a host boundary as plain data. Copy first: replacing
# absent slots must never fill the guest's holes or change any guest alias.
function ts.boundary(value: Any) -> Any
kernel 1
errors "cyclic_value", "too_deep", "type_error", "not_data"
charge sum(4, deep(value))
body {
  let k = kind(value)
  let copied = value
  if same(k, "list") { set copied = list.copy_deep(value) }
  if same(k, "record") { set copied = record.copy_deep(value) }
  if same(k, "map") { set copied = map.copy_deep(value) }
  if same(k, "set") { set copied = set.copy_deep(value) }
  let visit = absent
  set visit = fn(item) {
    let k = kind(item)
    if same(k, "tuple") {
      let token = invoke ts.receiver(item)
      for callable in ["closure", "builtin"] {
        if same(token, callable) { throw error.new("not_data", "A built-in function or object is not data", null) }
      }
    }
    if same(k, "list") {
      let index = 0
      while num.lt(index, list.len(item)) {
        let child = item[index]
        if same(child, ()) { set child = null }
        if same(child, absent) { set child = null }
        set child = apply visit(child)
        set item[index] = child
        set index = num.add(index, 1)
      }
    }
    if same(k, "record") {
      for key in record.keys(item) {
        let child = item[key]
        set child = apply visit(child)
        set item[key] = child
      }
    }
    if same(k, "map") {
      for pair in map.entries(item) {
        let key = pair[0]
        let child = pair[1]
        set child = apply visit(child)
        set item[key] = child
      }
    }
    return item
  }
  let outcome = apply visit(copied)
  return outcome
}


# The strict arguments object owns its indexed properties and independent length.
function ts.arguments(items: List(Any)) -> Any
kernel 1
charge sum(8, size(items))
body {
  let properties = {length: num.to_float(list.len(items))}
  let index = 0
  for value in items {
    let key = invoke ts.number.to_string(index)
    set properties[key] = value
    set index = num.add(index, 1)
  }
  return {brand: "ts.arguments", properties: properties, hidden: set{"length"}}
}

# Calls `member`, read as `target`'s member `key`, with `target` as `this`.
function ts.call_value(member: Any, target: Any, key: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge 8
body {
  let method = invoke ts.callable(member)
  let k = invoke ts.receiver(method)
  if same(k, "closure") {
    let outcome = apply method(target, args)
    return outcome
  }
  let name = invoke ts.to_property_key(key)
  throw error.new("type_error", text.concat(name, " is not a function"), null)
}
