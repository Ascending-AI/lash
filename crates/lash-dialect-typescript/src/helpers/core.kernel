function ts.function_from_text(this: Any, args: List(Any)) -> Any
kernel 1
errors "TS_FUNCTION_CONSTRUCTOR_UNSUPPORTED"
charge 4
body {
  throw error.new("TS_FUNCTION_CONSTRUCTOR_UNSUPPORTED", "The Function constructor builds code from text, which the TypeScript dialect does not", null)
}

# `Function.prototype(...)`, which accepts anything and returns undefined.
function ts.nothing(this: Any, args: List(Any)) -> Any
kernel 1
charge 2
body {
  return absent
}

function ts.is_primitive(value: Any) -> Bool
kernel 1
charge 4
native
body {
  let k = kind(value)
  if same(k, "float") { return true }
  if same(k, "text") { return true }
  if same(k, "integer") { return true }
  if same(k, "bool") { return true }
  if same(k, "null") { return true }
  return same(k, "absent")
}

function ts.is_nullish(value: Any) -> Bool
kernel 1
charge 2
native
body {
  if same(value, null) {
    return true
  }
  return same(value, absent)
}

# Raises the ReferenceError of a `let` or `const` read before its
# declaration ran.
function ts.tdz(value: Any, name: Text) -> Any
kernel 1
errors "ReferenceError"
charge 2
body {
  if same(value, ()) {
    throw error.new("ReferenceError", text.concat("Cannot access '", text.concat(name, "' before initialization")), null)
  }
  return value
}

function ts.require_object_coercible(value: Any) -> Any
kernel 1
errors "type_error"
charge 3
body {
  let nullish = invoke ts.is_nullish(value)
  if nullish {
    throw error.new("type_error", "Cannot destructure a value that is undefined or null", null)
  }
  return value
}

# ToBoolean.
function ts.to_boolean(value: Any) -> Bool
kernel 1
charge 3
native
body {
  let k = kind(value)
  if same(k, "bool") {
    return value
  }
  if same(k, "float") {
    if num.is_nan(value) {
      return false
    }
    return bool.not(eq(value, 0))
  }
  if same(k, "absent") {
    return false
  }
  if same(k, "text") {
    return bool.not(same(value, ""))
  }
  if same(k, "null") {
    return false
  }
  if same(k, "integer") {
    return bool.not(eq(value, 0))
  }
  return true
}

# `!value`.
function ts.not(value: Any) -> Bool
kernel 1
charge 4
body {
  let truthy = invoke ts.to_boolean(value)
  return bool.not(truthy)
}

function ts.typeof(value: Any) -> Text
kernel 1
charge 4
body {
  let k = invoke ts.receiver(value)
  if same(k, "absent") {
    return "undefined"
  }
  if same(k, "bool") {
    return "boolean"
  }
  if same(k, "number") {
    return "number"
  }
  if same(k, "bigint") { return "bigint" }
  if same(k, "text") {
    return "string"
  }
  if same(k, "closure") {
    return "function"
  }
  return "object"
}

# ToString of a primitive.
function ts.primitive_to_string(value: Any) -> Text
kernel 1
errors "type_error"
charge sum(4, size(result))
native
body {
  let k = kind(value)
  if same(k, "text") {
    return value
  }
  if same(k, "float") {
    let spelled = invoke ts.number.format_value(value)
    return spelled
  }
  if same(k, "integer") { return int.to_text(value, 10) }
  if same(k, "absent") {
    return "undefined"
  }
  if same(k, "null") {
    return "null"
  }
  if same(k, "bool") {
    if value {
      return "true"
    }
    return "false"
  }
  throw error.new("type_error", "Cannot convert object to primitive value", null)
}

# ToNumber of a primitive.
function ts.primitive_to_number(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(4, size(value))
native
body {
  let k = kind(value)
  if same(k, "float") {
    return value
  }
  if same(k, "integer") {
    throw error.new("type_error", "Cannot convert a BigInt value to a number", null)
  }
  if same(k, "absent") {
    return nan
  }
  if same(k, "null") {
    return 0.0
  }
  if same(k, "bool") {
    if value {
      return 1.0
    }
    return 0.0
  }
  if same(k, "text") {
    let parsed = invoke ts.number.parse(value)
    return parsed
  }
  throw error.new("type_error", "Cannot convert object to primitive value", null)
}

# ToPrimitive. `hint` is "default", "number" or "string". An array is its
# elements joined by commas; a plain object runs its own `valueOf` and
# `toString` in the hint's order and is "[object Object]" when it has
# neither.
function ts.to_primitive(value: Any, hint: Text) -> Any
kernel 1
errors "type_error"
charge sum(4, deep(value))
native
body {
  # A primitive is its own primitive: no hint changes it.
  let primitive = invoke ts.is_primitive(value)
  if primitive {
    return value
  }
  let convert = absent
  set convert = fn(value, hint) {
    let k = invoke ts.receiver(value)
    for primitive in ["absent", "null", "bool", "number", "text"] {
      if same(k, primitive) {
        return value
      }
    }
    if same(k, "brand:typescript.arguments") { return "[object Arguments]" }
    if same(k, "brand:typescript.template") { set value = value.items set k = "list" }
    if same(k, "list") {
      let pieces = []
      for item in value {
        let piece = ""
        let nullish = same(item, ())
        if nullish {} else { set nullish = invoke ts.is_nullish(item) }
        if nullish {} else {
          let primitive = apply convert(item, "string")
          set piece = invoke ts.primitive_to_string(primitive)
        }
        set pieces[list.len(pieces)] = piece
      }
      return text.join(pieces, ",")
    }
    if same(k, "record") {
      let order = ["valueOf", "toString"]
      if same(hint, "string") {
        set order = ["toString", "valueOf"]
      }
      for name in order {
        if record.contains(value, name) {} else {
          # Ordinary objects inherit valueOf (returns the receiver) and
          # toString (returns the tag). An own non-callable shadows either.
          if same(name, "toString") { return "[object Object]" }
        }
        let method = record.get(value, name)
        set method = invoke ts.callable(method)
        if same(kind(method), "closure") {
          let none = []
          let outcome = apply method(value, none)
          let primitive = invoke ts.is_primitive(outcome)
          if primitive {
            return outcome
          }
        }
      }
      throw error.new("type_error", "Cannot convert object to primitive value", null)
    }
    if same(k, "error") {
      # Error coercion reads the guest's current fields, just as the method
      # does. Recurse through this conversion closure for object fields.
      let name = invoke ts.exotic.get(value, "name")
      if same(name, absent) { set name = "Error" } else {
        let primitive = apply convert(name, "string")
        set name = invoke ts.primitive_to_string(primitive)
      }
      let message = invoke ts.exotic.get(value, "message")
      if same(message, absent) { set message = "" } else {
        let primitive = apply convert(message, "string")
        set message = invoke ts.primitive_to_string(primitive)
      }
      if same(name, "") { return message }
      if same(message, "") { return name }
      return text.concat(name, text.concat(": ", message))
    }
    if same(k, "closure") {
      if same(kind(value), "tuple") {
        if same(value[1], "") {
          if record.contains(value[5], "native") { return "function () { [native code] }" }
          throw error.new("type_error", "A function has no string or number form", null)
        } else {
          return text.concat("function ", text.concat(value[2], "() { [native code] }"))
        }
      }
      return "function () { [native code] }"
    }
    if same(k, "builtin") {
      let path = value[1]
      if same(path, "Array.prototype") { return "" }
      if same(path, "String.prototype") { return "" }
      if same(path, "Number.prototype") { return 0.0 }
      if same(path, "Boolean.prototype") { return false }
      if same(path, "Date.prototype") { if same(hint, "number") { return nan } return "Invalid Date" }
      if text.ends_with(path, "Error.prototype") { return text.slice(path, 0, num.sub(text.len(path), 10)) }
      if same(path, "RegExp.prototype") { return "/(?:)/" }
      return text.concat("[object ", text.concat(value[2], "]"))
    }
    let exotic = invoke ts.exotic.to_primitive(value, hint)
    return exotic
  }
  let outcome = apply convert(value, hint)
  return outcome
}

# ToString.
function ts.to_string(value: Any) -> Text
kernel 1
errors "type_error"
charge sum(8, deep(value), size(result))
native
body {
  if same(kind(value), "text") { return value }
  # ToPrimitive leaves a number as it is: its text needs no closure.
  if same(kind(value), "float") {
    let spelled = invoke ts.number.format_value(value)
    return spelled
  }
  if same(kind(value), "integer") { return int.to_text(value, 10) }
  let dynamic = fn(value) {
    let k = kind(value)
    # ToPrimitive leaves a number as it is.
    if same(k, "float") {
      let spelled = invoke ts.number.format_value(value)
      return spelled
    }
    if same(k, "integer") { return int.to_text(value, 10) }
    let primitive = invoke ts.to_primitive(value, "string")
    let spelled = invoke ts.primitive_to_string(primitive)
    return spelled
  }
  let outcome = apply dynamic(value)
  return outcome
}

# ToNumber.
function ts.to_number(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(8, deep(value))
native
body {
  if same(kind(value), "float") {
    return value
  }
  let primitive = invoke ts.to_primitive(value, "number")
  let number = invoke ts.primitive_to_number(primitive)
  return number
}

# ToPropertyKey.
function ts.to_property_key(key: Any) -> Text
kernel 1
errors "type_error"
charge sum(8, deep(key), size(result))
native
body {
  if same(kind(key), "text") { return key }
  let dynamic = fn(key) {
    let spelled = invoke ts.to_string(key)
    return spelled
  }
  let outcome = apply dynamic(key)
  return outcome
}


function ts.to_numeric(value: Any) -> Number
kernel 1
errors "type_error"
charge sum(8, deep(value))
native
body {
  let primitive = invoke ts.to_primitive(value, "number")
  if same(kind(primitive), "integer") { return primitive }
  let output = invoke ts.primitive_to_number(primitive) return output
}

function ts.numeric_pair(left: Any, right: Any) -> Tuple(Number, Number)
kernel 1
errors "type_error"
charge sum(8, deep(left), deep(right))
native
body {
  let a = invoke ts.to_numeric(left)
  let b = invoke ts.to_numeric(right)
  if same(kind(a), kind(b)) {} else {
    throw error.new("type_error", "Cannot mix BigInt and Number", null)
  }
  return (a, b)
}

function ts.step(value: Number, delta: Number) -> Number
kernel 1
charge sum(8, size(value))
body {
  if same(kind(value), "integer") { return num.add(value, float.to_int(delta)) }
  return num.add(value, delta)
}

# `a + b`.
function ts.add(left: Any, right: Any) -> Any
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
native 2
body {
  # Two numbers add and two texts join, whatever their conversions would
  # say.
  let left_kind = kind(left)
  if same(left_kind, kind(right)) {
    if same(left_kind, "float") { return num.add(left, right) }
    if same(left_kind, "text") { return text.concat(left, right) }
  }
  let a = invoke ts.to_primitive(left, "default")
  let b = invoke ts.to_primitive(right, "default")
  let textual = same(kind(a), "text")
  if textual {} else {
    set textual = same(kind(b), "text")
  }
  if textual {
    let sa = invoke ts.primitive_to_string(a)
    let sb = invoke ts.primitive_to_string(b)
    return text.concat(sa, sb)
  }
  let pair = invoke ts.numeric_pair(a, b)
  return num.add(pair[0], pair[1])
}

function ts.sub(left: Any, right: Any) -> Number
kernel 1
errors "type_error"
charge sum(12, deep(left), deep(right))
native
body {
  # Float pairs already have ECMA Number semantics, including NaN and zero.
  if same(kind(left), "float") {
    if same(kind(right), "float") { return num.sub(left, right) }
  }
  let pair = invoke ts.numeric_pair(left, right)
  let a = pair[0]
  let b = pair[1]
  return num.sub(a, b)
}

