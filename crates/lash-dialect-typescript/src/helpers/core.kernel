  if same(k, "brand:typescript.iterator") { return same(name, "next") }
  if same(k, "text") {
    if same(name, "length") { return true }
    let length = text.utf16_len(target)
    let position = invoke ts.list_index(name, length)
    return num.le(0, position)
  }
  if same(k, "error") {
    if same(kind(target.data), "record") {
      let properties = target.data.properties
      if same(kind(properties), "record") { return record.contains(properties, name) }
      return false
    }
    return same(name, "message")
