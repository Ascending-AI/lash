function ts.regexp.toString(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error"
charge sum(8, deep(result))
body {
  let primitive = invoke ts.is_primitive(this)
  if primitive { throw error.new("type_error", "RegExp toString requires an object", null) }
  let source = invoke ts.get(this, "source")
  let sourceText = invoke ts.to_string(source)
  let flags = invoke ts.get(this, "flags")
  let flagText = invoke ts.to_string(flags)
  return text.concat("/", text.concat(sourceText, text.concat("/", flagText)))
}

