function ts.regexp.is(value: Any) -> Bool
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  if same(kind(value), "record") { return same(value.brand, "regex.ecma") }
  return false
}

