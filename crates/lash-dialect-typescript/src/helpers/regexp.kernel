function ts.regexp.match_record(match: Any, input: Text) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  if same(match, null) { return null }
  let items = []
  for group in match.groups {
    if same(group, null) { set items[list.len(items)] = absent } else { set items[list.len(items)] = group }
  }
  let named = match.named
  if same(named, null) { set named = absent } else {
    for key in record.keys(named) {
      if same(named[key], null) { set named[key] = absent }
    }
  }
  return {brand: "regex.match", items: items, index: num.to_float(match.index), input: input, groups: named}
}

