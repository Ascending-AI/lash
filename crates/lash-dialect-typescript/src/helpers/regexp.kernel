function ts.string.match(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 1)
  let arg_1 = padded[0]
  let regex = invoke ts.regexp.argument(arg_1)
  let global = invoke ts.regexp.global(regex)
  if global {
    set regex.lastIndex = 0.0
    let snapshot = invoke ts.regexp.snapshot(regex)
    let matches = invoke ts.regexp.native_match_all(snapshot, text)
    set regex.lastIndex = 0.0
    if eq(list.len(matches), 0) { return null }
    let output_value = []
    for match in matches { set output_value[list.len(output_value)] = match.groups[0] }
    return output_value
  }
  let passed = [text]
  let output_value = invoke ts.regexp.exec(regex, passed)
  return output_value
}

function ts.string.search(this: Any, args: List(Any)) -> Float
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 1)
  let arg_2 = padded[0]
  let regex = invoke ts.regexp.argument(arg_2)
  let snapshot = {brand: "regex.ecma", pattern: regex.pattern, flags: regex.flags, lastIndex: 0}
  let outcome = invoke ts.regexp.native_exec(snapshot, text)
  if same(outcome.match, null) { return -1.0 }
  return num.to_float(outcome.match.index)
}

function ts.string.matchAll(this: Any, args: List(Any)) -> List(Any)
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 1)
  let arg_3 = padded[0]
  let regex = invoke ts.regexp.is(arg_3)
  let value = padded[0]
  if regex {
    let global = invoke ts.regexp.global(value)
    if global {} else { throw error.new("type_error", "matchAll requires a global RegExp", null) }
  } else {
    let passed = [value, "g"]
    set value = invoke ts.regexp.create(absent, passed)
  }
  let snapshot = invoke ts.regexp.snapshot(value)
  let matches = invoke ts.regexp.native_match_all(snapshot, text)
  let output_value = []
  for match in matches {
    let item = invoke ts.regexp.match_record(match, text)
    set output_value[list.len(output_value)] = item
  }
  return output_value
}

function ts.string.split(this: Any, args: List(Any)) -> List(Any)
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 2)
  let limit = 4294967295
  if same(padded[1], absent) {} else {
    let arg_4 = padded[1]
    set limit = invoke ts.string.uint32(arg_4) }
  if eq(limit, 0) { return [] }
  let arg_5 = padded[0]
  let regex = invoke ts.regexp.is(arg_5)
  if regex {
    let value = padded[0]
    let snapshot = {brand: "regex.ecma", pattern: value.pattern, flags: value.flags, lastIndex: 0}
    let split = invoke ts.regexp.native_split(snapshot, text, limit)
    let output_value = []
    for part in split {
      if same(part, null) { set output_value[list.len(output_value)] = absent } else { set output_value[list.len(output_value)] = part }
    }
    return output_value
  }
  if same(padded[0], absent) { return [text] }
  let arg_6 = padded[0]
  let separator = invoke ts.to_string(arg_6)
  let output_value = []
  let start = 0
  let width = text.utf16_len(separator)
  let length = text.utf16_len(text)
  if eq(width, 0) {
    while num.lt(start, length) {
      let end = num.add(start, 1)
      let part = invoke ts.string.slice_units(text, start, end)
      set output_value[list.len(output_value)] = part
      if eq(list.len(output_value), limit) { return output_value }
      set start = end
    }
    return output_value
  }
  while true {
    let position = text.utf16_find(text, separator, start)
    if num.lt(position, 0) { break }
    let part = invoke ts.string.slice_units(text, start, position)
    set output_value[list.len(output_value)] = part
    if eq(list.len(output_value), limit) { return output_value }
    set start = num.add(position, width)
  }
  let tail = invoke ts.string.slice_units(text, start, length)
  set output_value[list.len(output_value)] = tail
  return output_value
}

function ts.string.substitute(replacement: Text, text: Text, needle: Text, position: Int) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let output_value = ""
  let index = 0
  let length = text.utf16_len(replacement)
  while num.lt(index, length) {
    let unit = text.utf16_get(replacement, index)
    let end = num.add(index, 1)
    if eq(unit, 36) {
      if num.lt(end, length) {
        let token = text.utf16_get(replacement, end)
        let piece = absent
        if eq(token, 36) { set piece = "$" }
        if eq(token, 38) { set piece = needle }
        if eq(token, 96) { set piece = invoke ts.string.slice_units(text, 0, position) }
        if eq(token, 39) {
          let after = num.add(position, text.utf16_len(needle))
          let size = text.utf16_len(text)
          set piece = invoke ts.string.slice_units(text, after, size)
        }
        if same(piece, absent) {} else {
          set output_value = text.concat(output_value, piece)
          set index = num.add(end, 1)
          continue
        }
      }
    }
    if num.le(55296, unit) { if num.le(unit, 56319) { set end = num.add(end, 1) } }
    set output_value = text.concat(output_value, text.utf16_slice(replacement, index, end))
    set index = end
  }
  return output_value
}

function ts.string.replace_value(this: Any, args: List(Any), replace_every: Bool) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 2)
  let search = padded[0]
  let replacement = padded[1]
  set replacement = invoke ts.callable(replacement)
  let callback = same(kind(replacement), "closure")
  let regex = invoke ts.regexp.is(search)
  if regex {
    let global = invoke ts.regexp.global(search)
    if replace_every { if global {} else { throw error.new("type_error", "replaceAll requires a global RegExp", null) } }
    if global { set search.lastIndex = 0.0 }
    let snapshot = invoke ts.regexp.snapshot(search)
    if callback {} else {
      let template = invoke ts.to_string(replacement)
      let outcome = invoke ts.regexp.native_replace(snapshot, text, template)
      let stateful = global
      if stateful {} else { set stateful = invoke ts.regexp.sticky(search) }
      if stateful { set search.lastIndex = num.to_float(outcome.lastIndex) }
      return outcome.text
    }
    # Collect before calling any callback. It may mutate the same regex.
    let matches = invoke ts.regexp.native_match_all(snapshot, text)
    if global { set search.lastIndex = 0.0 } else {
      let sticky = invoke ts.regexp.sticky(search)
      if sticky {
        if eq(list.len(matches), 0) { set search.lastIndex = 0.0 } else {
          let item = matches[0]
          set search.lastIndex = num.to_float(num.add(item.index, text.utf16_len(item.groups[0])))
        }
      }
    }
    let output_value = ""
    let end = 0
    for match in matches {
      let passed = []
      for capture in match.groups {
        if same(capture, null) { set passed[list.len(passed)] = absent } else { set passed[list.len(passed)] = capture }
      }
      set passed[list.len(passed)] = num.to_float(match.index)
      set passed[list.len(passed)] = text
      if same(match.named, null) {} else {
        let named = match.named
        for key in record.keys(named) { if same(named[key], null) { set named[key] = absent } }
        set passed[list.len(passed)] = named
      }
      let value = apply replacement(absent, passed)
      let substituted = invoke ts.to_string(value)
      let arg_7 = match.index
      let prefix = invoke ts.string.slice_units(text, end, arg_7)
      set output_value = text.concat(output_value, text.concat(prefix, substituted))
      set end = num.add(match.index, text.utf16_len(match.groups[0]))
    }
    let size = text.utf16_len(text)
    let tail = invoke ts.string.slice_units(text, end, size)
    return text.concat(output_value, tail)
  }
  let needle = invoke ts.to_string(search)
  let template = ""
  if callback {} else { set template = invoke ts.to_string(replacement) }
  let output_value = ""
  let end = 0
  let next = 0
  let length = text.utf16_len(text)
  let width = text.utf16_len(needle)
  while num.le(next, length) {
    let position = text.utf16_find(text, needle, next)
    if num.lt(position, 0) { break }
    let piece = ""
    if callback {
      let passed = [needle, num.to_float(position), text]
      let value = apply replacement(absent, passed)
      set piece = invoke ts.to_string(value)
    } else { set piece = invoke ts.string.substitute(template, text, needle, position) }
    let prefix = invoke ts.string.slice_units(text, end, position)
    set output_value = text.concat(output_value, text.concat(prefix, piece))
    set end = num.add(position, width)
    if replace_every {} else { break }
    set next = end
    if eq(width, 0) { set next = num.add(next, 1) }
  }
  let tail = invoke ts.string.slice_units(text, end, length)
  return text.concat(output_value, tail)
}

