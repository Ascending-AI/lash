function ts.regexp.exec(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  do invoke ts.regexp.require(this)
  let padded = invoke ts.pad(args, 1)
  let arg_6 = padded[0]
  let input = invoke ts.to_string(arg_6)
  let snapshot = invoke ts.regexp.snapshot(this)
  let outcome = absent
  set outcome = invoke ts.regexp.native_exec(snapshot, input)
  let stateful = num.le(0, text.utf16_find(this.flags, "g", 0))
  if stateful {} else { set stateful = num.le(0, text.utf16_find(this.flags, "y", 0)) }
  if stateful { set this.lastIndex = num.to_float(outcome.lastIndex) }
  let arg_7 = outcome.match
  let output_value = invoke ts.regexp.match_record(arg_7, input)
  return output_value
}

function ts.regexp.test(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
