}

function ts.regexp.create(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let padded = invoke ts.pad(args, 2)
  let source = ""
  let flags = ""
  let arg_1 = padded[0]
  let regex = invoke ts.regexp.is(arg_1)
  if regex {
    set source = padded[0].pattern
    set flags = padded[0].flags
  } else {
    if same(padded[0], absent) {} else {
      let arg_2 = padded[0]
      set source = invoke ts.to_string(arg_2) }
  }
  if same(padded[1], absent) {} else {
    let arg_3 = padded[1]
    set flags = invoke ts.to_string(arg_3) }
  try {
    let compiled = regex.ecma.compile_check(source, flags)
    set compiled.lastIndex = 0.0
    return compiled
  } catch syntax {
    if same(syntax.kind, "regex.syntax") { throw error.new("SyntaxError", syntax.message, null) }
    throw syntax
  }
}

