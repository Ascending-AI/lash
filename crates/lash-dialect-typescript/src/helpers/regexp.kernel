  let stateful = num.le(0, text.utf16_find(this.flags, "g", 0))
  if stateful {} else { set stateful = num.le(0, text.utf16_find(this.flags, "y", 0)) }
  if stateful { set this.lastIndex = num.to_float(outcome.lastIndex) }
  return outcome.matched
}

