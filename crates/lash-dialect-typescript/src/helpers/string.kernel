}

# Admit primitive bounds before any coercion; the generic path owns hooks.
function ts.string.slice(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "text") {
    let lower = absent
    let upper = absent
    if num.lt(0, list.len(args)) { set lower = args[0] }
    if num.lt(1, list.len(args)) { set upper = args[1] }
    let plain = true
    if same(lower, absent) {} else { if same(kind(lower), "float") {} else { set plain = false } }
    if same(upper, absent) {} else { if same(kind(upper), "float") {} else { set plain = false } }
    if plain {
      let length = text.utf16_len(this)
      let start = 0
      let end = length
      if same(lower, absent) {} else {
        set start = lower
        if num.is_nan(start) { set start = 0 } else { set start = num.trunc(start) }
        if num.lt(start, 0) { set start = num.add(length, start) }
        set start = num.min(num.max(start, 0), length)
      }
      if same(upper, absent) {} else {
        set end = upper
        if num.is_nan(end) { set end = 0 } else { set end = num.trunc(end) }
        if num.lt(end, 0) { set end = num.add(length, end) }
        set end = num.min(num.max(end, 0), length)
      }
      let first = float.to_int(num.to_float(start))
      let last = float.to_int(num.to_float(end))
      let out = invoke ts.string.slice_units(this, first, last)
      return out
    }
  }
  let out = invoke ts.string.slice_generic(this, args)
  return out
}

