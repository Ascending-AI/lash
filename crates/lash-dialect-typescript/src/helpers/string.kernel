function ts.string.codePointAt(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 1)
  let arg_5 = padded[0]
  let n = invoke ts.string.integer(arg_5)
  let length = text.utf16_len(text)
  if num.lt(n, 0) { return absent }
  if num.lt(n, length) {} else { return absent }
  let index = float.to_int(num.to_float(n))
  let unit = text.utf16_get(text, index)
  if num.le(55296, unit) {
    if num.le(unit, 56319) {
      let next = num.add(index, 1)
      if num.lt(next, length) {
        let low = text.utf16_get(text, next)
        if num.le(56320, low) {
          if num.le(low, 57343) {
            return num.to_float(num.add(65536, num.add(num.mul(num.sub(unit, 55296), 1024), num.sub(low, 56320))))
          }
        }
      }
    }
  }
  return num.to_float(unit)
}

