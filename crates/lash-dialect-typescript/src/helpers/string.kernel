  return text.repeat(text, float.to_int(num.to_float(n)))
}

function ts.string.padStart(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 2)
  let arg_24 = padded[0]
  let length = invoke ts.string.length_value(arg_24)
  let original = text.utf16_len(text)
  if num.le(length, original) { return text }
  let fill = " "
  if same(padded[1], absent) {} else {
    let arg_25 = padded[1]
    set fill = invoke ts.to_string(arg_25) }
  let width = text.utf16_len(fill)
  if eq(width, 0) { return text }
  let remaining = num.sub(length, original)
  let pad = ""
  while num.le(width, remaining) {
    set pad = text.concat(pad, fill)
    set remaining = num.sub(remaining, width)
  }
  let tail = invoke ts.string.slice_units(fill, 0, remaining)
  set pad = text.concat(pad, tail)
  return text.concat(pad, text)
}

function ts.string.padEnd(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
