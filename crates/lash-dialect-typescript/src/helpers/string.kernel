function ts.string.fromCharCode(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let units = []
  for value in args {
    let n = invoke ts.string.uint32(value)
    set units[list.len(units)] = int.rem_floor(n, 65536)
  }
  try { return text.from_utf16_units(units) } catch boundary {
    throw error.new("TS_LONE_SURROGATE_UNSUPPORTED", "String output_value contains a lone surrogate", null)
  }
}

function ts.string.fromCodePoint(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let units = []
  for value in args {
    let n = invoke ts.to_number(value)
    if num.is_finite(n) {} else { throw error.new("RangeError", "Invalid code point", null) }
    if eq(num.floor(n), n) {} else { throw error.new("RangeError", "Invalid code point", null) }
    if num.lt(n, 0) { throw error.new("RangeError", "Invalid code point", null) }
    if num.lt(1114111, n) { throw error.new("RangeError", "Invalid code point", null) }
    set units[list.len(units)] = float.to_int(n)
  }
  try { return text.from_code_points(units) } catch boundary {
    throw error.new("TS_LONE_SURROGATE_UNSUPPORTED", "String output_value contains a lone surrogate", null)
  }
}

function ts.string.raw(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let padded = invoke ts.pad(args, 1)
  let arg_28 = padded[0]
  let raw = invoke ts.get(arg_28, "raw")
  do invoke ts.require_object_coercible(raw)
  let count = invoke ts.get(raw, "length")
  let length = invoke ts.string.length_value(count)
  let output_value = ""
  let index = 0
  while num.lt(index, length) {
    let value = invoke ts.get(raw, index)
    let text = invoke ts.to_string(value)
    set output_value = text.concat(output_value, text)
    set index = num.add(index, 1)
    if num.lt(index, length) {
      if num.lt(index, list.len(args)) {
        let arg_29 = args[index]
        let substitution = invoke ts.to_string(arg_29)
        set output_value = text.concat(output_value, substitution)
      }
    }
  }
  return output_value
}

# CreateListFromArrayLike for Function.prototype.apply on a registered built-in.
function ts.string.apply_arguments(value: Any) -> List(Any)
kernel 1
errors "type_error"
charge sum(8, deep(result))
body {
  let nullish = invoke ts.is_nullish(value)
  if nullish { return [] }
  if same(kind(value), "list") { return value }
  if same(kind(value), "record") {} else { throw error.new("type_error", "apply arguments must be an object", null) }
  let count = invoke ts.get(value, "length")
  let length = invoke ts.string.length_value(count)
  let output_value = []
  let position = 0
  while num.lt(position, length) {
    let item = invoke ts.get(value, position)
    set output_value[list.len(output_value)] = item
    set position = num.add(position, 1)
  }
  return output_value
}
