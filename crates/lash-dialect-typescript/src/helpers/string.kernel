function ts.string.integer(value: Any) -> Number
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let number = invoke ts.to_number(value)
  if num.is_nan(number) { return 0 }
  if eq(number, 0) { return 0 }
  if num.is_finite(number) {} else { return number }
  if num.lt(number, 0) { return num.neg(num.floor(num.neg(number))) }
  return num.floor(number)
}

function ts.string.clamp(value: Number, length: Int) -> Int
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  if num.lt(value, 0) { return 0 }
  if num.lt(value, length) { return float.to_int(num.to_float(value)) }
  return length
}

function ts.string.relative(value: Any, length: Int) -> Int
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let index = invoke ts.string.integer(value)
  if num.lt(index, 0) { set index = num.add(length, index) }
  let output_value = invoke ts.string.clamp(index, length)
  return output_value
}

function ts.string.length_value(value: Any) -> Int
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let n = invoke ts.string.integer(value)
  let output_value = invoke ts.string.clamp(n, 9007199254740991)
  return output_value
}

function ts.string.uint32(value: Any) -> Int
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let n = invoke ts.string.integer(value)
  if num.is_finite(n) {} else { return 0 }
  return int.rem_floor(float.to_int(num.to_float(n)), 4294967296)
}

function ts.string.receiver(this: Any) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  do invoke ts.require_object_coercible(this)
  let text = invoke ts.to_string(this)
  return text
}

function ts.string.slice_units(text: Text, start: Int, end: Int) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  try { return text.utf16_slice(text, start, end) } catch boundary {
    if same(boundary.kind, "text_boundary") {
      throw error.new("TS_LONE_SURROGATE_UNSUPPORTED", "String output_value contains a lone surrogate", null)
    }
    throw boundary
  }
}

