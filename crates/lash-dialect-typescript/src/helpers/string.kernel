function ts.string.lastIndexOf(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 2)
  let arg_12 = padded[0]
  let needle = invoke ts.to_string(arg_12)
  let length = text.utf16_len(text)
  let position = 0
  let arg_13 = padded[1]
  let n = invoke ts.to_number(arg_13)
  if num.is_nan(n) { set n = inf } else { set n = invoke ts.string.integer(n) }
  set position = invoke ts.string.clamp(n, length)
  let found = -1
  let next = 0
  while num.le(next, position) {
    let at = text.utf16_find(text, needle, next)
    if num.lt(at, 0) { break }
    if num.lt(position, at) { break }
    set found = at
    set next = num.add(at, 1)
  }
  return num.to_float(found)
}

