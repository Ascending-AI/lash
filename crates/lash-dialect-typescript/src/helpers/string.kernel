# Admit primitive bounds before any coercion; the generic path owns hooks.
function ts.string.at(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "text") {
    let input = absent
    if num.lt(0, list.len(args)) { set input = args[0] }
    let plain = same(input, absent)
    if same(kind(input), "float") { set plain = true }
    if plain {
      let n = 0
      if same(input, absent) {} else {
        set n = input
        if num.is_nan(n) { set n = 0 } else { set n = num.trunc(n) }
      }
      let length = text.utf16_len(this)
      if num.lt(n, 0) { set n = num.add(length, n) }
      if num.lt(n, 0) { return absent }
      if num.lt(n, length) {} else { return absent }
      let index = float.to_int(num.to_float(n))
      let end = num.add(index, 1)
      let out = invoke ts.string.slice_units(this, index, end)
      return out
    }
  }
  let out = invoke ts.string.at_generic(this, args)
  return out
}

