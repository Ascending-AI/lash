charge sum(8, deep(this), deep(args), deep(result))
body {
  if same(kind(this), "text") {
    if num.lt(0, list.len(args)) {
      if same(kind(args[0]), "text") {
        let position = 0
        let input = absent
        if num.lt(1, list.len(args)) { set input = args[1] }
        let plain = same(input, absent)
        if same(kind(input), "float") { set plain = true }
        if plain {
          if same(input, absent) {} else {
            let n = input
            if num.is_nan(n) { set n = 0 } else { set n = num.trunc(n) }
            set position = float.to_int(num.to_float(num.min(num.max(n, 0), text.utf16_len(this))))
          }
          return num.to_float(text.utf16_find(this, args[0], position))
        }
      }
    }
  }
  let out = invoke ts.string.indexOf_generic(this, args)
  return out
}

