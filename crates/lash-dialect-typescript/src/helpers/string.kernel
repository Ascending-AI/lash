function ts.string.slice_units(text: Text, start: Int, end: Int) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, size(text), size(start), size(end), deep(result))
body {
