  let end = length
  if same(padded[1], absent) {} else {
    let arg_7 = padded[1]
    set end = invoke ts.string.relative(arg_7, length)
  }
  let out = invoke ts.string.slice_units(text, start, end)
  return out
}

function ts.string.substring(this: Any, args: List(Any)) -> Text
kernel 1
errors "type_error", "RangeError", "TS_LONE_SURROGATE_UNSUPPORTED"
charge sum(8, deep(result))
body {
  let text = invoke ts.string.receiver(this)
  let padded = invoke ts.pad(args, 2)
  let length = text.utf16_len(text)
  let arg_8 = padded[0]
  let n = invoke ts.string.integer(arg_8)
  let start = invoke ts.string.clamp(n, length)
  let end = length
  if same(padded[1], absent) {} else {
    let arg_9 = padded[1]
    let n = invoke ts.string.integer(arg_9)
    set end = invoke ts.string.clamp(n, length)
  }
  if num.lt(end, start) { let old = start
    set start = end
    set end = old
  }
  let out = invoke ts.string.slice_units(text, start, end)
  return out
}

