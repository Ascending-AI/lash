# JavaScript function behavior, expressed in kernel code.
use text.concat
use ts.callable
use error.new
use kind
use list.len
use num.add
use num.lt
use num.sub
use num.to_float
use record.contains
use same
use ts.function.apply
use ts.function.bind
use ts.function.call
use ts.function.toString
use ts.get
use ts.is_nullish
use ts.own
use ts.pad
use ts.rest
use ts.spread
use ts.to_number

function ts.function.call(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let receiver = args[0]
  let passed = invoke ts.rest(args, 1)
  let target = invoke ts.callable(this)
  let output = apply target(receiver, passed)
  return output
}

function ts.function.apply(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let receiver = args[0]
  let values = args[1]
  let passed = []
  let nullish = invoke ts.is_nullish(values)
  if nullish {} else {
    if same(kind(values), "list") { set passed = values } else {
      let length = invoke ts.get(values, "length")
      let length = invoke ts.to_number(length)
      let i = 0
      while num.lt(i, length) {
        let value = invoke ts.get(values, i)
        set passed[list.len(passed)] = value
        set i = num.add(i, 1)
      }
    }
  }
  let target = invoke ts.callable(this)
  let output = apply target(receiver, passed)
  return output
}

function ts.function.bind(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let original = invoke ts.callable(this)
  if same(kind(original), "closure") {} else { throw error.new("type_error", "Bind target must be callable", null) }
  let args = invoke ts.pad(args, 1)
  let receiver = args[0]
  let prefix = invoke ts.rest(args, 1)
  # Named for the target, with the target's own length less the
  # arguments bound (ECMA-262 Function.prototype.bind).
  let length = 0.0
  if same(kind(this), "closure") {
    let target_own = invoke ts.own(this)
    if record.contains(target_own, "length") { set length = target_own.length }
  } else {
    let token_length = invoke ts.get(this, "length")
    set length = token_length
  }
  set length = num.sub(length, num.to_float(list.len(prefix)))
  if num.lt(length, 0) { set length = 0.0 }
  let name = invoke ts.get(this, "name")
  if same(kind(name), "text") {} else { set name = "" }
  let own = {name: text.concat("bound ", name), length: length}
  return fn(ignored, tail) {
    try { let counted = list.len(tail) } catch asked { return own }
    let builtin_arg_0 = [prefix, tail]
let passed = invoke ts.spread(builtin_arg_0)
    let output = apply original(receiver, passed)
    return output
  }
}

function ts.function.toString(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let target = invoke ts.callable(this)
  if same(kind(target), "closure") {} else { throw error.new("type_error", "Function receiver required", null) }
  if same(kind(this), "tuple") { return text.concat("function ", text.concat(this[2], "() { [native code] }")) }
  throw error.new("TS_FUNCTION_STRING_COERCION", "Function source is unavailable", null)
}

# The global function is a value; calling it cannot admit dynamic source.
function ts.function.eval(this: Any, args: List(Any)) -> Any
kernel 1
errors "TS_EVAL_UNSUPPORTED"
charge 4
body {
  throw error.new("TS_EVAL_UNSUPPORTED", "Dynamic evaluation is outside the TypeScript dialect; write the code in the cell", null)
}
