use ts.boundary
use same
use text.join
use list.len
use json.stringify
use record.keys
use ts.console.json
use ts.receiver
use ts.to_string

# Console's compact JSON uses the guest number spelling. The kernel JSON
# codec preserves Int/Float spellings, so only scalar JSON escaping is
# shared; structured values have already passed its cycle/data checks.
function ts.console.json(value: Any) -> Text
kernel 1
errors "type_error"
charge sum(8, deep(value), size(result))
body {
  # Every value writes its fragments to `out`, which is joined once: the
  # text is copied once whatever its depth.
  let out = []
  let convert = absent
  set convert = fn(item) {
    let k = invoke ts.receiver(item)
    if same(k, "number") {
      let spelled = invoke ts.to_string(item)
      set out[list.len(out)] = spelled
      return null
    }
    if same(k, "list") {
      set out[list.len(out)] = "["
      let first = true
      for member in item {
        if first { set first = false } else { set out[list.len(out)] = "," }
        do apply convert(member)
      }
      set out[list.len(out)] = "]"
      return null
    }
    if same(k, "record") {
      set out[list.len(out)] = "{"
      let first = true
      for name in record.keys(item) {
        if first { set first = false } else { set out[list.len(out)] = "," }
        set out[list.len(out)] = json.stringify(name)
        set out[list.len(out)] = ":"
        let member = item[name]
        do apply convert(member)
      }
      set out[list.len(out)] = "}"
      return null
    }
    set out[list.len(out)] = json.stringify(item)
    return null
  }
  do apply convert(value)
  return text.join(out, "")
}

# `console.log` and its siblings: one print of the arguments joined by a
# space, a plain object or an array as compact JSON and anything else as its
# ToString.
function ts.console.log(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge sum(4, deep(args))
body {
  let pieces = []
  for item in args {
    let k = invoke ts.receiver(item)
    let structured = same(k, "record")
    if structured {} else {
      set structured = same(k, "list")
    }
    if structured {
      let copied = invoke ts.boundary(item)
      let checked = json.stringify(copied)
      let piece = invoke ts.console.json(copied)
      set pieces[list.len(pieces)] = piece
    } else {
      let piece = invoke ts.to_string(item)
      set pieces[list.len(pieces)] = piece
    }
  }
  let line = text.join(pieces, " ")
  print line
  return absent
}
