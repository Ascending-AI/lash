use ts.boundary
use same
use text.join
use list.len
use json.render_parts
use kind
use ts.number.to_string
use ts.console.json
use ts.receiver
use ts.to_string

# Strict JSON is visited once by the neutral codec. Text fragments are
# already escaped; numeric fragments keep their value for guest spelling.
# Maps, tuples and records marked by a text brand retain kernel spelling.
function ts.console.json(value: Any) -> Text
kernel 1
errors "type_error", "cycle", "json_number", "json_key", "json_depth", "not_data"
charge sum(8, deep(value), size(result))
body {
  let verbatim = set{"map", "tuple"}
  let parts = json.render_parts(value, verbatim, "brand")
  let out = []
  for part in parts {
    if same(kind(part), "text") { set out[list.len(out)] = part } else {
      let spelled = invoke ts.number.to_string(part)
      set out[list.len(out)] = spelled
    }
  }
  return text.join(out, "")
}

# `console.log` and its siblings: one print of the arguments joined by a
# space, a plain object or an array as compact JSON and anything else as its
# ToString.
function ts.console.log(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge sum(4, deep(args))
body {
  let pieces = []
  for item in args {
    let k = invoke ts.receiver(item)
    let structured = same(k, "record")
    if structured {} else {
      set structured = same(k, "list")
    }
    if structured {
      let copied = invoke ts.boundary(item)
      let piece = invoke ts.console.json(copied)
      set pieces[list.len(pieces)] = piece
    } else {
      let piece = invoke ts.to_string(item)
      set pieces[list.len(pieces)] = piece
    }
  }
  let line = text.join(pieces, " ")
  print line
  return absent
}
