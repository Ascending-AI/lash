use ts.boundary
use same
use text.join
use list.len
use json.render
use ts.console.json
use ts.receiver
use ts.to_string

# The shared strict writer uses the dialect's decimal-point limits,
# positive exponent sign and unsigned zero. Maps and kernel tuples retain
# kernel spelling; no fragments cross back into guest code.
function ts.console.json(value: Any) -> Text
kernel 1
errors "type_error", "cycle", "json_number", "json_key", "json_depth", "not_data", "number_range"
charge sum(8, deep(value), size(result))
body {
  let verbatim = set{"map", "tuple"}
  return json.render(value, verbatim, absent, (-5, 21, true, false))
}

# `console.log` and its siblings: one print of the arguments joined by a
# space, a plain object or an array as compact JSON and anything else as its
# ToString.
function ts.console.log(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge sum(4, deep(args))
body {
  let pieces = []
  for item in args {
    let k = invoke ts.receiver(item)
    let structured = same(k, "record")
    if structured {} else {
      set structured = same(k, "list")
    }
    if structured {
      let copied = invoke ts.boundary(item)
      let piece = invoke ts.console.json(copied)
      set pieces[list.len(pieces)] = piece
    } else {
      let piece = invoke ts.to_string(item)
      set pieces[list.len(pieces)] = piece
    }
  }
  let line = text.join(pieces, " ")
  print line
  return absent
}
