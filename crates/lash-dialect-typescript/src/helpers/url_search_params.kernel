}

function ts.url_search_params.has(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_5 = args[0]
let name = invoke ts.to_string(builtin_arg_5)
  let output = []
  let filter = args[1]
  if same(kind(filter), "absent") {} else { set filter = invoke ts.to_string(filter) }
  for pair in this.pairs {
    if same(pair[0], name) {
      if same(kind(filter), "absent") { return true }
      if same(pair[1], filter) { return true }
    }
  }
  return false
}

function ts.url_search_params.append(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_6 = args[0]
let name = invoke ts.to_string(builtin_arg_6)
  let builtin_arg_7 = args[1]
let value = invoke ts.to_string(builtin_arg_7)
  set this.pairs[list.len(this.pairs)] = [name, value]
  do invoke ts.url_search_params.refresh(this)
  return absent
}

function ts.url_search_params.set(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_8 = args[0]
let name = invoke ts.to_string(builtin_arg_8)
  let value = args[1]
  set value = invoke ts.to_string(value)
  let output = []
  let found = false
  for pair in this.pairs {
    if same(pair[0], name) {
      if found {} else { set output[list.len(output)] = [name, value] set found = true }
    } else { set output[list.len(output)] = pair }
  }
  if found {} else { set output[list.len(output)] = [name, value] }
  set this.pairs = output
  do invoke ts.url_search_params.refresh(this)
  return absent
}

function ts.url_search_params.delete(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_9 = args[0]
let name = invoke ts.to_string(builtin_arg_9)
  let value = args[1]
  if same(kind(value), "absent") {} else { set value = invoke ts.to_string(value) }
  let output = []
  let found = false
  for pair in this.pairs {
    if same(pair[0], name) {
      if same(kind(value), "absent") {} else { if same(pair[1], value) {} else { set output[list.len(output)] = pair } }
    } else { set output[list.len(output)] = pair }
  }
  set this.pairs = output
  do invoke ts.url_search_params.refresh(this)
  return absent
}

function ts.url_search_params.sort(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let i = 1
  while num.lt(i, list.len(this.pairs)) {
    let item = this.pairs[i]
    let j = i
    while num.lt(0, j) {
      let previous = num.sub(j, 1)
      if num.lt(text.utf16_compare(item[0], this.pairs[previous][0]), 0) {
        set this.pairs[j] = this.pairs[previous]
        set this.pairs[previous] = item
        set j = previous
      } else { break }
    }
    set i = num.add(i, 1)
  }
  do invoke ts.url_search_params.refresh(this)
  return absent
}

