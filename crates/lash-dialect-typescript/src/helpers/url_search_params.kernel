function ts.url_search_params.forEach(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let callback = args[0]
  set callback = invoke ts.callable(callback)
  let receiver = args[1]
  let i = 0
  while num.lt(i, list.len(this.pairs)) {
    let pair = this.pairs[i]
    let passed = [pair[1], pair[0], this]
    do apply callback(receiver, passed)
    set i = num.add(i, 1)
  }
  return absent
}
