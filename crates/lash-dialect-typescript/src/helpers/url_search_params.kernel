function ts.url_search_params.get(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let builtin_arg_3 = args[0]
let name = invoke ts.to_string(builtin_arg_3)
  let output = []
  let filter = args[1]
  if same(kind(filter), "absent") {} else { set filter = invoke ts.to_string(filter) }
  for pair in this.pairs {
    if same(pair[0], name) {
      return pair[1]
    }
  }
  return null
}

function ts.url_search_params.getAll(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
