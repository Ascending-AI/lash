function ts.url_search_params.refresh(params: Any) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(params.owner), "record") {
    let serialized = url.whatwg.query_stringify(params.pairs)
    let parsed = url.whatwg.update(params.owner.href, "search", serialized)
    for key in record.keys(parsed.state) { set params.owner[key] = parsed.state[key] }
  }
  return absent
}

function ts.url_search_params.construct(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let input = args[0]
  let pairs = []
  if same(kind(input), "absent") {} else {
    if same(kind(input), "record") {
      if same(input.brand, "url.search_params") {
        for pair in input.pairs { set pairs[list.len(pairs)] = [pair[0], pair[1]] }
      } else {
        for key in record.keys(input) { let builtin_arg_0 = input[key]
let value = invoke ts.to_string(builtin_arg_0) set pairs[list.len(pairs)] = [key, value] }
      }
    } else {
      if same(kind(input), "list") {
        for pair in input {
          let values = invoke ts.iterate(pair)
          if eq(list.len(values), 2) {} else { throw error.new("type_error", "Each query pair needs two items", null) }
          let builtin_arg_1 = values[0]
let name = invoke ts.to_string(builtin_arg_1)
          let builtin_arg_2 = values[1]
let value = invoke ts.to_string(builtin_arg_2)
          set pairs[list.len(pairs)] = [name, value]
        }
      } else {
        let text = invoke ts.to_string(input)
        set pairs = url.whatwg.query_parse(text)
      }
    }
  }
  return {brand: "url.search_params", pairs: pairs, owner: absent}
}

function ts.url_search_params.is(value: Any) -> Bool
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  if same(kind(value), "record") { return same(value.brand, "url.search_params") }
  return false
}

function ts.url_search_params.size(this: Any) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  return num.to_float(list.len(this.pairs))
}

function ts.url_search_params.toString(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  return url.whatwg.query_stringify(this.pairs)
}

function ts.url_search_params.valueOf(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  return this
