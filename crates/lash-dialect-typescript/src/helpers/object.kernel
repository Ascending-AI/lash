function ts.object.fromEntries(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let builtin_arg_3 = args[0]
let source = invoke ts.iterate(builtin_arg_3)
  let output = {}
  for pair_item in source {
    let entry_kind = kind(pair_item)
    if same(entry_kind, "list") {} else {
      if same(entry_kind, "record") {} else { throw error.new("type_error", "Iterator value is not an entry object", null) }
    }
    let key = invoke ts.get(pair_item, 0)
    let key = invoke ts.to_property_key(key)
    let value = invoke ts.get(pair_item, 1)
    set output[key] = value
  }
  return output
}

function ts.object.assign(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let target = args[0]
  do invoke ts.require_object_coercible(target)
  let receiver = invoke ts.receiver(target)
  let primitive = invoke ts.is_primitive(target)
  if primitive { throw error.new("TS_BOXED_PRIMITIVE_UNSUPPORTED", "Boxed primitive wrappers are outside the dialect", null) }
  if same(receiver, "record") {} else { throw error.new("TS_METHOD_UNSUPPORTED", "Object.assign requires a plain record target", null) }
  let sources = invoke ts.rest(args, 1)
  for source in sources {
    let keys = invoke ts.object.own_keys(source)
    for key in keys {
      let value = invoke ts.get(source, key)
      set target[key] = value
    }
  }
  return target
}

