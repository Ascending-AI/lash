function ts.object.hasOwnProperty(this: Any, args: List(Any)) -> Bool
kernel 1
errors "type_error"
charge sum(12, deep(this), deep(args))
body {
  let args = invoke ts.pad(args, 1)
  let key_value = args[0]
  let key = invoke ts.to_property_key(key_value)
  do invoke ts.require_object_coercible(this)
  let own = invoke ts.has_own(this, key)
  return own
}

function ts.object.toString(this: Any, args: List(Any)) -> Text
kernel 1
charge 12
body {
  let k = invoke ts.receiver(this)
  let tag = "Object"
  if same(k, "absent") { set tag = "Undefined" }
  if same(k, "null") { set tag = "Null" }
  if same(k, "bool") { set tag = "Boolean" }
  if same(k, "number") { set tag = "Number" }
  if same(k, "text") { set tag = "String" }
  if same(k, "list") { set tag = "Array" }
  if same(k, "map") { set tag = "Map" }
  if same(k, "set") { set tag = "Set" }
  if same(k, "timestamp") { set tag = "Date" }
  if same(k, "error") { set tag = "Error" }
  if same(k, "closure") { set tag = "Function" }
  if same(k, "brand:ts.arguments") { set tag = "Arguments" }
  if same(k, "brand:regex.ecma") { set tag = "RegExp" }
  if same(k, "brand:date.invalid") { set tag = "Date" }
  return text.concat("[object ", text.concat(tag, "]"))
}

function ts.object.propertyIsEnumerable(this: Any, args: List(Any)) -> Bool
kernel 1
errors "type_error"
charge sum(12, size(this), deep(args))
body {
  let args = invoke ts.pad(args, 1)
  let value = args[0]
  let key = invoke ts.to_property_key(value)
  do invoke ts.require_object_coercible(this)
  let keys = invoke ts.keys(this)
  for name in keys { if same(name, key) { return true } }
  return false
}

function ts.object.toLocaleString(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge sum(12, deep(this))
body {
  do invoke ts.require_object_coercible(this)
  let receiver = invoke ts.receiver(this)
  if same(receiver, "record") {
    if record.contains(this, "toString") {
      let method = this.toString
      let none = []
      let output = apply method(this, none)
      return output
    }
  } else {
    throw error.new("TS_METHOD_UNSUPPORTED", "Locale formatting for this receiver is outside the dialect", null)
  }
  let none = []
  let output = invoke ts.object.toString(this, none)
  return output
}

function ts.object.isPrototypeOf(this: Any, args: List(Any)) -> Bool
kernel 1
errors "type_error", "TS_METHOD_UNSUPPORTED"
charge sum(12, deep(args))
body {
  let args = invoke ts.pad(args, 1)
  let value = args[0]
  let primitive = invoke ts.is_primitive(value)
  if primitive { return false }
  do invoke ts.require_object_coercible(this)
  let primitive = invoke ts.is_primitive(this)
  if primitive { return false }
  let receiver = invoke ts.receiver(this)
  for instance in ["record", "list", "map", "set", "error", "timestamp", "closure", "brand:date.invalid", "brand:regex.ecma", "brand:ts.arguments"] {
    if same(receiver, instance) { return false }
  }
  # Ordinary guest objects cannot become another object's prototype:
  # creation with a prototype and prototype surgery are refused.
  throw error.new("TS_METHOD_UNSUPPORTED", "Reflection on built-in prototypes is outside the dialect", null)
}

function ts.object.valueOf(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error"
charge 12
body {
  do invoke ts.require_object_coercible(this)
  let primitive = invoke ts.is_primitive(this)
  if primitive { throw error.new("TS_BOXED_PRIMITIVE_UNSUPPORTED", "Boxed primitive wrappers are outside the dialect", null) }
  return this
}
