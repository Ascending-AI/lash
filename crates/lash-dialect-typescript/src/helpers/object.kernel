  let builtin_arg_4 = args[0]
do invoke ts.require_object_coercible(builtin_arg_4)
  let builtin_arg_5 = args[0]
let builtin_arg_6 = args[1]
let output = invoke ts.has_own(builtin_arg_5, builtin_arg_6)
  return output
}

function ts.object.is(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let a = args[0]
  let b = args[1]
  let ka = invoke ts.receiver(a)
  let kb = invoke ts.receiver(b)
  if same(ka, "number") {
    if same(kb, "number") {
      if num.is_nan(a) { return num.is_nan(b) }
      if eq(a, 0) { if eq(b, 0) { return eq(num.div(1.0, a), num.div(1.0, b)) } }
    }
  }
  let output = invoke ts.strict_equals(a, b)
  return output
}

function ts.object.groupBy(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 2)
  let callback = args[1]
  if same(kind(callback), "closure") {} else { throw error.new("type_error", "GroupBy callback must be callable", null) }
  let builtin_arg_7 = args[0]
let source = invoke ts.iterate(builtin_arg_7)
  let output = {}
  let index = 0.0
  for item in source {
    let passed = [item, index]
    let key = apply callback(absent, passed)
    let key = invoke ts.to_property_key(key)
    if record.contains(output, key) {} else { set output[key] = [] }
    let group = output[key]
    set group[list.len(group)] = item
    set index = num.add(index, 1.0)
  }
  return output
}

