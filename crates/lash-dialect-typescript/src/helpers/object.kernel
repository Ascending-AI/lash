function ts.object.own_keys(target: Any) -> List(Text)
kernel 1
charge sum(16, product(size(target), size(target)))
body {
  let keys = invoke ts.keys(target)
  let indices = []
  let others = []
  for key in keys {
    let number = invoke ts.number.parse(key)
    let spelling = invoke ts.number.to_string(number)
    let index = false
    if same(spelling, key) {
      if num.le(0, number) { if num.lt(number, 4294967295.0) { if eq(number, num.floor(number)) { set index = true } } }
    }
    if index {
      let position = list.len(indices)
      set indices[position] = key
      while num.lt(0, position) {
        let previous = num.sub(position, 1)
        let builtin_arg_0 = indices[previous]
let previous_number = invoke ts.number.parse(builtin_arg_0)
        if num.lt(number, previous_number) {
          set indices[position] = indices[previous]
          set indices[previous] = key
          set position = previous
        } else { break }
      }
    } else { set others[list.len(others)] = key }
  }
  for key in others { set indices[list.len(indices)] = key }
  return indices
}

function ts.object.convert(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let value = args[0]
  let nullish = invoke ts.is_nullish(value)
  if nullish { return {} }
  let primitive = invoke ts.is_primitive(value)
  if primitive { throw error.new("TS_BOXED_PRIMITIVE_UNSUPPORTED", "Boxed primitive wrappers are outside the dialect", null) }
  return value
}

function ts.object.keys(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let builtin_arg_1 = args[0]
do invoke ts.require_object_coercible(builtin_arg_1)
  let builtin_arg_2 = args[0]
let output = invoke ts.object.own_keys(builtin_arg_2)
  return output
}

function ts.object.values(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge sum(8, deep(result))
body {
  let args = invoke ts.pad(args, 1)
  let target = args[0]
  do invoke ts.require_object_coercible(target)
  let keys = invoke ts.object.own_keys(target)
  let output = []
  for key in keys {
    let value = invoke ts.get(target, key)
    set output[list.len(output)] = value
  }
  return output
}

