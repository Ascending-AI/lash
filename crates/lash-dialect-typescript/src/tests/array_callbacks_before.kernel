function ts.array.reduce(this: Any, args: List(Any)) -> Any
kernel 1
errors "type_error", "RangeError"
charge 8
body {
  let length = invoke ts.array.length(this)
  let input = invoke ts.array.argument(args, 0)
  let callback = invoke ts.array.callback(input)
  let accumulator = invoke ts.array.argument(args, 1)
  let initialised = num.lt(1, list.len(args))
  let index = 0.0
  while num.lt(index, length) {
    if num.lt(index, 0) { break }
    let present = invoke ts.has_own(this, index)
    if present {
      let value = invoke ts.get(this, index)
      if initialised {
        let passed = [accumulator, value, num.to_float(index), this]
        set accumulator = apply callback(absent, passed)
      } else {
        set accumulator = value
        set initialised = true
      }
    }
    set index = num.add(index, 1.0)
  }
  if initialised { return accumulator }
  throw error.new("type_error", "Reduce of empty array with no initial value", null)
}

