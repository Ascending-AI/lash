  if t70 {
    set lines[list.len(lines)] = ts.to_string(await(invoke dataframe.data_quanta.explain(viaExprs)) via ts.await)
    set t71 = absent
  } else {
    let t73 = invoke ts.member.push(lines)
    set t71 = let(t74 = t73, let(t75 = [ts.to_string(await(invoke dataframe.data_quanta.explain(viaExprs)) via ts.await)], let(t76 = ts.callable(t74), apply t76(lines, t75))))
  }
  return lines via ts.promise.adopt
}

main {
  let wordcount = &wordcount
}
