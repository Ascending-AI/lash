{
  "id": "process-literal-binding",
  "about": "a top-level uncalled async arrow is a function value, and lifts to a process in lash",
  "probe": [
    "worker"
  ],
  "deviations": [],
  "cells": [
    {
      "source": "const worker = async () => {\n  return 1;\n};\nconsole.log(typeof worker);\n",
      "reject": null,
      "deviation": "process-literal-is-a-process-value",
      "defect": null,
      "node": {
        "outcome": "normal",
        "prints": [
          "function"
        ],
        "probes": {
          "worker": "function undefined"
        },
        "closures": [
          "worker"
        ]
      },
      "lash": {
        "resident": {
          "outcome": "normal",
          "prints": [
            "object"
          ],
          "probes": {
            "worker": "object {\"id\":{\"$lash_definition_id\":\"lash.definition:sha256:<hash>\"},\"signature\":{\"encoding\":{\"x-lash\":{\"kind\":\"process\",\"signature\":{\"output\":{\"type\":\"integer\"},\"params\":[]}}},\"signature\":\"known\"}}"
          }
        },
        "restart": {
          "outcome": "normal",
          "prints": [
            "object"
          ],
          "probes": {
            "worker": "object {\"id\":{\"$lash_definition_id\":\"lash.definition:sha256:<hash>\"},\"signature\":{\"encoding\":{\"x-lash\":{\"kind\":\"process\",\"signature\":{\"output\":{\"type\":\"integer\"},\"params\":[]}}},\"signature\":\"known\"}}"
          }
        }
      }
    }
  ]
}
