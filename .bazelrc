# Where the pool lives, which certificate reaches it, which runtime image it
# pins, and where this host keeps its caches are deployment facts, not
# repository facts: they move when the pool is redeployed or the executor is
# repinned, and they differ between a development host and a CI runner. None
# of them is committed here.
#
# Locally, kiln writes them to .kiln.bazelrc on every fork and golden refresh,
# from the installed executor manifest. The file is gitignored and this import
# is `try-`: a checkout without it still builds, it just has no shared
# executor, and `scripts/hermetic-build.sh --shared` says so rather than
# failing obscurely. In CI they are `build-cache` environment secrets, written
# by the build-infra repository and read by
# `.github/actions/bazel-shared-cache`.
try-import %workspace%/.kiln.bazelrc

# Cargo's per-package opt levels (`[profile.dev.package]`), generated by
# `kiln sync` so the two build systems compile those crates alike.
import %workspace%/tools/bazel/opt_levels.bazelrc

startup --host_jvm_args=-Xmx4g
# An idle server returns its heap: G1 runs a periodic collection once a minute
# and uncommits what it frees, instead of holding its peak until it exits.
startup --host_jvm_args=-XX:G1PeriodicGCInterval=60000
# Each fork is its own output base and therefore its own Bazel server; 22
# idle servers held ~51 GiB on this box. The default idle timeout is 10800;
# a restart after eviction costs seconds, so ten minutes is enough to keep an
# edit-build loop warm without parking a server per forgotten fork.
startup --max_idle_secs=600
common --enable_platform_specific_config
common --lockfile_mode=error

# Every pre-analysis fetch of a module archive or a release asset is a serial
# point of failure on someone else's CDN, and a single HTTP 500 aborts analysis
# before anything is compiled. Measured against a local server that answers 500
# (Bazel 9.1.0, `bazel fetch` of an http_archive): the stock defaults give 8
# attempts over 17s and then fail, and the outer
# --experimental_repository_downloader_retries layer adds nothing for this error
# class -- --http_connector_attempts is the load-bearing knob. The backoff
# doubles from 100ms and is otherwise unbounded, so raising the attempt count
# alone buys attempts at an exponential price; capping each wait at 15s buys a
# window instead. At these values the same fault injection retries 22 times over
# 199s before giving up, and a 12-failure outage that the defaults could not ride
# out now succeeds on attempt 13. Roughly three minutes of transient 5xx is
# absorbed, against the 13 minutes plus queue position a CI rerun costs.
common --http_connector_attempts=20
common --http_connector_retry_max_timeout=15s
# Pinned rather than inherited: it is the documented retry knob, and a future
# default of 0 would silently remove the outer layer.
common --experimental_repository_downloader_retries=5

# What the pool is asked FOR is a repository fact and stays here.
#
# These two numbers are the request every action carries unless it names its
# own. The scheduler treats both as consumable minimums and subtracts them from
# the worker's advertised totals, and the executor sizes the action's cgroup
# from the memory request, so a default sized for the largest rustc in the
# graph made a 200 ms genrule hold a lash-core-sized slot: bazelbox-02 sat at
# 17 of 20 slots and 30% CPU. The default is therefore the small action, and
# the heavy ones are sized per target from the measured table in
# `tools/bazel/action-sizes.json` (emitted as `exec_properties` into the
# generated BUILD files, where the diff shows them).
#
# Both values are part of every action key, so changing either re-keys this
# repository's whole remote cache. That cost was paid once, deliberately, when
# these lines moved from 4 cores / 4 GiB to the values below. They do not
# change again: an action that is OOM-killed or starved is a missing row in
# action-sizes.json, never a reason to move a default.
#
# A test RUN is sized apart from its compile, through Bazel's `test` exec group:
# the generator writes `test.cpu_count` / `test.memory_kb` on every test target,
# and Bazel applies those to the TestRunner spawn only, while the plain keys
# size the compile. Runs are measured per Bazel label on the pool
# (`tools/bazel/test-run-sizes.json`, rebuilt by `action_sizes_from_log.py
# --test-runs`); an unmeasured run asks for four cores and 4 GiB. The
# timing-sensitive lash-perf and lash-sim suites keep four cores whatever they
# measure: at one core CI run 34950810111 failed
# `//crates/lash-perf:lash-perf__unit_test` on a phase assertion and timed out
# `//crates/lash-sim:stack_policy__test` (`CONTENTION_FLOOR_PACKAGES` in
# `tools/bazel/generate_build_files.py`).
#
# Local forks and CI inherit these same defaults, including toolchain and
# dependency actions without explicit requests. Different defaults produce
# different remote action keys.
build --remote_default_exec_properties=cpu_count=1
build --remote_default_exec_properties=memory_kb=2097152
build:shared --remote_local_fallback=false
# Remote-connection flags. They reach CI too, which composes its own flag list
# but inherits `build` lines (see the pipelining note below).
#
# A keepalive ping every 30 s keeps the pool's long-lived gRPC channels from
# being dropped silently while a client waits on queued actions: six CI legs
# died of `UNAVAILABLE: Keepalive failed` between 22:11 and 23:25 on
# 2026-09-22, each after a long idle wait.
build --grpc_keepalive_time=30s
# Bazel's 60 s default is too short for a large blob transfer to the pool
# under load. CI has run at 600 s since its first pool build; forks now use
# the same value from this one line.
build --remote_timeout=600
# Only pool workers publish action results. A spawn that still runs locally
# (no-remote-exec targets, service gates) is never uploaded, and the pool's
# client listener refuses the write anyway, so a local machine cannot seed a
# result that CI would trust.
build:shared --remote_upload_local_results=false
# A compile or clippy verdict needs no rlib on this disk, and a test verdict
# needs only its logs: CI already runs `minimal` in `.github/workflows/ci.yml`.
# `minimal` keeps every fork from downloading hundreds of megabytes of
# dependency artifacts it never opens. A test downloads its `test.log`,
# `test.xml` and undeclared outputs (the law-execution receipts) and nothing
# else -- not the test binary `toplevel` used to fetch for every label. `run`
# and `doc` ask for their top-level outputs in `scripts/hermetic-build.sh`.
build:shared --remote_download_outputs=minimal
test:shared --remote_download_regex=.*/testlogs/.*/(test[.]log|test[.]xml|test[.]outputs/.*)$
test:shared --test_output=errors
test --cache_test_results=yes

# Every test action writes its own JUnit report. A test that leaves
# $XML_OUTPUT_FILE unwritten costs a second TestRunner spawn (`generate-xml.sh`)
# that carries the test's whole run request for 0.1 s of work and queues for a
# pool slot again: 3,679 of them in 16 h on one dev box, up to 106 s at p90 per
# CI leg. `tools/bazel/test_xml.bzl` explains the prefix. A `--run_under` given
# on the command line (a debugger, say) replaces it, and Bazel then writes the
# report in that extra spawn as before.
test --run_under=//tools/bazel:test_xml_runner

# Local execution remains available for CI, bootstrap, and reproduction.
build:local --spawn_strategy=local
test:local --test_output=errors

# A dependent rlib does not need its dependency's object code, only its
# metadata. With this flag `rules_rust` emits a second, cheap
# `RustcMetadata` action per library (`-Zno-codegen --emit=metadata`, under the
# RUSTC_BOOTSTRAP the rules inject for a stable toolchain) and lets downstream
# libraries start as soon as that hollow rlib lands instead of waiting out the
# full codegen. The chain that owns this repository's Bazel critical path is
# exactly that shape - the lash-internal-core rlib, then the facade rlib, then
# the test binaries that link them - and the metadata half of a 128 s compile
# is a fraction of it. Only `rlib`/`lib` crate types pipeline; proc-macro and
# binary targets are unaffected, and any single target can opt out with
# `disable_pipelining`.
#
# It is set here rather than under `build:shared` because CI never passes
# `--config=shared`: `.github/actions/bazel-shared-cache` composes its own flag
# list, so a flag that must reach CI cannot live in that config.
build --@rules_rust//rust/settings:pipelined_compilation=True

# The pool's cache speaks zstd. Action outputs here are rlibs and test binaries
# measured in hundreds of megabytes, and every one of them crosses the wire at
# least twice; compressing them costs the workers CPU they are not short of and
# buys back runner wall clock on a link that is. Same reason as the flag above
# for living at the `build` level rather than in `build:shared`: an invocation
# with no remote cache ignores it.
build --remote_cache_compression

build --incompatible_strict_action_env
# Measured 2026-09-22 on `just floor` after a one-line test edit: at 8 the
# floor's 74 test actions ran eight at a time while the pool's slots sat
# idle; at 64 the same run was worse (summed remote queue time 9 s ->
# 2700-3900 s, the same tests' worker exec times doubled) because 74
# four-core test actions oversubscribe the pool's 160 CPUs. 16 is shared with
# CI, which composes its own flag list but inherits `build` lines.
build --jobs=16
build --loading_phase_threads=4
build --local_resources=cpu=8
build --local_resources=memory=32768
build --announce_rc
build --show_timestamps

# `--config=judged` is the Bazel spelling of Cargo's `[profile.judged]`: the
# development build geometry with the development-only self-checks removed.
#
# A judged runbook scores what a host actually ships. `debug_assert!` inside
# the runtime turns an in-contract outcome (an exhausted execution bound, say)
# into `effect_panicked`, and the row scores an opaque "turn could not be
# completed" that no shipped host would ever produce. Cargo's judged profile
# fixes that by inheriting `dev` and setting `debug-assertions = false` and
# `overflow-checks = false` for the whole graph, dependencies included.
#
# Bazel needs the same two flags said out loud. Nothing here sets
# `-Cdebug-assertions`, so rustc falls back to its own default, which is ON at
# `-Copt-level=0` — the geometry the judged profile exists to avoid. These are
# whole-build flags for the same reason the Cargo profile is whole-graph: the
# assertions that spoil a judged row live in the dependencies, not in the host
# binary's own crate. `extra_exec_rustc_flags` is deliberately left alone, so
# proc macros and build scripts keep their ordinary geometry and their cache
# entries stay shared with every other build.
#
# `scripts/check_judged_build_geometry.py` pins these two flags against
# `[profile.judged]` in Cargo.toml, so the two spellings cannot drift.
build:judged --@rules_rust//rust/settings:extra_rustc_flag=-Cdebug-assertions=off
build:judged --@rules_rust//rust/settings:extra_rustc_flag=-Coverflow-checks=off
