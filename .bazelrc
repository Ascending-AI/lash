# Where the pool lives, which certificate reaches it, which runtime image it
# pins, and where this host keeps its caches are deployment facts, not
# repository facts: they move when the pool is redeployed or the executor is
# repinned, and they differ between a development host and a CI runner. None
# of them is committed here.
#
# Locally, kiln writes them to .kiln.bazelrc on every fork and golden refresh,
# from the installed executor manifest. The file is gitignored and this import
# is `try-`: a checkout without it still builds, it just has no shared
# executor, and `scripts/hermetic-build.sh --shared` says so rather than
# failing obscurely. In CI they are `build-cache` environment secrets, written
# by the build-infra repository and read by
# `.github/actions/bazel-shared-cache`.
try-import %workspace%/.kiln.bazelrc

startup --host_jvm_args=-Xmx4g
common --enable_platform_specific_config
common --lockfile_mode=error

# Every pre-analysis fetch of a module archive or a release asset is a serial
# point of failure on someone else's CDN, and a single HTTP 500 aborts analysis
# before anything is compiled. Measured against a local server that answers 500
# (Bazel 9.1.0, `bazel fetch` of an http_archive): the stock defaults give 8
# attempts over 17s and then fail, and the outer
# --experimental_repository_downloader_retries layer adds nothing for this error
# class -- --http_connector_attempts is the load-bearing knob. The backoff
# doubles from 100ms and is otherwise unbounded, so raising the attempt count
# alone buys attempts at an exponential price; capping each wait at 15s buys a
# window instead. At these values the same fault injection retries 22 times over
# 199s before giving up, and a 12-failure outage that the defaults could not ride
# out now succeeds on attempt 13. Roughly three minutes of transient 5xx is
# absorbed, against the 13 minutes plus queue position a CI rerun costs.
common --http_connector_attempts=20
common --http_connector_retry_max_timeout=15s
# Pinned rather than inherited: it is the documented retry knob, and a future
# default of 0 would silently remove the outer layer.
common --experimental_repository_downloader_retries=5

# What the pool is asked FOR is a repository fact and stays here.
#
# These two numbers are the request every action carries unless it names its
# own. The scheduler treats both as consumable minimums and subtracts them from
# the worker's advertised totals, and the executor sizes the action's cgroup
# from the memory request, so a default sized for the largest rustc in the
# graph made a 200 ms genrule hold a lash-core-sized slot: bazelbox-02 sat at
# 17 of 20 slots and 30% CPU. The default is therefore the small action, and
# the heavy ones are sized per target from the measured table in
# `tools/bazel/action-sizes.json` (emitted as `exec_properties` into the
# generated BUILD files, where the diff shows them).
#
# Both values are part of every action key, so changing either re-keys this
# repository's whole remote cache. That cost was paid once, deliberately, when
# these lines moved from 4 cores / 4 GiB to the values below. They do not
# change again: an action that is OOM-killed or starved is a missing row in
# action-sizes.json, never a reason to move a default.
build:shared --remote_default_exec_properties=cpu_count=1
build:shared --remote_default_exec_properties=memory_kb=2097152
build:shared --remote_local_fallback=false
# Only pool workers publish action results. A spawn that still runs locally
# (no-remote-exec targets, service gates) is never uploaded, and the pool's
# client listener refuses the write anyway, so a local machine cannot seed a
# result that CI would trust.
build:shared --remote_upload_local_results=false
test:shared --test_output=errors
test --cache_test_results=yes

# Local execution remains available for CI, bootstrap, and reproduction.
build:local --spawn_strategy=local
test:local --test_output=errors

build --incompatible_strict_action_env
build --jobs=8
build --loading_phase_threads=4
build --local_resources=cpu=8
build --local_resources=memory=32768
build --announce_rc
build --show_timestamps
